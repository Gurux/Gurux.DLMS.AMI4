# Build context: the verified release ZIP extracted into app/ by publish-agent.yml.
FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
# Registration and local script compilation require a writable application directory.
RUN mkdir -p /data && chown app:app /app /data
COPY --chown=app:app app/ ./
USER $APP_UID
ENTRYPOINT ["dotnet", "Gurux.DLMS.AMI.Agent.dll"]
