<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>AMI.Compatibility.LegacyModule</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately compile against the published contract, never the current project. -->
    <PackageReference Include="Gurux.DLMS.AMI.Module" Version="[4.1.2611.502]" PrivateAssets="all" />
  </ItemGroup>
</Project>
