<GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
    <ChildContent>
        <TabHeader Name="@GXMenus.PolicyTab">
            <ContentForLink Context="link">
                @switch (link.Url)
                {
                    case "GeneralInformation":
                        @GeneralContent
                        break;
                    case "Policies":
                        @PolicyContent
                        break;
                }
            </ContentForLink>
        </TabHeader>
    </ChildContent>
</GXTabControl>

@code {
    /// <summary>Fields shown in the general information tab.</summary>
    [Parameter] public RenderFragment? GeneralContent { get; set; }

    /// <summary>Policy fields shown in their own tab within the shared edit form.</summary>
    [Parameter] public RenderFragment? PolicyContent { get; set; }
}
