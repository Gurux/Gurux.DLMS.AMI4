@namespace Gurux.DLMS.AMI.Client.Helpers
@using System.Net.Http.Json
@using Gurux.DLMS.AMI.Client.Shared
@inject HttpClient Http
@implements IDisposable

@if (_error)
{
    <p role="alert">@Properties.Resources.UnableToLoadTheRSSFeed</p>
}
else if (_feed != null)
{
    @if (!string.IsNullOrWhiteSpace(_feed.Title))
    {
        <h3 class="h6">@_feed.Title</h3>
    }
    <ul class="list-unstyled mb-0">
        @foreach (var item in _feed.Items)
        {
            <li class="mb-2">
                @if (!string.IsNullOrEmpty(item.Link))
                {
                    <a href="@item.Link" target="_blank" rel="noopener noreferrer">@item.Title</a>
                }
                else
                {
                    @item.Title
                }
                @if (item.Published is { } published)
                {
                    <small class="d-block text-muted"><time datetime="@published.ToString("O")">@published.ToLocalTime().ToString("g")</time></small>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public Guid BlockId { get; set; }

    private Guid? _loadedId;
    private GXBlockFeed? _feed;
    private bool _error;
    private CancellationTokenSource? _request;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == BlockId)
        {
            return;
        }
        _request?.Cancel();
        _request?.Dispose();
        var request = _request = new CancellationTokenSource();
        var id = BlockId;
        _loadedId = id;
        _feed = null;
        _error = false;
        try
        {
            var feed = await Http.GetFromJsonAsync<GXBlockFeed>($"api/Block/Feed/{id}", request.Token);
            if (!request.IsCancellationRequested && BlockId == id)
            {
                _feed = feed;
            }
        }
        catch (OperationCanceledException)when (request.IsCancellationRequested)
        {
        }
        catch (Exception e)when (e is HttpRequestException or System.Text.Json.JsonException)
        {
            if (!request.IsCancellationRequested && BlockId == id)
            {
                _error = true;
            }
        }
    }

    public void Dispose()
    {
        _request?.Cancel();
        _request?.Dispose();
    }
}

