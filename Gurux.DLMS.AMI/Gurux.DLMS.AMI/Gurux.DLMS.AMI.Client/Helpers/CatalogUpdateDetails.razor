@using Gurux.DLMS.AMI.Client.Rest

<article class="catalog-update-details">
    <div class="details-heading">
        <span aria-hidden="true"><CatalogUpdateIcon Entry="Entry" /></span>
        <h2>@Entry.Name <small>@Entry.Version</small></h2>
    </div>
    @if (!string.IsNullOrWhiteSpace(Entry.Description) && Entry.Description != Entry.ReleaseNotes)
    {
        <section aria-label="@Properties.Resources.Description">
            <h3>@Properties.Resources.Description</h3>
            <p class="catalog-details-text">@Entry.Description</p>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(Entry.ReleaseNotes))
    {
        <section aria-label="@Properties.Resources.CatalogUpdateSummary">
            <h3>@Properties.Resources.CatalogUpdateSummary</h3>
            <p class="catalog-details-text">@Entry.ReleaseNotes</p>
        </section>
    }
    @if (ReleaseUrl is { } url)
    {
        <a href="@url" target="_blank" rel="noopener noreferrer">@Properties.Resources.CatalogUpdateRelease</a>
    }
</article>

@code {
    [Parameter, EditorRequired] public GXCatalogUpdateEntry Entry { get; set; } = default!;
    private string? ReleaseUrl => Uri.TryCreate(Entry.ReleaseUrl, UriKind.Absolute, out var uri) &&
        uri.Scheme is "http" or "https" && string.IsNullOrEmpty(uri.UserInfo) ? uri.AbsoluteUri : null;
}
