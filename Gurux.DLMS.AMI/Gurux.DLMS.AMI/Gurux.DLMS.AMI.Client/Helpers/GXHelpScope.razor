@if (string.IsNullOrWhiteSpace(Topic))
{
    @ChildContent
}
else
{
    <CascadingValue Name="@GXHelpTopics.ScopeName" Value="@Topic">
        <GXHelpContext Topic="@Topic" />
        @ChildContent
    </CascadingValue>
}

@code {
    /// <summary>Help topic inherited by components inside the active tab.</summary>
    [Parameter] public string? Topic { get; set; }
    /// <summary>Content belonging to the active tab.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
