@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

@inject ILogger<CreatorSelector> Logger
@if (Action != CrudAction.Create)
{
    <div class="form-group">
        <label>@Properties.Resources.Creator</label>
        <UserSelector Disabled="@(!_isAdmin)" @bind-Value="@Target"></UserSelector>
        <ValidationMessage For="@(() => @Target)" />
    </div>
}

@code {
    /// <summary>Receives the current identity and subsequent authentication changes from the application cascade.</summary>
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationState { get; set; } = default!;


    /// <summary>
    /// Target user.
    /// </summary>
    [Parameter]
    public GXUser? Target { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter, EditorRequired]
    public CrudAction Action { get; set; }

    /// <summary>Records whether administrative actions are available to the current user.</summary>
    private bool _isAdmin;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _isAdmin = false;
            var authenticationState = AuthenticationState;
            var authState = await authenticationState;
            if (authenticationState != AuthenticationState)
            {
                return;
            }
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                _isAdmin = user.IsInRole("admin");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Status tile failed. {ex.Message}", ex);
        }
    }
}
