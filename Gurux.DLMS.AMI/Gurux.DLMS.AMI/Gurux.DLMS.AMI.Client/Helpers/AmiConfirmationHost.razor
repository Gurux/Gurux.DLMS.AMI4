@using Gurux.DLMS.AMI.Module
@inject GXConfirmationService Confirmation
@implements IDisposable

@if (_request is { } request)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="ami-confirmation-title">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ami-confirmation-title">@request.Title</h5>
                    <button type="button" class="btn btn-close" aria-label="@Properties.Resources.Close"
                            @onclick="() => Complete(request.Id, false)">
                    </button>
                </div>
                <div class="modal-body">
                    @if (request.Options.AllowDelete)
                    {
                        <div class="form-check">
                            <input id="ami-confirmation-disable" class="form-check-input" type="radio" name="ami-confirmation-mode"
                                   @onchange="() => _delete = false" checked="@(!_delete)" />
                            <label class="form-check-label" for="ami-confirmation-disable">@Properties.Resources.TargetDisableQuestion</label>
                        </div>
                        <div class="form-check">
                            <input id="ami-confirmation-delete" class="form-check-input" type="radio" name="ami-confirmation-mode"
                                   @onchange="() => _delete = true" checked="@_delete" />
                            <label class="form-check-label" for="ami-confirmation-delete">@Properties.Resources.TargetDeleteQuestion</label>
                            @Properties.Resources.ThisActionCannotBeUndone
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(request.Message))
                    {
                        <div style="white-space: pre-line">@request.Message</div>
                    }
                    @if (request.Options.Items != null)
                    {
                        @foreach (var item in request.Options.Items)
                        {
                            @if (!string.IsNullOrEmpty(item))
                            {
                                <div>@item</div>
                            }
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => Complete(request.Id, false)">
                        @Properties.Resources.Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => Complete(request.Id, true)">
                        @(request.Options.ConfirmText ?? Properties.Resources.Ok)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private GXConfirmationService.Request? _request;
    private IDisposable? _attachment;
    private bool _delete;
    private bool _disposed;

    protected override void OnInitialized()
    {
        Confirmation.Changed += Changed;
        _attachment = Confirmation.Attach();
    }

    private void Changed() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }
        var request = Confirmation.Current;
        if (_request?.Id != request?.Id)
        {
            _delete = false;
        }
        _request = request;
        StateHasChanged();
    });

    private void Complete(Guid id, bool approved)
    {
        Confirmation.Complete(id, approved, _delete);
    }

    public void Dispose()
    {
        _disposed = true;
        Confirmation.Changed -= Changed;
        _attachment?.Dispose();
    }
}
