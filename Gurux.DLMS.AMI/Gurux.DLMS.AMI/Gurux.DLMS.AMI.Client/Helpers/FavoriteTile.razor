@using System.Diagnostics.CodeAnalysis
@using Gurux.DLMS.AMI.Shared.DIs;
@using Gurux.DLMS.AMI.Shared.DTOs;
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;

@inject HttpClient Http
@inject IGXProgress Progress
@inject IGXNotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<FavoriteTile> Logger
@implements IDisposable
@inject IServiceProvider Services

@if (!_hide)
{
    @ChildContent
    @if (Checked)
    {
        <GXTooltip Title="@Properties.Resources.RemoveFromFavorites">
            <span @onclick="Unselect" style="color:deepskyblue"><span style="font-size:32px;">&#9733;</span></span>
        </GXTooltip>
    }
    else
    {
        <GXTooltip Title="@Properties.Resources.AddToFavorites">
            <span @onclick="Select" style="color:black"><span style="font-size:32px;">&#9734;</span></span>
        </GXTooltip>
    }
}

@code {
    /// <summary>
    /// User favorites.
    /// </summary>
    List<GXFavorite> _favorites = new List<GXFavorite>();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public bool Checked { get; set; }

    /// <summary>
    /// Select the star.
    /// </summary>
    async Task Select()
    {
        try
        {
            Checked = true;
            StateHasChanged();
            NotificationService.RemoveByKey("An error occurred while adding a favorite.");
            using var progressScope1 = Progress.ProgressStart(GXProgress.RetrievingFavoriteTile);
            //Add favorite.
            UpdateFavorite req = new UpdateFavorite();
            req.Favorites = new GXFavorite[]
            {
                new GXFavorite()
                {
                    Path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
                }
            };
            var ret = await Http.PostAsJson<UpdateFavoriteResponse>("api/Favorite/Add", req);
            if (ret.Ids == null || !ret.Ids.Any())
            {
                //If object is not create yet.
                Checked = false;
                StateHasChanged();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "An error occurred while adding a favorite.");
        }
    }

    /// <summary>
    /// Unselect the star.
    /// </summary>
    async Task Unselect()
    {
        try
        {
            Checked = false;
            NotificationService.RemoveByKey("An error occurred while removing a favorite.");
            using var progressScope2 = Progress.ProgressStart(GXProgress.RetrievingFavoriteTile);
            string path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            foreach (var it in _favorites)
            {
                if (it.Path == path)
                {
                    //Remove favorite.
                    _favorites.Remove(it);
                    RemoveFavorite req = new RemoveFavorite();
                    req.Ids = new Guid[] { it.Id };
                    _ = await Http.PostAsJson<RemoveFavoriteResponse>("api/Favorite/Delete", req);
                    break;
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "An error occurred while removing a favorite.");
        }
    }

    bool _hide;
    bool _authenticated;

    /// <summary>
    /// Update check state.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        bool found = false;
        string path = NavigationManager.ToBaseRelativePath(e.Location);
        //Favorite title is not shown on the main page or favorites page.
        bool oldHide = _hide;
        _hide = !_authenticated || string.IsNullOrEmpty(path) || string.Compare(path, "Favorites", true) == 0;
        if (!_hide)
        {
            foreach (var it in _favorites)
            {
                if (it.Path == path)
                {
                    found = true;
                    break;
                }
            }

        }
        if (oldHide != _hide || Checked != found)
        {
            Checked = found;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool isClient;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isClient = true;
            await LoadFavoritesAsync(await AuthStateProvider.GetAuthenticationStateAsync());
        }
    }

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        _hide = true;
    }

    private async Task LoadFavoritesAsync(AuthenticationState state)
    {
        if (!isClient)
        {
            return;
        }
        _authenticated = state.User.Identity?.IsAuthenticated == true;
        _hide = !_authenticated;
        Checked = false;
        _favorites.Clear();
        if (!_hide)
        {
            try
            {
                //Get favorites if user is authenticated.
                ListFavorites req = new ListFavorites();
                using var response = await Http.PostAsJsonAsync("api/Favorite/List", req);
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // The API session can expire after the client authentication state was serialized.
                    _authenticated = false;
                    _hide = true;
                    Checked = false;
                    _favorites.Clear();
                    Logger.LogInformation("Favorites are unavailable because the API session is not authenticated.");
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                await response.EnsureSuccessAsync(CancellationToken.None);
                var tmp = await response.Content.ReadFromJsonAsync<ListFavoritesResponse>();
                IEnumerable<GXFavorite>? list = tmp?.Favorites;
                if (list != null)
                {
                    _favorites.AddRange(list);
                    StateHasChanged();
                }
                //Update favorite star.
                OnLocationChanged(null, new LocationChangedEventArgs(NavigationManager.Uri, false));
            }
            catch (Exception ex)
            {
                NotificationService.ReportError(ex);
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        await InvokeAsync(() => LoadFavoritesAsync(state));
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
