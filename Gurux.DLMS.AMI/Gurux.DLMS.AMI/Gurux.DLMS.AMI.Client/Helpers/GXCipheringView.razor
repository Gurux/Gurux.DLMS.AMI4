@using Microsoft.AspNetCore.Components.Forms
@using DeviceSettings = Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings

@* <summary>Edits ciphering material supplied by a device or device-template editor.</summary> *@
<GXHelpContext Topic="Ciphering" />
<CascadingValue @key="FormContext" Value="@FormContext">
    <ValidationSummary />
    <div class="row gx-ciphering-view">
        <div class="form-group">
            <label>@Properties.Resources.Security</label>
            <input type="text" class="form-control" value="@((Gurux.DLMS.Enums.Security)Settings.Security)" readonly />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@(ClientSystemTitleDisabled ?? Disabled)" Value="@Settings.ClientSystemTitle"
                             ValueChanged="@((byte[]? value) => ChangeAsync(() => Settings.ClientSystemTitle = value, ClientSystemTitleDisabled))"
                             Title="@Properties.Resources.ClientSystemTitle" />
            <ValidationMessage For="@(() => Settings.ClientSystemTitle)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@Disabled" Value="@Settings.DeviceSystemTitle"
                             ValueChanged="@((byte[]? value) => ChangeAsync(() => Settings.DeviceSystemTitle = value))"
                             Title="@Properties.Resources.DeviceSystemTitle" />
            <ValidationMessage For="@(() => Settings.DeviceSystemTitle)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@Disabled" Value="@Settings.BlockCipherKey"
                             ValueChanged="@((byte[]? value) => ChangeAsync(() => Settings.BlockCipherKey = value))"
                             Title="@Properties.Resources.BlockCipherKey" />
            <ValidationMessage For="@(() => Settings.BlockCipherKey)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@Disabled" Value="@Settings.AuthenticationKey"
                             ValueChanged="@((byte[]? value) => ChangeAsync(() => Settings.AuthenticationKey = value))"
                             Title="@Properties.Resources.AuthenticationKey" />
            <ValidationMessage For="@(() => Settings.AuthenticationKey)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@Disabled" Value="@Settings.BroadcastKey"
                             ValueChanged="@((byte[]? value) => ChangeAsync(() => Settings.BroadcastKey = value))"
                             Title="@Properties.Resources.BroadcastKey" />
            <ValidationMessage For="@(() => Settings.BroadcastKey)" />
        </div>
    </div>
</CascadingValue>

@code {
    /// <summary>Gets or sets the owning editor's mutable DLMS settings instance.</summary>
    [Parameter, EditorRequired]
    public DeviceSettings Settings { get; set; } = default!;

    /// <summary>Gets or sets the owning form context used for field validation.</summary>
    [Parameter, EditorRequired]
    public EditContext FormContext { get; set; } = default!;

    /// <summary>Gets or sets whether the owner prohibits editing key material.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets whether the client title is read-only; null uses the key-material editing state.</summary>
    [Parameter]
    public bool? ClientSystemTitleDisabled { get; set; }

    /// <summary>Notifies the owner after a permitted byte-array change so it can mark its settings field modified.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Applies a permitted byte-array edit and notifies the owning editor.</summary>
    /// <param name="change">Assigns the new bytes to the supplied settings instance.</param>
    /// <param name="disabled">An optional field-specific read-only state; null uses the key-material state.</param>
    /// <returns>The completion of the owner's change notification.</returns>
    private async Task ChangeAsync(Action change, bool? disabled = null)
    {
        if (disabled ?? Disabled)
        {
            return;
        }
        change();
        await OnChanged.InvokeAsync();
    }
}
