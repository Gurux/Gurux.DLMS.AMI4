@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@inject HttpClient Http
@inherits ErrorBoundary
@if (CurrentException == null)
{
    @ChildContent
}
else if (ErrorContent != null)
{
    @ErrorContent(CurrentException)
}
else
{
    <div class="alert alert-danger" role="alert">
        @Gurux.DLMS.AMI.Client.Properties.Resources.AnUnhandledErrorHasOccurred
    </div>
}

@code
{
    /// <summary>Changing the route recovers a failed page while preserving healthy editor state.</summary>
    [Parameter]
    public string? RecoveryKey { get; set; }

    private string? _recoveryKey;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_recoveryKey, RecoveryKey, StringComparison.Ordinal))
        {
            _recoveryKey = RecoveryKey;
            if (CurrentException != null)
            {
                Recover();
            }
        }
        base.OnParametersSet();
    }

    protected override async Task OnErrorAsync(Exception exception)
    {
        try
        {
            GXLog ue = new GXLog(System.Diagnostics.TraceLevel.Error);
            ue.Message = exception.Message;
            ue.StackTrace = exception.StackTrace;
            AddLog req = new AddLog();
            req.Type = "Error";
            req.Logs = new GXLog[] { ue };
            await Http.PostAsJson<AddLogResponse>("api/Log/Add?source=user-error", req);
        }
        catch (Exception)
        {
            //It's OK if this fails.
        }
        await base.OnErrorAsync(exception);
    }

    public new void Recover()
    {
        base.Recover();
    }
}
