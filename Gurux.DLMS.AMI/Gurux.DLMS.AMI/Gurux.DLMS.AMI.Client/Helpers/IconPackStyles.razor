@foreach (var pack in Packs ?? DefaultPacks)
{
    <link rel="stylesheet" href="@pack.Replace("\\\"", "\"").Replace("\"", "'")" crossorigin="anonymous" />
}

@code {
    private static readonly string[] DefaultPacks = ["lib/bootstrap-icons/bootstrap-icons.min.css"];

    /// <summary>Selected icon stylesheets; null uses built-in icons while settings load, and an empty list disables them.</summary>
    [Parameter] public IEnumerable<string>? Packs { get; set; }
}
