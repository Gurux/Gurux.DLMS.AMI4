@using Gurux.DLMS.AMI.Shared.Rest
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using System.Globalization
@using System.Diagnostics
@inject HttpClient Http

@typeparam TItem

@inject ILogger<EnumTypeSelector<TItem>> Logger


@if (Types != null)
{
    <GXInputDropdown class="form-select"
                     Id="Tasks-Type"
                     @bind-Value="@Selected"
                     Items="Values"
                     Formatter="@(name => GXEnumTypeKeys.GetDisplayName(Type, name) ?? string.Empty)"
                     OnSelected="@((string? e) => Updated(e))">
    </GXInputDropdown>
}

@code {
    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected value.
    /// </summary>
    [Parameter]
    public TItem Value { get; set; } = default!;

    /// <summary>
    /// Notified when the selected item is changed.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> ValueChanged { get; set; }

    private IEnumerable<string?> Values
    {
        get
        {
            return Types?.Select(s => s.Name) ?? Enumerable.Empty<string?>();
        }
    }

    /// <summary>
    /// Enum type.
    /// </summary>
    [Parameter]
    public string? Type { get; set; }

    GXEnumType[]? Types;

    private string? Selected { get; set; }

    /// <summary>
    /// Notified when the selected item is changed.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnSelected { get; set; }

    /// <summary>
    /// Used resource storage.
    /// </summary>
    [Inject]
    public IServiceProvider Services { get; set; } = default!;

    public IGXResourceStorage? ResourceStorage => Services.GetService<IGXResourceStorage>();

    private string? ToString(GXEnumType value)
    {
        return value?.Name;
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated(string? value)
    {
        Logger.LogInformation("Selected value changed to {value}", value);
        try
        {
            Type type = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
            if (string.IsNullOrEmpty(value) || value == "-")
            {
                // The placeholder clears the filter; its default Id is not a log type.
                Value = default!;
            }
            else if (type.IsEnum)
            {
                // Special handling for enums.
                Value = (TItem)Enum.Parse(type, value);
                Logger.LogInformation("New value changed from {Value} to {value}", Value, value);
            }
            else
            {
                GXEnumType? sel = Types?.Where(w => w.Name == value).SingleOrDefault();
                if (sel != null)
                {
                    var targetType = Nullable.GetUnderlyingType(typeof(TItem)) ?? typeof(TItem);
                    var converted = (TItem?)Convert.ChangeType(
                       GXEnumTypeKeys.GetKey(Type, sel),
                       targetType,
                       CultureInfo.InvariantCulture);
                    if (converted == null)
                    {
                        throw new Exception($"Conversion failed for value '{value}' to type '{targetType}'.");
                    }
                    Value = converted;
                }
                else
                {
                    Value = default!;
                }
            }
            await ValueChanged.InvokeAsync(Value);
            await OnSelected.InvokeAsync(Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in Selected setter.");
        }
    }

    /// <summary>
    /// Enum type filter.
    /// </summary>
    private GXEnumType filter = new GXEnumType();

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            var storage = ResourceStorage;
            if (storage != null)
            {
                storage.OnEnumTypesChanged = EventCallback.Factory.Create(this, v => Refresh());
            }
            await Refresh();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Read enumeration types.
    /// </summary>
    protected async Task Refresh()
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingEnumType);
        try
        {
            filter.Type = Type;
            ListEnumTypes req = new ListEnumTypes()
            {
                Filter = filter,
            };
            var ret = await Http.PostAsJson<ListEnumTypesResponse>("api/EnumType/List", req);
            var tmp = new List<GXEnumType>();
            if (ret.Types != null)
            {
                //Empty filter.
                tmp.Add(new GXEnumType() { Name = "-" });
                tmp.AddRange(ret.Types);
            }
            Types = tmp.ToArray();
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (OperationCanceledException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (ObjectDisposedException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(ex.ToString());
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}
