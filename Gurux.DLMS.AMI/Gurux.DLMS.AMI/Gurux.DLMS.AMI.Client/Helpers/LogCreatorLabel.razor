@using System.Text.Json
@inject HttpClient Http
@implements IDisposable

<span title="@Creator" @attributes="AdditionalAttributes">@_label</span>

@code {
    [Parameter] public Guid? Creator { get; set; }
    [Parameter, EditorRequired] public string Resource { get; set; } = default!;
    [Parameter] public string Property { get; set; } = "Name";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private string? _label;
    private string? _key;
    private CancellationTokenSource? _request;

    protected override async Task OnParametersSetAsync()
    {
        var key = Resource + "/" + Creator + "/" + Property;
        if (key == _key)
        {
            return;
        }
        _key = key;
        _request?.Cancel(); _request?.Dispose();
        _request = new CancellationTokenSource();
        _label = Creator?.ToString();
        if (!Creator.HasValue)
        {
            return;
        }
        var request = _request;
        var token = request.Token;
        try
        {
            using var response = await Http.GetAsync($"api/{Resource}?id={Creator}", token);
            if (!response.IsSuccessStatusCode)
            {
                return;
            }
        
            using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync(token));
            var item = json.RootElement;
            if (item.ValueKind != JsonValueKind.Object)
            {
                return;
            }
        
            var wrapper = item.EnumerateObject().FirstOrDefault(p => p.Name.Equals("Item", StringComparison.OrdinalIgnoreCase));
            if (wrapper.Value.ValueKind == JsonValueKind.Object)
            {
                item = wrapper.Value;
            }
        
            if (item.ValueKind != JsonValueKind.Object)
            {
                return;
            }
        
            var name = item.EnumerateObject().FirstOrDefault(p => p.Name.Equals(Property, StringComparison.OrdinalIgnoreCase)).Value;
            if (_request == request && name.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(name.GetString()))
            {
                _label = name.GetString();
            }
        }
        catch (HttpRequestException)
        {
        }
        catch (OperationCanceledException)
        {
        }
        catch (JsonException)
        {
        }
    }

    public void Dispose() { _request?.Cancel(); _request?.Dispose(); }
}
