@using Microsoft.AspNetCore.Components.Authorization
@inject ModuleLoader Loader
@inject AuthenticationStateProvider Authentication
@implements IDisposable
@foreach (var module in Loader.AddIns)
{
    @foreach (var page in module.Pages.Where(p => p.Navigation))
    {
        <div class="nav-item px-3"><NavLink class="nav-link" href="@($"addin/{module.Id}/{page.Route}")">@(page.Title ?? page.Route)</NavLink></div>
    }
}
@code {
    private readonly CancellationTokenSource _lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Loader.Changed += Changed;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        try
        {
            if (!Loader.IsInitialized)
            {
                await Loader.RefreshAsync(_lifetime.Token);
            }
        }
        catch (OperationCanceledException)when (_lifetime.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private void AuthenticationChanged(Task<AuthenticationState> state) => _ = InvokeAsync(async () =>
    {
        try
        {
            await Loader.RefreshAsync(_lifetime.Token);
        }
        catch (OperationCanceledException)when (_lifetime.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }
    });
    public void Dispose()
    {
        Loader.Changed -= Changed;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        _lifetime.Cancel();
    }
}
