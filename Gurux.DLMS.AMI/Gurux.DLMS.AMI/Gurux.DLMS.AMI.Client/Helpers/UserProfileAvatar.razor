@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.DLMS.AMI.Shared.Rest
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject HttpClient Http
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@implements IDisposable

@if (!string.IsNullOrEmpty(_value))
{
    <GXImage Value="@_value" Width="32" Height="32" />
}
else
{
    <GXImage Id="User" Width="32" Height="32" />
}

@code {
    private string? _value;
    private Guid? _picture;
    private string? _owner;
    private long _revision;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += LocationChanged;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        await ReloadAsync();
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(ReloadAsync);
    private void AuthenticationChanged(Task<AuthenticationState> state) => _ = InvokeAsync(ReloadAsync);

    private async Task ReloadAsync()
    {
        var revision = ++_revision;
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            if (_disposed || revision != _revision) {
                return;
            }
            var owner = ClientHelpers.GetUserId(principal, false);
            if (string.IsNullOrEmpty(owner))
            {
                _owner = null; _picture = null; _value = null;
                StateHasChanged();
                return;
            }
            var id = await Http.GetFromJsonAsync<Guid?>("api/User/Picture/Current");
            if (_disposed || revision != _revision) {
                return;
            }
            if (_owner == owner && _picture == id && (!id.HasValue || !string.IsNullOrEmpty(_value))) {
                return;
            }
            string? value = null;
            if (id.HasValue)
                {
                value = (await Http.GetAsJsonAsync<GetAppearanceResponse>($"api/Appearance?type={(int)ResourceType.Image}&id={id.Value}")).Item?.Value;
            }
            if (!_disposed && revision == _revision)
            {
                _owner = owner; _picture = id; _value = value;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            if (!_disposed && revision == _revision) { _owner = null; _picture = null; _value = null; StateHasChanged(); }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ++_revision;
        Navigation.LocationChanged -= LocationChanged;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
    }
}
