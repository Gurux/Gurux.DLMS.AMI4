@inject ILogger<BlockFileView> Logger
@inject HttpClient Http
@implements IDisposable

@if (_error)
{
    <p role="alert">@Properties.Resources.UnableToLoadTheBlockContentFile</p>
}
else if (_content != null)
{
    <div class="markup">@((MarkupString)_content)</div>
}

@code {
    [Parameter]
    public Guid BlockId { get; set; }

    private Guid? _loadedId;
    private string? _content;
    private bool _error;
    private CancellationTokenSource? _request;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == BlockId)
        {
            return;
        }
        _request?.Cancel();
        _request?.Dispose();
        var request = _request = new CancellationTokenSource();
        var id = BlockId;
        _loadedId = id;
        _content = null;
        _error = false;
        try
        {
            var content = await Http.GetStringAsync($"api/Block/Content/{id}", request.Token);
            if (!request.IsCancellationRequested && BlockId == id)
            {
                _content = content;
            }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
        }
        catch (HttpRequestException error)
        {
            Logger.LogError(error, "{Message}", error.Message);
            if (!request.IsCancellationRequested && BlockId == id)
            {
                _error = true;
            }
        }
    }

    public void Dispose()
    {
        _request?.Cancel();
        _request?.Dispose();
    }
}

