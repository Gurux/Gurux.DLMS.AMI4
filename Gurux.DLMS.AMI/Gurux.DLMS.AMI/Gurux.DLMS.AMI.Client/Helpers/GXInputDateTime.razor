@using System.Diagnostics.CodeAnalysis
@using System.Globalization;
@using Gurux.DLMS

@inherits InputBase<GXDateTime>

<input class="@GXComponentAttributes.GetClass(AdditionalAttributes, EditContext?.FieldCssClass(FieldIdentifier))"
       style="@GXComponentAttributes.GetStyle(AdditionalAttributes)"
       @attributes="GXComponentAttributes.WithoutCss(AdditionalAttributes)"
       value="@BindConverter.FormatValue(CurrentValueAsString)"
       onchange="@((ChangeEventArgs __e) => CurrentValueAsString = Convert.ToString(__e.Value))" />
@code {
    protected override string FormatValueAsString(GXDateTime? value)
    {
        return value?.ToFormatString() ?? string.Empty;
    }

    protected override bool TryParseValueFromString(string? value,
    [MaybeNullWhen(false)] out GXDateTime result,
        [NotNullWhen(false)] out string validationErrorMessage)
    {
        validationErrorMessage = "";
        // GXDateTime uses reference equality. Re-entering the displayed value is not an edit.
        if (Value != null && value == FormatValueAsString(Value))
        {
            result = Value;
            return true;
        }
        if (value != null)
        {
            try
            {
                result = new GXDateTime(value);
            }
            catch (Exception ex)
            {
                result = new GXDateTime();
                validationErrorMessage = ex.Message;
                return false;
            }
        }
        else
        {
            result = new GXDateTime();
        }
        return true;
    }
}
