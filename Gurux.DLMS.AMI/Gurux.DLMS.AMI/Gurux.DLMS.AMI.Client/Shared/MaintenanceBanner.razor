@using System.Text.Json
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.DTOs
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGXNotificationService NotificationService
@inject ILogger<MaintenanceBanner> Logger
@implements IAsyncDisposable

@if (_settings?.IsActive(DateTimeOffset.UtcNow) == true)
{
    <div class="alert alert-warning" role="alert">
        @if (_isAdmin)
        {
            <span>@Properties.Resources.YourSiteIsOnMaintenanceMode</span>
            <a class="btn btn-link" href="config/maintenance">@Properties.Resources.GoOnLine</a>
            <hr />
            <span>@_settings.Message</span>
        }
        else
        {
            <p>@(string.IsNullOrWhiteSpace(_settings.Message) ? Properties.Resources.SiteIsOnMaintenanceMode : _settings.Message)</p>
        }
        @if (_settings.StartTime != null)
        {
            <div>StartTime: @_settings.StartTime.Value.ToLocalTime()</div>
        }
        @if (_settings.EndTime != null)
        {
            <div>EndTime: @_settings.EndTime.Value.ToLocalTime()</div>
        }
    </div>
}

@code {
    [Parameter]
    public EventCallback<bool> OnBlockingChanged { get; set; }

    private MaintenanceSettings? _settings;
    private bool _blocking;
    private bool _disposed;
    private bool _isAdmin;
    private readonly CancellationTokenSource _stop = new();
    private Task? _watch;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += AuthenticationChanged;
        await SetAuthentication(await AuthenticationStateProvider.GetAuthenticationStateAsync());
        await Refresh();
        _watch = Watch();
    }

    private async Task SetAuthentication(AuthenticationState state)
    {
        if (_disposed)
        {
            return;
        }
        _isAdmin = state.User.IsInRole("admin");
        await PublishState();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishState()
    {
        if (_disposed)
        {
            return;
        }
        var blocking = !_isAdmin && _settings?.IsActive(DateTimeOffset.UtcNow) == true;
        if (_blocking != blocking)
        {
            _blocking = blocking;
            await OnBlockingChanged.InvokeAsync(blocking);
        }
    }

    private async void AuthenticationChanged(Task<AuthenticationState> state)
    {
        try
        {
            await SetAuthentication(await state);
            await Refresh();
        }
        catch (OperationCanceledException)when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to update maintenance authentication state.");
        }
    }

    private async Task Refresh()
    {
        try
        {
            _settings = await Http.GetAsJsonAsync<MaintenanceSettings>("api/Configuration/Maintenance", _stop.Token);
        }
        catch (OperationCanceledException)when (_stop.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        { /* Preserve the last known state during a connection failure. */
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to retrieve maintenance status.");
        }
        if (!_disposed)
        {
            await PublishState();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Watch()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            int ticks = 0;
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (++ticks % 15 == 0)
                {
                    await Refresh();
                }
                else
                {
                    await PublishState();
                    if (!_disposed)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch (OperationCanceledException)when (_stop.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= AuthenticationChanged;
        _stop.Cancel();
        if (_watch != null)
        {
            await _watch;
        }
        _stop.Dispose();
    }
}
