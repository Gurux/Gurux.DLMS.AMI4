@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

<label class="visually-hidden" for="@(_id + "-filter")"><GXLocalizedText Value="@Properties.Resources.FilterPermissionsByName" /></label>
<input id="@(_id + "-filter")" data-testid="permission-filter" class="form-control" type="search" placeholder="@Properties.Resources.FilterByName"
       @bind="_filter" @bind:event="oninput" @bind:after="RefreshGroups" disabled="@Disabled" />
<hr />
<div class="d-flex gap-2 mb-2">
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Disabled" data-permission-action="select-visible" @onclick="SelectVisible"><GXLocalizedText Value="@Properties.Resources.SelectVisible" /></button>
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Disabled" data-permission-action="clear-visible" @onclick="ClearVisible"><GXLocalizedText Value="@Properties.Resources.ClearVisible" /></button>
</div>
<GXViewTable ViewName="@ViewName" ViewColumns="ViewColumnDefaults" ViewPolicies="@ViewPolicies"
 TItem="PermissionGroup" Context="group" @ref="_table" @key="_catalogKey"
         ItemsProvider="GetGroups" ShowAllUsers="false" ShowRemoved="false" ShowAllData="true">
    <HeaderContent>
        <GXTh Id="Name"><GXLocalizedText Value="@Properties.Resources.Name" /></GXTh>
        <GXTh Id="Permissions"><GXLocalizedText Value="@Properties.Resources.Permissions" /></GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name"><GXLocalizedText Value="@ClientHelpers.KebabToTitle(group.Name)" /></GXTd>
        <GXTd Id="Permissions">
            <Gurux.UI.Components.Accordion.GXAccordion Id="@(_id + "-" + group.Name)">
                <HeaderTemplate>
                    <span>@string.Join(", ", group.Names.Where(IsSelected).Select(n => ClientHelpers.KebabToTitle(PermissionAction(n))))</span>
                </HeaderTemplate>
                <ChildContent>
                    @foreach (var name in group.Names)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2" data-testid="@("permission-" + name)" @key="name">
                            <GXInputSwitch Inline="true" TValue="bool" Value="@IsSelected(name)" Save="false" Disabled="@Disabled"
                                    ValueChanged="@((bool selected) => SetPermission(name, selected))" />
                            <GXLocalizedText Value="@ClientHelpers.KebabToTitle(PermissionAction(name))" />
                        </div>
                    }
                </ChildContent>
            </Gurux.UI.Components.Accordion.GXAccordion>
        </GXTd>
    </ItemContent>
</GXViewTable>

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Permissions") { Position = 1, Description = "Permissions", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private readonly string _id = "permissions-" + Guid.NewGuid().ToString("N");
    private string? _filter;
    private GXTable<PermissionGroup>? _table;
    private string _catalogKey = string.Empty;

    protected override void OnParametersSet()
    {
        // The permission catalog arrives asynchronously after the editor's first render.
        // Recreate the table only when its available rows or target change.
        _catalogKey = ContextKey + "|" + string.Join(",", PermissionNames);
    }

    public sealed record PermissionGroup(string Name, string[] Names);

    private static string GroupName(string name)
    {
        var separator = name.LastIndexOf('.');
        return separator > 0 ? name[..separator] : name;
    }

    private static string PermissionAction(string name)
    {
        var separator = name.LastIndexOf('.');
        return separator >= 0 ? name[(separator + 1)..] : name;
    }

    private ValueTask<ItemsProviderResult<PermissionGroup>> GetGroups(GXItemsProviderRequest request)
    {
        var groups = PermissionNames.GroupBy(GroupName, StringComparer.OrdinalIgnoreCase)
            .Where(g => string.IsNullOrWhiteSpace(_filter)
                || (ClientHelpers.KebabToTitle(g.Key) ?? string.Empty).Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || g.Any(n => n.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
            .Select(g => new PermissionGroup(g.Key, g.OrderBy(PermissionAction, StringComparer.OrdinalIgnoreCase).ToArray()))
            .OrderBy(g => g.Name, StringComparer.OrdinalIgnoreCase).ToArray();
        return new(new ItemsProviderResult<PermissionGroup>(groups, groups.Length));
    }

    private async Task RefreshGroups()
    {
        if (_table != null)
        {
            await _table.RefreshDataAsync(true);
        }
    }

    [Parameter]
    public string? ContextKey { get; set; }

    [Parameter]
    public string ViewName { get; set; } = string.Empty;

    [Parameter]
    public List<string>? ViewPolicies { get; set; }

    [Parameter]
    public IEnumerable<string> SelectedNames { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<PermissionSelection> SelectionChanged { get; set; }

    public sealed record PermissionSelection(string Name, bool Selected);

    [Parameter]
    public IEnumerable<GXPermission> Catalog { get; set; } = Array.Empty<GXPermission>();

    [Parameter]
    public bool Disabled { get; set; }

    private IEnumerable<string> PermissionNames => Catalog.Select(p => p.Name)
        .Where(n => !string.IsNullOrEmpty(n)).Select(n => n!)
        .Concat(SelectedNames)
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(n => n);

    private string[] VisibleNames => PermissionNames.GroupBy(GroupName, StringComparer.OrdinalIgnoreCase)
        .Where(g => string.IsNullOrWhiteSpace(_filter)
            || (ClientHelpers.KebabToTitle(g.Key) ?? string.Empty).Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || g.Any(n => n.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        .SelectMany(g => g).ToArray();
    private bool IsSelected(string name) => SelectedNames.Contains(name, StringComparer.OrdinalIgnoreCase);

    private async Task SelectVisible()
    {
        if (Disabled)
        {
            return;
        }
        foreach (var name in VisibleNames)
        {
            await SetPermission(name, true);
        }
    }

    private async Task ClearVisible()
    {
        if (Disabled)
        {
            return;
        }
        foreach (var name in VisibleNames)
        {
            await SetPermission(name, false);
        }
    }

    private async Task SetPermission(string name, bool selected)
    {
        if (Disabled)
        {
            return;
        }
        if (IsSelected(name) == selected)
        {
            return;
        }
        await SelectionChanged.InvokeAsync(new PermissionSelection(name, selected));
    }
}
