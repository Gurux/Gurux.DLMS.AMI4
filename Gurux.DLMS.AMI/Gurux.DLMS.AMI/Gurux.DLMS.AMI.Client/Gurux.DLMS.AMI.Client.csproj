<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);Testing/**</DefaultItemExcludes>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">0.0.1-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Gurux.DLMS.AMI.Module" Version="5.0.2611.1101" />
        <PackageReference Include="Gurux.DLMS" Version="9.0.2609.2201" />
        <PackageReference Include="Gurux.DLMS.AMI.Http" Version="4.1.2611.501" />
        <PackageReference Include="Gurux.DLMS.AMI.Script" Version="4.1.2611.901" />
        <PackageReference Include="Gurux.DLMS.UI.Components" Version="1.0.2611.1201" />
        <PackageReference Include="Gurux.Net" Version="8.4.2604.201" />
        <PackageReference Include="Gurux.Scheduling" Version="1.0.2609.2201" />
        <PackageReference Include="Gurux.Serial" Version="8.4.2503.603" />
        <PackageReference Include="Gurux.Updater.Net" Version="1.0.2611.601" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Http.Connections.Client" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="ModuleComponents.xml" />
    </ItemGroup>
    <ItemGroup Condition="'$(AmiReleaseBuild)' == 'true'">
        <Content Remove="wwwroot/appsettings.Development*.json" />
    </ItemGroup>
</Project>
