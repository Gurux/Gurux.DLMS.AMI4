@using Gurux.DLMS.AMI.Client.Helpers
@inject GXScriptCommunityNotifications Notifications
@implements IDisposable

@code {
    /// <summary>Cancels outstanding asynchronous work when the component is disposed.</summary>
    private readonly CancellationTokenSource _lifetime = new();

    protected override void OnInitialized()
    {
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            do
            {
                try
                {
                    await Notifications.RefreshAsync(_lifetime.Token);
                }
                catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; }
                catch (Exception)
                {
                    // An unavailable AMI server must not discard reviews or flood the user with polling errors.
                    // The durable outcomes will be fetched again after reconnection.
                }
            }
            while (await timer.WaitForNextTickAsync(_lifetime.Token));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        Notifications.Reset();
        _lifetime.Dispose();
    }
}
