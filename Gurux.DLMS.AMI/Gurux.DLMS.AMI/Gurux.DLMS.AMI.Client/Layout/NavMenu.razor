@using System.Diagnostics
@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.DLMS.AMI.Shared.Rest
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger

@inject AuthenticationStateProvider AuthStateProvider
@inject CachedHttpClient CachedHttp
@inject IServiceProvider Services
@using Gurux.DLMS.AMI.Shared.DIs

<input type="checkbox" title="@Properties.Resources.NavigationMenu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (_menu?.Links != null)
        {
            @foreach (var link in _menu.Links)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@link.Url" Match="@GetPrefix(link.Url)">
                        @if (!string.IsNullOrEmpty(link.Icon))
                        {
                            <GXImage Id="@link.Icon"></GXImage>
                        }
                        <GXLocalizedText Value="@link.Name" />
                        @if (!string.IsNullOrEmpty(link.Padges))
                        {
                            <GXBadge Value="@ClientHelpers.GetBadgeCount(_updateStamps, link.Padges)"
                                   Label="@link.PadgeTitle"
                                   TraceLevel="@ClientHelpers.GetBadgeTraceLevel(_updateStamps, link.Padges)">
                            </GXBadge>
                        }
                    </NavLink>
                </div>
            }
        }
        <UpdateNavigation />
    </nav>
</div>

@code {


    private NavLinkMatch GetPrefix(string? url)
    {
        if (url == "/")
        {
            return NavLinkMatch.All;
        }
        return NavLinkMatch.Prefix;
    }

    private string? currentUrl;
    private GXMenu? _menu;
    private IAmiMenuStorage? _menuStorage;
    private bool _disposed;
    private int _menuVersion;

    //Language has changed.
    public void LanguageUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private IGXNotifier2? Notifier;

    /// <summary>
    /// User stamps.
    /// </summary>
    private List<GXUserStamp> _updateStamps = new();

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        Notifier = Services.GetService<IGXNotifier2>();
        _menuStorage = Services.GetService<IAmiMenuStorage>();
        try
        {
            if (_menuStorage != null)
            {
                _menuStorage.MenuChanged += OnMenuChanged;
                var version = _menuVersion;
                var menu = await _menuStorage.GetMenuAsync(GXMenus.NavMenu);
                if (!_disposed && version == _menuVersion)
                {
                    _menu = menu;
                }
            }
            if (Notifier != null)
            {
                _updateStamps.Clear();
                _updateStamps.AddRange(Notifier.GetUserStamps(ClientHelpers.GetBadges(_menu)));
                Notifier.On<IEnumerable<GXUserStamp>>(this, nameof(IGXHubEvents.StampUpdate), (stamps) =>
                {
                    bool updated = ClientHelpers.UpdateUserStamps(stamps, _updateStamps);
                    if (updated)
                    {
                        InvokeAsync(StateHasChanged);
                    }
                });

            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred.");
        }
    }

    private void OnMenuChanged(object? sender, GXMenuChangedEventArgs args)
    {
        if (args.Name != GXMenus.NavMenu || _disposed)
        {
            return;
        }
        ++_menuVersion;
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }
            _menu = args.Menu;
            _updateStamps.Clear();
            if (Notifier != null)
            {
                _updateStamps.AddRange(Notifier.GetUserStamps(ClientHelpers.GetBadges(_menu)));
            }
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        if (currentUrl.ToLower().Contains("/logout"))
        {
            try
            {
                _ = CachedHttp.ClearAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Cache clear failed.");
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;

        if (_menuStorage != null)
        {
            _menuStorage.MenuChanged -= OnMenuChanged;
        }
        Notifier?.RemoveListener(this);
        Notifier = null;
    }
}
