@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/Notification"
@page "/NotificationType"
@page "/Notification/ServerNotifications"
@attribute [Authorize(Policy = GXNotificationPolicies.View)]
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization


@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject AuthenticationStateProvider Authentication
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="Notifications" />

@if (User == null && GXNotificationRoutes.IsTypeList(NavigationManager))
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="Notification" Active="Types">
        <ChildContent>
            <TabHeader Name="@GXMenus.NotificationTab">
                <ContentForLink Context="link">
                    @switch (link.Url)
                    {
                        case "Types":
                            <NotificationTypes />
                            break;
                        case "ServerNotifications":
                            <ServerNotifications />
                            break;
                    }
                </ContentForLink>
            </TabHeader>
        </ChildContent>
    </GXTabControl>
}
else if (_canView)
{
@if (Title)
{
    <PageTitle>@Properties.Resources.Notifications</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        @if (CanEdit)
        {
            <GXMenuEntry Text="@Properties.Resources.ApplyDefaults" Id="Regenerate" OnClick="@OnApplyDefaults" Policy="@GXNotificationPolicies.Edit" />
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXNotificationPolicies.Add" />
            <GXMenuEntry Text="@Properties.Resources.Remove" Id="Remove" OnClick="@OnRemove" Policy="@GXNotificationPolicies.Delete" />
        }
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Notification.Notifications" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXNotificationPolicies.View })"
             TItem="GXNotification" @ref="table"
             @bind-Active="Active"
             Context="notification"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="false"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="Notifications-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated" Visibility="Visibility.Medium">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdateTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = "".Equals(__e.Value) ? DateTime.MinValue : Convert.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXNotificationPolicies.Edit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Name" Name="Name" Target="@notification">@Properties.Resources.Name</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@notification" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated" Name="Updated" Target="@notification">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@(User == null ? NavigationManager.GetCurrentPagePath("/Notification/Edit/" + notification!.Id) : null)">
            @if (User != null && CanEdit)
            {
                <button type="button" class="btn btn-link p-0" @onclick="@(() => OpenEditor(notification!.Id))" @onclick:stopPropagation="true">
                    <span class=@(ClientHelpers.GetActiveDot(notification.Enabled))></span>@notification.Name
                </button>
            }
            else
            {
                <span class=@(ClientHelpers.GetActiveDot(notification.Enabled))></span>@notification.Name
            }
        </GXTd>
        <GXTd Id="CreationTime">@notification.CreationTime</GXTd>
        <GXTd Id="Updated">@notification.Updated</GXTd>
    </ItemContent>
</GXViewTable>
@if (_editingNotificationId is Guid editingId)
{
    <GXDialog Title="@(Properties.Resources.Edit + " " + Properties.Resources.Notification)" Save="false" ManageFocus="true" Resizable="true"
              OkButtonTitle="" CancelButtonTitle="" OnCancel="CloseEditor">
        <Notification @key="editingId" Id="editingId" Action="Edit" Embedded="true" Saved="NotificationSaved" Cancelled="CloseEditor" />
    </GXDialog>
}
}



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 2, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected notification ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [Parameter]
    public GXUser? User { get; set; }

    private GXNotification? Active { get; set; }
    private Guid? _editingNotificationId;
    private void OpenEditor(Guid id)
    {
        if (!_canView || !CanEdit) {
            return;
        }
        _editingNotificationId = id;
    }
    private void CloseEditor() => _editingNotificationId = null;
    private async Task NotificationSaved()
    {
        CloseEditor();
        await Updated();
    }
    private bool _canView;
    protected override async Task OnParametersSetAsync()
    {
        var caller = (await Authentication.GetAuthenticationStateAsync()).User;
        _canView = caller.Identity?.IsAuthenticated == true &&
            (User == null || ClientHelpers.GetUserId(caller, false) == User.Id);
    }
    private bool _removing;
    private bool _applyingDefaults;



    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Notifications;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "Notifications";
        }
    }

    /// <summary>
    /// Amount of the notifications shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Notification filter.
    /// </summary>
    private GXNotification filter = new GXNotification();
    /// <summary>
    /// Reference to the table.
    /// </summary>
    protected GXTable<GXNotification>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Notification/Notifications.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Notification/Notifications.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/Notification/Notifications.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXNotificationPolicies.Add ||
                    it.Type == GXNotificationPolicies.Edit ||
                    it.Type == GXNotificationPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXNotification() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Notification/Notifications.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXNotification>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingNotifications);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListNotifications req = new ListNotifications()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
            };

            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListNotificationResponse>("api/Notification/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXNotification>((ret.Notifications ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit notification.
    /// </summary>
    public void OnAdd()
    {
        ClientHelpers.NavigateTo(NavigationManager, "/Notification/Add");
    }

    /// <summary>Removes the selected notifications after confirmation.</summary>
    public async Task OnRemove()
    {
        if (_removing) {
            return;
        }
        _removing = true;
        try
        {
            var selected = table?.SingleOrDefault()?.ToArray() ?? [];
            if (selected.Length == 0) {
                throw new InvalidOperationException(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.Remove, AllowDelete = true, Items = selected.Select(n => n.Name).ToArray() });
            if (!confirmation.Confirm) {
                return;
            }
            using var progress = Progress?.ProgressStart(GXProgress.SavingNotification);
            await Http.PostAsJson<RemoveNotificationResponse>("api/Notification/Delete",
                new RemoveNotification { Ids = selected.Select(n => n.Id).ToArray(), Delete = confirmation.Delete });
            await Updated();
        }
        catch (AccessTokenNotAvailableException ex) { ex.Redirect(); }
        catch (Exception ex) { NotificationService?.ReportError(ex, "Pages/Notification/Notifications.Remove"); }
        finally { _removing = false; }
    }

    /// <summary>Edits the selected notification.</summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Notification/Notifications.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            if (User != null) {
                OpenEditor(table.Active.Id);
            }
            else {
                ClientHelpers.NavigateTo(NavigationManager, "/Notification/Edit/" + table.Active.Id);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Notification/Notifications.OnEdit");
        }
    }

    /// <summary>Adds missing defaults, or restores only the selected defaults, after confirmation.</summary>
    public async Task OnApplyDefaults()
    {
        if (_applyingDefaults) {
            return;
        }
        _applyingDefaults = true;
        try
        {
            var selected = table?.SingleOrDefault()?.ToArray() ?? [];
            var ids = selected.Select(n => n.Id).Distinct().ToArray();
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ApplyBuiltInDefaults,
                Properties.Resources.SelectedItemsWillBeResetToDefaultsWithoutASelectionOnlyMissingDefaultsWillBeAdded,
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.ApplyDefaults, AllowDelete = false, Items = selected.Select(n => n.Name).ToArray() });
            if (!confirmation.Confirm) {
                return;
            }
            using var progress = Progress?.ProgressStart(Properties.Resources.ApplyDefaults);
            NotificationService?.RemoveByKey("Notifications.Defaults");
            await Http.PostAsJson<RegenerateNotificationResponse>("api/Notification/Regenerate", new RegenerateNotification { Ids = ids },
                progress?.CancellationToken ?? CancellationToken.None);
            await Updated();
        }
        catch (AccessTokenNotAvailableException ex) { ex.Redirect(); }
        catch (Exception ex) { NotificationService?.ReportError(ex, "Notifications.Defaults"); }
        finally { _applyingDefaults = false; }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

