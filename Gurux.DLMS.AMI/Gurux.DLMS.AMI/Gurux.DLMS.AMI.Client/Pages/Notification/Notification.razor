@page "/Notification/{Id:guid}"
@page "/Notification/{Action}/{Id:guid}/{Page}"
@page "/Notification/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Script
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="Notification" />

    @if (!Embedded)
    {
    <h1>
        @_title
    </h1>
    }
    <CascadingValue Value="this">
        @if (_sourcesLoaded)
        {
            <NotificationGeneral AvailablePermissions="@AvailablePermissions" AvailableTypes="@_availableTypes" Active="@Active" Action="@_action" />
        }
    </CascadingValue>
    @if (Embedded)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">
            <AuthorizeView Policy="@(_action == CrudAction.Create ? GXNotificationPolicies.Add : GXNotificationPolicies.Edit)">
                <button type="button" class="btn btn-primary" disabled="@(_saving || !_sourcesLoaded)" @onclick="SaveEditorAsync">@Properties.Resources.Save</button>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CancelEditorAsync">@Properties.Resources.Cancel</button>
        </div>
    }
<br />
@implements IDisposable
@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    /// <summary>Disables repeated save requests while changes are being persisted.</summary>
    private bool _saving;
    /// <summary>Tracks validation and unsaved changes in the currently open dialog.</summary>
    private EditContext? _dialogContext;
    /// <summary>Stores field-specific validation errors displayed by the open dialog.</summary>
    private ValidationMessageStore? _dialogMessages;
    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>Lists the permissions offered by the notification subscription editor.</summary>
    internal readonly List<GXPermission> AvailablePermissions = new();
    /// <summary>Records whether the available notification sources have been retrieved.</summary>
    private bool _sourcesLoaded;

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Caches the notification types offered for the selected source.</summary>
    private IReadOnlyList<GXNotificationType> _availableTypes = [];

    /// <summary>
    /// Page title.
    /// </summary>
    private string? _title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXNotification Active = new GXNotification(null)
    {
    };

    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    _title = Properties.Resources.Add;
                    var types = await Http.PostAsJson<ListNotificationTypeResponse>("api/NotificationType/List",
                        new ListNotificationType { Filter = new GXNotificationType { Enabled = true }, OrderBy = nameof(GXNotificationType.Name) });
                    _availableTypes = (types.NotificationTypes ?? []).Where(t => t.Enabled == true && t.Removed == null).ToArray();
                    break;
                case "Edit":
                    _title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    _title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            _title += " " + Properties.Resources.Notification;
            _notificationService?.RemoveByKey("Pages/Notification/Notification.OnInitializedAsync");
            // Load the notification first so permissions are resolved for its owner.
            if (!string.Equals(Action, "Add", StringComparison.OrdinalIgnoreCase))
            {
                using var progress = _progress?.ProgressStart(GXProgress.RetrievingNotification);
                var response = await Http.GetAsJsonAsync<GetNotificationResponse>("api/Notification?id=" + Id);
                if (response.Item == null)
                {
                    if (Embedded) {
                        throw new InvalidOperationException(Properties.Resources.InvalidTarget);
                    }
                    NavigationManager.NavigateTo("404");
                    return;
                }
                Active = response.Item;
            }
            var permissions = await Http.GetAsJsonAsync<GXPermission[]>("api/Permission/NotificationSources");
            AvailablePermissions.Clear();
            foreach (var permission in permissions)
            {
                AvailablePermissions.Add(permission);
            }
            await LoadTypeSettingsAsync();
            _notifier = Services.GetService<IGXNotifier2>();
            if (Embedded)
            {
                _dialogContext = GXEditContexts.For(Active);
                _dialogMessages = new ValidationMessageStore(_dialogContext);
            }
            else
            {
                _editorMenu = new GXEditorMenu(Services.GetRequiredService<IGXMenuService>());
                _editorMenu.Set(Active, _action, SaveEditorAsync, CancelEditorAsync);
            }
            _sourcesLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Notification/Notification.OnInitializedAsync");
        }
    }

    /// <summary>Owns editing commands and connects their enabled state to the current form.</summary>
    private GXEditorMenu? _editorMenu;
    /// <summary>Subscribes to connection and application-state notifications used by this view.</summary>
    private IGXNotifier2? _notifier;
    private bool IsToaster => string.Equals(Active.Type?.Code, "toaster", StringComparison.OrdinalIgnoreCase);
    /// <summary>Contains the configured maximum number of simultaneous toast notifications.</summary>
    internal int? ToasterMaxCount;
    /// <summary>Records whether the settings for the selected type have been retrieved.</summary>
    private bool _typeSettingsLoaded;
    /// <summary>Retains the user property that stores toast notification preferences.</summary>
    private Gurux.DLMS.AMI.Shared.DTOs.User.GXUserProperty? _toasterSetting;

    internal async Task LoadTypeSettingsAsync()
    {
        _typeSettingsLoaded = false;
        _toasterSetting = null;
        ToasterMaxCount = null;
        if (IsToaster)
        {
            var setting = await Http.GetAsJsonAsync<GetUserProperties>("api/UserProperties?name=Ami.Toaster.MaxCount");
            _toasterSetting = setting?.Item;
            ToasterMaxCount = int.TryParse(_toasterSetting?.Value, out var count) && count > 0 ? count : null;
        }
        _typeSettingsLoaded = true;
    }
    private bool ValidateEditor()
    {
        string? error = string.IsNullOrWhiteSpace(Active.Name) ? Properties.Resources.InvalidName :
            Active.Type == null || Active.Type.Id == Guid.Empty ? Properties.Resources.NotificationDelivery + ": " + Properties.Resources.Required :
            !_typeSettingsLoaded ? Properties.Resources.NotificationDelivery + ": " + Properties.Resources.Loading :
            IsToaster && ToasterMaxCount.HasValue && ToasterMaxCount.Value < 1 ? Properties.Resources.TheMaximumNotificationCountMustBePositive :
            Active.MinimumDeliveryTime < 0 ? Properties.Resources.InvalidInterval : null;
        if (error == null) {
            return true;
        }
        _editorMenu?.AddValidationError(nameof(GXNotification.Type), error);
        if (_dialogContext != null)
        {
            _dialogMessages?.Add(new FieldIdentifier(Active, nameof(GXNotification.Type)), error);
            _dialogContext.NotifyValidationStateChanged();
        }
        return false;
    }
    private Task CancelEditorAsync()
    {
        if (Embedded) {
            return Cancelled.InvokeAsync();
        }
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
    public void Dispose() => _editorMenu?.Dispose();
    private async Task SaveEditorAsync()
    {
        if (_saving || !_sourcesLoaded) {
            return;
        }
        _saving = true;
        try
        {
            _dialogMessages?.Clear();
            if (_dialogContext != null && !_dialogContext.Validate()) {
                return;
            }

            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }

            if (_action != CrudAction.Delete && !ValidateEditor()) {
                return;
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.SavingNotification);
            _notificationService?.RemoveByKey("Pages/Notification/NotificationGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveNotificationResponse>("api/Notification/Delete", new RemoveNotification()
                {
                    Ids = new Guid[] { Active.Id }
                });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/Notification/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/Notification/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateNotificationResponse>(address, new UpdateNotification() { Notifications = new List<GXNotification>() { Active } });
                if (IsToaster)
                {
                    _toasterSetting ??= new Gurux.DLMS.AMI.Shared.DTOs.User.GXUserProperty { Name = "Ami.Toaster.MaxCount", User = Active.Creator };
                    _toasterSetting.Value = ToasterMaxCount?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    await Http.PostAsJson("api/UserProperties/Update", new UpdateUserProperties { Properties = new List<GXUserProperty> { _toasterSetting } });
                }
            }
            if (_notifier is GXAmiNotifierService notifier)
            {
                await notifier.RefreshNotificationsAsync(Http);
            }
            if (Embedded)
            {
                _dialogContext?.MarkAsUnmodified();
                await Saved.InvokeAsync();
            }
            else {
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Notification/NotificationGeneral.OnSave");
        }
        finally { _saving = false; }
    }
}
