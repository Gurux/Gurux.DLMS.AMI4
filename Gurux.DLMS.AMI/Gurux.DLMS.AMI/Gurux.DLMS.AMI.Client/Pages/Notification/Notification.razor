@page "/Notification/{Id:guid}"
@page "/Notification/{Action}/{Id:guid}/{Page}"
@page "/Notification/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Script
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="Notification" />

    @if (!Embedded)
    {
    <h1>
        @Title
    </h1>
    }
    <CascadingValue Value="this">
        @if (_sourcesLoaded)
        {
            <NotificationGeneral AvailablePermissions="@AvailablePermissions" AvailableTypes="@AvailableTypes" Active="@Active" Action="@_action" />
        }
    </CascadingValue>
    @if (Embedded)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">
            <AuthorizeView Policy="@(_action == CrudAction.Create ? GXNotificationPolicies.Add : GXNotificationPolicies.Edit)">
                <button type="button" class="btn btn-primary" disabled="@(_saving || !_sourcesLoaded)" @onclick="SaveEditorAsync">@Properties.Resources.Save</button>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CancelEditorAsync">@Properties.Resources.Cancel</button>
        </div>
    }
<br />
@implements IDisposable
@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private bool _saving;
    private EditContext? _dialogContext;
    private ValidationMessageStore? _dialogMessages;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    internal readonly List<GXPermission> AvailablePermissions = new();
    private bool _sourcesLoaded;

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private IReadOnlyList<GXNotificationType> AvailableTypes = [];

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXNotification Active = new GXNotification(null)
    {
    };

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    var types = await Http.PostAsJson<ListNotificationTypeResponse>("api/NotificationType/List",
                        new ListNotificationType { Filter = new GXNotificationType { Enabled = true }, OrderBy = nameof(GXNotificationType.Name) });
                    AvailableTypes = (types.NotificationTypes ?? []).Where(t => t.Enabled == true && t.Removed == null).ToArray();
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Notification;
            NotificationService?.RemoveByKey("Pages/Notification/Notification.OnInitializedAsync");
            // Load the notification first so permissions are resolved for its owner.
            if (!string.Equals(Action, "Add", StringComparison.OrdinalIgnoreCase))
            {
                using var progress = Progress?.ProgressStart(GXProgress.RetrievingNotification);
                var response = await Http.GetAsJsonAsync<GetNotificationResponse>("api/Notification?id=" + Id);
                if (response.Item == null)
                {
                    if (Embedded) {
                        throw new InvalidOperationException(Properties.Resources.InvalidTarget);
                    }
                    NavigationManager.NavigateTo("404");
                    return;
                }
                Active = response.Item;
            }
            var permissions = await Http.GetAsJsonAsync<GXPermission[]>("api/Permission/NotificationSources");
            AvailablePermissions.Clear();
            foreach (var permission in permissions)
            {
                AvailablePermissions.Add(permission);
            }
            await LoadTypeSettingsAsync();
            Notifier = Services.GetService<IGXNotifier2>();
            if (Embedded)
            {
                _dialogContext = GXEditContexts.For(Active);
                _dialogMessages = new ValidationMessageStore(_dialogContext);
            }
            else
            {
                _editorMenu = new GXEditorMenu(Services.GetRequiredService<IGXMenuService>());
                _editorMenu.Set(Active, _action, SaveEditorAsync, CancelEditorAsync);
            }
            _sourcesLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Notification/Notification.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    private IGXNotifier2? Notifier;
    private bool IsToaster => string.Equals(Active.Type?.Code, "toaster", StringComparison.OrdinalIgnoreCase);
    internal int? ToasterMaxCount;
    private bool _typeSettingsLoaded;
    private Gurux.DLMS.AMI.Shared.DTOs.User.GXUserProperty? ToasterSetting;

    internal async Task LoadTypeSettingsAsync()
    {
        _typeSettingsLoaded = false;
        ToasterSetting = null;
        ToasterMaxCount = null;
        if (IsToaster)
        {
            var setting = await Http.GetAsJsonAsync<GetUserProperties>("api/UserProperties?name=Ami.Toaster.MaxCount");
            ToasterSetting = setting?.Item;
            ToasterMaxCount = int.TryParse(ToasterSetting?.Value, out var count) && count > 0 ? count : null;
        }
        _typeSettingsLoaded = true;
    }
    private bool ValidateEditor()
    {
        string? error = string.IsNullOrWhiteSpace(Active.Name) ? Properties.Resources.InvalidName :
            Active.Type == null || Active.Type.Id == Guid.Empty ? Properties.Resources.NotificationDelivery + ": " + Properties.Resources.Required :
            !_typeSettingsLoaded ? Properties.Resources.NotificationDelivery + ": " + Properties.Resources.Loading :
            IsToaster && ToasterMaxCount.HasValue && ToasterMaxCount.Value < 1 ? Properties.Resources.TheMaximumNotificationCountMustBePositive :
            Active.MinimumDeliveryTime < 0 ? Properties.Resources.InvalidInterval : null;
        if (error == null) {
            return true;
        }
        _editorMenu?.AddValidationError(nameof(GXNotification.Type), error);
        if (_dialogContext != null)
        {
            _dialogMessages?.Add(new FieldIdentifier(Active, nameof(GXNotification.Type)), error);
            _dialogContext.NotifyValidationStateChanged();
        }
        return false;
    }
    private Task CancelEditorAsync()
    {
        if (Embedded) {
            return Cancelled.InvokeAsync();
        }
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
    public void Dispose() => _editorMenu?.Dispose();
    private async Task SaveEditorAsync()
    {
        if (_saving || !_sourcesLoaded) {
            return;
        }
        _saving = true;
        try
        {
            _dialogMessages?.Clear();
            if (_dialogContext != null && !_dialogContext.Validate()) {
                return;
            }

            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }

            if (_action != CrudAction.Delete && !ValidateEditor()) {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingNotification);
            NotificationService?.RemoveByKey("Pages/Notification/NotificationGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveNotificationResponse>("api/Notification/Delete", new RemoveNotification()
                {
                    Ids = new Guid[] { Active.Id }
                });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/Notification/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/Notification/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateNotificationResponse>(address, new UpdateNotification() { Notifications = new List<GXNotification>() { Active } });
                if (IsToaster)
                {
                    ToasterSetting ??= new Gurux.DLMS.AMI.Shared.DTOs.User.GXUserProperty { Name = "Ami.Toaster.MaxCount", User = Active.Creator };
                    ToasterSetting.Value = ToasterMaxCount?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    await Http.PostAsJson("api/UserProperties/Update", new UpdateUserProperties { Properties = new List<GXUserProperty> { ToasterSetting } });
                }
            }
            if (Notifier is GXAmiNotifierService notifier)
            {
                await notifier.RefreshNotificationsAsync(Http);
            }
            if (Embedded)
            {
                _dialogContext?.MarkAsUnmodified();
                await Saved.InvokeAsync();
            }
            else {
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Notification/NotificationGeneral.OnSave");
        }
        finally { _saving = false; }
    }
}
