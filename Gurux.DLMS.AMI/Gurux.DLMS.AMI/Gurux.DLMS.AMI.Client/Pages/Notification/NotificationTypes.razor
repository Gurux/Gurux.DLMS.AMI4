@using Gurux.DLMS.AMI.Client.Shared
@using Gurux.DLMS.AMI.Shared.Rest
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IServiceProvider Services

<h1>@Properties.Resources.Notifications</h1>
<button type="button" class="btn btn-secondary mb-3" @onclick="Load">@Properties.Resources.Refresh</button>
<table class="table notification-type-settings">
    <thead><tr><th>@Properties.Resources.Name</th><th>@Properties.Resources.Enabled</th><th>@Properties.Resources.Policies2</th></tr></thead>
    <tbody>
        @foreach (var settings in _items)
        {
            <tr @key="settings.Id">
                <td><a href="@NavigationManager.GetCurrentPagePath("/NotificationType/Edit/" + settings.Id)">@settings.Name</a></td>
                <td>@settings.Enabled</td>
                <td>@string.Join(", ", settings.Policies ?? [])</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private GXNotificationType[] _items = [];
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        try
        {
            var response = await Http.PostAsJson<ListNotificationTypeResponse>("api/NotificationType/List",
                new ListNotificationType { Filter = new GXNotificationType(), OrderBy = nameof(GXNotificationType.Name) });
            _items = [.. response.NotificationTypes ?? []];
        }
        catch (AccessTokenNotAvailableException ex) { ex.Redirect(); }
        catch (Exception ex) { Services.GetService<IGXNotificationService>()?.ReportError(ex); }
    }
}
