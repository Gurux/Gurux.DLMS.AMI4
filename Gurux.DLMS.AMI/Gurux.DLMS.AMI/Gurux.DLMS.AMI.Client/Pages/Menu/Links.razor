@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Client.Pages.Config
@using Gurux.UI.Components.Accordion
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation

<GXHelpContext Topic="Links" />

<h1>@Properties.Resources.Links</h1>

@if (Active != null)
{
    <GXDialog OnCancel="Cancel"
            CancelButtonTitle="@Properties.Resources.Close"
            OkButtonTitle="@Properties.Resources.Save"
            OnOk="Save">
        <EditForm EditContext="@GXEditContexts.For(Active)">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <GXValidator @ref="_validator"
                         OnValidate="OnValidate" />
            <PolicyTabs>
                <GeneralContent>
                    <div class="row">
                        <div style="width:100%">
                            <div class="form-group">
                                <GXInputSwitch Text="@Properties.Resources.Enabled"
                                             @bind-Value="Active.Enabled" />
                            </div>
                            <div class="form-group">
                                <GXInputSwitch Text="@Properties.Resources.Preload" @bind-Value="Preload"
                                             Disabled="@(Menu?.Preload == true || Action == CrudAction.Delete)" />
                                @if (Menu?.Preload == true)
                                {
                                    <small class="form-text text-muted"><GXLocalizedText Value="@Properties.Resources.PreloadingIsEnabledByTheParentMenu" /></small>
                                }
                            </div>
                            <div class="form-group">
                                <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                                <InputText id="name" class="form-control"
                                           @bind-Value="Active.Name" />
                            </div>
                            <div class="form-group">
                                <label>@Properties.Resources.Link</label>
                                <InputText id="url" class="form-control"
                                           @bind-Value="Active.Url" />
                            </div>
                            <div class="form-group">
                                <label>@Properties.Resources.Description</label>
                                <InputText id="description" class="form-control"
                                           @bind-Value="Active.Description" />
                            </div>
                            <div class="form-group">
                                <label for="link-icon"><GXLocalizedText Value="@Properties.Resources.Icon" /></label>
                                <InputText id="link-icon" class="form-control" @bind-Value="Active.Icon" />
                            </div>
                            <div class="form-group">
                                <label for="link-component"><GXLocalizedText Value="@Properties.Resources.ComponentType" /></label>
                                <InputText id="link-component" class="form-control" @bind-Value="Active.TargetType" />
                            </div>
                            <div class="form-group">
                                <label for="link-visibility"><GXLocalizedText Value="@Properties.Resources.Visibility" /></label>
                                <GXInputDropdown id="link-visibility" class="form-select" @bind-Value="Active.Visibility"
                                                 RememberValue="false" Items="@(Enum.GetValues<Visibility>().Select(value => (byte?)value))">
                                    <Template Context="visibility"><GXLocalizedText Value="@(((Visibility)visibility!.Value).ToString())" /></Template>
                                </GXInputDropdown>
                            </div>
                            <div class="form-group">
                                <label for="link-configuration"><GXLocalizedText Value="@Properties.Resources.Configuration" /></label>
                                <GXInputDropdown id="link-configuration" class="form-control" @bind-Value="ConfigurationChoice" RememberValue="false" Items="@ConfigurationChoiceItems"><Template Context="choice"><GXLocalizedText Value="@choice.Label" /></Template></GXInputDropdown>
                            </div>
                        </div>

                    </div>
                </GeneralContent>
                <PolicyContent>
                    <Gurux.UI.Components.GXPolicyEditor @bind-Value="Active.Policies" Disabled="@(Action == CrudAction.Delete)" />
                </PolicyContent>
            </PolicyTabs>
        </EditForm>
    </GXDialog>
}
<p>
    <GXMenuControl RightCorner=true>
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
            <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" />
        </ChildContent>
    </GXMenuControl>
</p>
<GXViewTable ViewName="Menu.Links" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXMenuPolicies.View })" TItem="GXMenuLink" @ref="table"
         Context="link"
         ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Multiple"
         ShowRemoved="false"
         ShowAllUsers="false"
         Filter="false"
         Total="false"
         RearrangeRows="true"
         OnItemMoved="@OnItemMoved"
         ShowAllData="true"
         OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Icon"></GXFh>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Description"></GXFh>
        <GXFh Id="Link"></GXFh>
        <GXFh Id="Policies"></GXFh>
    </FilterContent>
    <HeaderContent>
        <GXTh Name="Icon" Target="@link"><GXLocalizedText Value="@Properties.Resources.Icon" /></GXTh>
        <GXTh Name="Name" Target="@link">@Properties.Resources.Name</GXTh>
        <GXTh Name="Description" Target="@link">@Properties.Resources.Description</GXTh>
        <GXTh Name="Link" Target="@link">@Properties.Resources.Link</GXTh>
        <GXTh Name="Policies" Target="@link">@Properties.Resources.Policy</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Icon"><GXImage Id="@link.Icon" /></GXTd>
        <GXTd Id="Name"><GXLinkButton TItem="GXMenuLink" Target="@link" OnClick="@Edit" Text="@link.Name" /></GXTd>
        <GXTd Id="Description">@link.Description</GXTd>
        <GXTd Id="Link">@link.Url</GXTd>
        <GXTd Id="Policies">@string.Join(", ", link.Policies ?? new List<string>())</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private sealed record DropdownChoice<T>(T Value, string? Label);
    private IEnumerable<DropdownChoice<Guid?>> ConfigurationChoiceItems
    {
        get
        {
            yield return new DropdownChoice<Guid?>(null, Properties.Resources.None);
            foreach (var configuration in _configurationChoices)
            {
                yield return new DropdownChoice<Guid?>(configuration.Id, configuration.Name);
            }
            // The dialog can render while the references request is still pending or has failed.
            if (Active?.Configuration is { } current && !_configurationChoices.Any(c => c.Id == current.Id))
            {
                yield return new DropdownChoice<Guid?>(current.Id, current.Name);
            }
        }
    }
    private DropdownChoice<Guid?> ConfigurationChoice
    {
        get => ConfigurationChoiceItems.First(it => EqualityComparer<Guid?>.Default.Equals(it.Value, ConfigurationId));
        set => ConfigurationId = value.Value;
    }

    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Icon") { Position = 0, Description = "Icon", Visibility = (byte)Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("Description") { Position = 2, Description = "Description", Visibility = (byte)Visibility.All },
        new("Link") { Position = 3, Description = "Link", Visibility = (byte)Visibility.All },
        new("Policies") { Position = 4, Description = "Policy", Visibility = (byte)Visibility.All },
    ];

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }
    }

    private IGXNotifier2? Notifier;

    private IGXNotificationService? NotificationService;

    private GXValidator? _validator;
    CrudAction Action;
    GXMenuLink? Active;
    private bool? Preload
    {
        get => Menu?.Preload == true || Active?.Preload == true;
        set
        {
            if (Active != null && Menu?.Preload != true && Action != CrudAction.Delete)
            {
                Active.Preload = value == true;
            }
        }
    }
    private GXConfiguration[] _configurationChoices = [];
    private Guid? ConfigurationId
    {
        get => Active?.Configuration?.Id;
        set
        {
            if (Active != null)
            {
                Active.Configuration = value.HasValue ? new GXConfiguration
                {
                    Id = value.Value
                }
            
                : null;
            }
        }
    }

    private async Task LoadConfigurationChoicesAsync()
    {
        try
        {
            using var response = await Http.GetAsync("api/Configuration/References");
            if (response.IsSuccessStatusCode)
            {
                _configurationChoices = await response.Content.ReadFromJsonAsync<GXConfiguration[]>() ?? [];
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Links.Configurations");
        }
    }

    [CascadingParameter]
    private MenuGeneral? Parent { get; set; }

    /// <summary>Menu to edit when the link editor is hosted outside the menu form.</summary>
    [Parameter]
    public GXMenu? Value { get; set; }

    private GXMenu? Menu
    {
        get
        {
            return Value ?? Parent?.Active;
        }
    }

    async Task OnItemMoved((GXMenuLink Item, int Index) moved)
    {
        var (item, index) = moved;
        if (Menu?.Links != null)
        {
            Menu.Links.Remove(item);
            Menu.Links.Insert(index, item);
            int order = 0;
            foreach (var it in Menu.Links)
            {
                it.Order = order++;
            }
            LinksChanged();
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Menu filter.
    /// </summary>
    private GXMenu filter = new GXMenu();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXMenuLink>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Add new link .
    /// </summary>
    public async Task OnAdd()
    {
        _editingLink = null;
        Active = new GXMenuLink(null);
        await LoadConfigurationChoicesAsync();
        Action = CrudAction.Create;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Remove selected links.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = false,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected menus.
    /// </summary>
    public void OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (Menu?.Links != null && table != null && args.Confirm)
            {
                bool changed = false;
                foreach (var it in table.SingleOrDefault().ToArray())
                {
                    changed |= Menu.Links.Remove(it);
                }
                if (changed)
                {
                    LinksChanged();
                    _ = Updated();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Validate the object content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (Active != null)
        {
            if (string.IsNullOrEmpty(Active.Name))
            {
                sender.AddError(() => Active.Name, Properties.Resources.InvalidName);
            }
            if (string.IsNullOrEmpty(Active.Url))
            {
                sender.AddError(() => Active.Url, Properties.Resources.InvalidLink);
            }
        }
    }

    /// <summary>
    /// Edit menu link.
    /// </summary>

    private async Task Edit(GXMenuLink link)
    {
        Action = CrudAction.Update;
        _editingLink = link;
        Active = ClientHelpers.Clone<GXMenuLink>(link);
        await LoadConfigurationChoicesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void LinksChanged()
    {
        if (Menu != null)
        {
            GXEditContexts.For(Menu).NotifyFieldChanged(new FieldIdentifier(Menu, nameof(GXMenu.Links)));
        }
    }

    private GXMenuLink? _editingLink;

    private ValueTask<ItemsProviderResult<GXMenuLink>> GetItems(GXItemsProviderRequest request)
    {
        try
        {
            if (Menu?.Links != null)
            {
                return new(new ItemsProviderResult<GXMenuLink>(Menu.Links, Menu.Links.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        return default;
    }

    /// <summary>
    /// Save link objects.
    ///</summary>
    public async System.Threading.Tasks.Task Save()
    {
        try
        {
            _validator?.ClearErrors();
            if (_validator != null &&
                !await _validator.ValidateAsync())
            {
                return;
            }
            if (Active != null && Menu != null)
            {
                if (Action == CrudAction.Create)
                {
                    Active.Order = Menu.Links?.Count > 0 ? Menu.Links.Max(l => l.Order) + 1 : 1;
                    (Menu.Links ??= []).Add(Active);
                }
                else if (_editingLink != null)
                {
                    ClientHelpers.Copy(Active, _editingLink);
                }
                LinksChanged();
            }
            Active = null;
            _editingLink = null;
            await InvokeAsync(StateHasChanged);
            //   Parent.Updated();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Hide link dialog.
    /// </summary>
    public async Task Cancel()
    {
        Active = null;
        _editingLink = null;
        await InvokeAsync(StateHasChanged);
    }
}

