@using MenuLocation = Gurux.DLMS.AMI.Shared.Enums.MenuLocation
@using MenuKind = Gurux.DLMS.AMI.Shared.DTOs.Enums.MenuKind
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Client.Pages.Config
@using Gurux.UI.Components.Accordion
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using System.Text.Json

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject ILogger<MenuGeneral> Logger
@inject HttpClient Http
<GXHelpContext Topic="MenuGeneral" />

@if (Active != null)
{
    <EditForm EditContext="@FormContext">
        <PolicyTabs>
            <GeneralContent>
                <div class="row">
                    <div style="width:100%">
                        <div class="form-group">
                            <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Active.Enabled" />
                        </div>
                        <div class="form-group">
                            <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                            <InputText id="name" disabled="@IsDeleting" @bind-Value="Active.Name" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>@Properties.Resources.Title</label>
                            <InputText id="title" disabled="@IsDeleting" @bind-Value="Active.Title" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="menu-kind"><GXLocalizedText Value="@Properties.Resources.MenuKind" /></label>
                            <GXInputDropdown id="menu-kind" Disabled="@(Action == CrudAction.Delete)" @bind-Value="Active.Kind" class="form-control" RememberValue="false" Items="@(Enum.GetValues<MenuKind>().Where(kind => kind != MenuKind.All))" ><Template Context="kind"><GXLocalizedText Value="@kind.ToString()" /></Template></GXInputDropdown>
                        </div>
                        <div class="form-group">
                            <label for="menu-location"><GXLocalizedText Value="@Properties.Resources.MenuLocation" /></label>
                            <GXInputDropdown id="menu-location" Disabled="@(Action == CrudAction.Delete)" @bind-Value="LocationChoice" class="form-select" RememberValue="false" Items="@LocationChoiceItems"><Template Context="choice"><GXLocalizedText Value="@choice.Label" /></Template></GXInputDropdown>
                        </div>
                        <div class="form-group">
                            <label for="menu-order"><GXLocalizedText Value="@Properties.Resources.Order" /></label>
                            <GXInputNumber RememberValue="false" id="menu-order" disabled="@IsDeleting" @bind-Value="Active.Order" class="form-control" Min="@GXNumberBounds.Minimum(Active.Order)" Max="@GXNumberBounds.Maximum(Active.Order)" />
                        </div>
                        <div class="form-group">
                            <label>@Properties.Resources.Description</label>
                            <InputText id="description" disabled="@IsDeleting" @bind-Value="Active.Description" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>@Properties.Resources.Publish</label>
                            <InputDate Type="@InputDateType.DateTimeLocal" id="publish" disabled="@IsDeleting" class="form-control"
                                       @bind-Value="Active.PublishTime" />
                        </div>
                        <CascadingValue Value="this">
                            <Links></Links>
                        </CascadingValue>
                        <GXInputSwitch Text="@Properties.Resources.Preload" @bind-Value="Active.Preload" />

                        <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                                            Updated="@Active.Updated" @bind-Removed="Active.Removed" />
                        @if (Action == CrudAction.Delete)
                        {
                            <hr />
                            <p>
                            </p>
                            <div class="form-group">
                                <InputRadioGroup @bind-Value="DeleteTarget">
                                    <InputRadio Value="false">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDisableQuestion</label><br>
                                    <InputRadio Value="true">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDeleteQuestion</label>
                                </InputRadioGroup>
                                <br />
                            </div>
                        }
                    </div>
                </div>
            </GeneralContent>
            <PolicyContent>
                <Gurux.UI.Components.GXPolicyEditor @bind-Value="Active.Policies" Disabled="@(Action == CrudAction.Delete)" />
            </PolicyContent>
        </PolicyTabs>
    </EditForm>
}
@code {
    private sealed record DropdownChoice<T>(T Value, string? Label);
    private IEnumerable<DropdownChoice<MenuLocation?>> LocationChoiceItems => new[] { new DropdownChoice<MenuLocation?>(null, Properties.Resources.DefaultPlacement) }.Concat(Enum.GetValues<MenuLocation>().Select(it => new DropdownChoice<MenuLocation?>(it, it.ToString())));
    private DropdownChoice<MenuLocation?> LocationChoice
    {
        get => LocationChoiceItems.First(it => EqualityComparer<MenuLocation?>.Default.Equals(it.Value, Active?.Location));
        set
        {
            var active = Active;
            if (active == null) {
                return;
            }
            active.Location = value.Value;
            GXEditContexts.For(active).NotifyFieldChanged(new FieldIdentifier(active, nameof(active.Location)));
        }
    }


    [Parameter, EditorRequired]
    public GXMenu? Active { get; set; }

    void OnEdit(object? value)
    {

    }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter, EditorRequired]
    public CrudAction Action { get; set; }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter] public Menu? Editor { get; set; }
    private bool DeleteTarget { get => Editor?.DeleteTarget ?? false; set { if (Editor != null) {
        Editor.DeleteTarget = value;
    } } }
    private EditContext FormContext => GXEditContexts.For(Active ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget));

    public string? IsDeleting
    {
        get
        {
            if (Action != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    public void Update() => StateHasChanged();

    public void Updated()
    {
        InvokeAsync(StateHasChanged);
    }

}
