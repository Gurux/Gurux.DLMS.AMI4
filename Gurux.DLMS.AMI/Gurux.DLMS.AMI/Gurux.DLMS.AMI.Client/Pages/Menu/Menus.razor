@page "/menus"
@page "/tabs"
@page "/config/tab"
@page "/config/tabs"

@using MenuKind = Gurux.DLMS.AMI.Shared.DTOs.Enums.MenuKind
@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Menus" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXMenuPolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXMenuPolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.ApplyDefaults" Id="Regenerate" OnClick="@OnRegenerate" Policy="@GXMenuPolicies.Edit" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Menu.Menus" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXMenuPolicies.View })" TItem="GXMenu" @ref="table"
             Active="Active"
             Context="menu"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Title"></GXFh>
        <GXFh Id="Kind">
            @if (RouteKind == MenuKind.All)
            {
                <GXInputDropdown class="form-select" Id="Menus-Kind" RememberValue="true"
                                 Items="MenuKinds"
                                 @bind-Value="SelectedKind" OnSelected="@((MenuKind _) => Updated())" />
            }
        </GXFh>
        <GXFh Id="PublishTime"></GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXMenuPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXMenuPolicies.Delete"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="Name" Target="@menu">@Properties.Resources.Name</GXTh>
        <GXTh Name="Title" Target="@menu">@Properties.Resources.Title</GXTh>
        <GXTh Name="Kind" Target="@menu"><GXLocalizedText Value="@Properties.Resources.MenuKind" /></GXTh>
        <GXTh Name="PublishTime" Target="@menu">@Properties.Resources.Publish</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath(EditorPath + "/Edit/" + menu.Id)"><span class=@(ClientHelpers.GetActiveDot(menu.Enabled))></span>@menu.Name</GXTd>
        <GXTd Id="Title">@menu.Title</GXTd>
        <GXTd Id="Kind"><GXLocalizedText Value="@menu.Kind.ToString()" /></GXTd>
        <GXTd Id="PublishTime">@menu.PublishTime</GXTd>
    </ItemContent>
</GXViewTable>
<br />





@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("Title") { Position = 1, Description = "Title", Visibility = (byte)Visibility.All },
        new("Kind") { Position = 2, Description = Properties.Resources.MenuKind, Visibility = (byte)Visibility.All },
        new("PublishTime") { Position = 3, Description = "Publish", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected menu ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Menus;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "menu";
        }
    }

    /// <summary>
    /// Amount of the menus shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public GXMenu? Active { get; set; }


    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Menu filter.
    /// </summary>
    private GXMenu filter = new GXMenu();
    private static readonly MenuKind[] MenuKinds = Enum.GetValues<MenuKind>().Where(kind => kind != MenuKind.Tabs).ToArray();
    private MenuKind SelectedKind = MenuKind.All;
    private MenuKind FilterKind => RouteKind == MenuKind.Tabs ? MenuKind.Tabs :
        SelectedKind == MenuKind.Tabs ? MenuKind.All : SelectedKind;

    private MenuKind RouteKind
    {
        get
        {
            var path = GXConfigurationRoutes.LegacyPath(NavigationManager.GetCurrentPagePath().Trim('/'));
            return string.Equals(path, "tabs", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(path, "config/tab", StringComparison.OrdinalIgnoreCase) ? MenuKind.Tabs : MenuKind.All;
        }
    }

    private string EditorPath => RouteKind == MenuKind.Tabs ? "/Config/Tab" : "/Config/Menu";

    protected override async Task OnParametersSetAsync()
    {
        if (filter.Kind != FilterKind)
        {
            filter.Kind = FilterKind;
            await Updated();
        }
    }


    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXMenu>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Menu/Menus.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Menu/Menus.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingMenus);
            NotificationService?.RemoveByKey("Pages/Menu/Menus.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXMenuPolicies.Add ||
                        it.Type == GXMenuPolicies.Edit ||
                        it.Type == GXMenuPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXMenu() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Menu/Menus.OnInitializedAsync");
        }
    }

    private async ValueTask<ItemsProviderResult<GXMenu>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingMenus);
        try
        {
            filter.Kind = FilterKind;
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListMenus req = new ListMenus()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            if (FilterKind == MenuKind.All)
            {
                // Exclude tabs on the server so page sizes and total counts stay correct.
                var tabs = await Http.PostAsJson<ListMenusResponse>("api/Menu/List", new ListMenus
                {
                    Filter = new GXMenu { Kind = MenuKind.Tabs, Removed = filter.Removed },
                    AllUsers = request.ShowAllUserData
                }, request.CancellationToken);
                req.Exclude = tabs.Menus?.Select(menu => menu.Id).ToArray();
            }
            var ret = await Http.PostAsJson<ListMenusResponse>("api/Menu/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXMenu>((ret.Menus ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new menu.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, EditorPath + "/Add");
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit menu.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Menu/Menus.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, EditorPath + "/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Menu/Menus.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected menu.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected menus.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveMenu req = new RemoveMenu()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveMenuResponse>("api/Menu/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Regenerate menus.
    /// </summary>
    public async Task OnRegenerate()
    {
        try
        {
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ApplyBuiltInDefaults, Properties.Resources.SelectedItemsWillBeResetToDefaultsWithoutASelectionOnlyMissingDefaultsWillBeAdded,
                new AmiConfirmationOptions
                {
                    ConfirmText = "Apply defaults",
                    AllowDelete = false
                });
            await OnRegenerateConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Refresh menus.
    /// </summary>
    public async Task OnRegenerateConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progress = Progress?.ProgressStart(Properties.Resources.Regenerate);
                RegenerateMenu req = new RegenerateMenu()
                {
                    Kind = FilterKind,
                    Ids = table?.SingleOrDefault().Select(item => item.Id).ToArray()
                };
                await Http.PostAsJson<RegenerateMenuResponse>("api/Menu/Regenerate", req,
                    progress?.CancellationToken ?? CancellationToken.None);
                NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.MenuDefaultsHaveBeenApplied, string.Empty, Closable: true));
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

