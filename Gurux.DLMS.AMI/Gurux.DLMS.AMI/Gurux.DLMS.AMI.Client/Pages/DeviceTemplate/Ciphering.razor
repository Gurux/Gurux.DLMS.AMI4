@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS
@using Gurux.DLMS.ManufacturerSettings
@using Gurux.DLMS.Objects
@using System.Xml.Linq
@using System.IO
@using System.Xml
@using System.Xml.Serialization
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text.Json
@using System.Web;
@using System.Text.Json.Serialization;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ILogger<DeviceTemplateGeneral> Logger
<GXHelpContext Topic="Ciphering" />

@if (Parent?.Settings != null)
{
    <div class="row">
        <div style="width:100%">
            <div class="form-group">
                <label>@Properties.Resources.Security</label>
                <GXInputDropdown RememberValue="false" id="type" class="form-select"
                             @bind-Value="SelectedSettings" readonly="true"
                                 Items="@(GetSecurityLevels().Select(it => it.Id))" Formatter="@((Guid value) => GetSecurity(GetSecurityLevels().First(it => it.Id == value)).ToString())" />
                <ValidationMessage For="@(() => SelectedSettings)" />
            </div>
        </div>

        <div class="form-group">
            <GXInputHexAscii Disabled="@IsDeleting"
                           @bind-Value="Parent.Settings.ClientSystemTitle"
                           Title="@Properties.Resources.ClientSystemTitle">
            </GXInputHexAscii>
            <ValidationMessage For="@(() => Parent.Settings.ClientSystemTitle)" />
        </div>

        <div class="form-group">
            <GXInputHexAscii Disabled="@IsDeleting"
                           @bind-Value="Parent.Settings.DeviceSystemTitle"
                           Title="@Properties.Resources.DeviceSystemTitle">
            </GXInputHexAscii>
            <ValidationMessage For="@(() => Parent.Settings.DeviceSystemTitle)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@IsDeleting"
                           @bind-Value="Parent.Settings.BlockCipherKey"
                           Title="@Properties.Resources.BlockCipherKey">
            </GXInputHexAscii>
            <ValidationMessage For="@(() => Parent.Settings.BlockCipherKey)" />
        </div>
        <div class="form-group">
            <GXInputHexAscii Disabled="@IsDeleting"
                           @bind-Value="Parent.Settings.AuthenticationKey"
                           Title="@Properties.Resources.AuthenticationKey">
            </GXInputHexAscii>
            <ValidationMessage For="@(() => Parent.Settings.AuthenticationKey)" />
        </div>
    </div>
}
@code {
    protected override void OnInitialized()
    {
    }

    internal void Update()
    {
        InvokeAsync(StateHasChanged);
    }

    internal void Validate(GXValidator sender, Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings s)
    {
        if (Parent?.Settings != null && s.Security != (byte)Enums.Security.None)
        {
            if (Parent.Settings.ClientSystemTitle?.Any() == true)
            {
                if (Parent.Settings.ClientSystemTitle.Length != 8)
                {
                    sender.AddError(() => Parent.Settings.ClientSystemTitle, Properties.Resources.InvalidSystemTitle);
                }
            }
            if (Parent.Settings.DeviceSystemTitle?.Any() == true)
            {
                if (Parent.Settings.DeviceSystemTitle.Length != 8)
                {
                    sender.AddError(() => Parent.Settings.DeviceSystemTitle, Properties.Resources.InvalidSystemTitle);
                }
            }
            if (Parent.Settings.BlockCipherKey?.Any() == true)
            {
                if ((Parent.Settings.SecuritySuite != (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Parent.Settings.BlockCipherKey.Length != 16) ||
                (Parent.Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Parent.Settings.BlockCipherKey.Length != 32))
                {
                    sender.AddError(() => Parent.Settings.BlockCipherKey, Properties.Resources.InvalidBlockCipherKey);
                }
            }
            if (Parent.Settings.AuthenticationKey?.Any() == true)
            {
                if ((Parent.Settings.SecuritySuite != (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Parent.Settings.AuthenticationKey.Length != 16) ||
                (Parent.Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Parent.Settings.AuthenticationKey.Length != 32))
                {
                    sender.AddError(() => Parent.Settings.AuthenticationKey, Properties.Resources.InvalidAuthenticationKey);
                }
            }
        }
    }

    private Guid SelectedSettings { get; set; }

    [Parameter]
    public DeviceTemplateGeneral? Parent { get; set; }

    internal GXDeviceTemplate? Active
    {
        get
        {
            return Parent?.Active;
        }
    }

    public bool IsDeleting
    {
        get
        {
            if (Parent == null)
            {
                return false;
            }
            return Parent.IsDeleting;
        }
    }

    private bool IsCiphered()
    {
        if (Active?.Settings != null)
        {
            var s = JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Settings);
            if (s == null)
            {
                return false;
            }
            if (s == null ||
                s.Security != (byte)Gurux.DLMS.Enums.Security.None)
            {
                return false;
            }
            return true;
        }
        return false;
    }

    /// <summary>
    /// Get available security levels.
    /// </summary>
    /// <returns>Available security levels.</returns>
    List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> GetSecurityLevels()
    {
        Gurux.DLMS.Enums.Security current = Gurux.DLMS.Enums.Security.None;
        if (Active?.Settings != null)
        {
            var s = JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Settings);
            if (s != null)
            {
                //Get default value when new device is create from device template.
                current = (Gurux.DLMS.Enums.Security)s.Security;
            }
        }
        List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> settings = new();
        settings.Add(new AMI.Shared.DTOs.Manufacturer.GXDeviceSettings()
        {
            Settings = JsonSerializer.Serialize(new Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings()
            {
                Security = (byte)current
            })
        });
        return settings;
    }

    Gurux.DLMS.Enums.Security GetSecurity(AMI.Shared.DTOs.Manufacturer.GXDeviceSettings value)
    {
        Gurux.DLMS.Enums.Security current = Gurux.DLMS.Enums.Security.None;
        if (!string.IsNullOrEmpty(value?.Settings))
        {
            current = (Gurux.DLMS.Enums.Security)(JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(value.Settings ?? "{}") ?? new()).Security;
        }
        return current;
    }
}
