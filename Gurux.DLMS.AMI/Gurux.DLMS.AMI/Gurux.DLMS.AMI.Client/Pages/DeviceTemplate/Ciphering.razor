@using Microsoft.AspNetCore.Components.Forms
@using DeviceEditor = Gurux.DLMS.AMI.Client.Pages.Device.Device
@using DeviceSettings = Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings

@* <summary>Adapts saved Ciphering tab links and template settings tabs to the common ciphering editor.</summary> *@
@if (Settings is { } settings && FormContext is { } formContext)
{
    <GXCipheringView Settings="@settings" FormContext="@formContext" Disabled="@Disabled" ClientSystemTitleDisabled="@ClientSystemTitleDisabled" OnChanged="SettingsChanged" />
}

@code {
    /// <summary>Gets or sets the legacy template-general host supplied by existing template settings tabs.</summary>
    [Parameter]
    public DeviceTemplateGeneral? Parent { get; set; }

    /// <summary>Gets or sets the device editor supplied by the existing device tab cascade.</summary>
    [CascadingParameter]
    public DeviceEditor? Editor { get; set; }

    /// <summary>Gets the mutable settings belonging to the active host.</summary>
    private DeviceSettings? Settings => Parent != null ? Parent.Settings : Editor?.Settings;

    /// <summary>Gets the edit context whose settings field owns these changes.</summary>
    private EditContext? FormContext => Parent?.Active is { } template
        ? GXEditContexts.For(template) : Editor?.FormContext;

    /// <summary>Gets the template deletion state retained for existing consumers of this tab adapter.</summary>
    public bool IsDeleting => Parent?.IsDeleting ?? false;

    /// <summary>Gets whether the active host prevents key material changes.</summary>
    private bool Disabled => Parent != null ? Parent.IsDeleting : Editor?.CanEditCiphering != true;

    /// <summary>Gets whether the active host prevents changing the client title independently of managed keys.</summary>
    private bool ClientSystemTitleDisabled => Parent != null ? Parent.IsDeleting : Editor?.CanEditClientSystemTitle != true;

    /// <summary>Refreshes the common editor when the template host replaces its settings.</summary>
    internal void Update()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Marks the owning device or template settings field modified after a permitted change.</summary>
    private void SettingsChanged()
    {
        if (Disabled && ClientSystemTitleDisabled)
        {
            return;
        }
        if (Parent != null)
        {
            Parent.SettingsChanged();
        }
        else if (Editor != null)
        {
            Editor.FormContext.NotifyFieldChanged(new FieldIdentifier(Editor.Active, nameof(GXDevice.Settings)));
        }
    }
}
