@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.Objects;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Client.Pages.Agent
@using System.Text.Json
@using System.Text;
@using Gurux.DLMS.AMI.Client.Helpers

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="AttributeTemplate" />

@if (Active != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.Index</label>
                    <GXInputNumber RememberValue="false" id="name" disabled="disabled" class="form-control"
                                 @bind-Value="Active.Index" Min="@GXNumberBounds.Minimum(Active.Index)" Max="@GXNumberBounds.Maximum(Active.Index)" />
                </div>
                <div class="form-group">
                    <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                    <InputText id="name" disabled="@IsDeleting" class="form-control"
                               @bind-Value="Active.Name" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.DataType</label>
                    <GXInputNumber RememberValue="false" id="name" disabled="@IsDeleting" class="form-control"
                                 @bind-Value="Active.DataType" Min="@GXNumberBounds.Minimum(Active.DataType)" Max="@GXNumberBounds.Maximum(Active.DataType)" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.UIDataType</label>
                    <GXInputNumber RememberValue="false" id="name" disabled="@IsDeleting" class="form-control"
                                 @bind-Value="Active.UIDataType" Min="@GXNumberBounds.Minimum(Active.UIDataType)" Max="@GXNumberBounds.Maximum(Active.UIDataType)" />
                </div>

                <div class="form-group">
                    <label>@Properties.Resources.Scaler</label>
                    <GXInputNumber RememberValue="false" id="name" disabled="@IsDeleting" class="form-control"
                                 @bind-Value="Active.Scaler" Min="@GXNumberBounds.Minimum(Active.Scaler)" Max="@GXNumberBounds.Maximum(Active.Scaler)" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.Unit</label>
                    <InputText id="name" disabled="@IsDeleting" class="form-control"
                               @bind-Value="Active.Unit" />
                </div>
                <div class="form-group">
                    <label for="attribute-expiration">@Properties.Resources.ExpirationTime</label>
                    <AttributeExpirationEditor Id="attribute-expiration" Template="@Active" Disabled="@(IsDeleting != null)" />
                </div>
            </div>
        </div>
    </EditForm>
}
@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [CascadingParameter]
    private AttributeTemplates? Parent { get; set; }

    private GXAttributeTemplate? _active;

    private GXAttributeTemplate? Active
    {
        get
        {
            if (_active != null)
            {
                return _active;
            }
            return Parent?.Active;
        }
    }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction action;
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// List of the modified items.
    /// </summary>
    private Dictionary<GXAttributeTemplate, GXAttributeTemplate> Modified = new Dictionary<GXAttributeTemplate, GXAttributeTemplate>();

    /// <summary>
    /// Copy the content of the modified item to the original item.
    /// </summary>
    /// <param name="modified">Modified item.</param>
    /// <param name="save">Is value saved.</param>
    protected void UpdateInstance(GXAttributeTemplate modified, bool save)
    {
        //Find key with modified item.
        GXAttributeTemplate? key = null;
        foreach (var it in Modified)
        {
            if (it.Value == modified)
            {
                key = it.Key;
                break;
            }
        }
        if (key == null)
        {
            throw new Exception(Properties.Resources.InvalidTarget);
        }
        if (save)
        {
            ClientHelpers.Copy(modified, key);
        }
        if (Modified.ContainsKey(key))
        {
            Modified.Remove(key);
        }
    }

    public string? IsDeleting
    {
        get
        {
            if (action != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            action = ClientHelpers.GetAction(NavigationManager, Action);
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAttributeTemplate);
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplate.OnInitializedAsync");
            MenuService.Clear();
            if (Active == null && Id != null)
            {
                //Get Attribute template data.
                var tmp = (await Http.GetAsJsonAsync<GetAttributeTemplateResponse>(string.Format("api/AttributeTemplate?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    _active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                }
            }
            if (Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
             if (action == CrudAction.Delete)
            {
                MenuService.AddMenuItems(new GXMenuItem() { Text = Properties.Resources.Remove, Icon = "oi oi-trash", OnClick = EventCallback.Factory.Create(this, OnSave) });
            }
            else
            {
                MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSave)));
            }
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplate.OnInitializedAsync");
        }
    }

    public void OnEdit(GXAttributeTemplate template)
    {
        GXAttributeTemplate tmp = ClientHelpers.Clone<GXAttributeTemplate>(template);
        Modified.Add(template, tmp);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Save Attribute template.
    /// </summary>
    public async void OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingAttributeTemplate);
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplate.OnSave");
            if (action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAgentResponse>("api/AttributeTemplate/Delete", new RemoveAgent() { Ids = new Guid[] { Active.Id } });
            }
            else
            {
                string address;
                if (action == CrudAction.Create)
                {
                    address = "api/AttributeTemplate/Add";
                }
                else if (action == CrudAction.Update)
                {
                    address = "api/AttributeTemplate/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateAttributeTemplateResponse>(address, new UpdateAttributeTemplate() { AttributeTemplates = new GXAttributeTemplate[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplate.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        MenuService.Dispose();
    }
}
