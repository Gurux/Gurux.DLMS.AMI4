@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.Objects;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Client.Pages.Agent
@using System.Text.Json
@using System.Text;
@using Gurux.DLMS.AMI.Client.Helpers

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="ObjectTemplate" />

@if (Active != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.LogicalName</label>
                    <InputText id="name" disabled="disabled" class="form-control"
                               @bind-Value="Active.LogicalName" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.Description</label>
                    <InputText id="name" disabled="@IsDeleting" class="form-control"
                               @bind-Value="Active.Name" />
                </div>
                <GXObjectTemplateTabs Template="Active">
                <table class="table table-striped" width="100%">
                    <thead>
                        <tr>
                            <th>@Properties.Resources.Index</th>
                            <th>@Properties.Resources.Name</th>
                            <th>@Properties.Resources.DataType</th>
                            <th>@Properties.Resources.UIDataType</th>
                            <th>@Properties.Resources.ExpirationTime</th>
                            <th width="1%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in GetAttributes())
                        {
                            <tr class=@(GetSelectedClass(it)) @onclick="@(() => RowSelected(it))">
                                <td>@it.Index</td>
                                <td><GXLinkButton TItem="GXAttributeTemplate" Target="@it" OnClick="@OnEdit" Text="@it.Name" /></td>
                                <td>@GetDataType(it.DataType)</td>
                                <td>@GetDataType(it.UIDataType)</td>
                                <td>@GetExpirationTime(it)</td>
                                @if (_activeAttribute == it && IsDeleting == null)
                                {
                                    <td>
                                        <GXContextMenuController>
                                            <ChildContent>
                                                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="() => OnEdit(it)"></GXContextMenuItem>
                                            </ChildContent>
                                        </GXContextMenuController>
                                    </td>
                                }
                                else
                                {
                                    <td>@Properties.Resources.Text2</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </GXObjectTemplateTabs>

                @if (Active.Updated != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.Updated</label>
                        <InputDate Type="@InputDateType.DateTimeLocal" id="updated" readonly="readonly" class="form-control"
                                   @bind-Value="Active.Updated" />
                    </div>
                }
                @if (Active.Removed != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.Remove</label>
                        <InputDate Type="@InputDateType.DateTimeLocal" id="remove" class="form-control"
                                   @bind-Value="Active.Removed" />
                    </div>
                }
            </div>
        </div>
    </EditForm>
}
@if (_editingAttribute != null && Active != null && IsDeleting == null)
{
    <GXAttributeTemplateDialog @key="_editingAttribute" Template="_editingAttribute" ObjectType="Active.ObjectType" ObjectTemplate="Active"
                               VersionThree="@(Active.ActionAccessLevels?.StartsWith("0x", StringComparison.OrdinalIgnoreCase) == true)"
                               OnSave="ApplyAttribute" OnCancel="CloseAttributeDialog" />
}
@code {
    /// <summary>Owns the page's command registration and releases it when the page is disposed.</summary>
    private GXPageMenu? _pageMenu;
    /// <summary>Gets the page command registration scope.</summary>
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    /// <summary>Subscribes to connection and application-state notifications used by this view.</summary>
    private IGXNotifier2? _notifier;
    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;


    /// <summary>Gets or sets the owning object list providing the active template.</summary>
    [CascadingParameter]
    private ObjectTemplates? Parent { get; set; }

    /// <summary>Stores the object template loaded directly by this page.</summary>
    private GXObjectTemplate _active = new GXObjectTemplate();

    /// <summary>Gets the loaded template or the template supplied by the owning list.</summary>
    private GXObjectTemplate? Active
    {
        get
        {
            if (_active.ObjectType != 0)
            {
                return _active;
            }
            return Parent?.Active;
        }
    }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>Selects whether the editor adds, updates, copies, or deletes the current record.</summary>
    private CrudAction _action;
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }


    /// <summary>
    /// Get data type.
    /// </summary>
    /// <param name="value">The persisted DLMS type identifier.</param>
    /// <returns>The protocol type name, or empty text when unspecified.</returns>
    private string GetDataType(int value)
    {
        if (value == 0)
        {
            return string.Empty;
        }
        return ((Gurux.DLMS.Enums.DataType)value).ToString();
    }

    /// <summary>Identifies the row selected for context menu commands.</summary>
    private GXAttributeTemplate? _activeAttribute;

    /// <summary>Identifies the original attribute whose detached values are shown in the dialog.</summary>
    private GXAttributeTemplate? _editingAttribute;

    /// <summary>Gets attributes in their protocol order.</summary>
    /// <returns>The attributes of the active object template, or an empty sequence.</returns>
    private IEnumerable<GXAttributeTemplate> GetAttributes() => (Active?.Attributes ?? []).OrderBy(attribute => attribute.Index);

    /// <summary>Applies confirmed editable values without replacing ownership or audit metadata.</summary>
    /// <param name="edited">The validated detached values returned by the dialog.</param>
    private void ApplyAttribute(GXAttributeTemplate edited)
    {
        if (_editingAttribute == null || Active == null || IsDeleting != null)
        {
            return;
        }
        var original = _editingAttribute;
        original.Name = edited.Name;
        original.AccessLevel = edited.AccessLevel;
        original.DataType = edited.DataType;
        original.UIDataType = edited.UIDataType;
        original.Scaler = edited.Scaler;
        original.Unit = edited.Unit;
        original.ExpirationTime = edited.ExpirationTime;
        original.DefaultValue = edited.DefaultValue;
        original.ListItems = edited.ListItems;
        GXEditContexts.For(Active).NotifyFieldChanged(new FieldIdentifier(Active, nameof(Active.Attributes)));
        CloseAttributeDialog();
    }

    /// <summary>Closes the attribute dialog and discards any unconfirmed values.</summary>
    private void CloseAttributeDialog()
    {
        _editingAttribute = null;
    }

    /// <summary>Gets the CSS class highlighting the selected row.</summary>
    /// <param name="selected">The row whose selection is inspected.</param>
    /// <returns>The selected or ordinary table row class.</returns>
    protected string GetSelectedClass(GXAttributeTemplate selected)
    {
        return ReferenceEquals(selected, _activeAttribute) ? "table-info" : "table-striped";
    }
    /// <summary>Selects the attribute targeted by its row menu.</summary>
    /// <param name="selected">The attribute selected by the user.</param>
    protected void RowSelected(GXAttributeTemplate selected)
    {
        _activeAttribute = selected;
    }

    /// <summary>Gets the disabled attribute value when the object is being deleted.</summary>
    public string? IsDeleting
    {
        get
        {
            if (_action != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    /// <summary>Formats an attribute expiration interval or its read-once setting.</summary>
    /// <param name="template">The attribute whose expiration is displayed.</param>
    /// <returns>The localized read-once label, formatted time, or empty text.</returns>
    private string GetExpirationTime(GXAttributeTemplate template)
    {
        string str = "";
        if (template.ExpirationTime != null)
        {
            if (template.ExpirationTime.Value.Year == DateTimeOffset.MaxValue.Year)
            {
                str = Properties.Resources.AttributeReadOnce;
            }
            else
            {
                str = template.ExpirationTime.Value.ToString("HH:mm:ss");
            }
        }
        return str;
    }


    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _notifier = Services.GetService<IGXNotifier2>();
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();
        if (_notifier == null)
        {
            return;
        }

        try
        {
            _action = ClientHelpers.GetAction(NavigationManager, Action);
            using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingObjectTemplate);
            _notificationService?.RemoveByKey("Pages/DeviceTemplate/ObjectTemplate.OnInitializedAsync");
            MenuService.Clear();
            if (Active?.ObjectType.GetValueOrDefault(0) == 0 && Id != null)
            {
                //Get object template data.
                var tmp = (await Http.GetAsJsonAsync<GetObjectTemplateResponse>(string.Format("api/ObjectTemplate?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    _active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                }
            }
            else
            {
                //Wait until object view is loaded.
                // Don't remove this or table is null and last settings are not available.
                await Task.Delay(1);
            }
            if (Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }

            if (_action == CrudAction.Delete)
            {
                MenuService.AddMenuItems(new GXMenuItem() { Text = Properties.Resources.Remove, Icon = "oi oi-trash", OnClick = EventCallback.Factory.Create(this, OnSave) });
            }
            else
            {
                MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSave)));
            }
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/ObjectTemplate.OnInitializedAsync");
        }
    }

    /// <summary>Opens the selected attribute in an isolated edit dialog.</summary>
    /// <param name="template">The original attribute whose values will be copied into the dialog.</param>
    public void OnEdit(GXAttributeTemplate template)
    {
        if (IsDeleting == null)
        {
            _activeAttribute = template;
            _editingAttribute = template;
        }
    }

    /// <summary>
    /// Validates the page and saves confirmed attribute edits or removes the selected object template.
    /// </summary>
    public async void OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !await GXEditContexts.ValidateAsync(GXEditContexts.For(Active)))
            {
                return;
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.SavingObjectTemplate);
            _notificationService?.RemoveByKey("Pages/DeviceTemplate/ObjectTemplate.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAgentResponse>("api/ObjectTemplate/Delete", new RemoveAgent() { Ids = new Guid[] { Active.Id } });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/ObjectTemplate/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/ObjectTemplate/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateObjectTemplateResponse>(address, new UpdateObjectTemplate() { ObjectTemplates = new GXObjectTemplate[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/ObjectTemplate.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        MenuService.Dispose();
    }
}
