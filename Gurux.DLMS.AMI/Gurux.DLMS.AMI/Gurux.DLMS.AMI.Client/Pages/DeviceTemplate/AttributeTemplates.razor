@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@page "/AttributeTemplate/{Action}"
@page "/AttributeTemplate/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.Objects;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="AttributeTemplates" />

@if (string.Compare(Action, "Add", true) == 0 || (Id != null && string.Compare(Action, "Edit", true) == 0))
{
    <CascadingValue Value="this">
        <AttributeTemplate Action="@Action" Id="@Id"></AttributeTemplate>
    </CascadingValue>
}
else
{
    @if (Header)
    {
        <GXMenuControl RightCorner="true">
            <ChildContent>
                <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXDeviceTemplatePolicies.Delete" />
            </ChildContent>
        </GXMenuControl>
    }

    <GXViewTable ViewName="DeviceTemplate.AttributeTemplates" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXAttributeTemplatePolicies.View })" TItem="GXAttributeTemplate" @ref="table"
                 Context="template"
                 ItemsProvider="@GetItems"
                 SelectionMode="SelectionMode.Multiple"
                 Filter="@Filter"
                 ShowAllUsers="@Header"
                 ShowRemoved="@Header"
                 CanEdit="@CanEdit"
                 Columns="@Columns"
                 OnSearch="@Updated">
        <FilterContent>
        </FilterContent>
        <MenuContent>
            @if (Menu)
            {
                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
            }
        </MenuContent>
        <HeaderContent>
            <GXTh Name="LogicalName" Target="@template">@Properties.Resources.LogicalName</GXTh>
            <GXTh Name="ObjectName" Target="@template">@Properties.Resources.Name</GXTh>
            <GXTh Name="Index" Target="@template">@Properties.Resources.Index</GXTh>
            <GXTh Name="Name" Target="@template">@Properties.Resources.Name</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="LogicalName">@template.ObjectTemplate?.LogicalName</GXTd>
            <GXTd Id="ObjectName">@template.ObjectTemplate?.Name</GXTd>
            <GXTd Id="Index">@template.Index</GXTd>
            <GXTd Id="Name">@template.Name</GXTd>
        </ItemContent>
    </GXViewTable>
    
}

<br />
@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("LogicalName") { Position = 0, Description = "LogicalName", Visibility = (byte)Visibility.All },
        new("ObjectName") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("Index") { Position = 2, Description = "Index", Visibility = (byte)Visibility.All },
        new("Name") { Position = 3, Description = "Name", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected Attribute template ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }



    /// <summary>
    /// List of available device IDs.
    /// </summary>
    [Parameter]
    public IEnumerable<GXAttributeTemplate>? AvailableAttributeTemplates { get; set; }

    /// <summary>
    /// Shown object types.
    /// </summary>
    /// <remarks>
    /// All object types are shown if object types are not set.
    /// </remarks>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? ObjectTypes { get; set; }

    /// <summary>
    /// Ignored object types.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? IgnoredObjectTypes { get; set; }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "attribute-template";
        }
    }

    /// <summary>
    /// Amount of the Attribute templates shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is menu shown.
    /// </summary>
    [Parameter]
    public bool Menu { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Device filter.
    /// </summary>
    private GXAttributeTemplate filter = new GXAttributeTemplate();

    /// <summary>
    /// Filter using Attribute type.
    /// </summary>
    private string? filterByAttributeType;
    /// <summary>
    /// Filter using Attribute name.
    /// </summary>
    private string? filterByName;
    /// <summary>
    /// Filter by logical name of the Attribute.
    /// </summary>
    private string? filterByLogicalName;

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXAttributeTemplate>? table;

    /// <summary>
    /// Active device.
    /// </summary>
    [Parameter, EditorRequired]
    public GXDeviceTemplate? Device { get; set; }

    /// <summary>
    /// Active Attribute template.
    /// </summary>
    public GXAttributeTemplate? Active
    {
        get
        {
            return table?.Active;
        }
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplates.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplates.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        if (NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("AttributeTemplate/"))
        {
            //If Attribute template is shown.
            return;
        }
        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAttributeTemplates);
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplates.OnInitializedAsync");
            //Get selected item.
            if (Device == null &&
                (AvailableAttributeTemplates == null || !AvailableAttributeTemplates.Any()))
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
           {
               foreach (var it in items)
               {
                   if (it.Type == GXAttributeTemplatePolicies.Add ||
                       it.Type == GXAttributeTemplatePolicies.Edit ||
                       it.Type == GXAttributeTemplatePolicies.Delete)
                   {
                       _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                       break;
                   }
               }
           });
            if (Header)
            {
            }
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXAttributeTemplate() { Id = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplates.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Search by Attribute type.
    /// </summary>
    private async Task SearchByAttributeType(ChangeEventArgs args)
    {
        filterByAttributeType = Convert.ToString(args.Value);
        await Updated();
    }

    /// <summary>
    /// Search by name.
    /// </summary>
    private async Task SearchByName(ChangeEventArgs args)
    {
        filterByName = Convert.ToString(args.Value);
        await Updated();
    }

    /// <summary>
    /// Search by logical name.
    /// </summary>
    private async Task SearchByLogicalName(ChangeEventArgs args)
    {
        filterByLogicalName = Convert.ToString(args.Value);
        await Updated();
    }

    private async ValueTask<ItemsProviderResult<GXAttributeTemplate>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingAttributeTemplates);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListAttributeTemplates req = new ListAttributeTemplates()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                //Object template information are also read.
                Select = new string[] { TargetType.ObjectTemplate }
            };
            if (AvailableAttributeTemplates != null && AvailableAttributeTemplates.Any())
            {
                req.Included = AvailableAttributeTemplates.Select(s => s.Id).ToArray();
            }
            if (ObjectTypes != null && ObjectTypes.Any())
            {
                req.ObjectTypes = ObjectTypes?.Cast<int>().ToArray();
            }
            if (IgnoredObjectTypes != null && IgnoredObjectTypes.Any())
            {
                req.IgnoredObjectTypes = IgnoredObjectTypes?.Cast<int>().ToArray();
            }
            var ret = await Http.PostAsJson<ListAttributeTemplatesResponse>("api/AttributeTemplate/List", req, request.CancellationToken);
            if (ret.AttributeTemplates != null)
            {
                return new ItemsProviderResult<GXAttributeTemplate>(ret.AttributeTemplates, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit Attribute template.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplates.OnEdit");
            if (Device == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/AttributeTemplate/Edit/" + Device.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplates.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected Attribute templates.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected Attribute templates.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveAttributeTemplate req = new RemoveAttributeTemplate()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveAttributeTemplateResponse>("api/AttributeTemplate/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
