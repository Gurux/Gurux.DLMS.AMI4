@page "/DeviceTemplate/{Id:guid?}"
@page "/DeviceTemplate/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Admin
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@using Gurux.DLMS.AMI.Shared.DTOs.Menu
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="DeviceTemplate" />

<h1>
    @Title
</h1>
@if (_ready)
{
    <EditForm EditContext="@GXEditContexts.For(Active)"><ValidationSummary /></EditForm>
}
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.DeviceTemplateDetailsTab" Parameters="@TabParameters" ParametersForLink="@GetTabParameters" LinkFilter="@ShowTemplateTab" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);
    public bool DeleteTarget { get; set; }
    public bool IsDeleting => _action == CrudAction.Delete;
    internal GXDLMSSettings? Settings;
    internal List<GXDeviceTemplate> ImportedTemplates = new();
    internal string? ImportedFileName;
    private GXDeviceTemplate? _settingsTarget;
    private GXProfilePictureEdit? _profilePictureEdit;
    private bool _savingProfilePicture;
    internal void LoadSettings(GXDeviceTemplate template)
    {
        if (ReferenceEquals(_settingsTarget, template)) {
            return;
        }
        _settingsTarget = template;
        Settings = string.IsNullOrWhiteSpace(template.Settings) ? new GXDLMSSettings() : JsonSerializer.Deserialize<GXDLMSSettings>(template.Settings) ?? new GXDLMSSettings();
    }
    private void OnActiveChanged(GXDeviceTemplate template)
    {
        if (_savingProfilePicture) {
            return;
        }
        // Imported protocol alternatives belong to the same new template editor.
        // Keep its pending picture instead of inheriting an imported reference.
        if (_action == CrudAction.Create && !ReferenceEquals(Active, template))
        {
            template.ProfilePicture = Active.ProfilePicture;
        }
        Active = template;
        LoadSettings(template);
        EditorMenu.Set(Active, _action, OnSave, OnCancel);
    }
    private bool ValidateContent()
    {
        if (string.IsNullOrEmpty(Active.Name)) {
            EditorMenu.AddValidationError(nameof(Active.Name), Properties.Resources.InvalidName);
        }
        if (Active.Objects == null || Active.Objects.Count == 0) {
            throw new Exception(Properties.Resources.DeviceTemplateFileIsNotSelected);
        }
        if (Settings != null && Settings.Security != (byte)Gurux.DLMS.Enums.Security.None)
        {
            if (Settings.ClientSystemTitle?.Length is > 0 and not 8) {
                EditorMenu.AddValidationError(nameof(Settings.ClientSystemTitle), Properties.Resources.InvalidSystemTitle);
            }
            if (Settings.DeviceSystemTitle?.Length is > 0 and not 8) {
                EditorMenu.AddValidationError(nameof(Settings.DeviceSystemTitle), Properties.Resources.InvalidSystemTitle);
            }
            int keyLength = Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 ? 32 : 16;
            if (Settings.BlockCipherKey?.Length > 0 && Settings.BlockCipherKey.Length != keyLength) {
                EditorMenu.AddValidationError(nameof(Settings.BlockCipherKey), Properties.Resources.InvalidBlockCipherKey);
            }
            if (Settings.AuthenticationKey?.Length > 0 && Settings.AuthenticationKey.Length != keyLength) {
                EditorMenu.AddValidationError(nameof(Settings.AuthenticationKey), Properties.Resources.InvalidAuthenticationKey);
            }
        }
        return !GXEditContexts.For(Active).GetValidationMessages().Any();
    }
    public void Dispose() => _editorMenu?.Dispose();
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Device"] = Active,
        ["TopMenu"] = false
    };

    private IGXProgress? Progress;
    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
    {
        var type = Type.GetType(link.TargetType ?? string.Empty);
        if (type == typeof(ProfilePictureEditor))
        {
            return new Dictionary<string, object>
            {
                [nameof(ProfilePictureEditor.Value)] = Active.ProfilePicture!,
                [nameof(ProfilePictureEditor.ValueChanged)] = EventCallback.Factory.Create<GXAppearance?>(this, ProfilePictureChanged),
                [nameof(ProfilePictureEditor.Disabled)] = _savingProfilePicture || _action is not (CrudAction.Create or CrudAction.Update),
                [nameof(ProfilePictureEditor.Id)] = "device-template-profile-picture-editor"
            };
        }
        return type == typeof(DeviceTemplateGeneral)
            ? new Dictionary<string, object>
            {
                ["Action"] = _action,
                ["ActiveChanged"] = EventCallback.Factory.Create<GXDeviceTemplate>(this, OnActiveChanged)
            } : null;
    }

    private bool ShowTemplateTab(GXMenuLink link)
        => _action != CrudAction.Create || Type.GetType(link.TargetType ?? string.Empty) != typeof(ProfilePictureEditor);

    private void ProfilePictureChanged(GXAppearance? image)
    {
        if (_savingProfilePicture || _action is not (CrudAction.Create or CrudAction.Update)) {
            return;
        }
        Active.ProfilePicture = image;
        GXEditContexts.For(Active).NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXDeviceTemplate.ProfilePicture)));
    }

    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXDeviceTemplate Active = new GXDeviceTemplate(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.DeviceTemplate;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceTemplate);
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplate.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get device template data.
                var tmp = (await Http.GetAsJsonAsync<GetDeviceTemplateResponse>(string.Format("api/DeviceTemplate?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            _profilePictureEdit = new GXProfilePictureEdit(Active.ProfilePicture?.Id, Active.Id == Guid.Empty ? null : Active.Creator?.Id);
            LoadSettings(Active);
            _ready = true;
            EditorMenu.Set(Active, _action, OnSave, OnCancel);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplate.OnInitializedAsync");
        }
    }

    private void UpdateSettings()
    {
        //Update settings
        if (Active != null && Settings != null)
        {
            var options = new JsonSerializerOptions
            {
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingDefault
            };



            //Set empty strings to null.
            foreach (var it in Settings.GetType().GetProperties())
            {
                object? value = it.GetValue(Settings);
                if (value is string str)
                {
                    if (str == string.Empty)
                    {
                        it.SetValue(Settings, null);
                    }
                }
                if (value is byte[] ba)
                {
                    if (ba.Length == 0)
                    {
                        it.SetValue(Settings, null);
                    }
                }
            }
            Active.Settings = JsonSerializer.Serialize(Settings, options);
        }
    }
    public async Task OnSave()
    {
        if (_savingProfilePicture) {
            return;
        }
        _savingProfilePicture = true;
        try
        {
            StateHasChanged();
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }

            if (_action != CrudAction.Delete && !ValidateContent())
            {
                return;
            }
            UpdateSettings();
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingDeviceTemplate);
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplateGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveDeviceTemplateResponse>("api/DeviceTemplate/Delete", new RemoveDeviceTemplate()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else if (_action == CrudAction.Create)
            {
                await SaveTemplateWithPictureAsync("api/DeviceTemplate/Add");
            }
            else if (_action == CrudAction.Update)
            {
                await SaveTemplateWithPictureAsync("api/DeviceTemplate/Update");
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplateGeneral.OnSave");
        }
        finally
        {
            _savingProfilePicture = false;
            StateHasChanged();
        }
    }
    private Task SaveTemplateWithPictureAsync(string address)
    {
        var template = Active;
        return (_profilePictureEdit ??= new GXProfilePictureEdit(template.ProfilePicture?.Id, template.Id == Guid.Empty ? null : template.Creator?.Id)).SaveAsync(Http,
            template.ProfilePicture, image => template.ProfilePicture = image,
            async () => { await Http.PostAsJson<UpdateDeviceTemplateResponse>(address, new UpdateDeviceTemplate { Templates = [template] }); },
            error => NotificationService?.ReportError(error, "DeviceTemplate.ProfilePicture.Cleanup"));
    }

    private Task OnCancel()
    {
        if (_savingProfilePicture) {
            return Task.CompletedTask;
        }
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
}
