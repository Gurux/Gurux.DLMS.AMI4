@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums

@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS
@using Gurux.DLMS.ManufacturerSettings
@using Gurux.DLMS.Objects
@using System.Xml.Linq
@using System.IO
@using System.Xml
@using System.Xml.Serialization
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text.Json
@using System.Web
@using System.Text.Json.Serialization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ILogger<DeviceTemplateGeneral> Logger
@inject IGXAmiConfirmation Confirmation

<GXHelpContext Topic="Profiles" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd"></GXMenuEntry>
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXMenuEntry>
    </ChildContent>
</GXMenuControl>

@if (ProfileAction != CrudAction.None)
{
    @*Show profile.*@
    <Profile Parent="this"></Profile>
}

<br />
<br />
<p>
    <div class="row">
        <div style="width:100%">
            <div class="form-group">
                <GXViewTable ViewName="DeviceTemplate.Profiles" ViewColumns="ViewColumnDefaults" TItem="GXCommunicationProfile" @ref="table"
                         Context="profile"
                         ItemsProvider="@GetItems"
                         SelectionMode="SelectionMode.Multiple"
                         Filter="false"
                         ShowRemoved="false"
                         ShowAllUsers="false"
                         ShowAllData="true">
                    <FilterContent>
                    </FilterContent>
                    <MenuContent>
                        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
                        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
                    </MenuContent>
                    <HeaderContent>
                        <GXTh Name="InterfaceType" Target="@profile">@Properties.Resources.InterfaceType</GXTh>
                        <GXTh Name="ClientAddress" Target="@profile">@Properties.Resources.ClientAddress</GXTh>
                        <GXTh Name="LogicalAddress" Target="@profile">@Properties.Resources.LogicalAddress</GXTh>
                        <GXTh Name="PhysicalAddress" Target="@profile">@Properties.Resources.PhysicalAddress</GXTh>
                    </HeaderContent>
                    <ItemContent>
                        <GXTd Id="InterfaceType">
                            <GXLinkButton TItem="GXCommunicationProfile" Target="@profile" OnClick="@Edit"
                                        Text="@(((Gurux.DLMS.Enums.InterfaceType)profile.InterfaceType).ToString())" />
                        </GXTd>
                        <GXTd Id="ClientAddress">@profile.ClientAddress</GXTd>
                        <GXTd Id="LogicalAddress">@profile.LogicalAddress</GXTd>
                        <GXTd Id="PhysicalAddress">@profile.PhysicalAddress</GXTd>
                    </ItemContent>
                </GXViewTable>
            </div>
        </div>
    </div>
</p>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("InterfaceType") { Position = 0, Description = "InterfaceType", Visibility = (byte)Visibility.All },
        new("ClientAddress") { Position = 1, Description = "ClientAddress", Visibility = (byte)Visibility.All },
        new("LogicalAddress") { Position = 2, Description = "LogicalAddress", Visibility = (byte)Visibility.All },
        new("PhysicalAddress") { Position = 3, Description = "PhysicalAddress", Visibility = (byte)Visibility.All },
    ];


    private IGXNotificationService? NotificationService;

    internal CrudAction ProfileAction;

    internal List<GXCommunicationProfile>? _profiles;

    /// <summary>
    /// Reference to the table.
    /// </summary>
    private GXTable<GXCommunicationProfile>? table;

    internal IEnumerable<GXCommunicationProfile>? GetSelectedProfiles()
    {
        return table?.Items;
    }

    /// <summary>
    /// User is verified before profiles are removed.
    ///</summary>

    internal void Update(Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings s, bool renderOnSuccess = true)
    {
        _profiles = s.Profiles;
        //Handle old way.
        if (s.ClientAddress != 0)
        {
            s.Profiles.Add(new GXCommunicationProfile()
                {
                    InterfaceType = s.InterfaceType,
                    ClientAddress = s.ClientAddress,
                    LogicalAddress = s.LogicalAddress,
                    PhysicalAddress = (int)s.PhysicalAddress
                });
            s.ClientAddress = 0;
            s.LogicalAddress = 0;
            s.PhysicalAddress = 0;
        }
        if (renderOnSuccess)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private ValueTask<ItemsProviderResult<GXCommunicationProfile>> GetItems(GXItemsProviderRequest request)
    {
        if (_profiles != null)
        {
            return new(new ItemsProviderResult<GXCommunicationProfile>(_profiles, _profiles.Count));
        }
        return default;
    }

    /// <summary>
    /// Add new profile.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ProfileAction = CrudAction.Create;
            Active = new()
                {
                    ClientAddress = 1,
                    PhysicalAddress = 1
                };
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    internal GXCommunicationProfile? Active;

    /// <summary>
    /// Close profile form.
    /// </summary>
    internal void Update()
    {
        ProfileAction = CrudAction.None;
        InvokeAsync(StateHasChanged);
    }

    private void Edit(GXCommunicationProfile item)
    {
        try
        {
            ProfileAction = CrudAction.Update;
            Active = item;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit profile.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/Profiles.OnEdit");
            if (table == null || table.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ProfileAction = CrudAction.Update;
            Active = table.Active;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/Profiles.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected device template group.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.InterfaceType.ToString()).ToArray()
                });
            OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected device template groups.
    /// </summary>
    public void OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                if (_profiles?.RemoveAll(w => (table?.SingleOrDefault()?.Contains(w) == true)) > 0)
                    {
                    Parent?.SettingsChanged();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    internal void Validate(GXValidator sender, Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings s)
    {
    }

    internal void UpdateSettings(Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings s)
    {
        s.Profiles = _profiles ?? [];
    }

    [Parameter]
    public DeviceTemplateGeneral? Parent { get; set; }

    public bool IsDeleting
    {
        get
        {
            if (Parent == null)
            {
                return false;
            }
            return Parent.IsDeleting;
        }
    }

    protected override void OnInitialized()
    {
        NotificationService = Services.GetService<IGXNotificationService>();

        if (Parent?.Settings is Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings s)
        {
            Update(s, false);
        }
    }
}
