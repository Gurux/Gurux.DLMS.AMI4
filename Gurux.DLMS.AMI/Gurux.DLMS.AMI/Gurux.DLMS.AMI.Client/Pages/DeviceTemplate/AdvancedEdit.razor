@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums;
@using Gurux.DLMS.AMI.Shared.DTOs.KeyManagement;

@using Gurux.DLMS.ASN;
@using Gurux.DLMS.Objects.Enums;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text;
@using System.Reflection;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="AdvancedEdit" />

@if (Active != null)
{
    <GXDialog OnOk="OnSave" OnCancel="OnCancel">
        <EditForm EditContext="@GXEditContexts.For(Active)">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <GXValidator @ref="_validator" OnValidate="OnValidate" />
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <div class="col-auto">
                            <label>@Active.Name</label>
                        </div>
                        <div class="col-auto">
                            @if (IsHexString)
                            {
                                <GXInputHexAscii @bind-Value="HexByteArray"></GXInputHexAscii>
                                <ValidationMessage For="@(() => Active.Name)" />
                            }
                            else @if (Active.Name == "Authentication")
                            {
                                <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="ByteValue"
                                                 Items="@(Enum.GetValues<Gurux.DLMS.Enums.Authentication>().Select(it => (int)it))" Formatter="@((int value) => ((Gurux.DLMS.Enums.Authentication)value).ToString())" />
                            }
                            else if (Active.Name == "Standard")
                            {
                                <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="ByteValue"
                                                 Items="@(Enum.GetValues<Gurux.DLMS.Enums.Standard>().Select(it => (int)it))" Formatter="@((int value) => ((Gurux.DLMS.Enums.Standard)value).ToString())" />
                            }
                            else if (Active.Name == "Security")
                            {
                                <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="ByteValue"
                                                 Items="@(Enum.GetValues<Gurux.DLMS.Enums.Security>().Select(it => (int)it))" Formatter="@((int value) => ((Gurux.DLMS.Enums.Security)value).ToString())" />
                            }
                            else if (Active.Name == "SecuritySuite")
                            {
                                <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="ByteValue"
                                                 Items="@(Enum.GetValues<SecuritySuite>().Select(it => (int)it))" Formatter="@((int value) => ((SecuritySuite)value).ToString())" />
                            }
                            else if (Active.PropertyType.FullName == typeof(string).FullName)
                            {
                                <InputText class="form-control" @bind-Value="StringValue" />
                                <ValidationMessage For="@(() => Active.Name)" />
                            }
                            else if (Active.PropertyType.FullName == typeof(int).FullName)
                            {
                                <GXInputNumber RememberValue="false" @bind-Value="IntValue" Min="@GXNumberBounds.Minimum(IntValue)" Max="@GXNumberBounds.Maximum(IntValue)" />
                                <ValidationMessage For="@(() => Active.Name)" />
                            }
                            else if (Active.PropertyType.FullName == typeof(byte).FullName)
                            {
                                <GXInputNumber @bind-Value="ByteValue" Min="0" Max="255" />
                                <ValidationMessage For="@(() => Active.Name)" />
                            }
                            else if (Active.PropertyType.FullName == typeof(bool).FullName)
                            {
                                <GXInputSwitch @bind-Value="BoolValue" />
                            }
                            else if (Active.PropertyType.FullName == typeof(byte[]).FullName)
                            {
                                <GXInputHexAscii @bind-Value="ByteArray" Title="@Active.Name"></GXInputHexAscii>
                                <ValidationMessage For="@(() => Active.Name)" />
                            }
                            else
                            {
                                <label>@Value</label>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </GXDialog>
}
@code {

    private IGXNotificationService? NotificationService;

    private object? Value;

    private bool IsHexString
    {
        get
        {
            return Active == null ||
            Active.Name == "ClientSystemTitle" ||
            Active.Name == "DeviceSystemTitle" ||
            Active.Name == "BlockCipherKey" ||
            Active.Name == "AuthenticationKey" ||
            Active.Name == "DedicatedKey" ||
            Active.Name == "HexPassword";
        }
    }

    private byte[]? ByteArray
    {
        get
        {
            return Value as byte[];
        }
        set
        {
            Value = value;
        }
    }

    private byte[]? HexByteArray
    {
        get
        {
            return GXDLMSTranslator.HexToBytes(Value as string);
        }
        set
        {
            Value = GXDLMSTranslator.ToHex(value);
        }
    }

    private int IntValue
    {
        get
        {
            return (int?)Value ?? 0;
        }
        set
        {
            Value = value;
        }
    }

    private int ByteValue
    {
        get
        {
            return (byte?)Value ?? 0;
        }
        set
        {
            Value = Convert.ToByte(value);
        }
    }

    private bool BoolValue
    {
        get
        {
            return (bool?)Value ?? false;
        }
        set
        {
            Value = value;
        }
    }

    private string StringValue
    {
        get
        {
            return (string?)Value ?? string.Empty;
        }
        set
        {
            Value = value;
        }
    }

    private GXValidator? _validator;

    [Parameter]
    public Advanced? Parent { get; set; }

    private PropertyInfo? Active
    {
        get
        {
            return Parent?.Selected;
        }
    }

    protected override void OnInitialized()
    {
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AdvancedEdit.OnInitialized");
            if (Active == null || Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            Value = Active.GetValue(Parent?.Settings ?? throw new InvalidOperationException(Properties.Resources.DeviceTemplateSettingsAreMissing));
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AdvancedEdit.OnInitialized");
        }
    }

    /// <summary>
    /// Validate the profile content.
    ///</summary>
    ///<param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {

    }

    /// <summary>
    /// Save profile group.
    ///</summary>
    public async System.Threading.Tasks.Task OnSave()
    {
        try
        {
            _validator?.ClearErrors();
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_validator != null && !await _validator.ValidateAsync())
            {
                return;
            }
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/AdvancedEdit.OnSave");
            if (Parent?.Action == CrudAction.Update)
            {
                Active.SetValue(Parent.Settings, Value);
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Parent?.Parent?.SettingsChanged();
            Parent?.Update();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/AdvancedEdit.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        Parent?.Update();
    }
}
