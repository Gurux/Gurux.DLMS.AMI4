@namespace Gurux.DLMS.AMI.Client.Pages.DeviceTemplate
@implements IDisposable
@using Gurux.UI.Components.Enums

<div class="attribute-expiration-editor">
    <GXInputTimeSpan @key="IsStatic" TValue="TimeSpan?" id="@InputId" class="form-control"
                     RememberValue="false" TimeSpanUnit="TimeSpanUnit.Second"
                     disabled="@(Disabled || IsStatic)" @bind-Value="Duration" />
    <ValidationMessage For="@(() => Duration)" />
    <ValidationMessage For="@(() => Template.ExpirationTime)" />
    <div class="form-check mt-2">
        <input id="@StaticId" class="form-check-input" type="checkbox"
               disabled="@Disabled" checked="@IsStatic" @onchange="ChangeStatic" />
        <label class="form-check-label" for="@StaticId">@Properties.Resources.AttributeReadOnce</label>
    </div>
</div>

@code {
    private readonly string _generatedId = $"attribute-expiration-{Guid.NewGuid():N}";
    private string InputId => Id ?? _generatedId;
    private string StaticId => InputId + "-static";

    /// <summary>Attribute whose cache lifetime is being edited.</summary>
    [Parameter, EditorRequired]
    public GXAttributeTemplate Template { get; set; } = default!;

    /// <summary>Identifier for the duration input and its external label.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>Prevents editing both the duration and read-once selection.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    [CascadingParameter]
    private EditContext? FormContext { get; set; }

    private bool _hasPendingDuration;
    private TimeSpan? _pendingDuration;
    private ValidationMessageStore? _durationValidation;
    private EditContext? _validationContext;
    private GXAttributeTemplate? _validationTemplate;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_validationContext, FormContext) || !ReferenceEquals(_validationTemplate, Template))
        {
            ClearDurationValidation();
            _validationContext = FormContext;
            _validationTemplate = Template;
            _durationValidation = FormContext == null ? null : new ValidationMessageStore(FormContext);
            _hasPendingDuration = false;
        }
    }

    private void ClearDurationValidation()
    {
        _durationValidation?.Clear();
        _validationContext?.NotifyValidationStateChanged();
    }

    public void Dispose()
    {
        ClearDurationValidation();
    }

    private bool IsStatic => Template.ExpirationTime?.Year == DateTimeOffset.MaxValue.Year;

    // Only the UI uses TimeSpan. The existing DTO retains its compatible storage representation.
    private TimeSpan? Duration
    {
        get => IsStatic ? null : _hasPendingDuration ? _pendingDuration : Template.ExpirationTime?.TimeOfDay;
        set
        {
            if (Disabled || IsStatic)
            {
                return;
            }
            ClearDurationValidation();
            _pendingDuration = value;
            _hasPendingDuration = true;
            if (value is TimeSpan duration && duration >= TimeSpan.FromDays(1))
            {
                _durationValidation?.Add(new FieldIdentifier(Template, nameof(GXAttributeTemplate.ExpirationTime)),
                    Properties.Resources.AttributeExpirationLessThanOneDay);
                _validationContext?.NotifyValidationStateChanged();
                return;
            }
            _hasPendingDuration = false;
            if (value == null || value == TimeSpan.Zero)
            {
                SetExpiration(null);
            }
            else
            {
                var basis = Template.ExpirationTime ?? DateTimeOffset.Now;
                SetExpiration(new DateTimeOffset(basis.Date.Add(value.Value), basis.Offset));
            }
        }
    }

    private void ChangeStatic(ChangeEventArgs args)
    {
        if (!Disabled)
        {
            ClearDurationValidation();
            _hasPendingDuration = false;
            SetExpiration(args.Value is true ? DateTimeOffset.MaxValue : null);
        }
    }

    private void SetExpiration(DateTimeOffset? value)
    {
        if (Template.ExpirationTime != value)
        {
            Template.ExpirationTime = value;
            FormContext?.NotifyFieldChanged(new FieldIdentifier(Template, nameof(GXAttributeTemplate.ExpirationTime)));
        }
    }
}
