@page "/DeviceTemplate/Groups"
@page "/DeviceTemplate"
@page "/DeviceTemplateGroup"

@using Gurux.DLMS.AMI.Client.Pages.Admin
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs

@inject NavigationManager NavigationManager

@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="DeviceTemplateManage" />

@if (string.Compare(Action, "Add", true) == 0 || (Id != null && Path != null && string.Compare(Action, "Edit", true) == 0))
{
    @if (string.Compare(Path, "DeviceTemplateGroup", true) == 0)
    {
        <DeviceTemplateGroup Action="@Action" Id="@Id"></DeviceTemplateGroup>
    }
    else if (string.Compare(Path, "DeviceTemplate", true) == 0)
    {
        <DeviceTemplate Action="@Action" Id="@Id"></DeviceTemplate>
    }
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="DeviceTemplate" Active="@Path" SelectionChanged="@SelectionChanged">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            <GXLocalizedText Value="@context.Text" />
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.DeviceTemplateTab"></TabHeader>
        </ChildContent>
    </GXTabControl>
}
<br />
@code {
    protected override void OnParametersSet()
    {
        Path = GXTabRoutes.Active(NavigationManager, "DeviceTemplate", 0, Path);
    }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string? Path { get; set; }

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(GXTabPage page)
    {
        Path = page.Path;
    }

    protected override void OnInitialized()
    {
        //Get selected tab from the url.
        Path = GXTabRoutes.Active(NavigationManager, "DeviceTemplate", 0, Path);
    }
}



