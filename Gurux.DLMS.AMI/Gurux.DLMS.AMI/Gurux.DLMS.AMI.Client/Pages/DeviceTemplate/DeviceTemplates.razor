@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/DeviceTemplates"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable


<GXHelpContext Topic="DeviceTemplates" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXDeviceTemplatePolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"
                     Policy="@GXDeviceTemplatePolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.PublishToCommunity" Id="publish-community" OnClick="@OnPublishCommunity" Policy="@GXDeviceTemplatePolicies.Add" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="DeviceTemplate.DeviceTemplates" ViewColumns="ViewColumnDefaults"
             ViewPolicies="@(new List<string> { GXDeviceTemplatePolicies.View })" TItem="GXDeviceTemplate" @ref="table"
             Context="template" ItemsProvider="@GetItems" SelectionMode="SelectionMode.Multiple" Filter="@Filter"
             ShowAllUsers="@Header" ShowRemoved="@Header" CanEdit="@CanEdit" Columns="@Columns" OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Manufacturer">
            @*Manufacturer*@
            @if (filter.Manufacturer != null)
            {
                <input class="form-control" placeholder="@Properties.Resources.Manufacturer" type="text"
                       @onchange="@((ChangeEventArgs __e) => filter.Manufacturer.Name = Convert.ToString(__e.Value))" />
            }
        </GXFh>
        <GXFh Id="Model">
            @*Model*@
            @if (filter.Manufacturer?.Models?.FirstOrDefault() is GXDeviceModel mod)
            {
                <input class="form-control" placeholder="@Properties.Resources.Model" type="text"
                       @onchange="@((ChangeEventArgs __e) => mod.Name = Convert.ToString(__e.Value))" />
            }
        </GXFh>
        <GXFh Id="Version">
            @*Version*@
            @if (filter.Manufacturer?.Models?.FirstOrDefault()?.Versions?.FirstOrDefault() is GXDeviceVersion ver)
            {
                <input class="form-control" placeholder="@Properties.Resources.Version" type="text"
                       @onchange="@((ChangeEventArgs __e) => ver.Name = Convert.ToString(__e.Value))" />
            }
        </GXFh>
        <GXFh Id="Name">
            <input class="form-control" placeholder="@Properties.Resources.FilterByName" type="text"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="DeviceTemplates-CreationTime" @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime" type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"
                           Policy="@GXDeviceTemplatePolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"
                           Policy="@GXDeviceTemplatePolicies.Delete"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.PublishToCommunity" Id="publish-community" OnClick="@OnPublishCommunity" Policy="@GXDeviceTemplatePolicies.Add" />
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Manufacturer" TItem="GXDeviceTemplate">@Properties.Resources.Manufacturer</GXTh>
        <GXTh Id="Model" TItem="GXDeviceTemplate">@Properties.Resources.Model</GXTh>
        <GXTh Id="Version" TItem="GXDeviceTemplate">@Properties.Resources.Version</GXTh>
        <GXTh Name="Name" Target="@template">@Properties.Resources.Name</GXTh>
        <GXTh Name="CreationTime" Target="@template" SortMode="SortMode.Descending">
            @Properties.Resources.CreationTime
        </GXTh>
        <GXTh Name="Updated" Target="@template">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Manufacturer">@template.Manufacturer?.Name</GXTd>
        <GXTd Id="Model">@template.Manufacturer?.Models?.FirstOrDefault()?.Name</GXTd>
        <GXTd Id="Version">@GetVersionName(template)</GXTd>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/DeviceTemplate/Edit/" + template.Id)">
            @template.Name
        </GXTd>
        <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(template.CreationTime)</GXTd>
        <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(template.Updated)</GXTd>
    </ItemContent>
</GXViewTable>
<br />

<DeviceTemplateCommunityDialog @ref="communityDialog" />

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Manufacturer") { Position = 0, Description = "Manufacturer", Visibility = (byte)Visibility.All },
        new("Model") { Position = 1, Description = "Model", Visibility = (byte)Visibility.All },
        new("Version") { Position = 2, Description = "Version", Visibility = (byte)Visibility.All },
        new("Name") { Position = 3, Description = "Name", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 4, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Updated") { Position = 5, Description = "Updated", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    private string GetVersionName(GXDeviceTemplate template)
    {
        var ver = template.Manufacturer?.Models?.FirstOrDefault()?.Versions?.FirstOrDefault();
        if (string.IsNullOrEmpty(ver?.Name))
        {
            return Properties.Resources.Generic;
        }
        return ver.Name;
    }

    /// <summary>
    /// Selected device template ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.DeviceTemplates;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device-template";
        }
    }

    /// <summary>
    /// Amount of the device templates shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Device template filter.
    /// </summary>
    private GXDeviceTemplate filter = new GXDeviceTemplate();

    /// <summary>
    /// Active item.
    /// </summary>
    public GXDeviceTemplate? Active
    {
        get
        {
            return table?.Active;
        }
    }

    private bool publishingCommunity;
    private DeviceTemplateCommunityDialog? communityDialog;

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXDeviceTemplate>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplates.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplates.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        GXDeviceVersion version = new GXDeviceVersion(null);
        GXDeviceModel model = new GXDeviceModel(null);
        (model.Versions ??= []).Add(version);
        filter.Manufacturer = new GXManufacturer(null);
        (filter.Manufacturer.Models ??= []).Add(model);
        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplates.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXDeviceTemplatePolicies.Add ||
                            it.Type == GXDeviceTemplatePolicies.Delete ||
                            it.Type == GXDeviceTemplatePolicies.Edit)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXDeviceTemplate() { Id = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplates.OnInitializedAsync");
        }
    }

    private async ValueTask<ItemsProviderResult<GXDeviceTemplate>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceTemplates);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListDeviceTemplates req = new ListDeviceTemplates()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                //Get manufacturer settings.
                Select = new string[] { "Manufacturer" }
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListDeviceTemplatesResponse>("api/DeviceTemplate/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXDeviceTemplate>(ret.Templates, ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new device template.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplates.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager, "/DeviceTemplate/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplates.OnAdd");
        }
    }

    /// <summary>
    /// Edit device template.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplates.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/DeviceTemplate/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplates.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected device templates.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected device templates.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        if (table != null && args.Confirm)
        {
            try
            {
                using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingDeviceTemplate);
                RemoveDeviceTemplate req = new RemoveDeviceTemplate()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveDeviceTemplateResponse>("api/DeviceTemplate/Delete", req);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
    }

    /// <summary>Confirms anonymous publication of one saved device template before sending it for review.</summary>
    public async Task OnPublishCommunity()
    {
        if (publishingCommunity) { return; }
        publishingCommunity = true;
        const string key = "Pages/DeviceTemplate/PublishCommunity";
        try
        {
            NotificationService?.RemoveByKey(key);
            var selected = table?.SingleOrDefault().ToArray() ?? [];
            if (selected.Length != 1)
            {
                throw new InvalidOperationException(selected.Length == 0 ? Properties.Resources.NoItemIsSelected : Properties.Resources.SelectOneDeviceTemplate);
            }
            // Capture the selected template before asking for public metadata.
            var template = selected[0];
            var request = await (communityDialog ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget)).ShowAsync(template);
            if (request == null)
            {
                return;
            }
            var result = await Confirmation.ConfirmAsync(Properties.Resources.PublishToCommunity, Properties.Resources.PublishDeviceTemplateCommunityConfirmation,
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.PublishToCommunity, Items = [template.Name] });
            if (!result.Confirm) { return; }
            using var progress = Progress?.ProgressStart(Properties.Resources.PublishToCommunity);
            request.AcceptPublication = true;
            await Services.GetRequiredService<GXScriptCommunityNotifications>().PublishDeviceTemplateAsync(request);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, key, NotificationScope.Global);
        }
        finally { publishingCommunity = false; }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

