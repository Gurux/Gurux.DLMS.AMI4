@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="DeviceTemplatesSelector" />

<GXRelationshipSelector TItem="GXDeviceTemplate" @ref="_selectionContainer"
                        SelectedItems="@(() => _selectedItems)"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems"
                        Disabled="@Disabled">
    <ItemContent>
            @context.Name

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether relationship changes are disabled by the parent editor.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>References the edit model collection that is saved by the parent editor.</summary>
    private List<GXDeviceTemplate> _selectedItems = [];

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Gets or sets the parent group whose relationship is being edited.</summary>
    [Parameter, EditorRequired]
    public GXDeviceTemplateGroup? Active { get; set; }

    /// <summary>Coordinates paged checkbox selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXDeviceTemplate>? _selectionContainer;

    /// <summary>Stores endpoint criteria shared by selected and available device template queries.</summary>
    private GXDeviceTemplate _filter = new GXDeviceTemplate(null);

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null)
            {
                _filter.Name = name;
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplatesSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplatesSelector.SearchByName");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.DeviceTemplateGroups = null;
                }
                else
                {
                    GXUser user;
                    GXDeviceTemplateGroup? dtg = _filter.DeviceTemplateGroups?.FirstOrDefault();
                    if (dtg == null)
                    {
                        dtg = new GXDeviceTemplateGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        dtg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        _filter.DeviceTemplateGroups = new(new GXDeviceTemplateGroup[] { dtg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(dtg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplatesSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplatesSelector.SearchByUser");
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXDeviceTemplate>> GetItems(GXRelationshipQuery<GXDeviceTemplate> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingDeviceTemplates);
        try
        {
            ListDeviceTemplates req = new ListDeviceTemplates()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = _filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Included = request.Included?.Select(item => item.Id).ToArray(),
                    OrderBy = nameof(GXDeviceTemplate.Id),
                    Exclude = request.Excluded.Select(item => item.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListDeviceTemplatesResponse>("api/DeviceTemplate/List", req, request.CancellationToken);
            if (ret?.Templates != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXDeviceTemplate>(ret.Templates, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXDeviceTemplate>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (Active == null || Active == null || Active.DeviceTemplates == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingDeviceTemplates);
            _notificationService?.RemoveByKey("Pages/DeviceTemplate/DeviceTemplatesSelector.OnInitializedAsync");
            if (_selectionContainer != null && Active?.DeviceTemplates != null)
            {
                _selectedItems = Active.DeviceTemplates;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/DeviceTemplatesSelector.OnInitializedAsync");
        }
    }
}

