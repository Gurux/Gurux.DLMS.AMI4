@using Gurux.DLMS.AMI.Client.Pages.Schedule
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq
@using System.Text;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="AttributeTemplatesSelector" />

<GXRelationshipSelector TItem="GXAttributeTemplate" @ref="_selectionContainer"
                        SelectedItems="@(() => GetAttributes())"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems"
                        Disabled="@Disabled" OwnerMutates="true" OnAdded="OnAdded" OnRemoved="Removed">
    <ItemContent>
            @(context.ObjectTemplate?.LogicalName + " " +
                context.ObjectTemplate?.Name +
                " #" + context.Index + " " + context.Name)

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByLogicalName"
                    ValueChanged="@SearchByObjectLogicalName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByObject"
                    ValueChanged="@SearchByObject" />
            <GXSearch Placeholder="@Properties.Resources.FilterByDevice"
                    ValueChanged="@SearchByDevice" />
            <GXSearch Placeholder="@Properties.Resources.FilterByDeviceType"
                    ValueChanged="@SearchByDeviceType" />
            <GXSearch Placeholder="@Properties.Resources.FilterByAttributeIndex"
                    ValueChanged="@SearchByAttributeIndex" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether relationship changes are disabled by the parent editor.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Device templates where objects are asked.
    /// </summary>
    [Parameter]
    public List<GXDeviceTemplate>? DeviceTemplates { get; set; }

    /// <summary>
    /// Shown object types.
    /// </summary>
    /// <remarks>
    /// All object types are shown if object types are not set.
    /// </remarks>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? ObjectTypes { get; set; }

    /// <summary>
    /// Ignored object types.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? IgnoredObjectTypes { get; set; }

    /// <summary>
    /// Available attribute templates.
    /// </summary>
    [Parameter]
    public List<GXAttributeTemplate>? Templates { get; set; }

    /// <summary>Coordinates paged checkbox selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXAttributeTemplate>? _selectionContainer;
    /// <summary>Stores endpoint criteria shared by selected and available attribute queries.</summary>
    private readonly GXAttributeTemplate _filter = new GXAttributeTemplate(null)
        {
            ObjectTemplate = new GXObjectTemplate()
            {
                DeviceTemplate = new GXDeviceTemplate()
            }
        };

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null && _filter != null)
            {
                if (string.IsNullOrEmpty(name))
                {
                    _filter.Name = null;
                }
                else
                {
                    _filter.Name = name;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByName");
        }
    }

    /// <summary>Applies the attribute index filter to both selected and available relationship records.</summary>
    /// <param name="index">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByAttributeIndex(string? index)
    {
        try
        {
            if (_selectionContainer != null && _filter != null)
            {
                if (string.IsNullOrEmpty(index))
                {
                    _filter.Index = 0;
                }
                else
                {
                    _filter.Index = int.Parse(index);
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByAttributeIndex");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByAttributeIndex");
        }
    }

    /// <summary>Applies the object logical name filter to both selected and available relationship records.</summary>
    /// <param name="logicalName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByObjectLogicalName(string? logicalName)
    {
        try
        {
            if (_selectionContainer != null && _filter.ObjectTemplate != null)
            {
                if (string.IsNullOrEmpty(logicalName))
                {
                    _filter.ObjectTemplate.LogicalName = null;
                }
                else
                {
                    _filter.ObjectTemplate.LogicalName = logicalName;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByObjectLogicalName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByObjectLogicalName");
        }
    }

    /// <summary>Applies the object filter to both selected and available relationship records.</summary>
    /// <param name="objectName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByObject(string? objectName)
    {
        try
        {
            if (_selectionContainer != null && _filter.ObjectTemplate != null)
            {
                if (string.IsNullOrEmpty(objectName))
                {
                    _filter.ObjectTemplate.Name = null;
                }
                else
                {
                    _filter.ObjectTemplate.Name = objectName;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByObject");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByObject");
        }
    }

    /// <summary>Applies the device filter to both selected and available relationship records.</summary>
    /// <param name="deviceName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByDevice(string? deviceName)
    {
        try
        {
            if (_selectionContainer != null && _filter.ObjectTemplate?.DeviceTemplate != null)
            {
                if (string.IsNullOrEmpty(deviceName))
                {
                    _filter.ObjectTemplate.DeviceTemplate.Name = null;
                }
                else
                {
                    _filter.ObjectTemplate.DeviceTemplate.Name = deviceName;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByDevice");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByDevice");
        }
    }

    /// <summary>Applies the device type filter to both selected and available relationship records.</summary>
    /// <param name="deviceType">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByDeviceType(string? deviceType)
    {
        try
        {
            if (_selectionContainer != null && _filter.ObjectTemplate?.DeviceTemplate != null)
            {
                if (string.IsNullOrEmpty(deviceType))
                {
                    _filter.ObjectTemplate.DeviceTemplate.Name = null;
                }
                else
                {
                    _filter.ObjectTemplate.DeviceTemplate.Name = deviceType;
                }
                _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByDeviceType");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.SearchByDeviceType");
        }
    }

    /// <summary>Returns the relationship collection owned by the explicit parameter or the containing editor.</summary>
    /// <returns>The parent editor's authoritative relationship collection.</returns>
    private List<GXAttributeTemplate> GetAttributes()
    {
        return Templates ??= [];
    }

    /// <summary>Adds each new identity once to the authoritative relationship and refreshes its selection view.</summary>
    /// <param name="items">The records explicitly added or removed by the selection control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    public async Task OnAdded(IEnumerable<GXAttributeTemplate> items)
    {
        List<GXAttributeTemplate> attributes = GetAttributes();
        attributes.InsertRange(0, items.Where(item => !attributes.Any(existing => existing.Id == item.Id)).DistinctBy(item => item.Id));
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Removes matching identities from the authoritative relationship, including reloaded DTO instances.</summary>
    /// <param name="items">The records explicitly added or removed by the selection control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    private async Task Removed(IEnumerable<GXAttributeTemplate> items)
    {
        List<GXAttributeTemplate> attributes = GetAttributes();
        attributes.RemoveAll(value => items.Any(item => item.Id == value.Id));
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXAttributeTemplate>> GetItems(GXRelationshipQuery<GXAttributeTemplate> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingAttributeTemplates);
        try
        {
            ListAttributeTemplates req = new ListAttributeTemplates()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = _filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Select = new string[] { TargetType.ObjectTemplate },
                    Included = request.Included?.Select(item => item.Id).ToArray(),
                    OrderBy = nameof(GXAttributeTemplate.Id),
                    Exclude = request.Excluded.Select(item => item.Id).ToArray()
                };
            if (DeviceTemplates != null && DeviceTemplates.Any())
            {
                req.DeviceTemplates = DeviceTemplates.Select(s => s.Id).ToArray();
            }
            if (ObjectTypes != null && ObjectTypes.Any())
            {
                req.ObjectTypes = ObjectTypes?.Cast<int>().ToArray();
            }
            if (IgnoredObjectTypes != null && IgnoredObjectTypes.Any())
            {
                req.IgnoredObjectTypes = IgnoredObjectTypes?.Cast<int>().ToArray();
            }
            var ret = await Http.PostAsJson<ListAttributeTemplatesResponse>("api/AttributeTemplate/List", req, request.CancellationToken);
            if (ret?.AttributeTemplates != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXAttributeTemplate>(ret.AttributeTemplates, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXAttributeTemplate>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingAttributeTemplates);
            _notificationService?.RemoveByKey("Pages/DeviceTemplate/AttributeTemplatesSelector.OnInitializedAsync");
            if (_selectionContainer == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (GetAttributes() == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/DeviceTemplate/AttributeTemplatesSelector.OnInitializedAsync");
        }
    }
}
