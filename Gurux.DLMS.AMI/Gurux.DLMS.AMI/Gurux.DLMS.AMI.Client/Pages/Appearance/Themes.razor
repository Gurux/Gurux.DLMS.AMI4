@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable

<GXHelpContext Topic="Themes" />

@if (Active != null)
{
    <GXDialog OnCancel="Cancel"
            CancelButtonTitle="@Properties.Resources.Cancel"
            OkButtonTitle="@Properties.Resources.Ok"
            OnOk="Save">
        <ThemeEditor Action="@CrudAction.Update" Active="@Active" AvailableThemes="@AvailableThemes"></ThemeEditor>
    </GXDialog>
}

<GXViewTable ViewName="Appearance.Themes" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXAppearancePolicies.View })" TItem="GXAppearance" @ref="table"
             Context="item"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Single"
             Filter="@Filter"
             ShowAllUsers="false"
             ShowRemoved="false"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Enabled">
            @*Icon.*@
        </GXFh>
        <GXFh Id="Name">
            <GXSearch class="form-control"
                    placeholder="@Properties.Resources.FilterByName"
                    id="Resources"
                    Immediate="true"
                    RememberValue="true"
                    @bind-Value="@filter.Name"
                    @bind-Value:after="Updated" />
        </GXFh>
        <GXFh Id="CreationTime"></GXFh>
        <GXFh Id="Updated"></GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXAppearancePolicies.Edit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Enabled" TItem="GXAppearance"></GXTh>
        <GXTh Name="Name" Target="@item">@Properties.Resources.Name</GXTh>
        <GXTh Name="CreationTime" Target="@item">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Updated" Target="@item">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Enabled">
            @if (item.Enabled == true)
            {
                <div class="rounded-circle bg-success" style="width: 16px; height: 16px;"></div>
            }
        </GXTd>
        <GXTd Id="Name">
            <GXLinkButton TItem="GXAppearance" Target="@item" OnClick="@Edit" Text="@item.Name" />
        </GXTd>
        <GXTd Id="CreationTime">@item.CreationTime</GXTd>
        <GXTd Id="Updated">@item.Updated</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Enabled") { Position = 0, Description = "Enabled", Visibility = (byte)Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 2, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Updated") { Position = 3, Description = "Updated", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private GXValidator? _validator { get; set; }

    /// <summary>
    /// Available themes.
    /// </summary>
    [Parameter]
    public List<GXAppearance>? AvailableThemes { get; set; }

    /// <summary>
    /// Selected resource ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    GXAppearance? Active;

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return "Resources";
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "themes";
        }
    }

    /// <summary>
    /// Amount of the resources shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Resource filter.
    /// </summary>
    private GXAppearance filter = new GXAppearance()
    {
        ResourceType = (byte)ResourceType.Theme
    };

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXAppearance>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Appearance/Themes.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Themes.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingThemes);
            NotificationService?.RemoveByKey("Pages/Appearance/Themes.OnInitialized");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Themes.OnInitialized");
        }
    }

    private ValueTask<ItemsProviderResult<GXAppearance>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingThemes);
        try
        {
            if (AvailableThemes != null)
            {
                List<GXAppearance> list = AvailableThemes;
                if (!string.IsNullOrEmpty(filter.Name))
                {
                    string name = filter.Name.ToLowerInvariant();
                    list = AvailableThemes.Where(w => w.Name.ToLowerInvariant().Contains(name) ||
                            w.Description?.ToLower().Contains(name) == true).ToList();
                }
                return new(new ItemsProviderResult<GXAppearance>(list, list.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit theme.
    /// </summary>

    private void Edit(GXAppearance value)
    {
        Active = ClientHelpers.Clone<GXAppearance>(value);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Validate the object content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (Active != null)
        {
        }
    }

    /// <summary>
    /// Edit theme.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Appearance/Themes.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            Edit(table.Active);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Themes.OnEdit");
        }
    }

    /// <summary>
    /// Save theme.
    ///</summary>
    public async Task Save()
    {
        try
        {
            _validator?.ClearErrors();
            if (_validator != null &&
                !await _validator.ValidateAsync())
            {
                return;
            }
            UpdateAppearance req = new UpdateAppearance()
            {
                Appearances = [Active ?? throw new InvalidOperationException(Properties.Resources.NoAppearanceIsSelected)]
            };
            await Http.PostAsJson<UpdateAppearanceResponse>("api/Appearance/Update", req);
            Active = null;
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }


    /// <summary>
    /// Hide icon dlg.
    /// </summary>
    public void Cancel()
    {
        Active = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}

