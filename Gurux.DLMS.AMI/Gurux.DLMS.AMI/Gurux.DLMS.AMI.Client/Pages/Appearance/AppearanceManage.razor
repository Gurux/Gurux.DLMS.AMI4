@page "/config/appearance"
@page "/config/appearance/image"
@page "/config/appearance/theme"
@page "/config/appearance/iconpack"

@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs
@using System.Text.Json

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="AppearanceManage" />

@if (string.Compare(Action, "Add", true) == 0 ||
(Id != null && Path != null && string.Compare(Action, "Edit", true) == 0))
{
    @if (string.Compare(Path, "config/appearance/theme", true) == 0)
    {
        <Theme Action="@Action" Id="@Id"></Theme>
    }
    @if (string.Compare(Path, "config/appearance/iconpack", true) == 0)
    {
        <IconPack></IconPack>
    }
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="appearance" Active="@Path" SelectionChanged="@SelectionChanged">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.AppearanceTab" Parameters="@TabParameters" />
        </ChildContent>
    </GXTabControl>
}
<br />
@code {
    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Id"] = Id!,
        ["IconPacks"] = IconPacks!
    };

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();
    private bool _disposed;
    private IGXNotifier? Notifier;

    /// <summary>
    /// Appearance settings.
    /// </summary>
    internal GXConfiguration Configuration { get; set; } = new GXConfiguration()
    {
        Name = GXConfigurations.Appearance
    };

    IEnumerable<GXAppearance>? IconPacks;
    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string? Path { get; set; }

    protected override void OnParametersSet()
    {
        var path = NavigationManager.GetCurrentPagePath().Trim('/');
        Path = string.Equals(path, "config/appearance/image", StringComparison.OrdinalIgnoreCase)
            ? "config/appearance/Image" : path.ToLowerInvariant();
    }

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(GXTabPage page)
    {
        Path = page.Path;
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        if (Notifier == null)
        {
            return;
        }

        //Get active icon packs.
        ListAppearances req1 = new ListAppearances()
        {
            AllUsers = true,
            Filter = new()
            {
                ResourceType = (byte)ResourceType.Iconpack,
                Enabled = true
            }
        };
        var ret2 = await Http.PostAsJson<ListAppearancesResponse>("api/Appearance/List", req1);
        if (_disposed) {
            return;
        }
        if (ret2.Appearances != null)
        {
            IconPacks = ret2.Appearances;
        }

        //Get appereance settings.
        ListConfiguration req = new ListConfiguration()
        {
            Filter = new GXConfiguration()
            {
                Name = GXConfigurations.Appearance
            }
        };

        var ret = await Http.PostAsJson<ListConfigurationResponse>("api/Configuration/List", req);
        if (_disposed) {
            return;
        }
        if (ret?.Configurations?.Count() == 1)
        {
            Configuration = ret.Configurations.First();
        }
        Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
        {
            _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Appearance, configuration =>
            {
                Configuration = configuration;
                StateHasChanged();
            }, () => true, Services.GetService<IGXNotificationService>()));
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _configurationRefresh.Dispose();
        Notifier?.RemoveListener(this);
    }
}