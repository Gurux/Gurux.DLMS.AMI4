@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using System.Text.Json
@using System.Text

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ILogger<ImageEditor> logger

<GXHelpContext Topic="ImageEditor" />

@if (Active != null && ProfilePictureMode)
{
    @if (!string.IsNullOrEmpty(Active.Value))
    {
        <GXImage Value="@Active.Value" Width="160" Height="160" />
    }
    @if (!string.IsNullOrEmpty(Active.OriginalFileName))
    {
        <div class="form-text">@Active.OriginalFileName</div>
    }
    @if (Action != CrudAction.Delete)
    {
        <GXFileSelector TType="byte[]" MaxFileSize="1000000" OnLoaded="@UpdateImage"
                      Filter=".png,.jpg,.jpeg,.gif,.webp,.bmp,.ico" />
    }
}
else if (Active != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <PolicyTabs>
            <GeneralContent>
                <div class="row">
                    <div style="width:100%">
                        <div class="form-group">
                            <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                            <InputText id="description" disabled="@(Action == CrudAction.Delete)" @bind-Value="Active.Name" class="form-control" />
                        </div>
                        <GXImage Id="@Active.Name" Value="@Active.Value" Color="@_color"></GXImage>
                        @if (!string.IsNullOrEmpty(Active.OriginalFileName))
                        {
                            <div class="form-text">@Active.OriginalFileName</div>
                        }
                        <GXInputDropdown class="form-select"
                                         Id="image-imageType"
                                         RememberValue="true"
                                         ItemsProvider="@GetTypes"
                                         @bind-Value="ImageType">
                        </GXInputDropdown>
                        @if (ImageType == ImageType.Html)
                        {
                            <GXDropdownSearch class="form-control"
                                            Id="image-html"
                                            RememberValue="true"
                                            @bind-Value="_htmlSymbol"
                                            Formatter="@((HtmlSymbol e) => e.Description)"
                                            ItemsProvider="@GetHtmlItems">
                                <Template Context="it">
                                    <span>@((MarkupString)it.NumericCode)</span> @it.Description
                                </Template>
                            </GXDropdownSearch>
                            <GXColorSelector @bind-Value="@_color"></GXColorSelector>
                        }
                        else
                        @if (ImageType == ImageType.IconLigature)
                        {
                            <GXInputDropdown class="form-select"
                                             TValue="GXAppearance"
                                             Id="image-imageType"
                                             RememberValue="true"
                                             Items="@IconPacks"
                                             Formatter="@((e) => e?.Name)"
                                             OnSelected="@UpdateIcons"
                                             @bind-Value="_iconPack">
                            </GXInputDropdown>
                            <GXDropdownSearch @ref="_icons"
                                            TValue="(string, string)"
                                            class="form-control"
                                            Id="image-icon"
                                            RememberValue="true"
                                            @bind-Value="_icon"
                                            Formatter="@((e) => e.Item2)"
                                            ItemsProvider="@GetIcons">
                                <Template Context="it">
                                    <GXImage Value="@it.Item1"></GXImage> @it.Item2
                                </Template>
                            </GXDropdownSearch>
                            <GXColorSelector @bind-Value="@_color"></GXColorSelector>
                        }
                        else
                        {
                            <GXFileSelector TType="byte[]" Value="@_value"
                                          Style="width:100%"
                                          MaxFileSize="1000000"
                                          OnLoaded="@UpdateImage"
                                          Filter="image/*,.png,.jpg,.jpeg,.gif,.bmp,.ico,.svg" />
                        }
                        <div class="form-group">
                            <GXLocalizedText Value="@Properties.Resources.Priority" />
                            <GXInputNumber RememberValue="false" class="form-control" @bind-Value="Active.Priority" Min="@GXNumberBounds.Minimum(Active.Priority)" Max="@GXNumberBounds.Maximum(Active.Priority)" />
                            <div class="form-text"><GXLocalizedText Value="@Properties.Resources.PriorityControlsResourceOrdering" /></div>
                        </div>
                        <GXInputSwitch Text="@Properties.Resources.Preload" @bind-Value="Active.Preload" />
                        <label for="image-accessVisibility">@Properties.Resources.AccessVisibility</label>
                        <GXInputDropdown id="image-accessVisibility" class="form-select" @bind-Value="Active.AccessVisibility" RememberValue="false" Items="@(new ResourceVisibility?[] { ResourceVisibility.Inherit, ResourceVisibility.Private, ResourceVisibility.Internal, ResourceVisibility.Public })" Formatter="@(value => value switch { ResourceVisibility.Inherit => Properties.Resources.Inherit, ResourceVisibility.Private => Properties.Resources.Private, ResourceVisibility.Internal => Properties.Resources.Internal, _ => Properties.Resources.Public })" />

                        <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                                            Updated="@Active.Updated" @bind-Removed="Active.Removed" />
                        @if (Action == CrudAction.Delete)
                        {
                            <hr />
                            <p>
                            </p>
                            <div class="form-group">
                                <InputRadioGroup @bind-Value="DeleteTarget">
                                    <InputRadio Value="false">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDisableQuestion</label><br>
                                    <InputRadio Value="true">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDeleteQuestion</label>
                                </InputRadioGroup>
                                <br />
                            </div>
                        }
                    </div>
                </div>
            </GeneralContent>
            <PolicyContent>
                <Gurux.UI.Components.GXPolicyEditor @bind-Value="Active.Policies" Disabled="@(Action == CrudAction.Delete)" />
            </PolicyContent>
        </PolicyTabs>
    </EditForm>
}
@code {
    /// <summary>Shows only the file upload and preview for a profile picture.</summary>
    [Parameter] public bool ProfilePictureMode { get; set; }
    /// <summary>Notifies the host that image contents were edited.</summary>
    [Parameter] public EventCallback ImageChanged { get; set; }
    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }
    }

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    [Parameter]
    public GXAppearance? Active { get; set; }

    protected override void OnParametersSet()
    {
        if (Active != null && Active.Id == Guid.Empty && Active.AccessVisibility == null)
            {
            Active.AccessVisibility = ResourceVisibility.Private;
        }
    }

    GXInputDropdown<(string, string)>? _icons;
    private ImageType ImageType { get; set; }

    private GXAppearance? _iconPack { get; set; }

    private async Task UpdateIcons(GXAppearance e)
    {
        _icon = default!;
        if (Active != null)
        {
            Active.Value = null;
        }
        if (_icons != null)
        {
            await _icons.RefreshDataAsync();
        }
    }

    private string _color { get; set; } = "black";
    /// <summary>
    /// Available icon packs
    /// </summary>
    [Parameter]
    public IEnumerable<GXAppearance>? IconPacks { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public CrudAction Action { get; set; }

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }
    private bool DeleteTarget;
    private byte[]? _value { get; set; }

    private HtmlSymbol _htmlSymbol
    {
        get
        {
            HtmlSymbol? tmp = null;
            if (!string.IsNullOrEmpty(Active?.Value))
            {
                tmp = Symbols.Where(w => w.NumericCode == Active.Value).SingleOrDefault();
            }
            if (tmp == null)
            {
                tmp = Symbols[0];
            }
            return tmp;
        }
        set
        {
            if (Active != null)
            {
                Active.Value = value.NumericCode;
                Active.OriginalFileName = null;
                StateHasChanged();
            }
        }
    }


    private (string, string) _icon
    {
        get
        {
            (string, string) tmp = default;
            if (!string.IsNullOrEmpty(Active?.Value))
            {
                tmp = Icons.Where(w => w.Item1 == Active.Value).SingleOrDefault();
            }
            if (tmp == default)
            {
                tmp = Icons.FirstOrDefault();
            }
            return tmp;
        }
        set
        {
            if (Active != null)
            {
                Active.Value = value.Item1;
                Active.OriginalFileName = null;
                StateHasChanged();
            }
        }
    }

    public record HtmlSymbol(
        string Description,
        string NumericCode
    );

    private readonly List<HtmlSymbol> Symbols =
 [
    new("Registered trademark","&#174;"),
    new("Trademark","&#8482;"),
    new("Ampersand","&#38;"),
    new("Less-than sign","&#60;"),
    new("Greater-than sign","&#62;"),
    new("Euro sign","&#8364;"),
    new("Pound sign","&#163;"),
    new("Yen sign","&#165;"),

    new("Left arrow","&#8592;"),
    new("Right arrow","&#8594;"),
    new("Up arrow",   "&#8593;"),
    new("Down arrow", "&#8595;"),
    new("Left-right arrow","&#8596;"),
    new("Left double arrow", "&#8656;"),
    new("Right double arrow","&#8658;"),

    new("Black star", "&#9733;"),
    new("White star",        "&#9734;"),
    new("Black heart suit",  "&#9829;"),
    new("White heart",       "&#9825;"),
    new("Check mark",   "&#10003;"),
    new("Heavy check mark","&#10004;"),
    new("Ballot x",        "&#10007;"),
    new("Heavy ballot x",  "&#10008;"),
    new("White smiling face",      "&#9786;"),
    new("House building",         "&#x1F3E0;"),
    new("Magnifying glass",       "&#x1F50D;"),
    new("Envelope",               "&#9993;"),
    new("E-mail symbol",          "&#x1F4E7;"),
    new("Hamburger menu",         "&#9776;"),
    new("Gear",                   "&#9881;"),
    new("Wastebasket",            "&#x1F5D1;"),
    new("White heavy check mark", "&#x2705;")
 ];

    /// <summary>
    /// Get image types.
    /// </summary>
    private ValueTask<ItemsProviderResult<ImageType>> GetTypes(GXItemsProviderRequest request)
    {
        var list = new List<ImageType>();
        list.AddRange(Enum.GetValues<ImageType>());
        if (IconPacks?.Any() != true)
        {
            list.Remove(ImageType.IconLigature);
        }
        list.Remove(ImageType.Auto);
        return new(new ItemsProviderResult<ImageType>(list, list.Count));
    }

    /// <summary>
    /// Get Html items.
    /// </summary>
    private ValueTask<ItemsProviderResult<HtmlSymbol>> GetHtmlItems(GXItemsProviderRequest request)
    {
        var list = new List<HtmlSymbol>();
        int total = list.Count;
        if (!string.IsNullOrEmpty(request.Filter))
        {
            string filter = request.Filter.ToLower();
            foreach (var it in Symbols)
            {
                if (it.ToString().ToLower().Contains(filter))
                {
                    list.Add(it);
                }
            }
        }
        else
        {
            list.AddRange(Symbols);
        }
        return new(new ItemsProviderResult<HtmlSymbol>(list, Symbols.Count));
    }

    private readonly List<(string, string)> Icons = new();

    private ValueTask<ItemsProviderResult<(string, string)>> GetIcons(GXItemsProviderRequest request)
    {
        try
        {
            if (!string.IsNullOrEmpty(_iconPack?.Name))
            {
                Icons.Clear();
                Icons.AddRange(ClientHelpers.GetIconPackIcons(_iconPack.Name));
                IEnumerable<(string, string)> icons = Icons;
                int total = Icons.Count;
                if (!string.IsNullOrEmpty(request.Filter))
                {
                    icons = icons.Where(w => w.Item2.ToLower().Contains(request.Filter.ToLower()));
                }
                if (request.StartIndex != 0)
                {
                    icons = icons.Skip(request.StartIndex);
                }
                if (request.Count != 0)
                {
                    icons = icons.Take(request.Count);
                }
                else
                {
                    //Show max 10 icons if count is not defined.
                    icons = icons.Take(10);
                }
                if (_icon == default)
                {
                    //Select first icon when image pack is changed.
                    _icon = icons.FirstOrDefault();
                }
                return new(new ItemsProviderResult<(string, string)>(icons, total));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }


    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(Active?.Value))
        {
            //Update image type.
            ImageType = GXImage.DetectKind(Active?.Value);
        }
        base.OnAfterRender(firstRender);
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            //Update _htmlSymbol.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
    /// <summary>
    /// Get image from the file.
    /// </summary>
    /// <param name="value"></param>
    private async Task UpdateImage((byte[]? Value, string FileName) loaded)
    {
        var (value, fileName) = loaded;
        if (Active != null && value != null)
        {
            Active.OriginalFileName = fileName;
            string ext = Path.GetExtension(fileName);
            if (string.Equals(ext, ".svg", StringComparison.OrdinalIgnoreCase))
            {
                Active.Value = ASCIIEncoding.UTF8.GetString(value);
            }
            else
            {
                Active.Value = Convert.ToBase64String(value);
            }
            await ImageChanged.InvokeAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Save resource.
    /// </summary>
    public async void OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingImageEditor);
            NotificationService?.RemoveByKey("Pages/Appearance/ImageEditor.OnSave");
            if (Action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAppearanceResponse>("api/Appearance/Delete", new RemoveAppearance()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (Action == CrudAction.Create)
                {
                    address = "api/Appearance/Add";
                }
                else if (Action == CrudAction.Update)
                {
                    address = "api/Appearance/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                var ret = await Http.PostAsJson<UpdateAppearanceResponse>(address, new UpdateAppearance()
                { Appearances = new List<GXAppearance>() { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/ImageEditor.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}

