@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using System.Text.Json
@using System.Text

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<GXHelpContext Topic="IconPackEditor" />

@if (Active != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Active.Enabled" Disabled="@(Action == CrudAction.Delete)" />
                </div>
                <div class="form-group">
                    <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                    <InputText id="iconpack-id" disabled="@(Action == CrudAction.Delete)" @bind-Value="Active.Name" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="iconpack-description">@Properties.Resources.Description</label>
                    <InputTextArea id="iconpack-description" class="form-control" @bind-Value="Active.Description"
                                   disabled="@(Action == CrudAction.Delete)" />
                </div>
                <div class="form-group">
                    <label for="iconpack-url"><GXLocalizedText Value="@Properties.Resources.CSSURL" /></label>
                    <InputText id="iconpack-url" class="form-control" @bind-Value="Active.Value"
                               placeholder="@Properties.Resources.LibBootstrapIconsBootstrapIconsMinCss"
                               disabled="@(Action == CrudAction.Delete)" />
                </div>
                <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                      Updated="@Active.Updated" @bind-Removed="Active.Removed" />
            </div>
        </div>
    </EditForm>
}
@code {
    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    [Parameter]
    public GXAppearance? Active { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public CrudAction Action { get; set; }

    /// <summary>
    /// Save resource.
    /// </summary>
    public async void OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingIconPackEditor);
            NotificationService?.RemoveByKey("Pages/Appearance/IconPackEditor.OnSave");
            if (Action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAppearanceResponse>("api/Appearance/Delete", new RemoveAppearance()
                {
                    Ids = new Guid[] { Active.Id },
                });
            }
            else
            {
                string address;
                if (Action == CrudAction.Create)
                {
                    address = "api/Appearance/Add";
                }
                else if (Action == CrudAction.Update)
                {
                    address = "api/Appearance/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                var ret = await Http.PostAsJson<UpdateAppearanceResponse>(address, new UpdateAppearance()
                { Appearances = new List<GXAppearance>() { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/IconPackEditor.OnSave");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}

