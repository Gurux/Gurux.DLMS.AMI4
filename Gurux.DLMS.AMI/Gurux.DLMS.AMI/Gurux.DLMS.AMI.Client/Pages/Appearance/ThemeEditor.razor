@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using System.Text.Json
@using System.Text

@inject NavigationManager NavigationManager
@inject IGXNotificationService NotificationService
@inject HttpClient Http
@inject IGXProgress Progress

@inject IJSRuntime JSRuntime

<GXHelpContext Topic="ThemeEditor" />

@if (Active != null && _settings != null)
{
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            <GXLocalizedText Value="@context.Text" />
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.ThemeEditorTab" Parameters="@TabParameters" />
        </ChildContent>
    </GXTabControl>
}
@code {
    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active!,
        ["Action"] = Action,
        ["Settings"] = _settings!
    };


    [Parameter]
    public GXAppearance? Active { get; set; }

    GXThemeInfo? _settings;
    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public CrudAction Action { get; set; }

    /// <summary>
    /// Available themes.
    /// </summary>
    [Parameter]
    public List<GXAppearance> AvailableThemes { get; set; } = default!;

    /// <summary>
    /// Save resource.
    /// </summary>
    public async void OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Active.Value = JsonSerializer.Serialize(_settings);
            using (Progress.ProgressStart(GXProgress.SavingThemeEditor))
            {
                if (Action == CrudAction.Delete)
                {
                    await Http.PostAsJson<RemoveAppearanceResponse>("api/Appearance/Delete", new RemoveAppearance()
                    {
                        Ids = new Guid[] { Active.Id },
                    });
                }
                else
                {
                    string address;
                    if (Action == CrudAction.Create)
                    {
                        address = "api/Appearance/Add";
                    }
                    else if (Action == CrudAction.Update)
                    {
                        address = "api/Appearance/Update";
                    }
                    else
                    {
                        throw new Exception(Properties.Resources.InvalidTarget);
                    }
                    var ret = await Http.PostAsJson<UpdateAppearanceResponse>(address, new UpdateAppearance()
                    { Appearances = new List<GXAppearance>() { Active } });
                }
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Active?.Value != null)
        {
            _settings = JsonSerializer.Deserialize<GXThemeInfo>(Active.Value);
        }
        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}


