@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@implements IDisposable

<GXHelpContext Topic="Images" />

@if (Active != null)
{
    <GXDialog OnCancel="Cancel"
            CancelButtonTitle="@Properties.Resources.Cancel"
            OkButtonTitle="@Properties.Resources.Ok"
            OnOk="Save">
        <ImageEditor Action="@CrudAction.Update" Active="@Active"
                     IconPacks="@IconPacks"></ImageEditor>
    </GXDialog>
}
<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Id="Run" Text="@Properties.Resources.Refresh" OnClick="@OnRefresh" Policy="@GXAppearancePolicies.Edit" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Appearance.Images" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXAppearancePolicies.View })" TItem="GXAppearance" @ref="table"
             Context="resource"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Single"
             Filter="@Filter"
             ShowAllUsers="false"
             ShowRemoved="false"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Image">
            @*
                Image
            *@
        </GXFh>
        <GXFh Id="Name">
            <GXSearch class="form-control"
                    placeholder="@Properties.Resources.FilterByName"
                    id="Resources"
                    Immediate="true"
                    RememberValue="true"
                    @bind-Value="@filter.Name"
                    @bind-Value:after="Updated" />
        </GXFh>
        <GXFh Id="ResourceType"></GXFh>
        <GXFh Id="Updated"></GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXAppearancePolicies.Edit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Image" TItem="GXAppearance" width="1%"></GXTh>
        <GXTh Name="Name" Target="@resource">@Properties.Resources.Name</GXTh>
        <GXTh Name="ResourceType" Target="@resource">@Properties.Resources.Type</GXTh>
        <GXTh Name="Updated" Target="@resource">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Image" class="img-cell">
            @if (!string.IsNullOrEmpty(resource.Name))
            {
                <GXImage Id="@resource.Name" Value="@resource.Value" Width="24" Height="24" Color="black"></GXImage>
            }
        </GXTd>
        <GXTd Id="Name"><GXLinkButton TItem="GXAppearance" Target="@resource" OnClick="@Edit" Text="@resource.Name" /></GXTd>
        <GXTd Id="ResourceType">@((ResourceType?)resource.ResourceType)</GXTd>
        <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(resource.Updated)</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Image") { Position = 0, Description = "Image", Visibility = (byte)Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("ResourceType") { Position = 2, Description = "Type", Visibility = (byte)Visibility.All },
        new("Updated") { Position = 3, Description = "Updated", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private GXValidator? _validator { get; set; }
    /// <summary>
    /// Available icon packs
    /// </summary>
    [Parameter]
    public IEnumerable<GXAppearance>? IconPacks { get; set; }

    /// <summary>
    /// Selected resource ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    GXAppearance? Active;

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return "Images";
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "images";
        }
    }

    /// <summary>
    /// Amount of the resources shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Resource filter.
    /// </summary>
    private GXAppearance filter = new GXAppearance()
    {
        ResourceType = (byte)ResourceType.Image
    };

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXAppearance>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Appearance/Images.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Images.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingImages);
            NotificationService?.RemoveByKey("Pages/Appearance/Images.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXAppearancePolicies.Add ||
                        it.Type == GXAppearancePolicies.Edit ||
                        it.Type == GXAppearancePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXAppearance() { Id = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Images.OnInitializedAsync");
        }
    }

    private async ValueTask<ItemsProviderResult<GXAppearance>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingImages);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }

            ListAppearances req = new ListAppearances()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListAppearancesResponse>("api/Appearance/List", req, request.CancellationToken);
            if (ret.Appearances != null)
            {
                return new ItemsProviderResult<GXAppearance>(ret.Appearances, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Refresh system resources.
    /// </summary>
    public async void OnRefresh()
    {
        using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingImage);
        NotificationService?.RemoveByKey("Pages/Appearance/Images.regenerate");
        try
        {
            RegenerateAppearance req = new RegenerateAppearance()
            {
                Type = (int)ResourceType.Image
            };
            var ret = await Http.PostAsJson<RegenerateAppearanceResponse>("api/appearance/regenerate", req);
            if (ret.NewItems)
            {
                await Updated();
            }
            //Update all icons to the local storage.
            NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.Updated, string.Empty, Closable: true));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Images.OnRefresh");
        }
    }

    /// <summary>
    /// Edit image.
    /// </summary>

    private void Edit(GXAppearance value)
    {
        Active = ClientHelpers.Clone<GXAppearance>(value);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Validate the object content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (Active != null)
        {
        }
    }

    /// <summary>
    /// Edit image.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Appearance/Images.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            Edit(table.Active);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Appearance/Images.OnEdit");
        }
    }

    /// <summary>
    /// Save icon.
    ///</summary>
    public async Task Save()
    {
        try
        {
            _validator?.ClearErrors();
            if (_validator != null &&
                !await _validator.ValidateAsync())
            {
                return;
            }
            UpdateAppearance req = new UpdateAppearance()
            {
                Appearances = [Active ?? throw new InvalidOperationException(Properties.Resources.NoAppearanceIsSelected)]
            };
            await Http.PostAsJson<UpdateAppearanceResponse>("api/Appearance/Update", req);
            Active = null;
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }


    /// <summary>
    /// Hide icon dlg.
    /// </summary>
    public void Cancel()
    {
        Active = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

