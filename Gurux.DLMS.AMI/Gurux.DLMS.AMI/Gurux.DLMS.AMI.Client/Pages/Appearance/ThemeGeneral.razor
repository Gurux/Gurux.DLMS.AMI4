@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Enums
@using System.Text.Json

@if (Active != null && Settings != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <PolicyTabs>
            <GeneralContent>
                <div class="row">
                    <div style="width:100%">
                        <div class="form-group">
                            <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Active.Enabled" />
                        </div>
                        <div class="form-group">
                            <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                            <InputText id="theme-id" disabled="@(Action == CrudAction.Delete)" @bind-Value="Active.Name" class="form-control" />
                        </div>
                        <div class="form-group">
                            <GXCopyButton Value="@Settings.CssFile">@Properties.Resources.Url</GXCopyButton>
                            <InputText id="theme-url" @bind-Value="Settings.CssFile" @bind-Value:after="UpdateThemeValue" class="form-control" />
                        </div>
                        <div class="form-group">
                            <GXLocalizedText Value="@Properties.Resources.Priority" />
                            <GXInputNumber RememberValue="false" class="form-control" @bind-Value="Active.Priority" Min="@GXNumberBounds.Minimum(Active.Priority)" Max="@GXNumberBounds.Maximum(Active.Priority)" />
                            <div class="form-text"><GXLocalizedText Value="@Properties.Resources.HigherPriorityThemesArePreferredWhenSeveralAreAvailable" /></div>
                        </div>
                        <GXInputSwitch Text="@Properties.Resources.Preload" @bind-Value="Active.Preload" />

                        <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                                            Updated="@Active.Updated" @bind-Removed="Active.Removed" />
                    </div>
                </div>
            </GeneralContent>
            <PolicyContent>
                <Gurux.UI.Components.GXPolicyEditor @bind-Value="Active.Policies" Disabled="@(Action == CrudAction.Delete)" />
            </PolicyContent>
        </PolicyTabs>
    </EditForm>
}
@code {
    /// <summary>The theme being edited.</summary>
    [Parameter, EditorRequired]
    public GXAppearance? Active { get; set; }

    /// <summary>The theme settings shared with the saving editor.</summary>
    [Parameter, EditorRequired]
    public GXThemeInfo? Settings { get; set; }

    /// <summary>The current editor action.</summary>
    [Parameter]
    public CrudAction Action { get; set; }

    private void UpdateThemeValue()
    {
        if (Active != null)
        {
            Active.Value = JsonSerializer.Serialize(Settings);
        }
    }
}

