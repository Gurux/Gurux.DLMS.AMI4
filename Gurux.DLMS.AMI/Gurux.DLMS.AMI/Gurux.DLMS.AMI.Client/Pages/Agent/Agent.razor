@page "/Agent/{Id:guid?}"
@page "/Agent/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs

@using Gurux.DLMS.AMI.Module
@using System.Text.Json
@using System.Text.Encodings.Web
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="Agent" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXTabIcon Id="@context.Icon" Color="@context.IconColor" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.AgentDetailsTab" Parameters="@TabParameters" />
            }
            <ModuleViews Area="AmiViewArea.Agent" Target="@Active" Parameters="@TabParameters" />
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
<ModuleViews Area="AmiViewArea.Agent" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action;

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXAgent Active = new GXAgent(null);
    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        _action = ClientHelpers.GetAction(NavigationManager, Action);
        try
        {
            switch (_action)
            {
                case CrudAction.Create:
                    Title = Properties.Resources.Add;
                    break;
                case CrudAction.Update:
                    Title = Properties.Resources.Edit;
                    break;
                case CrudAction.Delete:
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Agent;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgent);
            NotificationService?.RemoveByKey("Pages/Agent/AgentTab.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get agent data.
                var tmp = (await Http.GetAsJsonAsync<GetAgentResponse>(string.Format("api/Agent?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            SetEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentTab.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    public bool DeleteTarget { get; set; }
    private void SetEditorMenu()
    {
        InitializeSettings();
        _editorMenu = new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active, _action, OnSave, () => { OnCancel(); return Task.CompletedTask; });
    }
    public void Dispose() => _editorMenu?.Dispose();
    private bool ValidateSettings()
    {
        bool valid = true;
        void Error(string field, string message) { valid = false; _editorMenu?.AddValidationError(field, message); }
        if (string.IsNullOrEmpty(Active.Name)) {
            Error(nameof(Active.Name), Properties.Resources.InvalidName);
        }
        if (ReaderSettings?.Enabled == true)
        {
            if (ReaderSettings.Threads < 1 || ReaderSettings.Threads > 10000) {
                Error(nameof(Active.ReaderSettings), Properties.Resources.InvalidThreadsAmount);
            }
            if (ReaderSettings.AliveTime < 1) {
                Error(nameof(Active.ReaderSettings), Properties.Resources.InvalidAliveTime);
            }
        }
        if (RawNotificationSettings?.Enabled == true)
        {
            if (RawNotificationSettings.Threads < 1) {
                Error(nameof(Active.RawNotificationSettings), Properties.Resources.TheNumberOfRawNotificationWorkersMustBeGreaterThanZero);
            }
            if (RawNotificationSettings.ScriptMethod == null || RawNotificationSettings.ScriptMethod == Guid.Empty) {
                Error(nameof(Active.RawNotificationSettings), Properties.Resources.SelectARawNotificationParserScript);
            }
        }
        void Network(string? mediaType, string? settings, string field)
        {
            if (mediaType != typeof(Gurux.Net.GXNet).FullName) {
                return;
            }
            using var net = new Gurux.Net.GXNet();
            try { net.Settings = settings; } catch { }
            if (net.Port == 0) {
                Error(field, Properties.Resources.InvalidPort);
            }
        }
        if (NotificationSettings?.Enabled == true)
        {
            if (NotificationSettings.ExpirationTime < 0) {
                Error(nameof(Active.NotifySettings), Properties.Resources.InvalidExpirationTime);
            }
            Network(NotificationSettings.MediaType, NotificationSettings.MediaSettings, nameof(Active.NotifySettings));
        }
        if (ListenerSettings?.Enabled == true)
        {
            if (ListenerSettings.ExpirationTime < 0) {
                Error(nameof(Active.ListenerSettings), Properties.Resources.InvalidExpirationTime);
            }
            Network(ListenerSettings.MediaType, ListenerSettings.MediaSettings, nameof(Active.ListenerSettings));
        }
        if (GatewaySettings?.Enabled == true)
        {
            if (GatewaySettings.ExpirationTime < 0) {
                Error(nameof(Active.GatewaySettings), Properties.Resources.InvalidExpirationTime);
            }
            Network(typeof(Gurux.Net.GXNet).FullName, GatewaySettings.MediaSettings, nameof(Active.GatewaySettings));
            if (GatewaySettings.Id == null && GatewaySettings.ScriptMethod == null) {
                Error(nameof(Active.GatewaySettings), Properties.Resources.GatewayMustBeSelected);
            }
        }
        return valid;
    }
    public ReaderSettings? ReaderSettings { get; set; }
    public NotifySettings? NotificationSettings { get; set; }
    public RawNotificationSettings? RawNotificationSettings { get; set; }
    public ListenerSettings? ListenerSettings { get; set; }
    public GatewaySettings? GatewaySettings { get; set; }

    private void InitializeSettings()
    {
        if (!string.IsNullOrEmpty(Active?.ReaderSettings))
        {
            ReaderSettings = JsonSerializer.Deserialize<ReaderSettings>
                (Active.ReaderSettings);
        }
        else
        {
            ReaderSettings = new ReaderSettings();
        }
        if (!string.IsNullOrEmpty(Active?.NotifySettings))
        {
            NotificationSettings = JsonSerializer.Deserialize<NotifySettings>
                (Active.NotifySettings);
        }
        else
        {
            NotificationSettings = new NotifySettings();
        }
        RawNotificationSettings = string.IsNullOrEmpty(Active?.RawNotificationSettings)
            ? new RawNotificationSettings()
            : JsonSerializer.Deserialize<RawNotificationSettings>(Active.RawNotificationSettings) ?? new RawNotificationSettings();
        if (!string.IsNullOrEmpty(Active?.ListenerSettings))
        {
            ListenerSettings = JsonSerializer.Deserialize<ListenerSettings>
                (Active.ListenerSettings);
        }
        else
        {
            ListenerSettings = new ListenerSettings();
        }
        if (!string.IsNullOrEmpty(Active?.GatewaySettings))
        {
            GatewaySettings = JsonSerializer.Deserialize<GatewaySettings>
                (Active.GatewaySettings);
        }
        else
        {
            GatewaySettings = new GatewaySettings();
        }
    }
    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !ValidateSettings())
            {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingAgent);
            NotificationService?.RemoveByKey("Pages/Agent/Agent.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAgentResponse>
                    ("api/Agent/Delete", new RemoveAgent()
                    {
                        Ids = new Guid[] { Active.Id },
                        Delete = DeleteTarget
                    });
            }
            else
            {
                //This is needed to serialize special chars.
                var options = new JsonSerializerOptions
                {
                    Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                };
                Active.ReaderSettings = JsonSerializer.Serialize(ReaderSettings, options);
                Active.NotifySettings = JsonSerializer.Serialize(NotificationSettings, options);
                Active.RawNotificationSettings = JsonSerializer.Serialize(RawNotificationSettings, options);
                Active.ListenerSettings = JsonSerializer.Serialize(ListenerSettings, options);
                if (GatewaySettings != null)
                {
                    GatewaySettings.MediaSettings = GatewaySettings.MediaSettings?.Trim();
                }
                Active.GatewaySettings = JsonSerializer.Serialize(GatewaySettings, options);

                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/Agent/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/Agent/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateAgentResponse>
                    (address, new UpdateAgent()
                    {
                        Agents = new GXAgent[] { Active }
                    }
                    );
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/Agent.OnSave");
        }
    }
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}
