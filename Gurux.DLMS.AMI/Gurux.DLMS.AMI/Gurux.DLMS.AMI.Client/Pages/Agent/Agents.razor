@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/agents"
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.ComponentModel;
@using System.ComponentModel.DataAnnotations

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent

<GXHelpContext Topic="Agents" />

@if (Menu)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Update" Id="Update" OnClick="@OnUpdateVersion" Policy="@GXAgentPolicies.Edit" />
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXAgentPolicies.Add" />
            <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXAgentPolicies.Delete" />
        </ChildContent>
    </GXMenuControl>
}

<GXViewTable ViewName="Agent.Agents" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXAgentPolicies.View })" TItem="GXAgent" @ref="table"
             @bind-Active="Active"
             Context="agent"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             Total="@Total"
             Menu="@Menu"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="agents-creationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Detected">
            <GXDateTimeSelector Id="agents-detected"
                                @bind-Value="@filter.Detected"
                                Placeholder="@Properties.Resources.FilterByDetected">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Status">
            @*Status*@
            <EnumTypeSelector Type="@TargetType.AgentStatus"
                              TItem="AgentStatus?"
                              @bind-Value="@filter.Status"
                              OnSelected="@((AgentStatus? e) => Updated())">
            </EnumTypeSelector>

        </GXFh>
        <GXFh Id="Version">
            <input class="form-control" placeholder="@Properties.Resources.FilterByVersion"
                   type="text"
                   @onchange="@((ChangeEventArgs __e) => filter.Version = Convert.ToString(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXAgentPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Update" Id="update" OnClick="@OnUpdateVersion" Policy="@GXAgentPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXAgentPolicies.Delete"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="Name" Target="@agent">@Properties.Resources.Name</GXTh>
        <GXTh Name="CreationTime" Target="@agent" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Detected" Target="@agent">@Properties.Resources.Detected</GXTh>
        <GXTh Name="Status" Target="@agent">@Properties.Resources.Status</GXTh>
        <GXTh Name="Version" Target="@agent">@Properties.Resources.Version</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Agent/Edit/" + agent.Id)"><span class=@(ClientHelpers.GetActiveDot(agent.Enabled))></span>@agent.Name</GXTd>
        <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(agent.CreationTime)</GXTd>
        <GXTd Id="Detected">@GetConnectionInformation(agent)</GXTd>
        <GXTd Id="Status">@(agent.Status is { } status ? ResourceStorage.GetEnumType(TargetType.AgentStatus, status) : null)</GXTd>
        @if (IsNewVersionAvailable(agent))
        {
            <GXTd Id="Version">
                <GXTooltip Title=@string.Format("Version {0} is available.", agent.AvailableVersion)>
                    @GetVersion(agent.Version)
                    <span class="Version" aria-hidden="true"></span>
                </GXTooltip>
            </GXTd>
        }
        else
        {
            <GXTd Id="Version">@GetVersion(agent.Version)</GXTd>
        }
    </ItemContent>
</GXViewTable>
<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Detected") { Position = 2, Description = "Detected", Visibility = (byte)Visibility.All },
        new("Status") { Position = 3, Description = "Status", Visibility = (byte)Visibility.All },
        new("Version") { Position = 4, Description = "Version", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected agent ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }
    private GXAgent? Active { get; set; }

    private bool IsNewVersionAvailable(GXAgent agent)
    {
        if (string.IsNullOrEmpty(agent.Version) ||
            !string.IsNullOrEmpty(agent.UpdateVersion) ||
            agent.Version == agent.AvailableVersion)
        {
            return false;
        }
        return true;
    }

    private string? GetConnectionInformation(GXAgent agent)
    {
        if (agent.Detected != null)
        {
            return string.Format(Properties.Resources.ConnectionInformationFormat, ResourceStorage.DateTimeOffsetToString(agent.Detected.Value), agent.ConnectionInfo);
        }
        return null;
    }
    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Agents;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "agents";
        }
    }

    /// <summary>
    /// Amount of the agents shown on the view.
    /// </summary>
    [Parameter]
    [Display(Name = "AmountOfTheRowsShownOnTheView", ResourceType = typeof(Properties.Resources))]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    [Display(Name = "ShowFilter", ResourceType = typeof(Properties.Resources))]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Show total count.
    /// </summary>
    [Parameter]
    [Display(Name = "ShowTotal", ResourceType = typeof(Properties.Resources))]
    public bool Total { get; set; } = true;

    /// <summary>
    /// Is menu shown.
    /// </summary>
    [Parameter]
    [Display(Name = "ShowMenu", ResourceType = typeof(Properties.Resources))]
    public bool Menu { get; set; } = true;

    private string? GetVersion(string? version)
    {
        if (version == null)
        {
            return Properties.Resources.CustomBuild;
        }
        return version;
    }

    /// <summary>
    /// Agent filter.
    /// </summary>
    private GXAgent filter = new GXAgent(null)
    {
        Template = false
    };


    //Verify that agent can be updated.

    /// <summary>
    /// Reference to the table.
    /// </summary>
    private GXTable<GXAgent>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    /// <returns></returns>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Agent/Agents.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/Agents.Updated");
        }
    }

    /// <summary>
    /// Agent status has changed.
    /// </summary>
    /// <param name="agent">Changed agent.</param>
    protected void StateChanged(IEnumerable<GXAgent> list)
    {
        try
        {
            if (table != null && table.Items != null)
            {
                foreach (var agent in list)
                {
                    foreach (var it in table.Items)
                    {
                        if (it.Id == agent.Id)
                        {
                            it.Status = agent.Status;
                            if (agent.Detected != null)
                            {
                                it.Detected = agent.Detected;
                            }
                            if (agent.AvailableVersion != null)
                            {
                                it.AvailableVersion = agent.AvailableVersion;
                            }
                            break;
                        }
                    }
                }
                InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/Agent/Agents.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXAgentPolicies.Add ||
                        it.Type == GXAgentPolicies.Edit ||
                        it.Type == GXAgentPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXAgent() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/Agents.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXAgent>> GetItems(GXItemsProviderRequest request)
    {
        try
        {
            //Don't clear status or error is lost.
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgents);
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }

            ListAgents req = new ListAgents()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.AgentStatus);
            var ret = await Http.PostAsJson<ListAgentsResponse>("api/Agent/List", req, request.CancellationToken);
            if (ret.Agents != null)
            {
                ItemsProviderResult<GXAgent> value = new ItemsProviderResult<GXAgent>(ret.Agents, ClientHelpers.ToVirtualizedCount(ret.Count));
                return value;
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Update the selected agents to the new version.
    /// </summary>
    public async Task OnUpdateVersion()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmUpdate, Properties.Resources.AgentUpdates,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Update,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnUpdateConfirmation(confirmation);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Update the agent.
    /// </summary>
    public async Task OnUpdateConfirmation(AmiConfirmationResult args)
    {
        if (table != null && args.Confirm)
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.UpdatingAgents);
            NotificationService?.RemoveByKey("Pages/Agent/Agents.OnUpdateConfirmation");
            try
            {
                //Version to update.
                List<GXAgent> agents = new List<GXAgent>();
                foreach (var it in table.SingleOrDefault())
                {
                    agents.Add(new GXAgent()
                    {
                        Id = it.Id,
                        UpdateVersion = it.AvailableVersion,
                        ConcurrencyStamp = it.ConcurrencyStamp
                    });
                }
                InstallAgent req = new InstallAgent()
                {
                    Agents = agents
                };
                await Http.PostAsJson<InstallAgentResponse>("api/agent/Install", req);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex, "Pages/Agent/Agents.OnUpdateConfirmation");
            }
        }
    }

    /// <summary>
    /// Add new agent.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/AgentAdd");
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit agent.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Agent/Agents.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Agent/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/Agents.OnEdit");
        }
    }

    /// <summary>
    /// Delete selected agents.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Remove the agent(s).
    /// </summary>
    /// <param name="args">Confirm arguments.</param>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                await Http.PostAsJson<RemoveAgentResponse>("api/Agent/Delete",
                    new RemoveAgent()
                    {
                        Delete = args.Delete,
                        Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                    });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
