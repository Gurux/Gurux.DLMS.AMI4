@page "/AgentGroup/{Id:guid?}"
@page "/AgentGroup/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Device
@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="AgentGroup" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.AgentGroupTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    private CrudAction _action;
    /// <summary>
    /// Active item.
    /// </summary>
    public GXAgentGroup Active = new GXAgentGroup(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        _action = ClientHelpers.GetAction(NavigationManager, Action);
        try
        {
            switch (_action)
            {
                case CrudAction.Create:
                    Title = Properties.Resources.Add;
                    break;
                case CrudAction.Update:
                    Title = Properties.Resources.Edit;
                    break;
                case CrudAction.Delete:
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.AgentGroup;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgentGroup);
            NotificationService?.RemoveByKey("Pages/Agent/AgentGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get agent group data.
                var tmp = (await Http.GetAsJsonAsync<GetAgentGroupResponse>(string.Format("api/AgentGroup?Id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            SetEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentGroup.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    public bool DeleteTarget { get; set; }
    private void SetEditorMenu() { _editorMenu = new GXEditorMenu(SharedMenuService); _editorMenu.Set(Active, _action, OnSave, () => { OnCancel(); return Task.CompletedTask; }); }
    public void Dispose() => _editorMenu?.Dispose();
    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !GXEditContexts.For(Active).Validate()) {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingAgentGroup);
            NotificationService?.RemoveByKey("Pages/Agent/AgentGroup.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveAgentGroupResponse>("api/AgentGroup/Delete", new RemoveAgentGroup()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/AgentGroup/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/AgentGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddAgentGroupResponse>(address, new AddAgentGroup() { AgentGroups = new GXAgentGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentGroup.OnSave");
        }
    }
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}


