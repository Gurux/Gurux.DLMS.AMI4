@page "/Agent/Logs"
@page "/Agent/Groups"
@page "/Agent"
@page "/AgentGroup"
@page "/AgentLog/{Id:guid?}"
@page "/AgentLog/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable

@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="AgentManage" />

@if (Path != null && string.Compare(Action, "Add", true) == 0 || (Id != null && string.Compare(Action, "Edit", true) == 0))
{
    @if (string.Compare(Path, "AgentGroup", true) == 0)
    {
        <AgentGroup Action="@Action" Id="@Id"></AgentGroup>
    }
    else if (string.Compare(Path, "Agent", true) == 0)
    {
        @if (string.Compare(Action, "Add", true) == 0)
        {
            <AgentAdd></AgentAdd>
        }
        else
        {
            <Agent Action="@Action" Id="@Id"></Agent>
        }
    }
    else if (string.Compare(Path, "AgentLog", true) == 0)
    {
        <AgentLog Action="@Action" Id="@Id"></AgentLog>
    }
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="Agent" Active="@Path" SelectionChanged="@SelectionChanged">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
        <GXLocalizedText Value="@context.Text" />        
            <GXBadge Value="@context.PadgeCount" Label="@context.Padge"
                   TraceLevel="@context.PadgeType">
            </GXBadge>
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.AgentTab"></TabHeader>
        </ChildContent>
    </GXTabControl>
}
<br />
@code {
    protected override void OnParametersSet()
    {
        Path = GXTabRoutes.Active(NavigationManager, "Agent", 0, Path);
    }

    private IGXNotifier2? Notifier;

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string? Path { get; set; }

    /// <summary>
    /// Stamp.
    /// </summary>
    private GXUserStamp _log = new GXUserStamp();

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(GXTabPage page)
    {
        Path = page.Path;
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        if (Notifier == null)
        {
            return;
        }

        //Get selected tab from the url.
        Path = GXTabRoutes.Active(NavigationManager, "Agent", 0, Path);
        _log = Notifier?.GetUserStamps(TargetType.AgentLog) ?? new GXUserStamp { TargetType = TargetType.AgentLog };
        Notifier?.On<IEnumerable<GXUserStamp>>(this, nameof(IGXHubEvents.StampUpdate), (stamps) =>
        {
            bool updated = false;
            foreach (var it in stamps)
            {
                if (it.TargetType == TargetType.AgentLog)
                {
                    updated = true;
                }
            }
            if (updated)
            {
                InvokeAsync(StateHasChanged);
            }
        });
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}



