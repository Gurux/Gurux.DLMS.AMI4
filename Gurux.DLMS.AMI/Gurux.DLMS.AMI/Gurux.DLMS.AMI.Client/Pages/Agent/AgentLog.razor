@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="AgentLog" />

@if (_active != null)
{
    <EditForm EditContext="@GXEditContexts.For(_active)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXCopyButton Value="@_active.Message">@Properties.Resources.Name</GXCopyButton>
                    <InputText id="name" disabled="disabled" @bind-Value="_active.Message" class="form-control" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.ErrorSeverityLevel</label>
                    <input type="text" id="level" disabled="disabled"
                           value="@ClientHelpers.LevelToString(_active.Level)" class="form-control" />
                </div>
                @if (_active.Creator != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.Agent</label>
                        <LogCreatorLabel Creator="@_active.Creator" Resource="Agent" Property="Name" class="form-control" />
                    </div>
                }
                <GXBrowserErrorLog Entry="@_active" />
                @if (_active.CreationTime != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.CreationTime</label>
                        <InputDate Type="@InputDateType.DateTimeLocal" id="generation" readonly="readonly" class="form-control"
                                   @bind-Value="_active.CreationTime" />
                    </div>
                }
                @if (_active.Closed != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.Closed</label>
                        <InputDate Type="@InputDateType.DateTimeLocal" id="generation" readonly="readonly" class="form-control"
                                   @bind-Value="_active.Closed" />
                    </div>
                }
            </div>
        </div>
    </EditForm>
}
@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private GXLog? _active;

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgentLog);
            NotificationService?.RemoveByKey("Pages/Agent/AgentLog.OnInitializedAsync");
            //Get selected item.
            if (Id == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem()
            {
                Text = Properties.Resources.Close,
                Icon = "Close",
                OnClick = EventCallback.Factory.Create(this, OnCancel)
            });
            //Read agent log item.
            HttpResponseMessage response = await Http.GetAsync(string.Format("api/Log?source=agent&id={0}", Id));
            await response.EnsureSuccessAsync(default);
            _active = (await response.Content.ReadFromJsonAsync<GetLogResponse>())?.Item;
            if (_active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentLog.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Cancel.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        MenuService.Dispose();
    }
}
