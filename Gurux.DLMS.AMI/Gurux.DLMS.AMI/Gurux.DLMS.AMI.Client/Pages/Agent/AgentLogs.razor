@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/AgentLogs"
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="AgentLogs" />

@if (Title)
{
    <PageTitle>@Properties.Resources.AgentLogs (@Properties.Resources.Total: @Total)</PageTitle>
}
<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Close" Id="Close" OnClick="@OnClose" Policy="@GXAgentLogPolicies.Close" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXAgentLogPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Agent.AgentLogs" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXAgentLogPolicies.View })" TItem="GXLog" @ref="table"
             Context="error"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             Filter="@Filter"
             ShowAllUsers="@Header"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="AgentLogs-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Type" Visibility="Visibility.Medium">
            <EnumTypeSelector Type="@TargetType.AgentLog"
                              @bind-Value="@filter.Type"
                              OnSelected="@((int? e) => Updated())">
            </EnumTypeSelector>
        </GXFh>
        <GXFh Id="Name">
            <GXInputText class="form-control" @bind-Value="CreatorFilter" Placeholder="@Properties.Resources.AgentID" />
        </GXFh>
        <GXFh Id="Message">
            <GXInputText class="form-control" Id="AgentLog-Message"
                         @bind-Value="@filter.Message"
                         Placeholder="@Properties.Resources.FilterByMessage">
            </GXInputText>
        </GXFh>
        <GXFh Id="Level">
            <GXInputDropdown class="form-select"
                             Id="AgentLogs-TraceLevel"
                             RememberValue="true"
                             @bind-Value="TraceLevel"
                             OnSelected="@((TraceLevel e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Closed">
            @*Closed time.*@
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="CreationTime" Target="@error" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Type" Target="@error">@Properties.Resources.Type</GXTh>
        <GXTh Id="Name" TItem="GXLog">@Properties.Resources.Name</GXTh>
        <GXTh Name="Message" Target="@error">@Properties.Resources.Error</GXTh>
        <GXTh Name="Level" Target="@error">@Properties.Resources.Level</GXTh>
        <GXTh Name="Closed" Target="@error">@Properties.Resources.CloseTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="CreationTime" Link="@NavigationManager.GetCurrentPagePath("/AgentLog/Edit/" + error.PublicId)">@ResourceStorage.DateTimeOffsetToString(error.CreationTime)</GXTd>
        <GXTd Id="Type">@(ResourceStorage.GetEnumType(TargetType.AgentLog, error.Type))</GXTd>
        <GXTd Id="Name"><LogCreatorLabel Creator="@error.Creator" Resource="Agent" /></GXTd>
        <GXTd Id="Message">@error.Message</GXTd>
        <GXTd Id="Level">@ClientHelpers.LevelToString(error.Level)</GXTd>
        <GXTd Id="Closed">@ResourceStorage.DateTimeOffsetToString(error.Closed)</GXTd>
    </ItemContent>
</GXViewTable>

<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Type") { Position = 1, Description = "Type", Visibility = (byte)Visibility.All },
        new("Name") { Position = 2, Description = "Name", Visibility = (byte)Visibility.All },
        new("Message") { Position = 3, Description = "Error", Visibility = (byte)Visibility.All },
        new("Level") { Position = 4, Description = "Level", Visibility = (byte)Visibility.All },
        new("Closed") { Position = 5, Description = "CloseTime", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Trace level.
    /// </summary>
    private TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// Selected schedule group ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.AgentLogs;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "agent-logs";
        }
    }

    /// <summary>
    /// Amount of the agent errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    internal long Total { get; private set; }

    /// <summary>
    /// Agent error filter.
    /// </summary>
    private GXLog filter = new GXLog();
    private string? CreatorFilter
    {
        get => filter.Creator?.ToString();
        set => filter.Creator = Guid.TryParse(value, out var id) ? id : null;
    }


    /// <summary>
    /// Reference to the table.
    /// </summary>
    protected GXViewTable<GXLog>? table;

    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXLog? Active
    {
        get
        {
            return table?.Active;
        }
    }
    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Agent/AgentLogs.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentLogs.Updated");
        }
    }


    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/Agent/AgentLogs.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXAgentLogPolicies.Add ||
                        it.Type == GXAgentLogPolicies.Clear ||
                        it.Type == GXAgentLogPolicies.Close)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXLog() { PublicId = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentLogs.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgentLogs);
        try
        {
            if (ShowClosedErrors)
            {
                //Show closed errors.
                filter.Closed = DateTimeOffset.MaxValue;
            }
            else
            {
                //Show active errors.
                filter.Closed = null;
            }
            if (filter.Message == string.Empty)
            {
                filter.Message = null;
            }
            if (TraceLevel == TraceLevel.Off)
            {
                filter.Level = null;
            }
            else
            {
                filter.Level = (int)TraceLevel;
            }

            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.AgentLog);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=agent", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                //Mark agent logs as seen.
                if (ret.Logs.Any())
                {
                    if (Notifier != null)
                    {
                        await Notifier.Mark(Http, TargetType.AgentLog, ret.Logs.Max(s => s.CreationTime));
                    }
                }
            }
            Total = ret.Count;
            //Get only selected amount of the agent logs.
            if (Total != 0)
            {
                ret.Count = Total;
            }
            if (Id.HasValue && table != null)
            {
                table.RestoreSelection(ret.Logs?.FirstOrDefault(log => log.PublicId == Id.Value));
            }
            return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (OperationCanceledException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (ObjectDisposedException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Show agent error details.
    /// </summary>
    void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Agent/AgentLogs.OnShow");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/AgentLog/Edit/" + table?.Active.PublicId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentLogs.OnShow");
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnClose()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmClose, Properties.Resources.AreYouSureYouWantToCloseSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Close,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Message).ToArray()
                });
            await OnCloseConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnCloseConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                CloseLog req = new CloseLog()
                {
                    Ids = table.SingleOrDefault().Select(w => w.PublicId).ToArray()
                };
                await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=agent", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Clear the agent error list.
    /// </summary>

    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Agent/AgentLogs.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the agent error list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingAgentLog);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=agent", new ClearLog());
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
