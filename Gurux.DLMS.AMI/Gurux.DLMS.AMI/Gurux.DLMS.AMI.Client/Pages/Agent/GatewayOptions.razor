@using Gurux.DLMS.AMI.Client.Pages.Admin
@using Gurux.DLMS.AMI.Client.Pages.Media;
@using Gurux.DLMS.AMI.Client.Pages.Script
@using Gurux.UI.Components.Enums;
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.Enums
@using Gurux.Net;
@using Gurux.Serial;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics
@using Gurux.DLMS.AMI.Client.Pages.DeviceTemplate

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="GatewayOptions" />

@if (Settings != null)
{
    <EditForm EditContext="@(GXEditContexts.For(Owner?.Active ?? (object)Settings))">
        <DataAnnotationsValidator />
        <GXValidator @ref="_validator" OnValidate="OnValidate" />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Settings.Enabled" />
                    <br />
                </div>
                <fieldset disabled="@(!Settings.Enabled)">
                    <NetworkSettings IsServer="true" @bind-Settings="@Settings.MediaSettings"
                                     @ref=networkSettings></NetworkSettings>
                    <div class="form-group">
                        <label>@Properties.Resources.TraceLevel</label>
                        <GXInputDropdown class="form-select" @bind-Value="Settings.TraceLevel" RememberValue="false" Items="@(TraceLevels)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.Gateway</label>
                        <GXDropdownSearch class="form-control"
                                        Id="DeviceImporter"
                                        RememberValue="true"
                                        @bind-Value="SelectedGateway"
                                        ItemsProvider="@GetGateways">
                        </GXDropdownSearch>
                    </div>
                    @if (SelectedGateway == null)
                    {
                        <div class="form-group">
                            <label>@Properties.Resources.IdentifyWaitTime</label>
                            <GXInputTimeSpan RememberValue="false" id="identifyWaitTime" class="form-control"
                                                  @bind-Value="Settings.IdentifyWaitTime" />
                            <ValidationMessage For="@(() => Settings.IdentifyWaitTime)" />
                        </div>
                        <div class="form-group row">
                            <ScriptMethodSelector Title="@Properties.Resources.GatewayIdentificationScript"
                                                  Scripts="@Scripts"
                                                  SelectionChanged="@GatewayIdentificationSelectionChanged"
                                                  ScriptMethod="@Settings.ScriptMethod"></ScriptMethodSelector>
                        </div>
                    }
                </fieldset>
            </div>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] public Agent? Owner { get; set; }

    protected override void OnInitialized()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
    }

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    //Available scripts.
    [Parameter]
    public IEnumerable<GXScript>? Scripts { get; set; }

    [Parameter]
    public GatewaySettings? Settings { get; set; }

    private GXValidator? _validator;

    TraceLevel[] TraceLevels = new TraceLevel[]
    {
        TraceLevel.Off,
        TraceLevel.Error,
        TraceLevel.Warning,
        TraceLevel.Info,
        TraceLevel.Verbose
    };

    NetworkSettings? networkSettings { get; set; }

    ///<summary>
    ///Gateway identification script method has been changed.
    ///</summary>
    private void GatewayIdentificationSelectionChanged(Guid? guid)
    {
        if (Settings != null)
        {
            Settings.ScriptMethod = guid;
        }
    }

    public async System.Threading.Tasks.Task ValidateAsync(GXValidator sender)
    {
        OnValidate(sender);
        if (_validator != null)
        {
            await _validator.ValidateAsync();
        }
    }

    public void OnValidate(GXValidator sender)
    {
        if (Settings != null && Settings.Enabled)
        {
            if (Settings.ExpirationTime < 0)
            {
                sender.AddError(() => Settings.ExpirationTime, Properties.Resources.InvalidExpirationTime);
            }
            networkSettings?.Validate(sender);
            if (Settings.Enabled && (Settings.Id == null && Settings.ScriptMethod == null))
            {
                sender.AddError(() => SelectedGateway, Properties.Resources.GatewayMustBeSelected);
            }
        }
    }

    private GXGateway? _selectedGateway;
    private GXGateway? SelectedGateway { get => _selectedGateway; set { _selectedGateway = value; if (Settings != null) {
        Settings.Id = value?.Id;
    } } }

    private async ValueTask<ItemsProviderResult<GXGateway?>> GetGateways(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingGatewayOptions);
        try
        {
            ListGateways req = new ListGateways()
            {
                Index = request.StartIndex,
                Count = request.Count,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            var settings = Settings;
            Guid? selectedId = settings?.Id;
            if (selectedId is Guid id)
            {
                //Load only the selected gateway.
                req.Filter = new() { Id = id };
            }
            else
            {
                req.Count = 5;
                if (!string.IsNullOrEmpty(request.Filter))
                {
                    req.Filter = new() { Name = request.Filter };
                }
            }
            ListGatewaysResponse ret = await Http.PostAsJson<ListGatewaysResponse>("api/Gateway/List", req, request.CancellationToken);
            if (ret.Gateways != null)
            {
                if (!request.CancellationToken.IsCancellationRequested && ReferenceEquals(Settings, settings) && selectedId is Guid && Settings?.Id == selectedId)
                {
                    //Set the selected gateway.
                    _selectedGateway = ret.Gateways.FirstOrDefault(item => item.Id == selectedId);
                    StateHasChanged();
                }
                return new ItemsProviderResult<GXGateway?>(ret.Gateways, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

}
