@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Pages.Script
@using Gurux.DLMS.AMI.Shared.DTOs.Script
@using Gurux.DLMS.AMI.Shared.DTOs.Device
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@inject HttpClient Http
<GXHelpContext Topic="RawNotificationOptions" />

@if (Settings != null)
{
    <EditForm EditContext="@(GXEditContexts.For(Owner?.Active ?? (object)Settings))">
        <DataAnnotationsValidator />
        <GXValidator @ref="_validator" OnValidate="OnValidate" />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXInputSwitch Id="RawNotificationOptions-Active" Text="@Properties.Resources.Enabled" @bind-Value="Settings.Enabled" />
                    <br />
                </div>
                <fieldset disabled="@(!Settings.Enabled)">
                    <div class="form-group">
                        <label for="RawNotificationOptions-Threads">@Properties.Resources.Threads</label>
                        <GXInputNumber RememberValue="false" id="RawNotificationOptions-Threads" class="form-control" @bind-Value="Settings.Threads" Min="@GXNumberBounds.Minimum(Settings.Threads)" Max="@GXNumberBounds.Maximum(Settings.Threads)" />
                        <ValidationMessage For="@(() => Settings.Threads)" />
                    </div>
                    <div class="form-group row">
                        <label>@Properties.Resources.Script</label>
                        <ScriptMethodSelector Scripts="@Scripts" SelectionChanged="SelectionChanged"
                                              ScriptMethod="@Settings.ScriptMethod" />
                        <ValidationMessage For="@(() => Settings.ScriptMethod)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.DefaultDeviceTemplate</label>
                        <GXDropdownSearch class="form-control"
                                        Id="RawNotificationOptions-DefaultDeviceTemplate"
                                        RememberValue="true" @bind-Value="DefaultDeviceTemplate" ItemsProvider="GetItems" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.TraceLevel</label>
                        <GXInputDropdown class="form-select"
                                         Id="RawNotificationOptions-TraceLevel" RememberValue="true"
                                         @bind-Value="Settings.TraceLevel" />
                    </div>
                </fieldset>
            </div>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] public Agent? Owner { get; set; }

    /// <summary>Available scripts from which the processing method can be selected.</summary>
    [Parameter]
    public IEnumerable<GXScript>? Scripts { get; set; }

    /// <summary>Parser settings edited by this tab and serialized by the parent agent editor.</summary>
    [Parameter]
    public RawNotificationSettings? Settings { get; set; }

    private GXValidator? _validator;
    private GXDeviceTemplate _defaultDeviceTemplate = new(Properties.Resources.Nothing);

    /// <summary>Maps the empty template selection to a null stored identifier.</summary>
    private GXDeviceTemplate DefaultDeviceTemplate
    {
        get => _defaultDeviceTemplate;
        set
        {
            _defaultDeviceTemplate = value;
            if (Settings != null)
            {
                Settings.DefaultDeviceTemplate = value.Id == Guid.Empty ? null : value.Id;
            }
        }
    }

    /// <summary>Refreshes the template selection when another agent or settings instance is loaded.</summary>
    protected override void OnParametersSet()
    {
        var selectedId = Settings?.DefaultDeviceTemplate ?? Guid.Empty;
        if (_defaultDeviceTemplate.Id != selectedId)
        {
            _defaultDeviceTemplate = new GXDeviceTemplate { Id = selectedId, Name = Properties.Resources.Nothing };
        }
    }

    /// <summary>Adds parser validation errors to the parent agent form and this tab's form.</summary>
    public async Task ValidateAsync(GXValidator sender)
    {
        OnValidate(sender);
        if (_validator != null)
        {
            _validator.ClearErrors();
            await _validator.ValidateAsync();
        }
    }

    /// <summary>Validates enabled processing settings; inactive settings do not block agent changes.</summary>
    public void OnValidate(GXValidator sender)
    {
        if (Settings?.Enabled == true && Settings.Threads < 1)
        {
            sender.AddError(() => Settings.Threads, Properties.Resources.TheNumberOfRawNotificationWorkersMustBeGreaterThanZero);
        }
        if (Settings?.Enabled == true && (Settings.ScriptMethod == null || Settings.ScriptMethod == Guid.Empty))
        {
            sender.AddError(() => Settings.ScriptMethod, Properties.Resources.SelectARawNotificationParserScript);
        }
    }

    /// <summary>Stores the selected parser method identifier.</summary>
    private void SelectionChanged(Guid? id)
    {
        if (Settings != null)
        {
            Settings.ScriptMethod = id;
        }
    }

    /// <summary>Loads matching device templates while retaining an explicit empty selection.</summary>
    private async ValueTask<ItemsProviderResult<GXDeviceTemplate>> GetItems(GXItemsProviderRequest request)
    {
        var response = await Http.PostAsJson<ListDeviceTemplatesResponse>("api/DeviceTemplate/List", new ListDeviceTemplates {
            Index = request.StartIndex, Count = request.Count,
            Filter = string.IsNullOrEmpty(request.Filter) ? null : new GXDeviceTemplate { Name = request.Filter },
            OrderBy = request.OrderBy, Descending = request.Descending, AllUsers = request.ShowAllUserData
        }, request.CancellationToken);
        List<GXDeviceTemplate> items = [new GXDeviceTemplate { Name = Properties.Resources.Nothing }];
        if (response.Templates != null)
        {
            items.AddRange(response.Templates);
        }
        var selected = items.FirstOrDefault(item => item.Id == (Settings?.DefaultDeviceTemplate ?? Guid.Empty));
        if (selected != null)
        {
            _defaultDeviceTemplate = selected;
        }
        return new ItemsProviderResult<GXDeviceTemplate>(items, ClientHelpers.ToVirtualizedCount(response.Count));
    }
}
