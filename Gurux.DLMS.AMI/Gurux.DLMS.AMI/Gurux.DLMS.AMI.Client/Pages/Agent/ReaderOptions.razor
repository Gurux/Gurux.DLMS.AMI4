@using Gurux.DLMS.AMI.Shared
@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

<GXHelpContext Topic="ReaderOptions" />

@if (Settings != null)
{
    <EditForm EditContext="@(GXEditContexts.For(Owner?.Active ?? (object)Settings))">
        <DataAnnotationsValidator />
        <GXValidator @ref="_validator" OnValidate="OnValidate" />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Settings.Enabled" />
                    <br />
                </div>
                <fieldset disabled="@(!Settings.Enabled)">
                    <div class="form-group">
                        <label>@Properties.Resources.Threads</label>
                        <GXInputNumber RememberValue="false" id="threads" class="form-control"
                                     @bind-Value="Settings.Threads"
                                     disabled="@IsDisabled()" Min="@GXNumberBounds.Minimum(Settings.Threads)" Max="@GXNumberBounds.Maximum(Settings.Threads)" />
                        <ValidationMessage For="@(() => Settings.Threads)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.AliveTime</label>
                        <GXInputTimeSpan RememberValue="false" id="aliveTime" class="form-control"
                                              TimeSpanUnit="TimeSpanUnit.Minute"
                                              @bind-Value="Settings.AliveTime" />
                        <ValidationMessage For="@(() => Settings.AliveTime)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.TraceLevel</label>
                        <GXInputDropdown class="form-select" @bind-Value="Settings.TraceLevel" RememberValue="false" Items="@(TraceLevels)" />
                    </div>
                    <ValidationMessage For="@(() => Settings.TraceLevel)" />
                </fieldset>
            </div>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] public Agent? Owner { get; set; }

    TraceLevel[] TraceLevels = new TraceLevel[] { TraceLevel.Off, TraceLevel.Error, TraceLevel.Warning, TraceLevel.Info, TraceLevel.Verbose };

    [Parameter]
    public ReaderSettings? Settings { get; set; }
    private GXValidator? _validator;


    /// <summary>
    /// The serial port of the agent.
    /// </summary>
    [Parameter]
    public string? SerialPort { get; set; }

    /// <summary>
    /// Amount of the threads is disabled when agent is used for the serial port.
    /// </summary>
    /// <returns></returns>
    private bool IsDisabled()
    {
        return !string.IsNullOrEmpty(SerialPort);
    }

    /// <summary>
    /// Notified when settings are updated.
    /// </summary>
    [Parameter]
    public EventCallback<string?> SerialPortChanged { get; set; }


    public async Task ValidateAsync(GXValidator sender)
    {
        OnValidate(sender);
        if (_validator != null)
        {
            await _validator.ValidateAsync();
        }
    }

    public void OnValidate(GXValidator sender)
    {
        if (Settings != null && Settings.Enabled)
        {
            if (Settings.Threads < 1 || Settings.Threads > 10000)
            {
                sender.AddError(() => Settings.Threads, Properties.Resources.InvalidThreadsAmount);
            }
            if (Settings.AliveTime < 1)
            {
                sender.AddError(() => Settings.AliveTime, Properties.Resources.InvalidAliveTime);
            }
        }
    }
    protected override void OnInitialized()
    {
    }

}
