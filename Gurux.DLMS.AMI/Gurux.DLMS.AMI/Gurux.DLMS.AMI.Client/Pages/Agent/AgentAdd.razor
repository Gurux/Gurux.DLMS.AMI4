@page "/agentadd"
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Client.Pages.Agent
@using System.Text.Json

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="AgentAdd" />

<h1>@Properties.Resources.ConfigureYourAccount</h1>
@Gurux.DLMS.AMI.Client.Properties.Resources.ConfigureYourAccountByFollowingTheStepsOutlined <a target="_blank" href="https://www.gurux.fi/agent-configure">@Properties.Resources.Here</a>.

<EditForm EditContext="@GXEditContexts.For(this)">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group mb-2">
        <label for="agent-download-version">@Properties.Resources.Version</label>
        <select id="agent-download-version" class="form-select" @bind="_downloadVersion" disabled="@(_loadingVersions || _downloading || _downloadVersions.Length == 0)">
            @if (_downloadVersions.Length == 0)
            {
                <option value="">@Properties.Resources.UpdatesLatestVersion</option>
            }
            @foreach (var version in _downloadVersions)
            {
                <option value="@version.Number">@version.Number</option>
            }
        </select>
    </div>
    <button type="button" id="agent-download" class="btn btn-secondary" @onclick="OnDownload" disabled="@(_loadingVersions || _downloading)">
        <div class="Download"></div>
        &nbsp;@Properties.Resources.DownloadAgent
    </button>
    <p>
        <hr />
    </p>
    <div class="form-group">
        <GXCopyButton Value="@TokenName">@Properties.Resources.Name</GXCopyButton>
        <InputText id="token" class="form-control" @bind-Value="TokenName" />
    </div>
    <div class="form-group">
        <label>@Properties.Resources.Expiration</label>
        <InputDate Type="@InputDateType.DateTimeLocal" id="expiration" class="form-control"
                   @bind-Value="TokenExpiration" />
    </div>
    <button type="button" class="btn btn-secondary" @onclick="OnToken">
        <div class="GenerateAccessToken"></div>
        &nbsp;@Properties.Resources.GenerateAccessToken
    </button>
    @if (Token != null)
    {
        <div class="agent-token-created alert alert-success" role="status" aria-live="polite">
            <svg class="agent-token-notice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                <path d="M10 21h4" />
            </svg>
            <div class="agent-token-content">
                <p class="agent-token-message">@Properties.Resources.AgentTokenCreateSucceeded</p>
                <div class="agent-token-value">
                    <input id="agent-access-token" class="form-control" type="text" value="@Token" readonly
                           aria-label="@Properties.Resources.TokensTitle" spellcheck="false" autocomplete="off" />
                    <GXCopyButton Value="@Token" />
                </div>
            </div>
        </div>
    }
</EditForm>
@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly CancellationTokenSource _lifetime = new();
    private GXAgentVersion[] _downloadVersions = [];
    private string? _downloadVersion;
    private bool _loadingVersions = true;
    private bool _downloading;

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = default!;
    //Token expiration time.
    public DateTimeOffset? TokenExpiration { get; set; }

    //Generated token.
    public string TokenName { get; set; } = "Generated";

    //Generated token.
    public string? Token { get; set; }

    /// <summary>
    /// Download the selected agent release, or resolve the latest release if no local catalog is available.
    /// </summary>
    public async Task OnDownload()
    {
        if (_loadingVersions || _downloading)
        {
            return;
        }
        _downloading = true;
        try
        {
            var req = new DownloadAgent
            {
                Agent = string.IsNullOrEmpty(_downloadVersion) ? null : new GXAgent { UpdateVersion = _downloadVersion }
            };
            var ret = await Http.PostAsJson<DownloadAgentResponse>("api/Agent/Download", req, _lifetime.Token);
            string url = ret.Urls?.FirstOrDefault() ?? throw new InvalidOperationException(Properties.Resources.TheAgentDownloadURLIsMissing);
            await using IJSObjectReference module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./download.js");
            await module.InvokeVoidAsync("saveFile", url);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _downloading = false;
        }
    }

    /// <summary>
    /// Generate new token.
    /// </summary>
    public async Task OnToken()
    {
        using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingAgentAdd);
        NotificationService?.RemoveByKey("Pages/Agent/AgentAdd.OnToken");
        try
        {
            var scopes = await Http.GetAsJsonAsync<string[]>("api/Role/AgentTokenScopes");
            // An empty scope list would grant all of the issuing user's permissions.
            if (scopes?.Length is not > 0)
            {
                throw new InvalidOperationException("The agent role must have permissions configured in access control before an agent token can be generated.");
            }
            GXPersonalToken token = new GXPersonalToken();
            token.Name = TokenName;
            token.Expiration = TokenExpiration;
            token.Scopes = scopes;
            UpdateToken req = new UpdateToken() { Tokens = new GXPersonalToken[] { token } };
            var ret = await Http.PostAsJson<UpdateTokenResponse>("api/Token/Add", req);
            Token = ret.Token;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentAdd.OnToken");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.PostAsJson<ListAgentInstallersResponse>("api/Agent/Installers", new ListAgentInstallers(), _lifetime.Token);
            // Show every available catalog version, independent of server assembly versions.
            _downloadVersions = (response.Agents ?? []).SelectMany(agent => agent.Versions ?? [])
                .Where(version => version.Removed == null && version.Enabled != false &&
                    GXReleaseVersionComparer.TryNormalize(version.Number, out _))
                .OrderByDescending(version => version.Number, GXReleaseVersionComparer.Instance)
                .ThenByDescending(version => version.CreationTime)
                .DistinctBy(version => GXReleaseVersionComparer.TryNormalize(version.Number, out var normalized) ? normalized.Split('+')[0] : string.Empty)
                .ToArray();
            _downloadVersion = _downloadVersions.FirstOrDefault()?.Number;
        }
        catch (AccessTokenNotAvailableException error)
        {
            error.Redirect();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception error)
        {
            NotificationService?.ReportError(error, "Pages/Agent/AgentAdd.Versions");
        }
        finally
        {
            _loadingVersions = false;
        }
    }

    protected override void OnInitialized()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            NotificationService?.RemoveByKey("Pages/Agent/AgentAdd.OnInitialized");
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem()
            {
                Text = Properties.Resources.Close,
                Icon = "Close",
                OnClick = EventCallback.Factory.Create(this, OnCancel)
            });
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentAdd.OnInitialized");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        MenuService.Dispose();
    }
}
