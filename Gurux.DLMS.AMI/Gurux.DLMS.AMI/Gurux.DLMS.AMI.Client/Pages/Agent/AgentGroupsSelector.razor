@using Gurux.DLMS.AMI.Client.Pages.Device
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="AgentGroupsSelector" />

<SelectionContainer TItem="GXAgentGroup" @ref="@_selectionContainer">
    <SelectionList TItem="GXAgentGroup" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems"
                   OnAdded="OnAdded"
                   OnRemoved="@Removed">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
        <ButtonContent>
            <div>
                <button style="float: right;" class="btn btn-outline-secondary border-left-0 border"
                        type="button" onclick="@(() => RemoveAll())">
                    &raquo;
                </button>
            </div>
        </ButtonContent>
    </SelectionList>
    <SelectionList TItem="GXAgentGroup" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
        <ButtonContent>
            <div>
                <button style="float: left;" class="btn btn-outline-secondary border-left-0 border"
                        type="button" onclick="@(() => AddAll())">
                    &laquo;
                </button>
            </div>
        </ButtonContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [CascadingParameter]
    private DeviceGroup? DeviceGroupParent { get; set; }

    [CascadingParameter]
    private Agent? AgentParent { get; set; }

    /// <summary>
    /// Selected agent groups.
    /// </summary>
    [Parameter]
    public List<GXAgentGroup>? AgentGroups { get; set; }

    SelectionList<GXAgentGroup>? _selected;
    SelectionList<GXAgentGroup>? _available;
    SelectionContainer<GXAgentGroup>? _selectionContainer;

    /// <summary>
    /// Agent group filter.
    /// </summary>
    private GXAgentGroup filter = new GXAgentGroup()
    {
        UserGroups = new List<GXUserGroup>()
    };

    /// <summary>
    /// Selected agent group filter.
    /// </summary>
    private GXAgentGroup selectedFilter = new GXAgentGroup(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected != null)
            {
                selectedFilter.Name = name;
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Agent/AgentGroupsSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentGroupsSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Agent/AgentGroupsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentGroupsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Add all objects to selected items.
    /// </summary>
    /// <returns></returns>
    private async Task AddAll()
    {
        int max = 0;
        //max 1000 items are added at the one time.
        if (_available != null && _available.TotalCount > 1000)
        {
            max = 1000;
        }
        var ret = await GetItems(new GXItemsProviderRequest(0, max));
        await OnAdded(ret.Items);
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
        if (_available != null)
        {
            await _available.RefreshDataAsync();
        }
    }

    /// <summary>
    /// Remove all objects from selected items.
    /// </summary>
    /// <returns></returns>
    private async Task RemoveAll()
    {
        List<GXAgentGroup> devs = GetGroups();
        devs.Clear();
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
        if (_available != null)
        {
            await _available.RefreshDataAsync();
        }
    }

    /// <summary>
    /// New device is added for selection list.
    /// </summary>
    public async Task OnAdded(IEnumerable<GXAgentGroup> items)
    {
        List<GXAgentGroup> devs = GetGroups();
        devs.InsertRange(0, items);
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
    }

    /// <summary>
    /// Device has removed from the lists.
    /// </summary>
    private async Task Removed(IEnumerable<GXAgentGroup> items)
    {
        List<GXAgentGroup> devs = GetGroups();
        devs.RemoveAll(w => items.Contains(w));
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
    }

    List<GXAgentGroup> GetGroups()
    {
        if (AgentGroups != null)
        {
            return AgentGroups;
        }
        if (DeviceGroupParent?.Active != null)
        {
            return DeviceGroupParent.Active.AgentGroups ??= [];
        }
        return AgentParent?.Active is { } agent ? agent.AgentGroups ??= [] : [];
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXAgentGroup>> GetSelectedItems(GXItemsProviderRequest request)
    {
        var groups = GetGroups();
        if (groups == null)
        {
            return new(new ItemsProviderResult<GXAgentGroup>(new GXAgentGroup[0], 0));
        }
        int total = groups.Count;
        if (!string.IsNullOrEmpty(selectedFilter.Name))
        {
            groups = groups.Where(w => (w.Name ?? string.Empty).ToLower().Contains((selectedFilter.Name ?? string.Empty).ToLower())).ToList();
        }
        return new(new ItemsProviderResult<GXAgentGroup>(
            groups.Skip(request.StartIndex).Take(request.Count), total));
    }

    private async ValueTask<ItemsProviderResult<GXAgentGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgentGroups);
        try
        {
            ListAgentGroups req = new ListAgentGroups()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                Exclude = GetGroups().Select(s => s.Id).ToArray()
            };
            var ret = await Http.PostAsJson<ListAgentGroupsResponse>("api/AgentGroup/List", req, request.CancellationToken);
            if (ret?.AgentGroups != null && _selected != null)
            {
                return new ItemsProviderResult<GXAgentGroup>(ret.AgentGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (_selectionContainer == null || _selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidNotifier);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingAgentGroups);
            NotificationService?.RemoveByKey("Pages/Agent/AgentGroupsSelector.OnInitializedAsync");
            if (_selected != null)
            {
                await _selected.RefreshDataAsync();
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Agent/AgentGroupsSelector.OnInitializedAsync");
        }
    }
}

