@page "/config/Script/{Id:guid?}"
@page "/config/Script/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Script" />

<h1>
    @_title
</h1>
<CascadingValue Value="this">
    <GXTabControl @key="Active" PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ScriptDetailsTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    /// <summary>Owns editing commands and connects their enabled state to the current form.</summary>
    private GXEditorMenu? _editorMenu;
    private CrudAction EditorAction => _action;
    public bool DeleteTarget { get; set; }
    public EditContext FormContext => GXEditContexts.For(Active ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget));
    private void InitializeEditorMenu()
    {
        _editorMenu ??= new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active, EditorAction, OnSave, OnCancel);
    }
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
    public void Dispose()
    {
        ++_loadVersion;
        _editorMenu?.Dispose();
    }
    private async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope3 = _progress?.ProgressStart(GXProgress.SavingScriptView);
            _notificationService?.RemoveByKey("Pages/Script/ScriptGeneral.OnSave");
            if (EditorAction == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveScriptResponse>("api/Script/Delete", new RemoveScript()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (EditorAction == CrudAction.Create)
                {
                    address = "api/Script/Add";
                }
                else if (EditorAction == CrudAction.Update)
                {
                    address = "api/Script/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateScriptResponse>(address, new UpdateScript()
                {
                    Scripts = new List<GXScript>() { Active }
                });
            }
            FormContext.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Script/ScriptGeneral.OnSave");
        }
    }

    /// <summary>Controls whether the loaded data can be displayed.</summary>
    private bool _ready;
    /// <summary>Identifies the request for which the current displayed data was retrieved.</summary>
    private (string? Action, Guid? Id, Guid? CopyFrom)? _loadedRequest;
    /// <summary>Invalidates stale asynchronous results when a newer load or selection supersedes them.</summary>
    private int _loadVersion;

    /// <summary>The authorized source to open as a new independent editable copy.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "copyFrom")]
    public Guid? CopyFrom { get; set; }

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? _title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXScript Active = new GXScript(null) { Enabled = true };

    protected override async Task OnParametersSetAsync()
    {
        var request = (Action, Id, CopyFrom);
        if (_loadedRequest == request)
        {
            return;
        }
        _loadedRequest = request;
        int loadVersion = ++_loadVersion;
        _ready = false;
        _editorMenu?.Dispose();
        _editorMenu = null;
        Active = new GXScript(null) { Enabled = true };
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    _title = Properties.Resources.Add;
                    break;
                case "Edit":
                    _title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    _title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            _title += " " + Properties.Resources.Script;
            using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingScript);
            _notificationService?.RemoveByKey("Pages/Script/Script.OnInitializedAsync");
            bool copying = string.Equals(Action, "Add", StringComparison.OrdinalIgnoreCase) && CopyFrom.HasValue;
            if (copying || string.Compare(Action, "Add", true) != 0)
            {
                //Get script data.
                var tmp = (await Http.GetAsJsonAsync<GetScriptResponse>(string.Format("api/Script?id={0}", copying ? CopyFrom : Id)));
                if (loadVersion != _loadVersion)
                {
                    return;
                }
                if (tmp?.Item != null)
                {
                    Active = copying ? GXScriptCopies.Create(tmp.Item, Properties.Resources.Copy) : tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            InitializeEditorMenu();
            if (copying)
            {
                FormContext.NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXScript.Name)));
            }
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Script/Script.OnInitializedAsync");
        }
    }
}
