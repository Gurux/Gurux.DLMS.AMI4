@page "/config/Script/{Id:guid?}"
@page "/config/Script/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Script" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ScriptDetailsTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private GXEditorMenu? _editorMenu;
    private CrudAction EditorAction => _action;
    public bool DeleteTarget { get; set; }
    public EditContext FormContext => GXEditContexts.For(Active ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget));
    private void InitializeEditorMenu()
    {
        _editorMenu ??= new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active, EditorAction, OnSave, OnCancel);
    }
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
    public void Dispose() => _editorMenu?.Dispose();
    private async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingScriptView);
            NotificationService?.RemoveByKey("Pages/Script/ScriptGeneral.OnSave");
            if (EditorAction == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveScriptResponse>("api/Script/Delete", new RemoveScript()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (EditorAction == CrudAction.Create)
                {
                    address = "api/Script/Add";
                }
                else if (EditorAction == CrudAction.Update)
                {
                    address = "api/Script/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<UpdateScriptResponse>(address, new UpdateScript()
                {
                    Scripts = new List<GXScript>() { Active }
                });
            }
            FormContext.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/ScriptGeneral.OnSave");
        }
    }

    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXScript Active = new GXScript(null) { Enabled = true };

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Script;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScript);
            NotificationService?.RemoveByKey("Pages/Script/Script.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get script data.
                var tmp = (await Http.GetAsJsonAsync<GetScriptResponse>(string.Format("api/Script?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            InitializeEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/Script.OnInitializedAsync");
        }
    }
}
