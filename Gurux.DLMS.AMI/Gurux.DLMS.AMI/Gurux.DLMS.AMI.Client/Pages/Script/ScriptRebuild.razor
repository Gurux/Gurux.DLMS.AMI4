@using Gurux.DLMS.AMI.Shared.DIs;
@using Gurux.DLMS.AMI.Shared.Rest;
@using System.Text.Json;
@using Gurux.DLMS.AMI.Shared;
@using System.Reflection;
@using System.Diagnostics;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;

@inject IServiceProvider Services
@inject HttpClient Http

<GXHelpContext Topic="ScriptRebuild" />

@if (Rebuild && HasScripts)
{
    <div role="alert"
         class="alert alert-warning alert-dismissible fade show">
        <p>
            @Properties.Resources.ScriptRebuildWarning
        </p>
        <button type="button" class="btn btn-danger"
                @onclick="() => OnRebuild()">
            @Properties.Resources.Rebuild
        </button>
    </div>
    <br />
}
@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>Whether the current script list contains items.</summary>
    [Parameter]
    public bool HasScripts { get; set; }

    private bool Rebuild = false;

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScriptRebuild);
            NotificationService?.RemoveByKey("Pages/Script/ScriptRebuild.OnInitializedAsync");
            //Get script info.
            ListConfiguration req = new ListConfiguration()
            {
                Filter = new Gurux.DLMS.AMI.Shared.DTOs.GXConfiguration()
                {
                    Name = GXConfigurations.Scripts
                }
            };
            var ret = await Http.PostAsJson<ListConfigurationResponse>("api/Configuration/List", req);
            Rebuild = true;
            if (ret.Configurations != null &&
                ret.Configurations.Count() == 1 &&
                !string.IsNullOrEmpty(ret.Configurations.First().Settings))
            {
                ScriptSettings? settings = JsonSerializer.Deserialize<ScriptSettings>(ret.Configurations.First().Settings ?? "{}");
                if (settings != null &&
                    settings.Versions == settings.CurrentVersions)
                {
                    Rebuild = false;
                }
            }
            else
            {
                //If there are no scipts.
                Rebuild = false;
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/ScriptRebuild.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Rebuild the scripts.
    /// </summary>
    private async Task OnRebuild()
    {
        try
        {
            RebuildScript req = new RebuildScript();
            var ret = await Http.PostAsJson<RebuildScriptResponse>("api/Script/Rebuild", req);
            Rebuild = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}

