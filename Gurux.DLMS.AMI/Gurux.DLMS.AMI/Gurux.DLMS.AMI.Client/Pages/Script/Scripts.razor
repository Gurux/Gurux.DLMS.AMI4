@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/scripts"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="Scripts" />

@if (Title)
{
    <PageTitle>@Properties.Resources.Scripts</PageTitle>
}

@if (_hasScripts == true)
{
    <ScriptRebuild HasScripts="true" />
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXScriptPolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXScriptPolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.PublishToCommunity" Id="publish-community" OnClick="@OnPublishCommunity" Policy="@GXScriptPolicies.Add" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Script.Scripts" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXScriptPolicies.View })"
             TItem="GXScript" @ref="table"
             @bind-Active="Active"
             Context="script"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="Scripts-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdateTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = "".Equals(__e.Value) ? DateTime.MinValue : Convert.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXScriptPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXScriptPolicies.Delete"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.PublishToCommunity" Id="publish-community" OnClick="@OnPublishCommunity" Policy="@GXScriptPolicies.Add" />
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Name" Name="Name" Target="@script">@Properties.Resources.Name</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@script" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated" Name="Updated" Target="@script">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Config/Script/Edit/" + script.Id)"><span class=@(ClientHelpers.GetActiveDot(script.Enabled))></span>@script.Name</GXTd>
        <GXTd Id="CreationTime">@script.CreationTime</GXTd>
        <GXTd Id="Updated">@script.Updated</GXTd>
    </ItemContent>
</GXViewTable>

<br />
@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 2, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;
    private bool publishingCommunity;

    /// <summary>
    /// Selected script ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXScript? Active { get; set; }
    private bool? _hasScripts;

    /// <summary>Reports whether the loaded script list contains items.</summary>
    [Parameter]
    public EventCallback<bool> HasScriptsChanged { get; set; }


    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Scripts;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "script";
        }
    }

    /// <summary>
    /// Amount of the scripts shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Script filter.
    /// </summary>
    private GXScript filter = new GXScript() { Enabled = null };
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXScript>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Script/Scripts.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/Scripts.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScripts);
        NotificationService?.RemoveByKey("Pages/Script/Scripts.OnInitialized");
        try
        {
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXScriptPolicies.Add ||
                        it.Type == GXScriptPolicies.Edit ||
                        it.Type == GXScriptPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXScript() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/Scripts.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXScript>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingScripts);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListScripts req = new ListScripts()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListScriptsResponse>("api/Script/List", req, request.CancellationToken);
            bool hasScripts = ret.Count > 0 || ret.Scripts?.Any() == true;
            if (_hasScripts != hasScripts)
            {
                _hasScripts = hasScripts;
                await HasScriptsChanged.InvokeAsync(hasScripts);
                await InvokeAsync(StateHasChanged);
            }
            return new ItemsProviderResult<GXScript>((ret.Scripts ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new script.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Script/Scripts.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager, "/Config/Script/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/Scripts.OnAdd");
        }
    }

    /// <summary>
    /// Edit script.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Script/Scripts.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Config/Script/Edit/" + table.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Script/Scripts.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected scripts.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected scripts.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveScript req = new RemoveScript()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveScriptResponse>("api/Script/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>Confirms anonymous publication of one saved script before sending it for review.</summary>
    public async Task OnPublishCommunity()
    {
        if (publishingCommunity)
        {
            return;
        }
        publishingCommunity = true;
        const string key = "Pages/Script/Scripts.PublishCommunity";
        try
        {
            NotificationService?.RemoveByKey(key);
            var selected = table?.SingleOrDefault().ToArray() ?? [];
            if (selected.Length != 1)
            {
                throw new InvalidOperationException(selected.Length == 0 ? Properties.Resources.NoItemIsSelected : Properties.Resources.SelectOneScript);
            }
            // Capture the confirmed ID; later selection changes must not change the submitted script.
            var script = selected[0];
            var result = await Confirmation.ConfirmAsync(Properties.Resources.PublishToCommunity, Properties.Resources.PublishCommunityConfirmation,
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.PublishToCommunity, Items = [script.Name] });
            if (!result.Confirm)
            {
                return;
            }
            using var progress = Progress?.ProgressStart(Properties.Resources.PublishToCommunity);
            await Services.GetRequiredService<GXScriptCommunityNotifications>().PublishAsync(script.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, key, NotificationScope.Global);
        }
        finally
        {
            publishingCommunity = false;
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

