@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject NavigationManager NavigationManager

<GXHelpContext Topic="ScriptMethodSelector" />

@if (Scripts != null)
{
    @if (!string.IsNullOrEmpty(Title))
    {
        <label style="margin:auto">@Title</label>
    }
    <div class="d-inline-flex">
        <GXInputDropdown TValue="MethodChoice" class="form-select" RememberValue="false" Items="@MethodChoices"
                         Formatter="@(choice => choice.Name)" Value="@SelectedChoice" ValueChanged="@SetChoiceAsync" />
        <AuthorizeView Policy="@GXScriptPolicies.View">
            &nbsp;<a target="_blank" href="@GetScriptId()">@Properties.Resources.Manage</a>
        </AuthorizeView>
    </div>
}

@code {
    private sealed record MethodChoice(Guid? Id, string Name);
    private IEnumerable<MethodChoice> MethodChoices => new[] { new MethodChoice(null, string.Empty) }
        .Concat((Scripts ?? []).SelectMany(script => (script.Methods ?? [])
            .Select(method => new MethodChoice(method.Id, script.Name + "." + method.Name))));
    private MethodChoice SelectedChoice => MethodChoices.FirstOrDefault(choice => choice.Id == ScriptMethod)
        ?? MethodChoices.First();
    private Task SetChoiceAsync(MethodChoice choice) => SetScriptMethodAsync(choice.Id);
    Guid? _scriptMethod;

    [Parameter]
    public IEnumerable<GXScript>? Scripts { get; set; }

    [Parameter]
    public string? Title { get; set; }


    [Parameter]
    public Guid? ScriptMethod
    {
        get
        {
            return _scriptMethod;
        }
        set
        {
            _scriptMethod = value;
        }
    }

    private async Task SetScriptMethodAsync(Guid? value)
    {
        if (_scriptMethod == value)
        {
            return;
        }
        _scriptMethod = value;
        await SelectionChanged.InvokeAsync(value);
    }

    private string GetScriptId()
    {
        if (Scripts != null)
        {
            foreach (var script in Scripts)
            {
                if (script.Methods != null)
                {
                    @foreach (var method in script.Methods)
                    {
                        if (method.Id == _scriptMethod)
                        {
                            return NavigationManager.GetCurrentPagePath("/Config/Script/Edit/" + script.Id);
                        }
                    }
                }
            }
        }
        return "Config/Script";
    }

    /// <summary>
    /// User has selected a new script.
    /// </summary>
    [Parameter]
    public EventCallback<Guid?> SelectionChanged { get; set; }
}
