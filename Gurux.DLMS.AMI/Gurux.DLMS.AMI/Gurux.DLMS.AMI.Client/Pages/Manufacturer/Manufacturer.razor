@using Gurux.DLMS.AMI.Client.Pages.Device
@using Gurux.DLMS.AMI.Client.Pages.Objects
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs

@inject IGXMenuService SharedMenuService
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="Manufacturer" />

<h1>
    @Title
</h1>

<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ManufacturerDetailsTab" Parameters="@TabParameters" ParametersForLink="@GetTabParameters" LinkFilter="@ShowManufacturerTab">
                    <ContentForLink Context="link">
                        @if (!string.IsNullOrEmpty(link.TargetType))
                        {
                            var componentType = Type.GetType(link.TargetType);
                            <div style="position: relative; width: 100%;">
                                @if (link.Url == "ModelProfilePicture" && Model != null)
                                {
                                    <h2>@Model.Name</h2>
                                }
                                <DynamicComponent Type="@componentType" Parameters="@GXTabParameters.Filter(componentType!, TabParameters, GetTabParameters(link))" />
                            </div>
                        }
                    </ContentForLink>
                </TabHeader>
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active ?? throw new InvalidOperationException(Properties.Resources.NoManufacturerIsSelected),
        ["Action"] = _action
    };

    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
    {
        if (Type.GetType(link.TargetType ?? string.Empty) != typeof(ProfilePictureEditor)) {
            return null;
        }
        var model = link.Url == "ModelProfilePicture" ? Model : null;
        return new Dictionary<string, object>
        {
            [nameof(ProfilePictureEditor.Value)] = (link.Url == "ModelProfilePicture" ? model?.ProfilePicture : Active?.ProfilePicture)!,
            [nameof(ProfilePictureEditor.ValueChanged)] = EventCallback.Factory.Create<GXAppearance?>(this,
                image => ProfilePictureChanged(model, image)),
            [nameof(ProfilePictureEditor.Disabled)] = _savingProfilePictures || _action != CrudAction.Update || (link.Url == "ModelProfilePicture" && model == null),
            [nameof(ProfilePictureEditor.Id)] = model == null ? "manufacturer-profile-picture-editor" : "device-model-profile-picture-editor"
        };
    }

    private bool ShowManufacturerTab(GXMenuLink link)
        => Type.GetType(link.TargetType ?? string.Empty) != typeof(ProfilePictureEditor) ||
            (_action != CrudAction.Create && (link.Url != "ModelProfilePicture" || Model != null));

    private void ProfilePictureChanged(GXDeviceModel? model, GXAppearance? image)
    {
        if (_savingProfilePictures || _action != CrudAction.Update || Active == null) {
            return;
        }
        if (model == null)
        {
            Active.ProfilePicture = image;
            _manufacturerPictureChanged = true;
            GXEditContexts.For(Active).NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXManufacturer.ProfilePicture)));
        }
        else
        {
            if (!_modelPictureEdits.ContainsKey(model.Id))
                {
                _modelPictureEdits.Add(model.Id, (model, new GXProfilePictureEdit(model.ProfilePicture?.Id, model.Creator?.Id ?? Active.Creator?.Id)));
            }
            model.ProfilePicture = image;
            GXEditContexts.For(model).NotifyFieldChanged(new FieldIdentifier(model, nameof(GXDeviceModel.ProfilePicture)));
            GXEditContexts.For(Active).NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXManufacturer.Models)));
        }
    }

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXManufacturer? Active;

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Manufacturer;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingManufacturer);
            NotificationService?.RemoveByKey("Pages/Manufacturer/Manufacturer.OnInitializedAsync");
            //Get manufacturer data.
            var tmp = (await Http.GetAsJsonAsync<GetManufacturerResponse>(string.Format("api/Manufacturer?id={0}", Id)));
            if (tmp?.Item != null)
            {
                Active = tmp.Item;
            }
            else
            {
                NavigationManager.NavigateTo("404");
                return;
            }
            Model = Active.Models?.FirstOrDefault();
            SetEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/Manufacturer.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    private GXProfilePictureEdit? _profilePictureEdit;
    private bool _manufacturerPictureChanged;
    private bool _savingProfilePictures;
    private readonly Dictionary<Guid, (GXDeviceModel Model, GXProfilePictureEdit Edit)> _modelPictureEdits = [];
    public bool DeleteTarget { get; set; }
    public GXDeviceModel? Model { get; set; }
    internal Task SelectModelAsync(GXDeviceModel model)
    {
        Model = model;
        return InvokeAsync(StateHasChanged);
    }
    public GXDeviceVersion? Version { get; set; }
    public GXDeviceModel[] InstalledModels { get; set; } = [];
    public GXDeviceVersion[] InstalledVersions { get; set; } = [];
    public GXDeviceSettings[] InstalledSettings { get; set; } = [];
    private void SetEditorMenu()
    {
        _profilePictureEdit = new GXProfilePictureEdit(Active?.ProfilePicture?.Id, Active?.Creator?.Id);
        _editorMenu = new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget), _action, OnSave, () => { OnCancel(); return Task.CompletedTask; });
    }
    public void Dispose() => _editorMenu?.Dispose();

    public async Task OnSave()
    {
        if (_savingProfilePictures) {
            return;
        }
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            NotificationService?.RemoveByKey("Pages/Manufacturer/ManufacturerGeneral.OnSave");
            var items = GetInstalledMeters();
            if (items.Any())
            {
                var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.InstallMetersVerify, "",
                    new AmiConfirmationOptions
                    {
                        ConfirmText = Properties.Resources.Install,
                        AllowDelete = false,
                        Items = items
                    });
                await OnInstallConfirmation(confirmation);
            }
            else
            {
                await SaveProfilePicturesAsync();
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/ManufacturerGeneral.OnSave");
        }
    }

    private async Task SaveProfilePicturesAsync()
    {
        if (_savingProfilePictures || Active == null || (!_manufacturerPictureChanged && _modelPictureEdits.Count == 0)) {
            return;
        }
        _savingProfilePictures = true;
        try
        {
            var manufacturer = Active;
            var modelEdits = _modelPictureEdits.Values.ToArray();
            Func<Task> save = async () =>
            {
                await Http.PostAsJson<UpdateManufacturerResponse>("api/Manufacturer/Update",
                    new UpdateManufacturer { Manufacturers = [manufacturer] });
            };
            if (_manufacturerPictureChanged)
            {
                var saveOwner = save;
                save = () => (_profilePictureEdit ??= new GXProfilePictureEdit(null, manufacturer.Creator?.Id)).SaveAsync(Http,
                    manufacturer.ProfilePicture, image => manufacturer.ProfilePicture = image, saveOwner,
                    error => NotificationService?.ReportError(error, "Manufacturer.ProfilePicture.Cleanup"));
            }
            foreach (var pending in modelEdits)
            {
                var saveOwner = save;
                save = () => pending.Edit.SaveAsync(Http, pending.Model.ProfilePicture,
                    image => pending.Model.ProfilePicture = image, saveOwner,
                    error => NotificationService?.ReportError(error, "Manufacturer.ModelProfilePicture.Cleanup"));
            }
            await save();
            foreach (var pending in modelEdits) {
                GXEditContexts.For(pending.Model).MarkAsUnmodified();
            }
            _modelPictureEdits.Clear();
            _manufacturerPictureChanged = false;
            GXEditContexts.For(manufacturer).MarkAsUnmodified();
        }
        finally
        {
            _savingProfilePictures = false;
        }
    }

    private string[] GetInstalledMeters()
    {
        var items = InstalledModels
            .Where(model => model.Versions != null && !model.Versions.Any(version => version.Settings?.Any(setting => setting.Template != null) == true))
            .Select(model => string.Format(Properties.Resources.InstallVersions, model.ToString())).ToList();
        if (items.Count == 0)
        {
            items.AddRange(InstalledVersions
                .Where(version => version.Settings != null && !version.Settings.Any(setting => setting.Template != null))
                .Select(version => string.Format(Properties.Resources.InstallAllSettings, Model?.ToString(), version.ToString())));
            if (items.Count == 0)
            {
                items.AddRange(InstalledSettings.Where(setting => setting.Template == null)
                    .Select(setting => Model?.ToString() + " " + Version?.ToString() + " " + setting.ToString()));
            }
        }
        return items.ToArray();
    }

    public async Task OnInstallConfirmation(AmiConfirmationResult args)
    {
        if (_savingProfilePictures) {
            return;
        }
        try
        {
            if (args.Confirm)
            {
                await SaveProfilePicturesAsync();
                using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingManufacturer);
                var models = InstalledModels;
                var versions = InstalledVersions;
                var settings = InstalledSettings;
                await Http.PostAsJson<InstallManufacturersResponse>("api/Manufacturer/Install",
          new InstallManufacturers()
          {
              Models = models,
              Versions = versions,
              Settings = settings
          });
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        finally
        {
            if (args.Confirm)
            {
            }
        }

    }

    private void OnCancel()
    {
        if (_savingProfilePictures) {
            return;
        }
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}
