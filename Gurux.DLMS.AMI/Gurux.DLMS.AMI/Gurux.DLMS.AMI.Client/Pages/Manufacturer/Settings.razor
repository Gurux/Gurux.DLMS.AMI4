@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums

@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text.Json;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Settings" />

<GXViewTable ViewName="Manufacturer.Settings" ViewColumns="ViewColumnDefaults" TItem="GXDeviceSettings" @ref="table"
         Context="item"
         ItemsProvider="@GetItems"
         OnChecked="@(items => Parent!.Owner.InstalledSettings = items.ToArray())"
         SelectionMode="SelectionMode.Multiple"
         ShowRemoved="false"
         ShowAllUsers="false"
         Filter="false"
         Total="false"
         ShowAllData="true"
         OnCheckboxDisabled="@OnCheckboxDisabled"
         OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Authentication">
        </GXFh>
        <GXFh Id="InterfaceType">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Security"></GXFh>
        <GXFh Id="PreEstablished"></GXFh>
        <GXFh Id="Installed"></GXFh>
    </FilterContent>
    <HeaderContent>
        <GXTh Id="Authentication" TItem="GXDeviceSettings">@Properties.Resources.Authentication</GXTh>
        <GXTh Id="InterfaceType" TItem="GXDeviceSettings">@Properties.Resources.InterfaceType</GXTh>
        <GXTh Id="Security" TItem="GXDeviceSettings">@Properties.Resources.Security</GXTh>
        <GXTh Id="PreEstablished" TItem="GXDeviceSettings">@Properties.Resources.PreEstablished</GXTh>
        <GXTh Id="Installed" TItem="GXDeviceSettings">@Properties.Resources.Installed</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Authentication">@GetAuthenticationLevel(item)</GXTd>
        <GXTd Id="InterfaceType">@GetInterfaceType(item)</GXTd>
        <GXTd Id="Security">@GetSecurity(item)</GXTd>
        <GXTd Id="PreEstablished">@GetPreEstablished(item)</GXTd>
        <GXTd Id="Installed">@item.InstallationTime</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Authentication") { Position = 0, Description = "Authentication", Visibility = (byte)Visibility.All },
        new("InterfaceType") { Position = 1, Description = "InterfaceType", Visibility = (byte)Visibility.All },
        new("Security") { Position = 2, Description = "Security", Visibility = (byte)Visibility.All },
        new("PreEstablished") { Position = 3, Description = Properties.Resources.PreEstablished, Visibility = (byte)Visibility.All },
        new("Installed") { Position = 4, Description = "Installed", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;

    private IGXNotificationService? NotificationService;

    [CascadingParameter]
    private ManufacturerGeneral? Parent { get; set; }

    private GXDeviceVersion? Version
    {
        get
        {
            return Parent?.Version;
        }
    }

    string GetInterfaceType(GXDeviceSettings value)
    {
        return ((Gurux.DLMS.Enums.InterfaceType)(JsonSerializer.Deserialize<GXDLMSSettings>(value.Settings ?? "{}") ?? new()).InterfaceType).ToString();
    }

    string GetSecurity(GXDeviceSettings value)
    {
        return ((Gurux.DLMS.Enums.Security)(JsonSerializer.Deserialize<GXDLMSSettings>(value.Settings ?? "{}") ?? new()).Security).ToString();
    }

    string GetPreEstablished(GXDeviceSettings value)
    {
        return (JsonSerializer.Deserialize<GXDLMSSettings>(value.Settings ?? "{}") ?? new()).PreEstablished.ToString();
    }

    string GetAuthenticationLevel(GXDeviceSettings value)
    {
        // Catalog entries contain a profile name before their settings are
        // downloaded. Missing settings do not imply Authentication.None.
        var settings = string.IsNullOrWhiteSpace(value.Settings) ? null : JsonSerializer.Deserialize<GXDLMSSettings>(value.Settings);
        if (settings == null)
            {
            return value.Name ?? string.Empty;
        }
        if (!string.IsNullOrEmpty(settings.AuthenticationName))
        {
            //Return authentication name if used.
            return settings.AuthenticationName;
        }
        return ((Gurux.DLMS.Enums.Authentication)settings.Authentication).ToString();
    }

    /// <summary>
    /// Settings filter.
    /// </summary>
    private GXDeviceSettings filter = new GXDeviceSettings();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXDeviceSettings>? table;

    /// <summary>
    /// Update installed items.
    /// </summary>
    public GXDeviceSettings[] GetInstalledItems()
    {
        List<GXDeviceSettings> list = new List<GXDeviceSettings>();
        if (table != null)
        {
            foreach (var it in table.SelectedItems)
            {
                if (it.Template == null)
                {
                    list.Add(it);
                }
            }
        }
        return list.ToArray();
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        try
        {
            //Select first setting.
            GXDeviceSettings? first = Version?.Settings?.FirstOrDefault();
            if (first != null)
            {
                if (table != null)
                {
                    //Get last selected item.
                    table.RestoreSelection(first);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Checkbox is disabled if template is already installed.
    /// </summary>
    public void OnCheckboxDisabled(GXDeviceSettings value, out bool disabled, out bool check)
    {
        disabled = value.Template != null; check = disabled || Parent?.Owner.InstalledSettings.Any(item => item.Id == value.Id) == true;
    }

    /// <summary>
    /// Update table.
    /// </summary>
    public async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Manufacturer/Settings.Updated");
                await table.RefreshDataAsync(true);
                //Select first setting.
                GXDeviceSettings? first = Version?.Settings?.FirstOrDefault();
                if (first != null)
                {
                    if (table != null)
                    {
                        //Get last selected item.
                        table.RestoreSelection(first);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/Settings.Updated");
        }
    }

    private async ValueTask<ItemsProviderResult<GXDeviceSettings>> GetItems(GXItemsProviderRequest request)
    {
        try
        {
            if (Version?.Settings != null)
            {
                return new ItemsProviderResult<GXDeviceSettings>(Version.Settings, Version.Settings.Count);
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Remove selected models.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected models.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveManufacturer req = new RemoveManufacturer()
                    {
                        Delete = args.Delete,
                        Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                    };
                await Http.PostAsJson<RemoveManufacturerResponse>("api/Manufacturer/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}

