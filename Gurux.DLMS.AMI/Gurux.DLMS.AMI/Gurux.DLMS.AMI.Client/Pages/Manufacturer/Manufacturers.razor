@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.DLMS.AMI.Client.Pages.Config;
@using Gurux.UI.Components
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text.Json

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXConfigUpdate

<GXHelpContext Topic="Manufacturers" />

<PageTitle>@Properties.Resources.Manufacturers</PageTitle>

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Install" Id="Install" OnClick="@OnInstall"></GXMenuEntry>
    </ChildContent>
</GXMenuControl>

@if (_settings != null)
{
    <EditForm EditContext="@GXEditContexts.For(_settings)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@string.Format(Properties.Resources.LastChecked, ClientHelpers.GetLastChecked(_settings.Checked))</label>
                    <button type="button" class="btn btn-link" @onclick="@OnCheck">(@Properties.Resources.CheckManually)</button>
                </div>
            </div>
        </div>
    </EditForm>
}
<GXViewTable ViewName="Manufacturer.Manufacturers" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXManufacturerPolicies.View })" TItem="GXManufacturer" @ref="table"
             Context="manufacturer"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             ShowAllUsers="false"
             ShowAllData="true"
             OnCheckboxDisabled="@OnCheckboxDisabled"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="Manufacturers-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdateTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = "".Equals(__e.Value) ? DateTime.MinValue : Convert.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXManufacturerPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Install" Id="Install" OnClick="@OnInstall" Policy="@GXManufacturerPolicies.Edit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="Name" Target="@manufacturer">@Properties.Resources.Name</GXTh>
        <GXTh Name="CreationTime" Target="@manufacturer" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Updated" Target="@manufacturer">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/config/Manufacturer/Edit/" + manufacturer.Id)">@manufacturer.Name</GXTd>
        <GXTd Id="CreationTime">@manufacturer.CreationTime</GXTd>
        <GXTd Id="Updated">@manufacturer.Updated</GXTd>
    </ItemContent>
</GXViewTable>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Updated") { Position = 2, Description = "Updated", Visibility = (byte)Visibility.All },
    ];

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Manufacturer.ManufacturerManage? Parent { get; set; }

    /// <summary>
    /// Manufacturer filter.
    /// </summary>
    private GXManufacturer filter = new GXManufacturer();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXManufacturer>? table;

    /// <summary>
    /// Manufacturer settings.
    /// </summary>
    private ManufacturerSettings? _settings;


    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Parent?.Active?.Settings))
        {
            _settings = JsonSerializer.Deserialize<ManufacturerSettings>(Parent.Parent.Active.Settings);
        }
        _ = InvokeAsync(async () =>
        {
            await Updated();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Manufacturer/Manufacturers.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/Manufacturers.Updated");
        }
    }

    /// <summary>
    /// Checkbox is disabled if all templates are already installed.
    /// </summary>
    public void OnCheckboxDisabled(GXManufacturer value, out bool disabled, out bool check)
    {
        disabled = true;
        check = true;
        if (value.Models != null)
        {
            foreach (var model in value.Models)
            {
                if (model.Versions != null)
                {
                    foreach (var version in model.Versions)
                    {
                        if (version.Settings != null)
                        {
                            foreach (var it in version.Settings)
                            {
                                if (it.InstallationTime == null)
                                {
                                    check = disabled = false;
                                    return;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingManufacturers);
            NotificationService?.RemoveByKey("Pages/Manufacturer/Manufacturers.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Manufacturer, configuration =>
                {
                    if (Parent?.Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => true, NotificationService));
            });
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
             {
                 foreach (var it in items)
                 {
                     if (it.Type == GXManufacturerPolicies.Add ||
                             it.Type == GXManufacturerPolicies.Edit ||
                             it.Type == GXManufacturerPolicies.Delete)
                     {
                         _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                         break;
                     }
                 }
             });
            if (!string.IsNullOrEmpty(Parent?.Parent?.Active?.Settings))
            {
                _settings = JsonSerializer.Deserialize<ManufacturerSettings>(Parent.Parent.Active.Settings);
            }
            else
            {
                _settings = new ManufacturerSettings();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/Manufacturers.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXManufacturer>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingManufacturers);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            filter.Template = true;
            ListManufacturers req = new ListManufacturers()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = true,
                //Get manufacturer template information.
                Select = new string[] { "Version" }
            };
            ListManufacturersResponse ret = await Http.PostAsJson<ListManufacturersResponse>("api/Manufacturer/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXManufacturer>((ret.Manufacturers ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit manufacturer.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Manufacturer/Manufacturers.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "config/Manufacturer/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Manufacturer/Manufacturers.OnEdit");
        }
    }

    /// <summary>
    /// Install selected manufacturers.
    /// </summary>
    private async Task OnInstall()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToInstallSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Install,
                    AllowDelete = false,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            await OnInstallConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Install the selected manufacturers.
    /// </summary>
    public async Task OnInstallConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingManufacturer);
                List<GXManufacturer> manufacturers = new List<GXManufacturer>();
                foreach (var manufacturer in table.SingleOrDefault())
                {
                    manufacturers.Add(new GXManufacturer() { Id = manufacturer.Id });
                }
                InstallManufacturers req = new InstallManufacturers()
                {
                    Manufacturers = manufacturers.ToArray()
                };
                var ret = await Http.PostAsJson<InstallManufacturersResponse>("api/Manufacturer/Install", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Check manufacturers manually.
    /// </summary>
    public async Task OnCheck()
    {
        using var progressScope4 = Progress?.ProgressStart(GXProgress.CheckingManufacturers);
        NotificationService?.RemoveByKey("update.manufacturers");
        try
        {
            await Services.GetRequiredService<GXBackgroundTaskNotifications>()
                .CheckManufacturersAsync(progressScope4?.CancellationToken ?? CancellationToken.None);
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (OperationCanceledException) when (progressScope4?.CancellationToken.IsCancellationRequested == true) { }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "update.manufacturers");
        }
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

