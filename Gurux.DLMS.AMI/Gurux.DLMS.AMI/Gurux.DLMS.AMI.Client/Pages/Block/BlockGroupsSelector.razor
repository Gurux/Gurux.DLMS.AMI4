@using Gurux.DLMS.AMI.Client.Helpers.Selection
@using Gurux.DLMS.AMI.Client.Pages.User;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject NavigationManager NavigationManager
@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="BlockGroupsSelector" />

<GXRelationshipSelector TItem="GXBlockGroup" @ref="_selectionContainer"
                        SelectedItems="@(() => _selectedItems)"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems"
                        Disabled="@Disabled">
    <ItemContent>
            @context.Name

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether relationship changes are disabled by the parent editor.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>References the edit model collection that is saved by the parent editor.</summary>
    private List<GXBlockGroup> _selectedItems = [];

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Receives the containing user group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private UserGroup? UserGroupParent { get; set; }

    /// <summary>Receives the containing block editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Block? BlockParent { get; set; }

    /// <summary>Coordinates paged checkbox selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXBlockGroup>? _selectionContainer;

    /// <summary>Stores endpoint criteria shared by selected and available block group queries.</summary>
    private GXBlockGroup _filter = new GXBlockGroup(null);

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null)
            {
                _filter.Name = name;
                _notificationService?.RemoveByKey("Pages/Block/BlockGroupsSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Block/BlockGroupsSelector.SearchByName");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = _filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        _filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(_filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/Block/BlockGroupsSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Block/BlockGroupsSelector.SearchByUser");
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXBlockGroup>> GetItems(GXRelationshipQuery<GXBlockGroup> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingBlockGroups);
        try
        {
            ListBlockGroups req = new ListBlockGroups()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = _filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Included = request.Included?.Select(item => item.Id).ToArray(),
                    OrderBy = nameof(GXBlockGroup.Id),
                    Exclude = request.Excluded.Select(item => item.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListBlockGroupsResponse>("api/BlockGroup/List", req, request.CancellationToken);
            if (ret?.BlockGroups != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXBlockGroup>(ret.BlockGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXBlockGroup>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (_selectionContainer == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidNotifier);
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingBlockGroups);
            _notificationService?.RemoveByKey("Pages/Block/BlockGroupsSelector.OnInitializedAsync");
            CrudAction action;
            if (UserGroupParent?.Active?.BlockGroups != null)
            {
                //Add selected block groups.
                _selectedItems = UserGroupParent.Active.BlockGroups;
                action = ClientHelpers.GetAction(NavigationManager, UserGroupParent.Action);
            }
            else if (BlockParent?.Active?.BlockGroups != null)
            {
                //Add selected block groups.
                _selectedItems = BlockParent.Active.BlockGroups;
                action = ClientHelpers.GetAction(NavigationManager, BlockParent.Action);
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            bool addDefaultBlocks = action == CrudAction.Create && !_selectedItems.Any();
            if (addDefaultBlocks)
            {
                //Show default groups when new group is added.
                ListBlockGroups req = new ListBlockGroups()
                    {
                        Filter = new GXBlockGroup()
                        {
                            Default = true
                        },
                        Count = 5,
                        Exclude = _selectedItems.Select(s => s.Id).ToArray()
                    };
                var ret = await Http.PostAsJson<ListBlockGroupsResponse>("api/BlockGroup/List", req);
                if (ret?.BlockGroups != null)
                {
                    _selectedItems.AddRange(ret.BlockGroups);
                }
            }
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Block/BlockGroupsSelector.OnInitializedAsync");
        }
    }
}

