@page "/blocks"
@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Blocks" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXBlockPolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXBlockPolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.Regenerate" Id="Regenerate" OnClick="@OnRegenerate" Policy="@GXBlockPolicies.Edit" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Block.Blocks" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXBlockPolicies.View })" TItem="GXBlock" @ref="table"
             @bind-Active="Active"
             Context="block"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="BlockType"></GXFh>
        <GXFh Id="Title"></GXFh>
        <GXFh Id="Location"></GXFh>
        <GXFh Id="LocationOrder"></GXFh>
        <GXFh Id="PublishTime"></GXFh>
        <GXFh Id="EndTime"></GXFh>
    </FilterContent>
    <MenuContent>
        <AuthorizeView Policy="@GXBlockPolicies.View">
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
        </AuthorizeView>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="Name" Target="@block">@Properties.Resources.Name</GXTh>
        <GXTh Name="BlockType" Target="@block">@Properties.Resources.Type</GXTh>
        <GXTh Name="Title" Target="@block">@Properties.Resources.Title</GXTh>
        <GXTh Name="Location" Target="@block">@Properties.Resources.Location</GXTh>
        <GXTh Name="LocationOrder" Target="@block">@Properties.Resources.LocationOrder</GXTh>
        <GXTh Name="PublishTime" Target="@block">@Properties.Resources.Publish</GXTh>
        <GXTh Name="EndTime" Target="@block">@Properties.Resources.EndTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Config/Block/Edit/" + block.Id)"><span class=@(ClientHelpers.GetActiveDot(block.Enabled))></span>@block.Name</GXTd>
        <GXTd Id="BlockType">@block.BlockType</GXTd>
        <GXTd Id="Title">@block.Title</GXTd>
        <GXTd Id="Location">@block.Location</GXTd>
        <GXTd Id="LocationOrder">@block.LocationOrder</GXTd>
        <GXTd Id="PublishTime">@block.PublishTime</GXTd>
        <GXTd Id="EndTime">@block.EndTime</GXTd>
    </ItemContent>
</GXViewTable>
<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("BlockType") { Position = 1, Description = "Type", Visibility = (byte)Visibility.All },
        new("Title") { Position = 2, Description = "Title", Visibility = (byte)Visibility.All },
        new("Location") { Position = 3, Description = "Location", Visibility = (byte)Visibility.All },
        new("LocationOrder") { Position = 4, Description = "LocationOrder", Visibility = (byte)Visibility.All },
        new("PublishTime") { Position = 5, Description = "Publish", Visibility = (byte)Visibility.All },
        new("EndTime") { Position = 6, Description = "EndTime", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    /// <summary>
    /// Selected block ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXBlock? Active { get; set; }


    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Blocks;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "blocks";
        }
    }

    /// <summary>
    /// Amount of the blocks shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Block filter.
    /// </summary>
    private GXBlock filter = new GXBlock();
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXBlock>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Block/Blocks.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/Blocks.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingBlocks);
            NotificationService?.RemoveByKey("Pages/Block/Blocks.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXBlockPolicies.Add ||
                        it.Type == GXBlockPolicies.Edit ||
                        it.Type == GXBlockPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXBlock() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/Blocks.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXBlock>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingBlocks);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListBlocks req = new ListBlocks()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListBlocksResponse>("api/Block/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXBlock>((ret.Blocks ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new block.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/Config/Block/Add");
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit block.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Block/Blocks.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Config/Block/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/Blocks.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected block.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected blocks.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveBlock req = new RemoveBlock()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveBlockResponse>("api/Block/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Regenerate menus.
    /// </summary>
    public async Task OnRegenerate()
    {
        try
        {
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToRegenerateMenus, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Regenerate,
                    AllowDelete = false
                });
            await OnRegenerateConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Refresh menus.
    /// </summary>
    public async Task OnRegenerateConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progress = Progress?.ProgressStart(Properties.Resources.Regenerate);
                RegenerateBlock req = new RegenerateBlock()
                {
                };
                await Http.PostAsJson<RegenerateBlockResponse>("api/Block/Regenerate", req,
                    progress?.CancellationToken ?? CancellationToken.None);
                await Updated();
                NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.TheBlocksHaveBeenRegenerated, string.Empty, Closable: true));
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

