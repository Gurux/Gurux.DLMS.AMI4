@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="BlockGroup" />

@if (Active != null)
{
    <EditForm EditContext="@GXEditContexts.For(Active)">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <PolicyTabs>
            <GeneralContent>
                <div class="row">
                    <div style="width:100%">
                        <div class="form-group">
                            <GXCopyButton Value="@Active.Name">@Properties.Resources.Name</GXCopyButton>
                            <InputText id="name" disabled="@IsDeleting" class="form-control"
                                       @bind-Value="Active.Name" />
                        </div>
                        <div class="form-group">
                            <GXInputSwitch Text="@Properties.Resources.DefaultGroup"
                                         @bind-Value="Active.Default" />
                            <br />
                        </div>
                        <div class="form-group">
                            <label>@Properties.Resources.Description</label>
                            <InputText id="name" disabled="@IsDeleting" class="form-control"
                                       @bind-Value="Active.Description" />
                        </div>
                        <div class="form-group">

                        </div>
                        <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                                            Updated="@Active.Updated" @bind-Removed="Active.Removed" />
                        @if (Action == CrudAction.Delete)
                        {
                            <hr />
                            <p>
                            </p>
                            <div class="form-group">
                                <InputRadioGroup @bind-Value="DeleteTarget">
                                    <InputRadio Value="false">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDisableQuestion</label><br>
                                    <InputRadio Value="true">
                                    </InputRadio>
                                    <label>@Properties.Resources.TargetDeleteQuestion</label>
                                </InputRadioGroup>
                                <br />
                            </div>
                        }
                    </div>
                </div>
            </GeneralContent>
            <PolicyContent>
                <Gurux.UI.Components.GXPolicyEditor @bind-Value="Active.Policies" Disabled="@(Action == CrudAction.Delete)" />
            </PolicyContent>
        </PolicyTabs>
    </EditForm>
}
@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter, EditorRequired]
    public GXBlockGroup? Active { get; set; }

    /// <summary>
    /// User Action.
    /// </summary>
    [Parameter, EditorRequired]
    public CrudAction Action { get; set; }

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter] public BlockGroup Owner { get; set; } = default!;
    private bool DeleteTarget { get => Owner.DeleteTarget; set => Owner.DeleteTarget = value; }
    public string? IsDeleting
    {
        get
        {
            if (Action != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingBlockGroup);
            NotificationService?.RemoveByKey("Pages/Block/BlockGroup.OnInitializedAsync");
            if (Active == null && Id != null)
            {
                //Get block group data.
                var tmp = (await Http.GetAsJsonAsync<GetBlockGroupResponse>(string.Format("api/BlockGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                }
            }
            if (Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }


        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/BlockGroup.OnInitializedAsync");
        }
    }


}
