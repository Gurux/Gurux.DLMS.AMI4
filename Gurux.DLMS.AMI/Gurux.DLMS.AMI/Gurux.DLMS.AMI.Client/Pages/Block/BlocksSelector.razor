@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="BlocksSelector" />

<SelectionContainer TItem="GXBlock" @ref="@_selectionContainer">
    <SelectionList TItem="GXBlock" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXBlock" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter, EditorRequired]
    public GXBlockGroup? Active { get; set; }

    SelectionList<GXBlock>? _selected;
    SelectionList<GXBlock>? _available;
    SelectionContainer<GXBlock>? _selectionContainer;
    /// <summary>
    /// Block filter.
    /// </summary>
    private GXBlock filter = new GXBlock(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(name))
                {
                    name = name.ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.Name != null && !(it.Name ?? string.Empty).ToLower().Contains(name))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/Block/BlocksSelector.SearchSelectedByName");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/BlocksSelector.SearchSelectedByName");
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Block/BlocksSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/BlocksSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.BlockGroups = null;
                }
                else
                {
                    GXUser user;
                    GXBlockGroup? bg = filter.BlockGroups?.FirstOrDefault();
                    if (bg == null)
                    {
                        bg = new GXBlockGroup();
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        bg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        filter.BlockGroups = new List<GXBlockGroup>(new GXBlockGroup[] { bg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(bg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Block/BlocksSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/BlocksSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXBlock>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return default;
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXBlock>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXBlock>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingBlocks);
        try
        {
            ListBlocks req = new ListBlocks()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListBlocksResponse>("api/Block/List", req, request.CancellationToken);
            if (ret?.Blocks != null && _selected != null)
            {
                return new ItemsProviderResult<GXBlock>(ret.Blocks, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingBlocks);
            NotificationService?.RemoveByKey("Pages/Block/BlocksSelector.OnInitializedAsync");
            if (_selected != null && Active?.Blocks != null)
            {
                _selected.Items = Active.Blocks;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Block/BlocksSelector.OnInitializedAsync");
        }
    }
}

