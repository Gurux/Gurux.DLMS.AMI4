@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="ModuleGroup" />

<h1>
    @_title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ModuleGroupTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    /// <summary>Controls whether the loaded data can be displayed.</summary>
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action,
        ["ModuleGroup"] = Active
    };

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? _title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXModuleGroup Active = new GXModuleGroup(null);

    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    _title = Properties.Resources.Add;
                    break;
                case "Edit":
                    _title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    _title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            _title += " " + Properties.Resources.ModuleGroup;
            using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingModuleGroup);
            _notificationService?.RemoveByKey("Pages/Module/ModuleGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get module group data.
                var tmp = (await Http.GetAsJsonAsync<GetModuleGroupResponse>(string.Format("api/ModuleGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            _ready = true;
            EditorMenu.Set(Active, EditorAction, OnSave, OnCancel);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Module/ModuleGroup.OnInitializedAsync");
        }
    }

    /// <summary>Owns editing commands and connects their enabled state to the current form.</summary>
    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);
    private CrudAction EditorAction => ClientHelpers.GetAction(NavigationManager, Action);
    public bool DeleteTarget { get; set; }
    public void Dispose() => _editorMenu?.Dispose();

    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.SavingModuleGroup);
            _notificationService?.RemoveByKey("Pages/Module/ModuleGroupGeneral.OnSave");
            if (EditorAction == CrudAction.Delete)

            {
                await Http.PostAsJson<RemoveModuleGroupResponse>("api/ModuleGroup/Delete", new RemoveModuleGroup()
                    {
                        Ids = new Guid[] { Active.Id },
                        Delete = DeleteTarget
                    });
            }
            else
            {
                string address;
                if (EditorAction == CrudAction.Create)
                {
                    address = "api/ModuleGroup/Add";
                }
                else if (EditorAction == CrudAction.Update)
                {
                    address = "api/ModuleGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddModuleGroupResponse>(address, new AddModuleGroup() { ModuleGroups = new GXModuleGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Module/ModuleGroupGeneral.OnSave");
        }
    }
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
}
