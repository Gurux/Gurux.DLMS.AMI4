@using Gurux.DLMS.AMI.Client.Pages.Config;
@using Gurux.DLMS.AMI.Client.Pages.Module
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs

@namespace Gurux.DLMS.AMI.Client.Pages.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="ModuleManage" />

@if (string.Compare(EditorAction, "Add", true) == 0 || (Id != null && Path != null && string.Compare(EditorAction, "Edit", true) == 0))
{
    @if (string.Compare(Path, "config/module", true) == 0)
    {
        <Module Action="@EditorAction" Id="@Id"></Module>
        @if (!string.IsNullOrWhiteSpace(Id))
        {
            <ModuleHealth @key="Id" ModuleId="@Id" />
        }
    }
    else if (string.Compare(Path, "config/moduleGroup", true) == 0)
    {
        <ModuleGroup Action="@Action" Id="@GetId()"></ModuleGroup>
    }
    else if (string.Compare(Path, "config/modulelog", true) == 0)
    {
        <ModuleLog Id="@GetId()"></ModuleLog>
    }
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="config/Module" Active="@ActivePath" SelectionChanged="@SelectionChanged">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.ModuleTab" ParametersForLink="@GetTabParameters" />
        </ChildContent>
    </GXTabControl>
    <br />
}
@code {
    private string? EditorAction => string.IsNullOrWhiteSpace(Action) && !string.IsNullOrWhiteSpace(Id) &&
        string.Equals(Path, "config/module", StringComparison.OrdinalIgnoreCase) ? "Edit" : Action;

    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
    {
        return Type.GetType(link.TargetType ?? "") == typeof(Modules)
            ? new Dictionary<string, object>
            {
                [nameof(Modules.Parent)] = this,
                [nameof(Modules.Title)] = false
            } : null;
    }

    private IGXNotifier? Notifier;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private Guid? GetId()
    {
        if (string.IsNullOrEmpty(Id))
        {
            return null;
        }
        return Guid.Parse(Id);
    }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Path { get; set; }

    private string? ActivePath => string.Equals(Path, "config/ModuleManage", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Path, "config/ModuleUpdate", StringComparison.OrdinalIgnoreCase)
        ? "config/Module" : Path;

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(GXTabPage page)
    {
        Path = page.Path;
    }

    protected override Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        if (Notifier == null)
        {
            return Task.CompletedTask;
        }

        return base.OnInitializedAsync();
    }

}



