@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@using System.Net.Http.Headers
@using Gurux.DLMS.AMI.Client.Layout
@inject ModuleLoader Loader
@using Gurux.DLMS.AMI.Module.Enums
@inject AuthenticationStateProvider Authentication
@inject IAuthorizationService Authorization
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Module" />

<h1>
    @Title
</h1>
<ModuleRemovalDialog @ref="_removalDialog" Removed="OnModuleRemovedAsync" />
@if (!isAdding && !string.IsNullOrWhiteSpace(Active.Id))
{
    <ModulePendingUpdatesPanel @ref="pendingUpdatesPanel" ModuleId="@Active.Id" OnApplied="RefreshInstalledModuleAsync" />
}
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ModuleDetailsTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
@if (_ready && _configurationUI != null)
{
    <div hidden="@(!GeneralVisible)"><EditForm EditContext="@FormContext"><ModuleErrorBoundary @key="_configurationUI" ModuleId="@Active.Id"><CascadingValue Name="GXHelpActive" Value="@GeneralVisible"><ModuleWrapper Target="@Active" ModuleId="@Active.Id" @ref="_module" ComponentType="_configurationUI" Settings="@Active.GetSettings()" SettingsChanged="@((string? value) => Active.SetSettings(value))" /></CascadingValue></ModuleErrorBoundary></EditForm></div>
}
<br />
@code {
    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);
    private EditContext FormContext => GXEditContexts.For(Active);
    internal byte[]? _value;
    internal CrudAction action;
    internal bool isAdding;
    private ModuleWrapper? _module;
    private Type? _configurationUI;
    private ModuleRemovalDialog? _removalDialog;
    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;
    internal bool GeneralVisible;
    internal void SetGeneralVisible(bool visible)
    {
        GeneralVisible = visible;
        if (!_disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private bool _ready;
    private ModulePendingUpdatesPanel? pendingUpdatesPanel;
    private async Task RefreshInstalledModuleAsync()
    {
        var response = await Http.GetFromJsonAsync<GetModuleResponse>("api/Module?id=" + Uri.EscapeDataString(Active.Id), _lifetime.Token);
        if (response?.Item is { } saved)
        {
            Active.Version = saved.Version;
            Active.ReleaseVersion = saved.ReleaseVersion;
            Active.Status = saved.Status;
            Active.RuntimeState = saved.RuntimeState;
        }
        await Loader.RefreshAsync(_lifetime.Token);
    }

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action,
        ["Id"] = Id!
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXModule Active = new GXModule("");

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += string.Equals(Action, "Add", StringComparison.OrdinalIgnoreCase)
                ? " " + Properties.Resources.Module
                : " " + Id + " " + Properties.Resources.Module;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModule);
            NotificationService?.RemoveByKey("Pages/Module/Module.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get module data.
                var tmp = (await Http.GetAsJsonAsync<GetModuleResponse>("api/Module?id=" + Id));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            action = _action;
            isAdding = action == CrudAction.Create;
            Loader.Changed += OnLoaderChanged;
            await ShowModuleSettings();
            _ready = true;
            EditorMenu.Set(Active, action, OnSave, OnCancel);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/Module.OnInitializedAsync");
        }
    }

    public async Task OnSave()
    {
        HttpResponseMessage response;
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (action == CrudAction.Delete)
            {
                _removalDialog?.Show([Active]);
                return;
            }
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingModule);
            NotificationService?.RemoveByKey("Pages/Module/ModuleGeneral.OnSave");
            if (action == CrudAction.Create)
            {
                if (_value == null)
                {
                    throw new Exception(Properties.Resources.ModuleFileIsNotSelected);
                }
                var content = new ByteArrayContent(_value);
                content.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
                response = await Http.PostAsync("api/Module/Add", content);
                await response.EnsureSuccessAsync(default);
                AddModuleResponse? ret = await response.Content.ReadFromJsonAsync<AddModuleResponse>();
                if (ret?.Restart == true)
                {
                    NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information,
                        Properties.Resources.ModuleUpdatePrepared, "", "Modules.Upload"));
                }
                if (ret != null && ret.Modules != null && ret.Modules.Any())
                {
                    Active = ret.Modules.First();
                    if (Active != null)
                    {
                        isAdding = false;
                        EditorMenu.Set(Active, action, OnSave, OnCancel);
                        FormContext.NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXModule.Properties)));
                        await ShowModuleSettings();
                        action = CrudAction.Update;
                        Action = "Edit";
                        EditorMenu.Set(Active, action, OnSave, OnCancel);
                        StateHasChanged();
                    }
                }
            }

            else if (action == CrudAction.Update)
            {
                if (_module != null)
                {
                    //Module is null when it's set from inactive to active.
                    await _module.NotifySavedAsync();
                }
                UpdateModule req = new UpdateModule() { Module = Active };
                await Http.PostAsJson<UpdateModuleResponse>
                    ("api/Module/Update", req);
                // Saving rotates property concurrency tokens, including when only Enabled
                // changed. Keep the form's model instance, but use the persisted versions
                // before the newly activated settings editor can issue another save.
                var saved = (await Http.GetFromJsonAsync<GetModuleResponse>(
                    "api/Module?id=" + Uri.EscapeDataString(Active.Id), _lifetime.Token))?.Item
                    ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget);
                Active.Properties = saved.Properties;
                Active.ConcurrencyStamp = saved.ConcurrencyStamp;
                Active.Updated = saved.Updated;
                Active.Enabled = saved.Enabled;
                Active.Status = saved.Status;
                Active.RuntimeState = saved.RuntimeState;
                FormContext.MarkAsUnmodified();
                NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.SettingsSaved, string.Empty, Closable: true));
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            await Loader.RefreshAsync(_lifetime.Token);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleGeneral.OnSave");
        }
    }
    private async Task OnCancel()
    {
        if (_module != null)
        {
            await _module.NotifyCancelAsync();
        }
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
    public async Task ShowModuleSettings()
    {
        if (_disposed)
        {
            return;
        }
        var token = _lifetime.Token;
        try
        {
            if (Active != null && _configurationUI == null)
            {
                if (!Loader.IsInitialized)
                {
                    await Loader.RefreshAsync(token);
                }

                if (_disposed)
                {
                    return;
                }

                var declaredView = Loader.AddIns.FirstOrDefault(m => m.Id == Active.Id)?.Views.FirstOrDefault(v => v.Area == AmiViewArea.Configuration && v.Key == null);
                if (declaredView == null || string.IsNullOrWhiteSpace(declaredView.Policy) || !(await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, declaredView.Policy)).Succeeded)
                {
                    return;
                }

                var configurationUI = await Loader.GetViewTypeAsync(Active.Id, AmiViewArea.Configuration, cancellationToken: token);
                if (_disposed)
                {
                    return;
                }

                _configurationUI = configurationUI;
            }

            if (_module != null)
            {
                await _module.NotifyInitializedAsync();
            }
        }
        catch (OperationCanceledException)when (_disposed)
        {
        }
    }
    private async Task OnModuleRemovedAsync(IReadOnlyList<ModuleRemovalResult> results)
    {
        await Loader.RefreshAsync(_lifetime.Token);
        if (results.Any(r => r.ModuleId == Active?.Id && r.Success))
        {
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
    }
    private void OnLoaderChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }
            _configurationUI = null;
            _module = null;
            StateHasChanged();
            try
            {
                if (Loader.RefreshError != null)
                {
                    NotificationService?.ReportError(Loader.RefreshError);
                }

                await ShowModuleSettings();
            }
            catch (OperationCanceledException)when (_disposed)
            {
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        _editorMenu?.Dispose();
        Loader.Changed -= OnLoaderChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _configurationUI = null;
        _module = null;
    }
}
