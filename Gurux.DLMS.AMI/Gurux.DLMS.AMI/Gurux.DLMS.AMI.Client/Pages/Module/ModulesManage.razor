@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable

<GXHelpContext Topic="ModulesManage" />

<h1>@Properties.Resources.ModulesTitle</h1>
<AuthorizeView Roles=@GXRoles.Admin
               Policy=@GXModulePolicies.Add>
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
        </ChildContent>
    </GXMenuControl>
</AuthorizeView>

<label><input type="checkbox" @bind="_includePrereleases" @bind:after="ChannelChangedAsync" /> Show prereleases</label>
<GXViewTable ViewName="Module.ModulesManage" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXModulePolicies.View })"
         TItem="GXModule" @ref="table"
         Context="module"
         ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Single"
         ShowRemoved="false"
         ShowAllUsers="false"
         OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Image">
            @*Icon*@
        </GXFh>
        <GXFh Id="Name">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Id = Convert.ToString(__e.Value) ?? string.Empty)" />
        </GXFh>
        <GXFh Id="Version">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByVersion"
                   @onchange="@((ChangeEventArgs __e) => filter.Version = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="AvailableVersion">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByLatestVersion"
                   @onchange="@((ChangeEventArgs __e) => filter.AvailableVersion = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="ModulesManage-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = Convert.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <AuthorizeView Policy="@GXModulePolicies.Add">
            <GXContextMenuItem Text="@Properties.Resources.Install"
                             Id="Install"
                             OnClick="@OnInstall"></GXContextMenuItem>
        </AuthorizeView>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Image" width="1%"></GXTh>
        <GXTh Id="Name">@Properties.Resources.Name</GXTh>
        <GXTh Id="Version">@Properties.Resources.Version</GXTh>
        <GXTh Id="AvailableVersion">@Properties.Resources.AvailableVersion</GXTh>
        <GXTh Id="CreationTime">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Image" class="img-cell">
            <GXImage Id="@module.Id"></GXImage>
        </GXTd>
        <GXTd Id="Name">@module.Id</GXTd>
        <GXTd Id="Version">@module.Version</GXTd>
        <GXTd Id="AvailableVersion">
            <GXInputDropdown TValue="string" class="form-control" Value="@SelectedVersion(module.Id)" ValueChanged="@(value => SelectVersion(module.Id, value))" Items="@(new[] { "" }.Concat((_versions.GetValueOrDefault(module.Id) ?? []).Where(version => version.Installable).Select(version => version.Id.ToString())))" Formatter="@(value => CatalogVersionLabel(module.Id, value))" RememberValue="false" />
        </GXTd>
        <GXTd Id="CreationTime">@module.CreationTime</GXTd>
        <GXTd Id="Updated">@module.Updated</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private string? CatalogVersionLabel(string id, string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return _includePrereleases ? Properties.Resources.LatestIncludingPrereleases : Properties.Resources.LatestStable;
        }
        var version = _versions[id].First(version => version.Id.ToString() == value);
        return version.Number + (version.Prerelease ? " (prerelease)" : "");
    }
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Image") { Position = 0, Description = "Image", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Version") { Position = 2, Description = "Version", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("AvailableVersion") { Position = 3, Description = "AvailableVersion", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 4, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 5, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// System error filter.
    /// </summary>
    private GXModule filter = new GXModule();
    private bool _includePrereleases;
    private Dictionary<string,List<ModuleReleaseInfo>> _versions=new();
    private readonly Dictionary<string,Guid> _selectedVersions=new();
    private string SelectedVersion(string id)=>_selectedVersions.TryGetValue(id,out var version)?version.ToString():"";
    private void SelectVersion(string id,object? value){
        if (Guid.TryParse(value?.ToString(), out var version))
        {
            _selectedVersions[id] = version;
        }
        else
        {
            _selectedVersions.Remove(id);
        }
    }
    private Task ChannelChangedAsync(){_selectedVersions.Clear();
        if (table != null)
        {
            table.ResetPage();
        }
        return table?.RefreshDataAsync(true)??Task.CompletedTask;}



    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXModule>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Module/ModulesManage.Updated");
                table.ResetPage();
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesManage.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModulesManage);
            NotificationService?.RemoveByKey("Pages/Module/ModulesManage.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXModulePolicies.Add ||
                        it.Type == GXModulePolicies.Edit ||
                        it.Type == GXCatalogNotifications.ModuleUpdated ||
                        it.Type == GXModulePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesManage.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingModulesManage);
        using var linked=CancellationTokenSource.CreateLinkedTokenSource(request.CancellationToken,(progressScope2?.CancellationToken ?? CancellationToken.None));
        try
        {
            ListModules req = new ListModules()
            {
                CatalogOnly = true,
                IncludePrereleases = _includePrereleases,
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            var ret = await Http.PostAsJson<ListModulesResponse>("api/Module/List", req, linked.Token);
            _versions=ret.CatalogVersions;
            //Get only selected amount of the modules.
            return new ItemsProviderResult<GXModule>((ret.Modules ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Install new module.
    /// </summary>
    public async void OnInstall()
    {
        try
        {
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingModulesManage);
            NotificationService?.RemoveByKey("Pages/Module/ModulesManage.OnInstall");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            var selected = _selectedVersions.GetValueOrDefault(table.Active.Id);
            if (selected == Guid.Empty && _includePrereleases)
            {
                selected = _versions.GetValueOrDefault(table.Active.Id)?.FirstOrDefault(v => v.Installable)?.Id ?? Guid.Empty;
            }
            InstallModule req = new InstallModule() { Module = new GXModule(table.Active.Id), VersionId = selected != Guid.Empty ? selected : null };
            await Http.PostAsJson<InstallModuleResponse>("api/Module/Install", req, (progressScope3?.CancellationToken ?? CancellationToken.None));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesManage.OnInstall");
        }
    }

    /// <summary>
    /// Add new module.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Module/ModulesManage.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager,  "/config/Module/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesManage.OnAdd");
        }
    }

    void OnClose(object sender)
    {
        ClientHelpers.NavigateTo(NavigationManager,  "/module");
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
