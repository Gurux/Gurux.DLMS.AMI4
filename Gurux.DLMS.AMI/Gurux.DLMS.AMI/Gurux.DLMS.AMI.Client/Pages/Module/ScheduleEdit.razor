@using Gurux.DLMS.AMI.Module.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider Authentication
@inject IAuthorizationService Authorization

@using Gurux.DLMS.AMI.Client.Layout
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Module
@using Microsoft.Extensions.Logging
@inject IServiceProvider Services
@inject HttpClient Http
@inject ILogger<ScheduleEdit> Logger
@inject ModuleLoader Loader
@inject IGXMenuService SharedMenuService
@implements IDisposable

<GXHelpContext Topic="ScheduleEdit" />

@if (_extensionUI != null)
{
    <EditForm EditContext="@GXEditContexts.For(this)">
        <ModuleErrorBoundary ModuleId="@Module?.Id" @key="_loadedTarget">
        <ModuleWrapper Target="@Schedule" @key="_loadedTarget" @ref="_module"
                       ModuleId="@Module?.Id" ComponentType="@_extensionUI"
                       Settings="@_settings?.Settings" SettingsChanged="@SaveSettingsAsync" />
        </ModuleErrorBoundary>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    [Parameter]
    public GXModule? Module { get; set; }

    [Parameter]
    public GXSchedule? Schedule { get; set; }

    [Parameter]
    public EventCallback Closed { get; set; }

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;
    private readonly CancellationTokenSource _lifetime = new();
    private GXScheduleModule? _settings;
    private Type? _extensionUI;
    private ModuleWrapper? _module;
    private (string ModuleId, Guid ScheduleId)? _loadedTarget;
    private bool _menuInitialized;
    private bool _busy;
    private int _loadVersion;
    private bool _canSave;

    protected override Task OnInitializedAsync()
    {
        Loader.Changed += LoaderChanged;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        return Task.CompletedTask;
    }

    private void AuthenticationChanged(Task<AuthenticationState> state) => LoaderChanged();
    private void LoaderChanged() => _ = InvokeAsync(async () =>
    {
        if (_lifetime.IsCancellationRequested)
        {
            return;
        }
        ++_loadVersion;
        _extensionUI = null;
        _module = null;
        _canSave = false;
        _menuInitialized = false;
        MenuService.Clear();
        await OnParametersSetAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        if (Module == null || Schedule == null || (_extensionUI != null && _loadedTarget == (Module.Id, Schedule.Id)))
        {
            return;
        }
        var target = (ModuleId: Module.Id, ScheduleId: Schedule.Id);
        var version = ++_loadVersion;
        _extensionUI = null;
        _module = null;
        _menuInitialized = false;
        MenuService.Clear();
        try
        {
            using var progress = Progress?.ProgressStart(GXProgress.RetrievingScheduleEdit);
            if (!Loader.IsInitialized)
            {
                await Loader.RefreshAsync(_lifetime.Token);
            }
            var declaredView = Loader.AddIns.FirstOrDefault(m => m.Id == target.ModuleId)?.Views.FirstOrDefault(v => v.Area == AmiViewArea.ScheduleSettings && v.Key == null);
                if (declaredView == null || string.IsNullOrWhiteSpace(declaredView.Policy) || !(await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, declaredView.Policy)).Succeeded)
                {
                    return;
                }
                var component = await Loader.GetViewTypeAsync(target.ModuleId, AmiViewArea.ScheduleSettings, cancellationToken: _lifetime.Token);
            if (component == null)
            {
                throw new InvalidOperationException(Properties.Resources.ThisModuleHasNoScheduleEditor);
            }
            var settings = target.ScheduleId != Guid.Empty ? await ReadSettingsAsync(target.ModuleId, target.ScheduleId) : null;
            if (version != _loadVersion || Module?.Id != target.ModuleId || Schedule?.Id != target.ScheduleId)
            {
                return;
            }
            _settings = settings;
            _canSave = typeof(IGXAmiModuleSettings).IsAssignableFrom(component);
            _loadedTarget = target;
            _extensionUI = component;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Failed to load schedule module editor.");
            NotificationService?.ReportError(error);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_menuInitialized || _extensionUI == null)
        {
            return;
        }
        _menuInitialized = true;
        var commands = new List<GXMenuItem>();
        if (_canSave)
        {
            commands.Add(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSaveAsync)));
        }
        commands.Add(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancelAsync)));
        MenuService.Clear();
        MenuService.AddMenuItems(commands);
    }

    private async Task<GXScheduleModule?> ReadSettingsAsync(string moduleId, Guid scheduleId)
    {
        var response = await Http.PostAsJson<GetModuleSettingsResponse>("api/Schedule/GetModuleSettings",
            new GetModuleSettings { Item = new GXScheduleModule { ModuleId = moduleId, ScheduleId = scheduleId } }, _lifetime.Token);
        return response?.Item;
    }

    private async Task SaveSettingsAsync(string? settings)
    {
        if (Module == null || Schedule == null)
        {
            throw new ArgumentException(Properties.Resources.InvalidTarget);
        }
        _settings ??= new GXScheduleModule { ModuleId = Module.Id, ScheduleId = Schedule.Id };
        _settings.Settings = settings;
        using var progress = Progress?.ProgressStart(GXProgress.SavingSchedule);
        await Http.PostAsJson<UpdateModuleSettingsResponse>("api/Schedule/UpdateModuleSettings",
            new UpdateModuleSettings { Item = _settings }, _lifetime.Token);
        // The update endpoint does not return the new concurrency stamp.
        _settings = await ReadSettingsAsync(_settings.ModuleId, _settings.ScheduleId) ?? _settings;
    }

    public async Task SaveAsync()
    {
        if (_module == null || !_canSave)
        {
            throw new InvalidOperationException(Properties.Resources.TheScheduleEditorIsNotReadyToSave);
        }
        await _module.NotifySavedAsync();
    }

    private async Task OnSaveAsync()
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            await SaveAsync();
            await Closed.InvokeAsync();
        }
        catch (Exception error)
        {
            NotificationService?.ReportError(error);
            Logger.LogError(error, "Failed to save schedule module settings.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnCancelAsync()
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            if (_module != null)
            {
                await _module.NotifyCancelAsync();
            }
            await Closed.InvokeAsync();
        }
        catch (Exception error)
        {
            NotificationService?.ReportError(error);
            Logger.LogError(error, "Failed to cancel schedule module editing.");
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        Loader.Changed -= LoaderChanged;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        MenuService.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
