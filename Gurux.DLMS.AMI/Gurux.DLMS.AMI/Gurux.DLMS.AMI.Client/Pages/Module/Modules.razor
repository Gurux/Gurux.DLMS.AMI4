@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/modules"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Text.Json

@namespace Gurux.DLMS.AMI.Client.Pages.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@implements IDisposable
@implements IGXAmiComponent

<GXHelpContext Topic="Modules" />

@if (Title)
{
    <h1>@Properties.Resources.ModulesTitle</h1>
}

<AuthorizeView Roles="@GXRoles.Admin" Policy="@GXModulePolicies.Add">
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
        </ChildContent>
    </GXMenuControl>
</AuthorizeView>

@if (_settings != null)
{
    <EditForm EditContext="@GXEditContexts.For(_settings)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    @if (_settings?.Checked != null)
                    {
                        <label>
                            @string.Format(Properties.Resources.LastChecked,
                            ClientHelpers.GetLastChecked(_settings?.Checked))
                </label>
                                }
                    <button type="button" class="btn btn-link"
                            @onclick="OnCheck">
                        (@Properties.Resources.CheckManually)
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
}
<label><input type="checkbox" @bind="_includePrereleases" @bind:after="ChannelChangedAsync" /> Show prereleases</label>
@if (_interactive)
{
    <div class="module-table">
    <GXViewTable ViewName="Module.Modules" ViewColumns="ViewColumnDefaults"
                 ViewPolicies="@(new List<string> { GXModulePolicies.View })" TItem="GXModule" @ref="table" Context="module"
                 ItemsProvider="@GetItems" SelectionMode="SelectionMode.Single" Filter="@Filter" Columns="@Columns"
                 CanEdit="@CanEdit" ShowRemoved="false" ShowAllUsers="false" OnSearch="@Updated">
        <FilterContent>
            <GXFh Id="Image" class="module-icon-column">
                @*Icon*@
            </GXFh>
            <GXFh Id="Name">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                       @onchange="@((ChangeEventArgs __e) => filter.Id = Convert.ToString(__e.Value) ?? string.Empty)" />
            </GXFh>
            <GXFh Id="Version">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByVersion"
                       @onchange="@((ChangeEventArgs __e) => filter.Version = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="AvailableVersion">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByAvailableVersion"
                       @onchange="@((ChangeEventArgs e) => filter.AvailableVersion = Convert.ToString(e.Value))" />
            </GXFh>
            <GXFh Id="Status"></GXFh>
            <GXFh Id="Enabled">
                <GXInputDropdown TValue="EnabledChoice" class="form-select" Value="@(new EnabledChoice(filter.Enabled))" ValueChanged="@(value => filter.Enabled = value.Value)" Items="@(new[] { new EnabledChoice(null), new EnabledChoice(true), new EnabledChoice(false) })" Formatter="@(value => value.Value == null ? Properties.Resources.All : value.Value.Value ? Properties.Resources.Enabled : Properties.Resources.Disabled)" aria-label="@Properties.Resources.FilterByEnabled" RememberValue="false" />
            </GXFh>
            <GXFh Id="RuntimeState"></GXFh>
            <GXFh Id="CreationTime" Visibility="Visibility.Medium">
                <GXDateTimeSelector Id="Modules-CreationTime" @bind-Value="@filter.CreationTime"
                                    Placeholder="@Properties.Resources.FilterByCreationTime">
                </GXDateTimeSelector>
            </GXFh>
            <GXFh Id="Updated">
                <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime" type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Updated = Convert.ToDateTime(__e.Value))" />
            </GXFh>
        </FilterContent>
        <MenuContent>
            @if (IsInstalled(table?.Active))
            {
                <GXContextMenuItem Text="@Properties.Resources.Update" Id="update" OnClick="@OnInstallAsync"
                                 Policy="@GXModulePolicies.Add" />
            }
            else if (!string.IsNullOrWhiteSpace(table?.Active?.AvailableVersion))
            {
                <GXContextMenuItem Text="@Properties.Resources.Install" Id="install" OnClick="@OnInstallAsync"
                                 Policy="@GXModulePolicies.Add" />
            }
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXModulePolicies.Edit">
            </GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"
                             Policy="@GXModulePolicies.Delete"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Id="Image" class="module-icon-column"></GXTh>
            <GXTh Id="Name" Name="Name" Target="@module">@Properties.Resources.Name</GXTh>
            <GXTh Id="Version" Name="Version" Target="@module">@Properties.Resources.Version</GXTh>
            <GXTh Id="AvailableVersion">@Properties.Resources.AvailableVersion</GXTh>
            <GXTh Id="Status">@Properties.Resources.Installation</GXTh>
            <GXTh Id="Enabled" Name="Enabled" Target="@module">@Properties.Resources.Enabled</GXTh>
            <GXTh Id="RuntimeState">@Properties.Resources.Runtime</GXTh>
            <GXTh Id="CreationTime" Name="CreationTime" Target="@module" SortMode="SortMode.Descending">
                @Properties.Resources.CreationTime
            </GXTh>
            <GXTh Id="Updated" Name="Updated" Target="@module">@Properties.Resources.Updated</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Image" class="module-icon-column">
                <span class="module-list-icon"><ModuleStateIcon Module="@module" /></span>
            </GXTd>
            <GXTd Id="Name" Link="@(IsInstalled(module) ? NavigationManager.GetCurrentPagePath("/Config/Module/" + module.Id) : null)">
                @module.Id
            </GXTd>
            <GXTd Id="Version">@module.Version</GXTd>
            <GXTd Id="AvailableVersion">
                <GXInputDropdown TValue="Guid" class="form-select form-select-sm" Value="@_selectedVersions.GetValueOrDefault(module.Id, _versions.GetValueOrDefault(module.Id)?.FirstOrDefault(v => v.Installable)?.Id ?? Guid.Empty)" Disabled="@(!_versions.GetValueOrDefault(module.Id)?.Any(v => v.Installable) ?? true)" ValueChanged="@(value => SelectCatalogVersion(module.Id, value))" Items="@CatalogVersionItems(module.Id)" Formatter="@(value => CatalogVersionLabel(module, value))" RememberValue="false" />
            </GXTd>
            <GXTd Id="Status">@GXModulePresentation.For(module).Installation</GXTd>
            <GXTd Id="Enabled">@GXModulePresentation.For(module).Enabled</GXTd>
            <GXTd Id="RuntimeState">@GXModulePresentation.For(module).Runtime</GXTd>
            <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(module.CreationTime)</GXTd>
            <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(module.Updated)</GXTd>
        </ItemContent>
    </GXViewTable>
    </div>
}
<ModuleRemovalDialog @ref="DeleteConfirmation" Removed="OnModulesRemoved" />
<br />
@code {
    private sealed record EnabledChoice(bool? Value);
    private IEnumerable<Guid> CatalogVersionItems(string id) => _versions.GetValueOrDefault(id)?.Any() == true
        ? _versions[id].Where(version => version.Installable).Select(version => version.Id)
        : new[] { Guid.Empty };
    private string? CatalogVersionLabel(GXModule module, Guid id)
    {
        var version = _versions.GetValueOrDefault(module.Id)?.FirstOrDefault(version => version.Id == id);
        return version == null ? module.AvailableVersion : version.Number + (version.Prerelease ? " (prerelease)" : "");
    }
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Image") { Position = 0, Description = "Image", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Version") { Position = 2, Description = "Version", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("AvailableVersion") { Position = 3, Description = "AvailableVersion", Visibility =
(byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Status") { Position = 4, Description = "Status", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Enabled") { Position = 5, Description = "Enabled", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("RuntimeState") { Position = 6, Description = "Runtime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 7, Description = "CreationTime", Visibility =
(byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 8, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Module.ModuleManage? Parent { get; set; }

    /// <summary>
    /// Selected module ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ModulesTitle;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "module";
        }
    }

    [Parameter]
    public GXModule? Active { get; set; }

    /// <summary>
    /// Amount of the modules shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Module filter for installed modules and available catalog entries.
    /// </summary>
    private GXModule filter = new GXModule()
    {
        Enabled = null,
        Status = null
    };

    private bool _includePrereleases;
    private Dictionary<string, List<ModuleReleaseInfo>> _versions = new();
    private readonly Dictionary<string, Guid> _selectedVersions = new();

    private void OnAdd() => ClientHelpers.NavigateTo(NavigationManager, "/config/Module/Add");

    private static bool IsInstalled(GXModule? module) => module != null &&
        (module.Status.GetValueOrDefault() & (ModuleStatus.Installed | ModuleStatus.CustomBuild)) != 0;

    private Task ChannelChangedAsync()
    {
        _selectedVersions.Clear();
        if (table != null)
        {
            table.ResetPage();
        }
        return Updated();
    }

    private void SelectCatalogVersion(string id, object? value)
    {
        if (Guid.TryParse(value?.ToString(), out var version))
        {
            _selectedVersions[id] = version;
        }
    }

    private async Task OnInstallAsync()
    {
        try
        {
            var module = table?.Active;
            if (module == null)
            {
                throw new InvalidOperationException(Properties.Resources.NoItemIsSelected);
            }
        
            var version = _selectedVersions.GetValueOrDefault(module.Id);
            if (version != Guid.Empty && _versions.GetValueOrDefault(module.Id)?.Any(v => v.Id == version && v.Installable && (_includePrereleases || !v.Prerelease)) != true)
            {
                throw new InvalidOperationException(Properties.Resources.TheSelectedVersionIsNotAvailableInTheCurrentReleaseChannel);
            }
        
            if (version == Guid.Empty)
            {
                version = _versions.GetValueOrDefault(module.Id)?.FirstOrDefault(v => v.Installable && (_includePrereleases || !v.Prerelease))?.Id ?? Guid.Empty;
            }
        
            if (version == Guid.Empty)
            {
                throw new InvalidOperationException(Properties.Resources.NoInstallableVersionAvailable);
            }
        
            using var progress = Progress?.ProgressStart(GXProgress.SavingModulesManage);
            await Http.PostAsJson<InstallModuleResponse>("api/Module/Install", new InstallModule { Module = new GXModule(module.Id), VersionId = version }, (progress?.CancellationToken ?? CancellationToken.None));
            await Updated();
        }
        catch (Exception error)
        {
            NotificationService?.ReportError(error, "Pages/Module/Modules.Install");
        }
    }

    /// <summary>
    /// User is verified before module is removed.
    /// </summary>
    protected Gurux.DLMS.AMI.Client.Helpers.ModuleRemovalDialog? DeleteConfirmation;

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXModule>? table;
    private bool _interactive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Module settings.
    /// </summary>
    private ModuleSettings? _settings;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Module/Modules.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/Modules.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/Module/Modules.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Modules, configuration =>
                {
                    if (Parent?.Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Parent.Active.Settings = configuration.Settings;
                    _settings = JsonSerializer.Deserialize<ModuleSettings>(configuration.Settings!);
                    StateHasChanged();
                }, () => true, NotificationService));
            });
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXModulePolicies.Add ||
                        it.Type == GXModulePolicies.Edit ||
                        it.Type == GXModulePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXModule() { Id = Id };
            }
            //Get configuration data.
            if (!string.IsNullOrEmpty(Parent?.Parent?.Active?.Settings))
            {
                _settings = JsonSerializer.Deserialize<ModuleSettings>(Parent.Parent.Active.Settings);
            }
            else
            {
                _settings = new ModuleSettings();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/Modules.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModules);
        try
        {
            ListModules req = new ListModules()
            {
                CatalogOnly = true,
                IncludePrereleases = _includePrereleases,
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListModulesResponse>("api/Module/List", req, request.CancellationToken);
            _versions = ret.CatalogVersions;
            return new ItemsProviderResult<GXModule>((ret.Modules ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit module.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Module/Modules.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Config/Module/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/Modules.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected module.
    /// </summary>
    public void OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            DeleteConfirmation?.Show(table.SingleOrDefault().ToArray());
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected modules groups.
    /// </summary>
    private async Task OnModulesRemoved(IReadOnlyList<ModuleRemovalResult> results)
    {
        if (table != null)
        {
            await table.RefreshDataAsync(true);
        }
    }
    /// <summary>
    /// Check module versions manually.
    /// </summary>
    public async Task OnCheck()
    {
        using var progressScope2 = Progress?.ProgressStart(GXProgress.CheckingNewVersions);
        NotificationService?.RemoveByKey("Pages/Module/Modules.OnCheck");
        try
        {
            await Services.GetRequiredService<GXBackgroundTaskNotifications>()
                .CheckModulesAsync(progressScope2?.CancellationToken ?? CancellationToken.None);
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (OperationCanceledException) when (progressScope2?.CancellationToken.IsCancellationRequested == true) { }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/Modules.OnCheck");
        }
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
