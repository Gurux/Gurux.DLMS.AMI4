@using Gurux.DLMS.AMI.Module.Enums
@inject ModuleLoader Loader

@using Gurux.DLMS.AMI.Client.Pages.Schedule
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="ModulesSelector" />

<GXRelationshipSelector TItem="GXModule" @ref="_selectionContainer"
                        SelectedItems="@(() => _selectedItems)"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems" Disabled="@Disabled">
    <ItemContent>
        @if (_selectedItems.Any(item => item.Id == context.Id))
        {
            <GXLinkButton TItem="GXModule" OnClick="Show" Target="@context" Text="@context.Id" />
        }
        else
        {
            @context.Id
        }

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether the parent editor prevents changes to this relationship.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>References the live relationship saved by the parent editor.</summary>
    private List<GXModule> _selectedItems = [];

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Gets or sets the module group whose modules are selected.</summary>
    [Parameter, EditorRequired]
    public GXModuleGroup? ModuleGroup { get; set; }

    /// <summary>Receives the containing schedule editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Schedule? ScheduleParent { get; set; }

    /// <summary>Gets or sets the selected edit-model module whose settings are currently displayed.</summary>
    internal GXModule? Active { get; set; }

    /// <summary>Opens settings for the authoritative selected module matching the clicked row identity.</summary>
    /// <param name="item">The displayed module whose selected edit-model instance is opened.</param>
    private void Show(GXModule item)
    {
        try
        {
            Active = _selectedItems.FirstOrDefault(selected => selected.Id == item.Id);
            ScheduleParent?.Update();
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Hide module settings dialog.
    /// </summary>
    private void OnCancel()
    {
        Active = null;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Closes the active module settings selection and refreshes the component display.</summary>
    public void Update()
    {
        Active = null;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Coordinates paged selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXModule>? _selectionContainer;
    /// <summary>Stores endpoint criteria shared by selected and available module queries.</summary>
    private GXModule _filter = new GXModule("");

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (!string.IsNullOrEmpty(name))
                {
                    _filter.Id = name;
                }
                else
                {
                    _filter.Id = string.Empty;
                }
                _notificationService?.RemoveByKey("Pages/Module/ModulesSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Module/ModulesSelector.SearchByName");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.ModuleGroups = null;
                }
                else
                {
                    GXUser user;
                    GXModuleGroup? mg = _filter.ModuleGroups?.FirstOrDefault();
                    if (mg == null)
                    {
                        mg = new GXModuleGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        mg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        _filter.ModuleGroups = new List<GXModuleGroup>(new GXModuleGroup[] { mg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(mg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/Module/ModulesSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Module/ModulesSelector.SearchByUser");
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXRelationshipQuery<GXModule> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingModules);
        try
        {
            string[]? allowed = null;
            if (ScheduleParent != null)
            {
                if (!Loader.IsInitialized)
                {
                    await Loader.RefreshAsync(request.CancellationToken);
                }
                allowed = Loader.AddIns.Where(module => module.Views.Any(view => view.Area == AmiViewArea.ScheduleSettings))
                    .Select(module => module.Id).ToArray();
                if (allowed.Length == 0)
                {
                    return new ItemsProviderResult<GXModule>([], 0);
                }
            }
            ListModules req = new ListModules()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = _filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Included = allowed == null ? request.Included?.Select(item => item.Id).ToArray() :
                        request.Included == null ? allowed : allowed.Intersect(request.Included.Select(item => item.Id), StringComparer.OrdinalIgnoreCase).ToArray(),
                    OrderBy = nameof(GXModule.Id),
                    Exclude = request.Excluded.Select(item => item.Id).ToArray()
                };
            if (req.Included != null && !req.Included.Any())
            {
                return new ItemsProviderResult<GXModule>([], 0);
            }
            var ret = await Http.PostAsJson<ListModulesResponse>("api/Module/List", req, request.CancellationToken);
            if (ret?.Modules != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXModule>(ret.Modules, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXModule>([], 0);
    }

    /// <summary>Returns the relationship collection owned by the explicit parameter or the containing editor.</summary>
    /// <returns>The parent editor's authoritative relationship collection.</returns>
    private List<GXModule> GetModules()
    {
        if (ModuleGroup?.Modules != null)
        {
            return ModuleGroup.Modules;
        }
        //Get only scheduled modules.

        return ScheduleParent?.Active is { } parent ? parent.Modules ??= [] : [];
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            List<GXModule> modules = GetModules();
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingModules);
            _notificationService?.RemoveByKey("Pages/Module/ModulesSelector.OnInitializedAsync");
            if (_selectionContainer != null && modules != null)
            {
                _selectedItems = modules;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            //Read available items.
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Module/ModulesSelector.OnInitializedAsync");
        }
    }
}

