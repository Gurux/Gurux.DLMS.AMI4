@using Gurux.DLMS.AMI.Module.Enums
@inject ModuleLoader Loader

@using Gurux.DLMS.AMI.Client.Pages.Schedule
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="ModulesSelector" />

<SelectionContainer TItem="GXModule" @ref="@_selectionContainer">
    <SelectionList TItem="GXModule" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @if (context != null)
            {
                <GXLinkButton TItem="GXModule" OnClick="@Show"
                            Target="@context"
                            Text="@context.Id" />
            }
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXModule" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Id
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter, EditorRequired]
    public GXModuleGroup? ModuleGroup { get; set; }

    [CascadingParameter]
    private Schedule? ScheduleParent { get; set; }

    internal GXModule? Active { get; set; }


    private void Show(GXModule item)
    {
        try
        {
            Active = item;
            ScheduleParent?.Update();
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Hide module settings dialog.
    /// </summary>
    private void OnCancel()
    {
        Active = null;
        InvokeAsync(StateHasChanged);
    }

    public void Update()
    {
        Active = null;
        InvokeAsync(StateHasChanged);
        if (_selected != null)
        {
            //_selected.Update();
            //     await _selected.RefreshDataAsync();
        }
        if (_available != null)
        {
            //_available.Update();
            //   await _available.RefreshDataAsync();
        }
    }


    SelectionList<GXModule>? _selected;
    SelectionList<GXModule>? _available;
    SelectionContainer<GXModule>? _selectionContainer;
    /// <summary>
    /// Module filter.
    /// </summary>
    private GXModule filter = new GXModule("");

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(name))
                {
                    name = name.ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.Id != null && !it.Id.ToLower().Contains(name))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/Module/ModulesSelector.SearchSelectedByName");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesSelector.SearchSelectedByName");
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                if (!string.IsNullOrEmpty(name))
                {
                    filter.Id = name;
                }
                else
                {
                    filter.Id = string.Empty;
                }
                NotificationService?.RemoveByKey("Pages/Module/ModulesSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.ModuleGroups = null;
                }
                else
                {
                    GXUser user;
                    GXModuleGroup? mg = filter.ModuleGroups?.FirstOrDefault();
                    if (mg == null)
                    {
                        mg = new GXModuleGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        mg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        filter.ModuleGroups = new List<GXModuleGroup>(new GXModuleGroup[] { mg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(mg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Module/ModulesSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXModule>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return default;
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXModule>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModules);
        try
        {
            ListModules req = new ListModules()
                {
                    Index = ScheduleParent != null ? 0 : request.StartIndex,
                    Count = ScheduleParent != null ? 0 : request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListModulesResponse>("api/Module/List", req, request.CancellationToken);
            if (ret?.Modules != null && _selected != null)
            {
                if (ScheduleParent != null)
                {
                    if (!Loader.IsInitialized)
                    {
                        await Loader.RefreshAsync(request.CancellationToken);
                    }
            
                    var available = Loader.AddIns.Where(m => m.Views.Any(v => v.Area == AmiViewArea.ScheduleSettings)).Select(m => m.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
                    var modules = ret.Modules.Where(m => available.Contains(m.Id)).ToArray();
                    return new ItemsProviderResult<GXModule>(modules.Skip(request.StartIndex).Take(request.Count), modules.Length);
                }
            
                return new ItemsProviderResult<GXModule>(ret.Modules, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    private List<GXModule> GetModules()
    {
        if (ModuleGroup?.Modules != null)
        {
            return ModuleGroup.Modules;
        }
        //Get only scheduled modules.

        return ScheduleParent?.Active is { } parent ? parent.Modules ??= [] : [];
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            //Show only the scheduled modules for schedule selector.
            if (ScheduleParent != null)
            {
        
            }
            List<GXModule> modules = GetModules();
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingModules);
            NotificationService?.RemoveByKey("Pages/Module/ModulesSelector.OnInitializedAsync");
            if (_selected != null && modules != null)
            {
                _selected.Items = modules;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModulesSelector.OnInitializedAsync");
        }
    }
}

