@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/modulelogs"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="ModuleLogs" />

@if (Title)
{
    <PageTitle>@Properties.Resources.ModuleLogs</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose" Policy="@GXModuleLogPolicies.Close" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="clear" OnClick="@OnClear" Policy="@GXModuleLogPolicies.Clear" />
    </ChildContent>
</GXMenuControl>


@if (_interactive)
{
    <GXViewTable ViewName="Module.ModuleLogs" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXModuleLogPolicies.View })"
                 TItem="GXLog" @ref="table"
                 Context="item"
                 ItemsProvider="@GetItems"
                 SelectionMode="SelectionMode.Multiple"
                 ShowRemoved="false"
                 Filter="@Filter"
                 ShowAllUsers="@Header"
                 Columns="@Columns"
                 CanEdit="@CanEdit"
                 OnSearch="@Updated">
        <FilterContent>
            <GXFh Id="CreationTime" Visibility="Visibility.Medium">
                <GXDateTimeSelector Id="ModuleLogs-CreationTime"
                                    @bind-Value="@filter.CreationTime"
                                    Placeholder="@Properties.Resources.FilterByCreationTime">
                </GXDateTimeSelector>
            </GXFh>
            <GXFh Id="Module">
                <ModuleSelector @bind-Value="_moduleFilter"></ModuleSelector>
            </GXFh>
            <GXFh Id="Type" Visibility="Visibility.Medium">
                <EnumTypeSelector Type="@TargetType.ModuleLog"
                                  @bind-Value="@filter.Type"
                                  OnSelected="@((int? e) => Updated())">
                </EnumTypeSelector>
            </GXFh>
            <GXFh Id="Error">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByLog"
                       @onchange="@((ChangeEventArgs __e) => filter.Message = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="Level">
                <div>
                    <GXInputDropdown class="form-select"
                                     Id="ModuleLogs-TraceLevel"
                                     RememberValue="true"
                                     @bind-Value="TraceLevel"
                                     OnSelected="@((TraceLevel e) => Updated())">
                    </GXInputDropdown>
                </div>
            </GXFh>
            <GXFh Id="CloseTime">
                <input class="form-control" placeholder="@Properties.Resources.FilterByCloseTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Closed = @StatusTile.ToDateTime(__e.Value))" />
            </GXFh>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="async () => OnShow()"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Close" Id="edit" OnClick="OnClose"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Id="CreationTime" Name="CreationTime" Target="@item" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
            <GXTh Id="Module" Target="@item">@Properties.Resources.Module</GXTh>
            <GXTh Id="Type" Name="Type" Target="@item">@Properties.Resources.Type</GXTh>
            <GXTh Id="Error" Target="@item">@Properties.Resources.Error</GXTh>
            <GXTh Id="Level" Target="@item">@Properties.Resources.Level</GXTh>
            <GXTh Id="CloseTime" Target="@item">@Properties.Resources.CloseTime</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="CreationTime" Link="@NavigationManager.GetCurrentPagePath("/Config/ModuleLog/Edit/" + item.PublicId)">@ResourceStorage.DateTimeOffsetToString(item.CreationTime)</GXTd>
            <GXTd Id="Module">@item.SourceId</GXTd>
            <GXTd Id="Type">@(ResourceStorage.GetEnumType(TargetType.ModuleLog, item.Type))</GXTd>
            <GXTd Id="Error">@item.Message</GXTd>
            <GXTd Id="Level">@ClientHelpers.LevelToString(item.Level)</GXTd>
            <GXTd Id="CloseTime">@ResourceStorage.DateTimeOffsetToString(item.Closed)</GXTd>
        </ItemContent>
    </GXViewTable>
}
<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Module") { Position = 1, Description = "Module", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Type") { Position = 2, Description = "Type", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Error") { Position = 3, Description = "Error", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Level") { Position = 4, Description = "Level", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CloseTime") { Position = 5, Description = "CloseTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected module log ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ModuleLogs;
        }
    }

    private TraceLevel TraceLevel
    {
        get
        {
            return (TraceLevel)filter.Level.GetValueOrDefault();
        }
        set
        {
            if (filter != null)
            {
                if (value == TraceLevel.Off)
                {
                    //If filter is not used.
                    filter.Level = null;
                }
                else
                {
                    filter.Level = (int)value;
                }
            }
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "module-log";
        }
    }

    /// <summary>
    /// Amount of the module logs shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Module log filter.
    /// </summary>
    private GXModule? _moduleFilter;
    private GXLog filter = new GXLog()
    {
        Level = null
    };


    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXLog? Active
    {
        get
        {
            return table?.Active;
        }
    }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXLog>? table;
    private bool _interactive;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Module/ModuleLogs.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleLogs.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            if (string.Compare(Action, "Edit", true) == 0)
            {
                //If user edist the module log.
                return;
            }
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModuleLogs);
            NotificationService?.RemoveByKey("Pages/Module/ModuleLogs.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
          {
              foreach (var it in items)
              {
                  if (it.Type == GXModuleLogPolicies.Add ||
                            it.Type == GXModuleLogPolicies.Clear ||
                            it.Type == GXModuleLogPolicies.Close)
                  {
                      _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                      break;
                  }
              }
          });
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXLog() { PublicId = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleLogs.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingModuleLogs);
        try
        {
            if (ShowClosedErrors)
            {
                //Show closed errors.
                filter.Closed = DateTimeOffset.MaxValue;
            }
            else
            {
                //Show active errors.
                filter.Closed = null;
            }
            filter.SourceId = _moduleFilter?.Id;
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.ModuleLog);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=module", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                //Mark module logs as seen.
                if (ret.Logs.Any())
                {
                    if (Notifier != null)
                    {
                        await Notifier.Mark(Http, TargetType.ModuleLog, ret.Logs.Max(s => s.CreationTime));
                    }
                }
            
                if (Id.HasValue && table != null)
                {
                    table.RestoreSelection(ret.Logs?.FirstOrDefault(log => log.PublicId == Id.Value));
                }
            
                return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Show module log details.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Module/ModuleLogs.OnShow");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "Config/ModuleLog/Edit/" + table.Active.PublicId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleLogs.OnShow");
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnClose()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmClose, Properties.Resources.AreYouSureYouWantToCloseSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Close,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Message).ToArray()
                });
            await OnCloseConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnCloseConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                CloseLog req = new CloseLog()
                {
                    Ids = table.SingleOrDefault().Select(w => w.PublicId).ToArray()
                };
                await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=module", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Clear the module logs.
    /// </summary>
    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Module/ModuleLogs.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the agent error list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingModuleLog);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=module", new ClearLog());
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
