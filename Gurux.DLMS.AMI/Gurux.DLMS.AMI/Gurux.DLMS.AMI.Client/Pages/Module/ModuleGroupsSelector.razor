@using Gurux.DLMS.AMI.Client.Pages.User;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="ModuleGroupsSelector" />

@if (_interactive)
{
<SelectionContainer TItem="GXModuleGroup" @ref="@_selectionContainer">
    <SelectionList TItem="GXModuleGroup" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXModuleGroup" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>
}

@code {
    protected override void OnInitialized()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
    }

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private bool _interactive;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
            return;
        }
        if (!_initialized && _selectionContainer != null && _selected != null)
        {
            _initialized = true;
            await InitializeSelectionAsync();
        }
    }
    [CascadingParameter]
    private UserGroup? UserGroupParent { get; set; }
    [CascadingParameter]
    private Module? ModuleParent { get; set; }

    SelectionList<GXModuleGroup>? _selected;
    SelectionList<GXModuleGroup>? _available;
    SelectionContainer<GXModuleGroup>? _selectionContainer;

    /// <summary>
    /// Module group filter.
    /// </summary>
    private GXModuleGroup filter = new GXModuleGroup(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(name))
                {
                    name = name.ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.Name != null && !(it.Name ?? string.Empty).ToLower().Contains(name))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/Module/ModuleGroupsSelector.SearchSelectedByName");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleGroupsSelector.SearchSelectedByName");
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Module/ModuleGroupsSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleGroupsSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Module/ModuleGroupsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleGroupsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXModuleGroup>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return new(new ItemsProviderResult<GXModuleGroup>(Array.Empty<GXModuleGroup>(), 0));
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXModuleGroup>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXModuleGroup>> GetItems(GXItemsProviderRequest request)
    {
        if (!_initialized)
        {
            return new ItemsProviderResult<GXModuleGroup>(Array.Empty<GXModuleGroup>(), 0);
        }
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingModuleGroups);
        try
        {
            ListModuleGroups req = new ListModuleGroups()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListModuleGroupsResponse>("api/ModuleGroup/List", req, request.CancellationToken);
            if (ret?.ModuleGroups != null && _selected != null)
            {
                return new ItemsProviderResult<GXModuleGroup>(ret.ModuleGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    private async Task InitializeSelectionAsync()
    {
        try
        {
            if (_selectionContainer == null || _selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingModuleGroups);
            NotificationService?.RemoveByKey("Pages/Module/ModuleGroupsSelector.OnInitializedAsync");
            CrudAction action;
            if (UserGroupParent?.Active?.ModuleGroups != null)
            {
                //Add selected module.
                _selected.Items = UserGroupParent.Active.ModuleGroups;
                action = ClientHelpers.GetAction(NavigationManager, UserGroupParent.Action);

            }
            else if (ModuleParent?.Active?.ModuleGroups != null)
            {
                //Add selected module.
                _selected.Items = ModuleParent.Active.ModuleGroups;
                action = ClientHelpers.GetAction(NavigationManager, ModuleParent.Action);
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            bool addDefaultGroups = action == CrudAction.Create && !_selected.Items.Any();
            if (addDefaultGroups)
            {
                //Show default groups when new group is added.
                ListModuleGroups req = new ListModuleGroups()
                    {
                        Filter = new GXModuleGroup()
                        {
                            Default = true
                        },
                        Count = _selectionContainer.PageSize,
                        Exclude = _selected.Items.Select(s => s.Id).ToArray()
                    };
                var ret = await Http.PostAsJson<ListModuleGroupsResponse>("api/ModuleGroup/List", req);
                if (ret?.ModuleGroups != null)
                {
                    _selected.Items.AddRange(ret.ModuleGroups);
                }
            }
            await _selected.RefreshDataAsync();
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Module/ModuleGroupsSelector.OnInitializedAsync");
        }
    }
}

