@page "/objects"
@page "/objects/{Id:guid?}"
@page "/Object/{Action}"
@page "/Object/{Action}/{Id:guid?}"

@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Objects" />

@if (!string.IsNullOrEmpty(DeviceName))
{
    <p>
        <div class="oi oi-tablet" style="display: inline;">
            <AuthorizeView Policy="@GXDevicePolicies.Edit">
                <Authorized>
                    <a href="@NavigationManager.GetCurrentPagePath("/device/Edit/" + Device?.Id)"><h2 style="display: inline;">@DeviceName</h2></a>
                </Authorized>
                <NotAuthorized>
                    <h2 style="display: inline;">@DeviceName</h2>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </p>
    <hr />
}

@*If user adds a new item or modifies the existing one.*@
@if (string.Compare(Action, "Add", true) == 0 || (Id != null && string.Compare(Action, "Edit", true) == 0))
{
    <CascadingValue Value="this">
        <ObjectView @key="(Id, Device?.Id ?? TargetDeviceId)" Device="@(Device ?? (TargetDeviceId.HasValue ? new GXDevice { Id = TargetDeviceId.Value } : null))" Action="@Action" Id="@Id"></ObjectView>
    </CascadingValue>
}
else
{
    <GXTable TItem="GXObject" @ref="table"
             Context="item"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
        <FilterContent>
            <th>
                <input class="form-control" placeholder="@Properties.Resources.FilterByName"
                       type="search"
                       @oninput="@SearchByName" />
            </th>
            <th>
                <input class="form-control" placeholder="@Properties.Resources.FilterByLogicalName"
                       @oninput="@SearchByLogicalName" />
            </th>
            <th>
                <GXInputDropdown class="form-select"
                                 Id="Objects-ObjectType"
                                 RememberValue="true"
                                 @bind-Value="filterByObjectType"
                                 OnSelected="@((Enums.ObjectType e) => Updated())">
                </GXInputDropdown>
            </th>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Read" Id="Read" OnClick="@OnRead"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Clear" Id="remove" OnClick="@OnClear"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="Template.Name" Target="@item">@Properties.Resources.Name</GXTh>
            <GXTh Name="Template.LogicalName" Target="@item">@Properties.Resources.LogicalName</GXTh>
            <GXTh Name="Template.ObjectType" Target="@item">@Properties.Resources.ObjectType</GXTh>
            <GXTh Name="LastError" Target="@item">@Properties.Resources.LastError</GXTh>
            <GXTh Name="LastErrorMessage" Target="@item">@Properties.Resources.Error</GXTh>
            <GXTh Name="LastRead" Target="@item">@Properties.Resources.LastRead</GXTh>
            <GXTh Name="LastWrite" Target="@item">@Properties.Resources.LastWrite</GXTh>
            <GXTh Name="CreationTime" Target="@item">@Properties.Resources.CreationTime</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Link="@ObjectUrl(item)">@item.Template?.Name</GXTd>
            <td>@item.Template?.LogicalName</td>
            <td>@GetObjectType(item.Template?.ObjectType)</td>
            <td>@item.LastError</td>
            <td>@item.LastErrorMessage</td>
            <td>@item.LastRead</td>
            <td>@item.LastWrite</td>
            <td>@item.CreationTime</td>
        </ItemContent>
    </GXTable>
    <br />
    
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    /// <summary>
    /// Shown object types.
    /// </summary>
    /// <remarks>
    /// All object types are shown if object types are not set.
    /// </remarks>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? ObjectTypes { get; set; }

    /// <summary>
    /// Ignored object types.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.Enums.ObjectType[]? IgnoredObjectTypes { get; set; }

    

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Device ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "deviceId")]
    public Guid? TargetDeviceId { get; set; }

    private string ObjectUrl(GXObject item)
    {
        var url = (Device?.Id ?? item.Device?.Id) is Guid deviceId
            ? GXDeviceObjectRoutes.Object(deviceId, item.Id) : "/Object/Edit/" + item.Id;
        return NavigationManager.GetCurrentPagePath(url);
    }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXObject? Active
    {
        get
        {
            return table?.Active;
        }
    }

    /// <summary>
    /// Active device.
    /// </summary>
    [Parameter, EditorRequired]
    public GXDevice? Device { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXObject>? table;

    //Verify that history is clear.


    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Objects;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "oi oi-tablet";
        }
    }

    /// <summary>
    /// Amount of the objects to shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Filter using object type.
    /// </summary>
    private Enums.ObjectType filterByObjectType;
    /// <summary>
    /// Filter using object name.
    /// </summary>
    private string? filterByName;
    /// <summary>
    /// Filter by logical name of the object.
    /// </summary>
    private string? filterByLogicalName;

    /// <summary>
    /// Object filter.
    /// </summary>
    private GXObject filter = new GXObject();

    /// <summary>
    /// Device name.
    /// </summary>
    private string? DeviceName;

    //Get object type as a string.
    public string GetObjectType(int? value)
    {
        if (value == null)
        {
            return "";
        }
        return ((Gurux.DLMS.Enums.ObjectType)value).ToString();
    }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Objects/Objects.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Objects/Objects.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            if (NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Object/"))
            {
                //If object template is shown.
                return;
            }
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingObjects);
            NotificationService?.RemoveByKey("Pages/Objects/Objects.OnInitializedAsync");
            filter.Template = new GXObjectTemplate();
            if (Device == null && Id != null)
            {
                //Get device objects.
                var tmp = (await Http.GetAsJsonAsync<GetDeviceResponse>(string.Format("api/Device?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Device = tmp.Item;
                }
            }
            if (Device == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            DeviceName = Device.Name;
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), items =>
            {
                var updates = items.Where(item => item.Type == GXObjectPolicies.Add ||
                    item.Type == GXObjectPolicies.Edit || item.Type == GXObjectPolicies.Delete ||
                    item.Type == GXAttributePolicies.Add || item.Type == GXAttributePolicies.Edit ||
                    item.Type == GXValuePolicies.Add || item.Type == GXValuePolicies.Clear ||
                    item.Type == GXTaskPolicies.Edit).ToArray();
                if (updates.Length != 0)
                {
                    _ = GXNotificationRefresh.RefreshAsync(table, updates, () => InvokeAsync(Updated));
                }
            });
            if (Header)
            {
                MenuService.Clear();
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    Text = Properties.Resources.Read,
                    Icon = "Read",
                    OnClick = EventCallback.Factory.Create(this, OnReadSelected)
                });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Objects/Objects.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Search by name.
    /// </summary>
    private Task SearchByName(ChangeEventArgs args)
    {
        filterByName = Convert.ToString(args.Value);
        return Updated();
    }

    /// <summary>
    /// Search by logical name.
    /// </summary>
    private Task SearchByLogicalName(ChangeEventArgs args)
    {
        filterByLogicalName = Convert.ToString(args.Value);
        return Updated();
    }

    /// <summary>
    /// Search by object type.
    /// </summary>
    private Task SearchByObjectType(Enums.ObjectType item)
    {
        return Updated();
    }

    private async ValueTask<ItemsProviderResult<GXObject>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope3 = Progress?.ProgressStart(GXProgress.RetrievingObjects);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            if (filter.Template != null)
            {
                if (!string.IsNullOrEmpty(filterByName))
                {
                    filter.Template.Name = filterByName;
                }
                else
                {
                    filter.Template.Name = null;
                }
                filter.Template.ObjectType = (int)filterByObjectType;
                if (filter.Template.ObjectType == 0)
                {
                    filter.Template.ObjectType = null;
                }
                if (!string.IsNullOrEmpty(filterByLogicalName))
                {
                    filter.Template.LogicalName = filterByLogicalName;
                }
                else
                {
                    filter.Template.LogicalName = null;
                }
            }
            if (Device != null)
            {
                filter.Device = new GXDevice() { Id = Device.Id };
            }
            else if (Id.HasValue && Id.Value != Guid.Empty)
            {
                filter.Device = new GXDevice() { Id = Id.Value };
            }
            ListObjects req = new ListObjects()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                //Attributes are also read.
                Select = new string[] { "AttributeTemplate" }
            };
            if (ObjectTypes != null && ObjectTypes.Any())
            {
                req.ObjectTypes = ObjectTypes?.Cast<int>().ToArray();
            }
            if (IgnoredObjectTypes != null && IgnoredObjectTypes.Any())
            {
                req.IgnoredObjectTypes = IgnoredObjectTypes?.Cast<int>().ToArray();
            }
            var ret = await Http.PostAsJson<ListObjectsResponse>("api/Object/List", req, request.CancellationToken);
            //Update device for late binding.
            if (ret != null)
            {
                foreach (var it in (ret.Objects ?? []))
                {
                    it.Device = filter.Device;
                }
                return new ItemsProviderResult<GXObject>((ret.Objects ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Read selected object.
    /// </summary>
    public async void OnRead()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Objects/Objects.OnRead");
            using var progressScope4 = Progress?.ProgressStart(GXProgress.SavingObject);
            if (Active?.Template == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            GXTask task = new GXTask();
            task.Object = new() { Id = Active.Id };
            //Add target device for late binding.
            if (Active.Latebind)
            {
                task.TargetDevice = Device?.Id;
            }
            task.TaskType = TaskType.Read;
            AddTask req = new AddTask();
            req.Tasks = new GXTask[] { task };
            var response = await Http.PostAsJson<AddTaskResponse>("api/Task/Add", req);
            Services.GetService<GXReadTaskNotifications>()?.Track(response.Ids);
            //Read objects agein when late binding is used because object Id is set.
            if (Active.Latebind)
            {
                await Updated();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Objects/Objects.OnRead");
        }
    }

    /// <summary>
    /// Read all selected objects.
    /// </summary>
    public async void OnReadSelected()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Objects/Objects.OnReadSelected");
            using var progressScope5 = Progress?.ProgressStart(GXProgress.SavingObject);
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            List<GXObject> selectedItems = new List<GXObject>();
            selectedItems.AddRange(table.SingleOrDefault());
            Guid? batch = null;
            if (selectedItems.Count != 1)
            {
                batch = Guid.NewGuid();
            }
            bool lateBinding = false;
            List<GXTask> tasks = new();
            foreach (var it in selectedItems)
            {
                GXTask task = new GXTask()
                {
                    Object = new() { Id = it.Id },
                    TaskType = TaskType.Read,
                    Batch = batch,
                };
                //Add target device when late binding is used.
                if (it.Latebind)
                {
                    lateBinding = true;
                    task.TargetDevice = Device?.Id;
                }
                tasks.Add(task);
                task.Order = tasks.Count;
            }
            AddTask req = new AddTask();
            req.Tasks = tasks.ToArray();
            var response = await Http.PostAsJson<AddTaskResponse>("api/Task/Add", req);
            Services.GetService<GXReadTaskNotifications>()?.Track(response.Ids);
            //Read objects agein when late binding is used because object Id is set.
            if (lateBinding)
            {
                await Updated();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Objects/Objects.OnReadSelected");
        }
    }

    /// <summary>
    /// Show selected object.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Objects/Objects.OnShow");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, ObjectUrl(table.Active));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Objects/Objects.OnShow");
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClear()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDelete, string.Format(Properties.Resources.AreYouSureYouWantToClearObject0HistoryThisActionCannotBeUndone, Device?.Template?.Name),
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Clear,
                    AllowDelete = true
                });
            await OnClearConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                List<GXObject> objects = new List<GXObject>();
                foreach (var it in table.SingleOrDefault())
                {
                    objects.Add(new GXObject() { Id = it.Id });
                }
                ClearValue arg = new ClearValue()
                {
                    Objects = objects.ToArray()
                };
                await Http.PostAsJson<ClearValueResponse>("api/Value/Clear", arg);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    public void Dispose()
    {
        GXNotificationRefresh.Remove(this);
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        MenuService.Dispose();
        if (Device?.Objects != null)
        {
            //Device objects are clear when page is changed.
            // This is done because value might change and it's not updated if page is not active.
            Device.Objects.Clear();
        }
        Notifier?.RemoveListener(this);
    }
}

