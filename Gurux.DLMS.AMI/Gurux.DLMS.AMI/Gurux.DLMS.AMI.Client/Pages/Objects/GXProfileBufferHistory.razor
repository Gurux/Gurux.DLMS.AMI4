@using Gurux.DLMS
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest
@using System.Globalization
@inject HttpClient Http
@inject IServiceProvider Services

<h3>@Properties.Resources.StoredHistory</h3>
@if (AttributeId == Guid.Empty)
{
    <p role="status">@Properties.Resources.ResourceManager.GetString("ProfileHistoryRequiresRead", CultureInfo.CurrentUICulture)</p>
}
<div class="profile-range-controls">
    <label>@Properties.Resources.ProfileRangeStart
        <GXDateTimeSelector TItem="DateTime?" class="profile-range-start"
                            @bind-Value="_start" Save="false" />
    </label>
    <label>@Properties.Resources.ProfileRangeEnd
        <GXDateTimeSelector TItem="DateTime?" class="profile-range-end"
                            @bind-Value="_end" Save="false" />
    </label>
    <button type="button" class="profile-range-apply" @onclick="ApplyAsync" disabled="@(_busy || AttributeId == Guid.Empty || _start == null || _end == null)">@Properties.Resources.StoredHistory</button>
    <button type="button" class="profile-read-missing" @onclick="ReadAsync" disabled="@(_busy || !CanRead || AttributeId == Guid.Empty || _start == null || _end == null)">@Properties.Resources.ProfileReadMissing</button>
</div>
<p>@Properties.Resources.ProfileLocalTime</p>
@if (_error != null) { <p role="alert">@_error</p> }
@if (_message != null) { <p role="status">@_message</p> }
@if (_coverage != null)
{
    <details class="profile-history-coverage">
        <summary>@Properties.Resources.ProfileCoverage</summary>
        @foreach (var group in CoverageGroups())
        {
            <p>@group.Label: @group.Ranges.Length</p>
            <ul>
                @foreach (var range in group.Ranges)
                {
                    <li>@range.Start.ToLocalTime().ToString("g") – @range.End.ToLocalTime().ToString("g")</li>
                }
            </ul>
        }
    </details>
}
<GXTable TItem="GXProfileStoredRow" @ref="_table" @key="AttributeId"
         Context="value" ItemsProvider="GetItems"
         SelectionMode="SelectionMode.None" CanEdit="false"
         ShowAllUsers="false" ShowRemoved="false" Filter="false">
    <HeaderContent>
        <th>@Properties.Resources.Read</th>
        <th>@Properties.Resources.Values</th>
    </HeaderContent>
    <ItemContent>
        <td>@value.CapturedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
        <td class="gx-profile-history-value">@Decode(value.Value)</td>
    </ItemContent>
</GXTable>

@code {
    /// <summary>Gets or sets the persisted buffer identity, or Guid.Empty to show an empty panel before the device object is materialized.</summary>
    [Parameter]
    public Guid AttributeId { get; set; }

    /// <summary>Gets or sets whether the current editor permits collecting profile rows once a persisted buffer is available.</summary>
    [Parameter] public bool CanRead { get; set; } = true;
    /// <summary>Identifies the attribute owning the current coverage, error and status state.</summary>
    private Guid _previousAttributeId;
    /// <summary>References the rendered table so its loaded rows and selection can be refreshed.</summary>
    private GXTable<GXProfileStoredRow>? _table;
    /// <summary>Stores the selected local interval start, or null when the shared selector is cleared.</summary>
    private DateTime? _start = DateTime.Today;
    /// <summary>Stores the selected local interval end, or null when the shared selector is cleared.</summary>
    private DateTime? _end = DateTime.Today.AddDays(1);
    /// <summary>Caches the stored profile-history coverage returned for the selected attribute.</summary>
    private GXProfileHistoryResponse? _coverage;
    /// <summary>Contains the error and status messages displayed by the profile-history panel.</summary>
    private string? _error, _message;
    /// <summary>Prevents overlapping operations while an asynchronous command is running.</summary>
    private bool _busy;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_previousAttributeId != AttributeId)
        {
            _previousAttributeId = AttributeId;
            _coverage = null;
            _error = null;
            _message = null;
        }
    }

    /// <summary>Refreshes the stored rows for the current persisted buffer.</summary>
    /// <returns>A task completing after the table has reloaded its current page.</returns>
    public async Task RefreshAsync()
    {
        if (_table != null) {
            await _table.RefreshDataAsync(true);
        }
    }

    /// <summary>Validates completed local boundaries and creates a UTC query without reusing cleared input values.</summary>
    /// <param name="index">The zero-based offset of the requested stored rows.</param>
    /// <param name="count">The maximum number of stored rows to request.</param>
    /// <returns>The history query, or null for missing, reversed or daylight-saving-invalid boundaries.</returns>
    private GXProfileHistoryRequest? CreateRequest(int index = 0, int count = 100)
    {
        _error = null;
        if (_start is not DateTime start || _end is not DateTime end || end <= start ||
            TimeZoneInfo.Local.IsInvalidTime(start) || TimeZoneInfo.Local.IsInvalidTime(end))
        {
            _error = Properties.Resources.ProfileInvalidRange;
            return null;
        }
        return new GXProfileHistoryRequest { AttributeId = AttributeId,
            Start = new DateTimeOffset(start).ToUniversalTime(), End = new DateTimeOffset(end).ToUniversalTime(),
            Index = index, Count = count };
    }

    private async Task ApplyAsync()
    {
        _message = null;
        if (CreateRequest() != null) {
            await RefreshAsync();
        }
    }

    private async Task ReadAsync()
    {
        var request = CreateRequest();
        if (request == null || !CanRead || AttributeId == Guid.Empty || _busy) {
            return;
        }
        _busy = true;
        _message = null;
        try
        {
            var response = await Http.PostAsJson<GXProfileHistoryResponse>("api/ProfileHistory/Read", request);
            _message = response.TaskIds.Length == 0 ? Properties.Resources.ProfileNoReadNeeded : null;
            Services.GetService<Gurux.DLMS.AMI.Client.Helpers.GXReadTaskNotifications>()?.Track(response.TaskIds);
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; Services.GetService<IGXNotificationService>()?.ReportError(ex); }
        finally { _busy = false; }
    }

    private IEnumerable<(string Label, GXProfileRange[] Ranges)> CoverageGroups()
    {
        yield return (Properties.Resources.ProfileCovered, _coverage!.Covered);
        yield return (Properties.Resources.ProfileMissing, _coverage.Missing);
        yield return (Properties.Resources.ProfileRefresh, _coverage.RefreshRanges);
        yield return (Properties.Resources.ProfileEmpty, _coverage.EmptyRanges);
        yield return (Properties.Resources.ProfileUnavailable, _coverage.Unavailable);
    }

    private async ValueTask<ItemsProviderResult<GXProfileStoredRow>> GetItems(GXItemsProviderRequest request)
    {
        var query = CreateRequest(request.StartIndex, request.Count);
        if (AttributeId == Guid.Empty || query == null) {
            return new([], 0);
        }
        try
        {
            var response = await Http.PostAsJson<GXProfileHistoryResponse>("api/ProfileHistory/List", query, request.CancellationToken);
            request.CancellationToken.ThrowIfCancellationRequested();
            _coverage = response;
            await InvokeAsync(StateHasChanged);
            return new(response.Values ?? [], ClientHelpers.ToVirtualizedCount(response.Count));
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception ex)
        {
            _error = ex.Message;
            Services.GetService<IGXNotificationService>()?.ReportError(ex);
            await InvokeAsync(StateHasChanged);
            return new([], 0);
        }
    }

    private static string Decode(string? xml)
    {
        if (string.IsNullOrEmpty(xml)) {
            return string.Empty;
        }
        try { return Format(GXDLMSTranslator.XmlToValue(xml)); }
        catch { return xml; }
    }

    private static string Format(object? value)
    {
        if (value is null) {
            return string.Empty;
        }
        if (value is byte[] bytes) {
            return GXDLMSTranslator.ToHex(bytes);
        }
        if (value is GXStructure structure)
            {
            return string.Join(" | ", structure.Select(Format));
        }
        if (value is GXArray array)
            {
            return "[" + string.Join("; ", array.Select(Format)) + "]";
        }
        if (value is DateTimeOffset offset)
            {
            return offset.ToString("g", CultureInfo.CurrentCulture);
        }
        if (value is DateTime date)
            {
            return date.ToString("g", CultureInfo.CurrentCulture);
        }
        return Convert.ToString(value, CultureInfo.CurrentCulture) ?? string.Empty;
    }
}
