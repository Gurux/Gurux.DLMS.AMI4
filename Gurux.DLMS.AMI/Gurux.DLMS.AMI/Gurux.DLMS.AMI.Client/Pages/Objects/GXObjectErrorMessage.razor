@using Gurux.DLMS.AMI.Shared.DTOs

@* <summary>Displays the persisted error from the latest operation on a COSEM object.</summary> *@
@if (Model is { LastErrorMessage: { } message } model && !string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-danger object-operation-error" role="alert">
        @if (model.Template is { } template)
        {
            <strong>@template.Name — @template.LogicalName</strong>
        }
        <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@message</div>
    </div>
}

@code {
    /// <summary>Gets or sets the object whose persisted last error is displayed; a blank message renders no alert.</summary>
    [Parameter]
    public GXObject? Model { get; set; }
}