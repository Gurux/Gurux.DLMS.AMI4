@using Gurux.DLMS
@using Gurux.DLMS.Enums
@using Gurux.DLMS.Objects
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.UI.Components.Help
@using Gurux.DLMS.UI.Components.Objects
@using Gurux.DLMS.AMI.Client.Pages.Device
@using Task = System.Threading.Tasks.Task
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable

<GXHelpContext Topic="ObjectView" />
@if (_cosem != null && Active != null)
{
    var objectHelp = GXDLMSObjectHelpCatalog.GetRequest(_cosem.Target);
    <CascadingValue TValue="string" Name="@GXHelpContext.ScopeName" Value="@((string)null!)" IsFixed="true">
        <GXHelpContext Topic="@objectHelp.Topic" Version="@objectHelp.Version" Culture="@objectHelp.Culture" />
    </CascadingValue>
    <CascadingValue Value="this">
        <EditForm EditContext="@GXEditContexts.For(Active)">
            @if (SelectedAttributeId != null)
            {
                @if (SelectedAttribute?.Template is { } selectedTemplate)
                {
                    <h2>@selectedTemplate.Index — @selectedTemplate.Name</h2>
                    @if (_cosem.Target is GXDLMSProfileGeneric && selectedTemplate.Index == 2 && !Active.Latebind)
                    {
                        <GXProfileBufferHistory @ref="_history" AttributeId="SelectedAttribute.Id" CanRead="@CanReadSelected" />
                    }
                    else
                    {
                        <GXAttributeField Edit="@GXDLMSObjectEditState.For(_cosem.Target)" Index="selectedTemplate.Index" Label="@(selectedTemplate.Name ?? selectedTemplate.Index.ToString())" Enabled="@CanWriteSelected" />
                    }
                    <button type="button" class="btn btn-primary" disabled="@(!CanReadSelected)" @onclick="() => OnRead()">@Properties.Resources.Read</button>
                    <button type="button" class="btn btn-primary" disabled="@(!CanWriteSelected)" @onclick="OnWrite">@Properties.Resources.Write</button>
                }
            }
            else
            {
                <ModuleViews Area="AmiViewArea.Object" Display="AmiViewDisplay.Replace" Target="Active" Parameters="ViewParameters">
                    @if (_cosem.Target is GXDLMSProfileGeneric && BufferAttribute is { } buffer)
                    {
                        <GXProfileBufferHistory @ref="_history" AttributeId="buffer.Id" CanRead="@(Template == null && !string.Equals(Action, "Delete", StringComparison.OrdinalIgnoreCase))" />
                    }
                    <div class="@(_cosem.Target is GXDLMSProfileGeneric ? "cosem-profile-settings" : null)">
                    <GXDLMSObjectView Target="@_cosem.Target" Client="@_cosem.Client"
                                      ReadOnly="@(Template != null || string.Equals(Action, "Delete", StringComparison.OrdinalIgnoreCase))"
                                      ActionsEnabled="@(Template == null && !_sending)" ImmediateWriteEnabled="@(Template == null && !_sending)"
                                      OnChanged="OnCosemChanged" OnActionRequested="OnActionRequested" OnWriteRequested="OnWriteRequested" />
                    </div>
                </ModuleViews>
            }
            @ChildContent
        </EditForm>
        @if (SelectedAttributeId == null)
        {
        <ModuleViews Area="AmiViewArea.Object" Display="AmiViewDisplay.Append" Target="Active" Parameters="ViewParameters" />
        <ParametersView Parameters="@(Active.Properties?.Cast<IGXProperty>().ToList() ?? [])" Target="Active" />
        }
    </CascadingValue>
}

@code {
    [CascadingParameter] public Objects? Parent { get; set; }
    [Parameter] public string? Action { get; set; }
    [Parameter] public GXDevice? Device { get; set; }
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public GXObjectTemplate? Template { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public GXObject? Model { get; set; }
    [Parameter] public Guid? SelectedAttributeId { get; set; }
    public GXObject? Active => Model ?? _active ?? Parent?.Active;
    private GXAttribute? SelectedAttribute => Active?.Attributes?.FirstOrDefault(a => a.Id == SelectedAttributeId || a.Template?.Id == SelectedAttributeId);
    private bool CanReadSelected => !_sending && Template == null && SelectedAttribute?.Template is { } template &&
        (_cosem?.Target.GetAccess(template.Index) is AccessMode.Read or AccessMode.ReadWrite or AccessMode.AuthenticatedRead or AccessMode.AuthenticatedReadWrite);
    private bool CanWriteSelected => !_sending && Template == null && SelectedAttribute?.Template is { } template &&
        !(_cosem?.Target is GXDLMSProfileGeneric && template.Index == 2) &&
        (_cosem?.Target.GetAccess(template.Index) is AccessMode.Write or AccessMode.ReadWrite or AccessMode.AuthenticatedWrite or AccessMode.AuthenticatedReadWrite);
    private GXDLMSObjectEditState? _attributeEdit;
    public GXDLMSObject? CosemObject => _cosem?.Target;
    private GXObject? _active;
    private GXObjectTemplate? _template;
    private GXObjectCosem? _cosem;
    private GXObject? _cosemModel;
    private GXProfileBufferHistory? _history;
    private GXPageMenu? _pageMenu;
    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;
    private bool _disposed;
    private bool _sending;
    private readonly Dictionary<int, (string Xml, DateTimeOffset? LastWrite)> _submittedWrites = new();
    private GXAttribute? BufferAttribute => Active?.Attributes?.FirstOrDefault(attribute => attribute.Template?.Index == 2);
    private IDictionary<string, object> ViewParameters => new Dictionary<string, object>
    {
        ["OnRead"] = EventCallback.Factory.Create<IEnumerable<AMIReadArgument>>(this, CreateRead),
        ["OnWrite"] = EventCallback.Factory.Create<IEnumerable<AMIWriteArgument>>(this, CreateWrite),
        ["OnAction"] = EventCallback.Factory.Create<IEnumerable<AMIActionArgument>>(this, CreateAction)
    };

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            using var progress = Progress?.ProgressStart(GXProgress.RetrievingObjectView);
            if (Template == null && Active == null && Id != null)
            {
                _active = (await Http.GetAsJsonAsync<GetObjectResponse>($"api/Object?id={Id}"))?.Item
                    ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget);
                _active.Device = Device ?? _active.Device;
            }
            EnsureCosem();
            if (Template == null && Active != null)
            {
                _pageMenu = new GXPageMenu(SharedMenuService);
                _pageMenu.EditContext = GXEditContexts.For(Active);
                _pageMenu.AddMenuItems([
                    new GXMenuItem(Properties.Resources.Read, "Read", EventCallback.Factory.Create(this, () => OnRead())),
                    new GXMenuItem(Properties.Resources.Write, "Write", EventCallback.Factory.Create(this, OnWrite), Gurux.UI.Components.Enums.EnableStyle.Modified),
                    new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel))
                ]);
            }
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), items =>
            {
                if (!_disposed && items.Any(IsObjectUpdate))
                    {
                    _ = GXNotificationRefresh.RefreshViewAsync(this, items, () => InvokeAsync(RefreshObjectAsync));
                }
            });
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (Exception error) { NotificationService?.ReportError(error); }
    }

    protected override void OnParametersSet() => EnsureCosem();

    private void EnsureCosem()
    {
        if (Template != null && !ReferenceEquals(_template, Template))
        {
            _template = Template;
            _active = new GXObject { Template = Template, Attributes = (Template.Attributes ?? [])
                .Select(attribute => new GXAttribute { Template = attribute }).ToList() };
        }
        if (Active?.Template?.ObjectType != null && !ReferenceEquals(_cosemModel, Active))
        {
            _cosemModel = Active;
            if (_attributeEdit != null)
            {
                _attributeEdit.Changed -= SelectedAttributeChanged;
            }
            _cosem = new GXObjectCosem(Active);
            if (SelectedAttributeId != null)
            {
                _attributeEdit = GXDLMSObjectEditState.For(_cosem.Target);
                _attributeEdit.Changed += SelectedAttributeChanged;
            }
        }
    }

    private void SelectedAttributeChanged()
    {
        if (!_disposed && _attributeEdit != null)
        {
            OnCosemChanged(_attributeEdit);
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private void OnCosemChanged(GXDLMSObjectEditState state)
    {
        if (_disposed || Active == null || !state.HasChanges) {
            return;
        }
        GXEditContexts.For(Active).NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXObject.Attributes)));
    }

    public async Task OnRead(bool showInfo = true)
    {
        if (_cosem == null) {
            return;
        }
        try
        {
        var indexes = (Active?.Attributes ?? []).Where(attribute => attribute.Template != null &&
            (SelectedAttributeId == null || attribute.Template.Index == SelectedAttribute?.Template?.Index) &&
            (AccessMode)attribute.Template.AccessLevel is AccessMode.Read or AccessMode.ReadWrite or AccessMode.AuthenticatedRead or AccessMode.AuthenticatedReadWrite)
            .Select(attribute => (int)attribute.Template!.Index);
        await GenerateTasksAsync(_cosem.Read(indexes), showInfo ? Properties.Resources.ReadTasksAdded : null);
        }
        catch (Exception error) { NotificationService?.ReportError(error, "Pages/Objects/ObjectView"); }
    }

    public async Task OnWrite()
    {
        if (_cosem == null) {
            return;
        }
        try
        {
            if (!GXDLMSObjectEditState.For(_cosem.Target).IsValid) {
                throw new InvalidOperationException(Properties.Resources.InvalidTarget);
            }
            var indexes = _cosem.Target.GetDirtyAttributeIndexes().Where(index => SelectedAttributeId == null || index == SelectedAttribute?.Template?.Index);
            var tasks = _cosem.Write(indexes);
            if (tasks.Count == 0) {
                throw new InvalidOperationException(Properties.Resources.NothingToWrite);
            }
            // Drafts remain pending until confirmed values arrive from the server.
            await GenerateTasksAsync(tasks, Properties.Resources.WriteTasksAdded);
        }
        catch (Exception error) { NotificationService?.ReportError(error); }
    }

    public async Task OnActionRequested(GXDLMSActionRequest request)
    {
        if (_cosem == null) {
            return;
        }
        await GenerateTasksAsync(_cosem.Action(request), Properties.Resources.ActionTasksAdded);
    }

    private Task OnWriteRequested(GXDLMSWriteRequest request)
    {
        if (_cosem == null || !ReferenceEquals(request.Target, _cosem.Target)) {
            return Task.CompletedTask;
        }
        return GenerateTasksAsync(_cosem.Write(request.AttributeIndex, request.Value), Properties.Resources.WriteTasksAdded);
    }

    private async Task GenerateTasksAsync(IReadOnlyList<GXTask> tasks, string? message)
    {
        if (tasks.Count == 0) {
            return;
        }
        if (Template != null) {
            throw new InvalidOperationException(Properties.Resources.InvalidTarget);
        }
        if (_sending) {
            throw new InvalidOperationException(Properties.Resources.TaskOnProgress);
        }
        if (tasks.Count > 1)
        {
            var batch = Guid.NewGuid();
            for (var index = 0; index < tasks.Count; ++index)
            {
                tasks[index].Batch = batch;
                tasks[index].Order = index + 1;
            }
        }
        _sending = true;
        using var progress = Progress?.ProgressStart(GXProgress.SavingObject);
        try
        {
            var response = await Http.PostAsJson<AddTaskResponse>("api/Task/Add", new AddTask { Tasks = tasks.ToArray() });
            foreach (var task in tasks.Where(task => task.TaskType == TaskType.Write && task.Index != null && task.Data != null))
                {
                _submittedWrites[task.Index!.Value] = (task.Data!, Active?.Attributes?.FirstOrDefault(attribute => attribute.Template?.Index == task.Index)?.LastWrite);
            }
            if (Active != null) {
                GXEditContexts.For(Active).MarkAsUnmodified();
            }
            if (message != null)
            {
                if (tasks.All(t => t.TaskType == TaskType.Read))
                    {
                    Services.GetService<GXReadTaskNotifications>()?.Track(response.Ids);
                }
                else
                    {
                    NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, message, string.Empty, Closable: true));
                }
            }
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (Exception error) { NotificationService?.ReportError(error, "Pages/Objects/ObjectView"); throw; }
        finally { _sending = false; }
    }

    private Task CreateRead(IEnumerable<AMIReadArgument> targets) => _cosem == null ? Task.CompletedTask : GenerateTasksAsync(
        _cosem.Read(targets.SelectMany(argument => argument.Target is GXAttribute attribute && attribute.Template != null
            ? new[] { (int)attribute.Template.Index } : (Active?.Attributes ?? []).Where(a => a.Template != null).Select(a => (int)a.Template!.Index))), Properties.Resources.ReadTasksAdded);
    private Task CreateWrite(IEnumerable<AMIWriteArgument> targets) => _cosem == null ? Task.CompletedTask : GenerateTasksAsync(
        targets.SelectMany(argument => argument.Target is GXAttribute attribute && attribute.Template != null
            ? _cosem.Write(attribute.Template.Index, argument.Value!) : throw new ArgumentException(Properties.Resources.InvalidTarget)).ToArray(), Properties.Resources.WriteTasksAdded);
    private Task CreateAction(IEnumerable<AMIActionArgument> targets) => _cosem == null ? Task.CompletedTask : GenerateTasksAsync(
        targets.SelectMany(argument => _cosem.Action(new GXDLMSActionRequest(_cosem.Target, argument.Index,
            client => client.Method(_cosem.Target, argument.Index, argument.Value, DataType.None)))).ToArray(), Properties.Resources.ActionTasksAdded);

    private bool IsObjectUpdate(GXTarget update)
    {
        if (_disposed || Active == null || Template != null) {
            return false;
        }
        if (update.Type == GXObjectPolicies.Edit || update.Type == GXObjectPolicies.Add)
            {
            return string.IsNullOrEmpty(update.Id) || update.Id == Active.Id.ToString();
        }
        if (update.Type == GXAttributePolicies.Edit || update.Type == GXAttributePolicies.Add)
            {
            return string.IsNullOrEmpty(update.Id) || Active.Attributes?.Any(attribute => attribute.Id.ToString() == update.Id) == true;
        }
        return update.Type == GXValuePolicies.Add || update.Type == GXValuePolicies.Clear || update.Type == GXTaskPolicies.Edit;
    }

    private async Task RefreshObjectAsync()
    {
        var current = Active;
        if (_disposed || current == null || _cosem == null || Template != null) {
            return;
        }
        try
        {
            var objectId = current.Id;
            if (current.Latebind && current.Device?.Id is Guid deviceId && current.Template != null)
            {
                var listed = await Http.PostAsJson<ListObjectsResponse>("api/Object/List", new ListObjects
                {
                    Count = 1,
                    Filter = new GXObject { Device = new GXDevice { Id = deviceId }, Template = new GXObjectTemplate { Id = current.Template.Id } }
                });
                var persisted = listed.Objects?.FirstOrDefault(item => !item.Latebind);
                if (persisted != null) {
                    objectId = persisted.Id;
                }
            }
            var latest = (await Http.GetAsJsonAsync<GetObjectResponse>($"api/Object?id={objectId}"))?.Item;
            if (_disposed || !ReferenceEquals(current, Active) || latest == null) {
                return;
            }
            current.LastRead = latest.LastRead;
            current.LastWrite = latest.LastWrite;
            current.LastAction = latest.LastAction;
            current.LastError = latest.LastError;
            current.LastErrorMessage = latest.LastErrorMessage;
            current.Id = latest.Id;
            current.Latebind = latest.Latebind;
            foreach (var attribute in current.Attributes ?? [])
            {
                var value = latest.Attributes?.FirstOrDefault(item => item.Id == attribute.Id || item.Template?.Index == attribute.Template?.Index);
                if (value == null) {
                    continue;
                }
                attribute.Id = value.Id;
                attribute.Read = value.Read;
                attribute.LastWrite = value.LastWrite;
                attribute.LastAction = value.LastAction;
                attribute.LastError = value.LastError;
                attribute.Exception = value.Exception;
                if (attribute.Template is { } template && _submittedWrites.TryGetValue(template.Index, out var submitted)
                    && _cosem.Target.GetDirty(template.Index, out var pending) && value.Value != null
                    && value.LastWrite != null && (submitted.LastWrite == null || value.LastWrite > submitted.LastWrite)
                    && value.LastError == null && string.IsNullOrEmpty(value.Exception)
                    && GXDLMSTranslator.ValueToXml(pending) == submitted.Xml
                    && GXDLMSTranslator.ValueToXml(_cosem.DecodeValue(template.Index, value.Value)) == submitted.Xml)
                {
                    _cosem.Target.ClearDirty(template.Index);
                    _submittedWrites.Remove(template.Index);
                }
                if (attribute.Template != null && !_cosem.Target.GetDirty(attribute.Template.Index, out _))
                {
                    attribute.Value = value.Value;
                    attribute.Values = value.Values;
                }
            }
            _cosem.Refresh(current);
            GXDLMSObjectEditState.For(_cosem.Target).RefreshConfirmedValues();
            if (_history != null) {
                await _history.RefreshAsync();
            }
            StateHasChanged();
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (Exception error) { NotificationService?.ReportError(error); }
    }

    internal void Update() => StateHasChanged();
    private void OnCancel() => ClientHelpers.NavigateToLastPage(NavigationManager);
    public void Dispose()
    {
        _disposed = true;
        if (_attributeEdit != null)
        {
            _attributeEdit.Changed -= SelectedAttributeChanged;
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
        _pageMenu?.Dispose();
    }
}
