@using Gurux.DLMS.AMI.Client.Shared.KeyManagement
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.DTOs.KeyManagement
@using Gurux.DLMS.ASN
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text
@using System.Net.Http.Json

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="KeyManagementKey" />

@if (Active != null)
{
    <GXDialog OnOk="OnSave" OnCancel="OnCancel">
        <EditForm EditContext="@GXEditContexts.For(Active)">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <GXValidator @ref="_validator" OnValidate="OnValidate" />
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <div class="col-auto">
                            <label>@Properties.Resources.KeyManagementKeyType</label>
                            <GXInputDropdown class="form-select" @bind-Value="KeyType" Disabled="@(Active.Id != Guid.Empty)" RememberValue="false" Items="@(KeyTypes.Select(it => (int)it))" Formatter="@(value => ClientHelpers.GetKeyTypeDescription((KeyManagementType)value))" />
                        </div>
                        <ValidationMessage For="@(() => KeyType)" />
                    </div>
                    <div class="form-group">
                        <label>@ClientHelpers.GetKeyTypeDescription(Active.KeyType)</label>
                        @if (Parent?.KeyManagement?.ProviderId == "KmipClient" && Active.Id == Guid.Empty)
                        {
                            <label>@Properties.Resources.RemoteObjectIdentifier</label>
                            <InputText @bind-Value="Active.ExternalId" />
                            <p>@Properties.Resources.TheKeyMetadataIsReadFromTheConfiguredKMIPServerMaterialIsNotCopiedIntoAMIStorage</p>
                        }
                        else
                        {
                            <GXInputHexAscii Id="key-management-value" Disabled="@(Active.Id != Guid.Empty)"
                                           @bind-Value="@Active.Key">
                            </GXInputHexAscii>
                        }
                        <ValidationMessage For="@(() => Active.Key)" />
                        @if (Active.Id != Guid.Empty)
                        {
                            <p>@Properties.Resources.KeyMaterialIsHidden</p>
                            @if (Active.KeyType == KeyManagementType.LLSPassword)
                            {
                                <p>@Properties.Resources.UseChangePasswordInTheKeyList</p>
                            }
                            <dl>
                                <dt>@Properties.Resources.State</dt>
                                <dd>@Active.State</dd>
                                <dt>@Properties.Resources.Algorithm</dt>
                                <dd>@Active.Algorithm (@Active.CryptographicLength bits)</dd>
                                <dt>@Properties.Resources.PermittedUsage</dt>
                                <dd>@Active.UsageMask</dd>
                                <dt>@Properties.Resources.ExternalIdentifier</dt>
                                <dd>@Active.ExternalId</dd>
                                <dt>@Properties.Resources.Activation</dt>
                                <dd>@Active.ActivationDate</dd>
                                <dt>@Properties.Resources.Deactivation</dt>
                                <dd>@Active.DeactivationDate</dd>
                            </dl>
                        }
                    </div>
                    @if (Active.CreationTime != null)
                    {
                        <div class="form-group">
                            <label>@Properties.Resources.CreationTime</label>
                            <InputDate Type="@InputDateType.DateTimeLocal" id="generation"
                                       readonly="readonly" class="form-control"
                                       @bind-Value="Active.CreationTime" />
                        </div>
                    }
                    @if (Active.Updated != null)
                    {
                        <div class="form-group">
                            <label>@Properties.Resources.Updated</label>
                            <InputDate Type="@InputDateType.DateTimeLocal" id="generation"
                                       readonly="readonly" class="form-control"
                                       @bind-Value="Active.Updated" />
                        </div>
                    }
                    @if (Active.Removed != null)
                    {
                        <div class="form-group">
                            <label>@Properties.Resources.Removed</label>
                            <InputDate Type="@InputDateType.DateTimeLocal" id="removed"
                                       class="form-control"
                                       @bind-Value="Active.Removed" />
                        </div>
                    }
                </div>
            </div>
        </EditForm>
    </GXDialog>
}
@code {

    private IGXNotificationService? NotificationService;

    private GXValidator? _validator;

    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.KeyManagement.KeyManagementKeys? Parent { get; set; }

    /// <summary>
    /// Origical value is returned if user cancels the action.
    /// </summary>
    GXKeyManagementKey? _original;

    private GXKeyManagementKey? Active
    {
        get
        {
            return Parent?.Active;
        }
    }

    private int KeyType
    {
        get
        {
            if (Active?.KeyType == null)
            {
                return (int)KeyManagementType.LLSPassword;
            }
            return (int)Active.KeyType.Value;
        }
        set
        {
            if (Active != null)
            {
                Active.KeyType = (KeyManagementType)value;
            }
        }
    }

    /// <summary>
    /// Available key types.
    /// </summary>
    private List<KeyManagementType> KeyTypes = new List<KeyManagementType>(new[]
    { KeyManagementType.LLSPassword,
        KeyManagementType.HLSPassword,
        KeyManagementType.BlockCipher,
        KeyManagementType.Authentication,
        KeyManagementType.Broadcast,
        KeyManagementType.MasterKey,
        KeyManagementType.PrivateKey,
        KeyManagementType.PublicKey});

    public string? IsDeleting
    {
        get
        {
            if (Parent?.KeyAction != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    protected override void OnInitialized()
    {
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementKey.OnInitialized");
            if (Active == null || Parent?.KeyManagement?.Keys == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            _original = ClientHelpers.Clone<GXKeyManagementKey>(Active);

            // Roles can have multiple immutable versions; lifecycle selects the current key.
            if (Parent.KeyAction == CrudAction.Create)
            {
                if (Active.KeyType == null)
                {
                    Active.KeyType = KeyTypes.FirstOrDefault();
                }
            }
        }
        catch (Exception ex)
        {
            if (_validator != null && Active != null)
            {
                _validator.AddError(() => Active.Key, ex.Message);
            }
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementKey.OnInitialized");
        }
    }

    /// <summary>
    /// Validate the key management content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (Active?.Id != Guid.Empty)
        {
            return;
        }
        if (Parent?.KeyManagement?.ProviderId == "KmipClient")
        {
            if (KeyType == 0)
            {
                sender.AddError(() => KeyType, Properties.Resources.SelectADLMSKeyRole);
            }
        
            if (Parent.KeyManagement.Id == Guid.Empty)
            {
                sender.AddError(() => Active!.ExternalId, Properties.Resources.SaveTheKeyManagementAndItsKMIPConnectionBeforeBindingARemoteObject);
            }
        
            if (string.IsNullOrWhiteSpace(Active?.ExternalId))
            {
                sender.AddError(() => Active!.ExternalId, Properties.Resources.ARemoteObjectIdentifierIsRequired);
            }
        
            return;
        }
        if (Active != null)
        {
            if (Parent?.KeyManagement?.Keys == null || Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (KeyType == 0)
            {
                sender.AddError(() => KeyType, Properties.Resources.InvalidKeyType);
            }
            if (Active.Key?.Any() != true)
            {
                sender.AddError(() => Active.Key, Properties.Resources.InvalidKey);
            }
            try
            {
                switch ((KeyManagementType)KeyType)
                {
                    case KeyManagementType.BlockCipher:
                    case KeyManagementType.Authentication:
                    case KeyManagementType.Broadcast:
                        if (Active.Key?.Length is not (16 or 24 or 32))
                        {
                            sender.AddError(() => Active.Key, Properties.Resources.InvalidKey);
                        }
                        break;
                    case KeyManagementType.PrivateKey:
                    case KeyManagementType.PublicKey:
                        // The server validates the declared curve and raw/DER/PEM encoding.
                        break;
                    default:
                        break;
                }
            }
            catch (Exception)
            {
                sender.AddError(() => Active.Key, Properties.Resources.InvalidKey);
            }
        }
    }

    /// <summary>
    /// Save key management group.
    /// </summary>
    public async System.Threading.Tasks.Task OnSave()
    {
        try
        {
            _validator?.ClearErrors();
            if (Active == null || Parent?.KeyManagement?.Keys == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_validator != null && !await _validator.ValidateAsync())
            {
                return;
            }
            NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementKey.OnSave");
            if (Parent?.KeyAction == CrudAction.Create)
            {
                if (Parent.KeyManagement.ProviderId == "KmipClient")
                {
                    using var response = await Http.PostAsJsonAsync("api/modules/KeyManagement/ImportExternal", new GXImportExternalKeyRequest { ManagementId = Parent.KeyManagement.Id, ObjectId = Active.ExternalId!, Role = Active.KeyType!.Value });
                    response.EnsureSuccessStatusCode();
                    var imported = await response.Content.ReadFromJsonAsync<GXKeyManagementKey>() ?? throw new InvalidOperationException("Missing imported key metadata.");
                    Parent.KeyManagement.Keys.Add(imported);
                }
                else
                {
                    Parent.KeyManagement.Keys.Add(Active);
                }
            }
            else if (Parent?.KeyAction == CrudAction.Update)
            {
            //Do nothing.
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (Parent?.KeyManagement is { } management)
                {
                GXEditContexts.For(management).NotifyFieldChanged(new FieldIdentifier(management, nameof(GXKeyManagement.Keys)));
            }
            Parent?.Update();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementKey.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private void OnCancel()
    {
        if (Active != null && _original != null)
        {
            //Reject the changes.
            ClientHelpers.Copy(_original, Active);
        }
        Parent?.Update();
    }
}

