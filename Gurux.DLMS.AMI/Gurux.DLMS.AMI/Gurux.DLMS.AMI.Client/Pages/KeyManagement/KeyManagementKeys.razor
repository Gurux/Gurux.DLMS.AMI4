@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.DLMS.AMI.Client.Shared.KeyManagement
@inject IServiceProvider Services
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums;
@using Gurux.DLMS.AMI.Shared.DTOs.KeyManagement;
@using System.Net.Http.Json

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="KeyManagementKeys" />

<PageTitle>@Properties.Resources.KeyManagementKeys</PageTitle>

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
    </ChildContent>
</GXMenuControl>
@if (KeyManagement?.Device == null)
{
    <label>@Gurux.DLMS.AMI.Client.Properties.Resources.MeterIDForDeploymentConfirmation <InputText @bind-Value="deploymentDeviceId" /></label>
}

@if (KeyAction != CrudAction.None)
{
    @*Show key.*@
    <KeyManagementKey Parent="this"></KeyManagementKey>
}
<GXViewTable ViewName="KeyManagement.KeyManagementKeys" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXKeyManagementPolicies.View })"
         TItem="GXKeyManagementKey" @ref="table"
         Context="item"
         ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Single"
         ShowRemoved="false"
         ShowAllUsers="false"
         Filter="false"
         OnCellChanged="EditKey"
         OnSearch="@Updated">
    <FilterContent>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXKeyManagementPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXKeyManagementPolicies.Delete"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="KeyType" Name="KeyType" Target="@item">@Properties.Resources.KeyManagementKeyType</GXTh>
        <GXTh Id="State">@Properties.Resources.State</GXTh>
        <GXTh Id="Keystorage">@Properties.Resources.KeyStorage</GXTh>
        <GXTh Id="Lifecycle">@Properties.Resources.Lifecycle</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@item" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated" Name="Updated" Target="@item">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="KeyType">
            <GXLinkButton TItem="GXKeyManagementKey" Target="@item" OnClick="@Edit"
                        Text="@ClientHelpers.GetKeyTypeDescription(item.KeyType)" />
        </GXTd>
        <GXTd Id="State">@(item.State?.ToString() ?? Properties.Resources.RequiresMigration)</GXTd>
        <GXTd Id="Keystorage">@(item.ProviderId ?? KeyManagement?.ProviderId ?? "local")</GXTd>
        <GXTd Id="Lifecycle">
            <AuthorizeView Policy="@GXKeyPermissions.Lifecycle">
                @if (item.Id != Guid.Empty)
                {
                    @if (item.State == KeyState.PreActive)
                    {
                        <button type="button" @onclick="() => ChangeState(item, KeyState.Active)">@Gurux.DLMS.AMI.Client.Properties.Resources.Activate</button>
                    }
                    @if (item.State == KeyState.Active)
                    {
                        <button type="button" @onclick="() => ChangeState(item, KeyState.Deactivated)">@Gurux.DLMS.AMI.Client.Properties.Resources.Deactivate</button>
                        <button type="button" @onclick="() => ConfirmDeployed(item)">@Gurux.DLMS.AMI.Client.Properties.Resources.ConfirmInstalledOnMeter</button>
                    }
                    @if (item.State is KeyState.PreActive or KeyState.Active or KeyState.Deactivated)
                    {
                        <button type="button" @onclick="() => ChangeState(item, KeyState.Compromised)">@Gurux.DLMS.AMI.Client.Properties.Resources.MarkCompromised</button>
                    }
                    @if (item.State is KeyState.PreActive or KeyState.Deactivated or KeyState.Compromised)
                    {
                        <button type="button" @onclick="() => ChangeState(item, item.State == KeyState.Compromised ? KeyState.DestroyedCompromised : KeyState.Destroyed)">@Gurux.DLMS.AMI.Client.Properties.Resources.DestroyMaterial</button>
                    }
                }
            </AuthorizeView>
        </GXTd>
        <GXTd Id="CreationTime">@item.CreationTime</GXTd>
        <GXTd Id="Updated">@item.Updated</GXTd>
    </ItemContent>
</GXViewTable>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("KeyType") { Position = 0, Description = "KeyManagementKeyType", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("State") { Position = 1, Description = "State", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Keystorage") { Position = 2, Description = Properties.Resources.KeyStorage, Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Lifecycle") { Position = 3, Description = "Lifecycle", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 4, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 5, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private string deploymentDeviceId = "";
    private async Task ChangeState(GXKeyManagementKey item, KeyState target)
    {
        try
        {
            using var response = await Http.PostAsJsonAsync("api/extensions/KeyManagement/Transition", new GXTransitionKeyRequest { KeyId = item.Id, Target = target, ExpectedStamp = item.ConcurrencyStamp });
            response.EnsureSuccessStatusCode();
            var updated = await response.Content.ReadFromJsonAsync<GXKeyManagementKey>() ?? throw new InvalidOperationException("Missing key metadata.");
            int index = KeyManagement!.Keys!.FindIndex(k => k.Id == item.Id);
            if (index >= 0)
            {
                KeyManagement.Keys[index] = updated;
            }
        
            await Updated();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    private async Task ConfirmDeployed(GXKeyManagementKey item)
    {
        try
        {
            Guid deviceId = KeyManagement?.Device?.Id ?? (Guid.TryParse(deploymentDeviceId, out var parsed) ? parsed : throw new ArgumentException("Enter the meter ID whose installation has been confirmed."));
            using var response = await Http.PostAsync($"api/extensions/KeyManagement/ConfirmDeployment/{deviceId}/{item.Id}", null);
            response.EnsureSuccessStatusCode();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
    private IGXNotifier? Notifier;

    private IGXNotificationService? NotificationService;

    internal CrudAction KeyAction;
    internal GXKeyManagementKey? Active;

    /// <summary>
    /// Close key manager key form.
    /// </summary>
    internal void Update()
    {
        KeyAction = CrudAction.None;
        InvokeAsync(StateHasChanged);
    }

    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.KeyManagement.KeyManagementGeneral? Parent { get; set; }

    internal GXKeyManagement? KeyManagement
    {
        get
        {
            return Parent?.Active;
        }
    }

    /// <summary>
    /// Key management key filter.
    /// </summary>
    private GXKeyManagementKey filter = new GXKeyManagementKey();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXKeyManagementKey>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementKeys.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementKeys.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXKeyManagementPolicies.Add ||
                        it.Type == GXKeyManagementPolicies.Edit ||
                        it.Type == GXKeyManagementPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
    }

    private ValueTask<ItemsProviderResult<GXKeyManagementKey>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        try
        {
            if (KeyManagement?.Keys != null)
            {
                return new(new ItemsProviderResult<GXKeyManagementKey>(
                    KeyManagement.Keys, KeyManagement.Keys.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new key management.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            if (Parent == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            KeyAction = CrudAction.Create;
            Active = new GXKeyManagementKey();
            InvokeAsync(StateHasChanged);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit key management key.
    /// </summary>
    void EditKey(GXKeyManagementKey item)
    {
        try
        {
            if (table != null)
            {
                table.RestoreSelection(item);
            }
            OnEdit();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    private void Edit(GXKeyManagementKey item)
    {
        try
        {
            KeyAction = CrudAction.Update;
            Active = item;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit key management key.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            if (Parent == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            KeyAction = CrudAction.Update;
            Active = table?.Active;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    private string[] GetKeyTypes(KeyManagementType?[] types)
    {
        List<string> list = new();
        foreach (var type in types)
        {
            list.Add(ClientHelpers.GetKeyTypeDescription(type));
        }
        return list.ToArray();
    }

    /// <summary>
    /// Remove selected key management.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = false,
                    Items = GetKeyTypes(table.SingleOrDefault().Select(s => s.KeyType).ToArray())
                });
            OnDeleteConfirmation(confirmation);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected key management keys.
    /// </summary>
    public void OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm && Parent?.Active?.Keys != null)
            {
                bool changed = false;
                foreach (var it in table.SingleOrDefault())
                {
                    changed |= Parent.Active.Keys.Remove(it);
                }
                if (changed)
                    {
                    GXEditContexts.For(Parent.Active).NotifyFieldChanged(new FieldIdentifier(Parent.Active, nameof(GXKeyManagement.Keys)));
                }
                InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

