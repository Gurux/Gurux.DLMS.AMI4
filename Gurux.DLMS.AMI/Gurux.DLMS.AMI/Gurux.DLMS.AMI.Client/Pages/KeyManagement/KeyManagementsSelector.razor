@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.KeyManagement;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="KeyManagementsSelector" />

<GXRelationshipSelector TItem="GXKeyManagement" @ref="_selectionContainer"
                        SelectedItems="@(() => _selectedItems)"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems"
                        Disabled="@Disabled">
    <ItemContent>
            @context.SystemTitle

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchBySystemTitle" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether relationship changes are disabled by the parent editor.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>References the edit model collection that is saved by the parent editor.</summary>
    private List<GXKeyManagement> _selectedItems = [];

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Gets or sets the parent group whose relationship is being edited.</summary>
    [Parameter, EditorRequired]
    public GXKeyManagementGroup? Active { get; set; }

    /// <summary>Coordinates paged checkbox selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXKeyManagement>? _selectionContainer;
    /// <summary>Stores endpoint criteria shared by selected and available keymanagement queries.</summary>
    private GXKeyManagement _filter = new GXKeyManagement(null);

    /// <summary>Applies the system title filter to both selected and available relationship records.</summary>
    /// <param name="systemTitle">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchBySystemTitle(string? systemTitle)
    {
        try
        {
            if (_selectionContainer != null)
            {
                _filter.SystemTitle = GXDLMSTranslator.HexToBytes(systemTitle);
                _notificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.SearchBySystemTitle");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.SearchBySystemTitle");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.KeyManagementGroups = null;
                }
                else
                {
                    GXUser user;
                    GXKeyManagementGroup? sg = _filter.KeyManagementGroups?.FirstOrDefault();
                    if (sg == null)
                    {
                        sg = new GXKeyManagementGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        sg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        _filter.KeyManagementGroups = new List<GXKeyManagementGroup>(new GXKeyManagementGroup[] { sg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(sg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.SearchByUser");
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXKeyManagement>> GetItems(GXRelationshipQuery<GXKeyManagement> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingKeyManagements);
        try
        {
            ListKeyManagements req = new ListKeyManagements()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = _filter,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                Included = request.Included?.Select(item => item.Id).ToArray(),
                OrderBy = nameof(GXKeyManagement.Id),
                Exclude = request.Excluded.Select(item => item.Id).ToArray()
            };
            var ret = await Http.PostAsJson<ListKeyManagementsResponse>("api/KeyManagement/List", req, request.CancellationToken);
            if (ret?.KeyManagements != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXKeyManagement>(ret.KeyManagements, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXKeyManagement>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingKeyManagements);
            _notificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.OnInitializedAsync");
            if (_selectionContainer == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (Active?.KeyManagements != null)
            {
                _selectedItems = Active.KeyManagements;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.OnInitializedAsync");
        }
    }
}
