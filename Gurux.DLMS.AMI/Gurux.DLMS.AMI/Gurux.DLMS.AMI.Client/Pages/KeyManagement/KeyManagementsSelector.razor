@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.KeyManagement;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="KeyManagementsSelector" />

<SelectionContainer TItem="GXKeyManagement" @ref="@_selectionContainer">
    <SelectionList TItem="GXKeyManagement" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.SystemTitle
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedBySystemTitle" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXKeyManagement" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.SystemTitle
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchBySystemTitle" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter, EditorRequired]
    public GXKeyManagementGroup? Active { get; set; }

    SelectionList<GXKeyManagement>? _selected;
    SelectionList<GXKeyManagement>? _available;
    SelectionContainer<GXKeyManagement>? _selectionContainer;
    /// <summary>
    /// KeyManagement filter.
    /// </summary>
    private GXKeyManagement filter = new GXKeyManagement(null);

    protected async Task SearchSelectedBySystemTitle(string? systemTitle)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(systemTitle))
                {
                    systemTitle = systemTitle.Replace(" ", "").Replace(":", "").Replace("-", "").ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.SystemTitle != null && !Convert.ToHexString(it.SystemTitle).ToLower().Contains(systemTitle))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.SearchSelectedBySystemTitle");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.SearchSelectedBySystemTitle");
        }
    }

    protected async Task SearchBySystemTitle(string? systemTitle)
    {
        try
        {
            if (_available != null)
            {
                filter.SystemTitle = GXDLMSTranslator.HexToBytes(systemTitle);
                NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.SearchBySystemTitle");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.SearchBySystemTitle");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.KeyManagementGroups = null;
                }
                else
                {
                    GXUser user;
                    GXKeyManagementGroup? sg = filter.KeyManagementGroups?.FirstOrDefault();
                    if (sg == null)
                    {
                        sg = new GXKeyManagementGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        sg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        filter.KeyManagementGroups = new List<GXKeyManagementGroup>(new GXKeyManagementGroup[] { sg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(sg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXKeyManagement>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return default;
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXKeyManagement>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXKeyManagement>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingKeyManagements);
        try
        {
            ListKeyManagements req = new ListKeyManagements()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
            };
            var ret = await Http.PostAsJson<ListKeyManagementsResponse>("api/KeyManagement/List", req, request.CancellationToken);
            if (ret?.KeyManagements != null && _selected != null)
            {
                return new ItemsProviderResult<GXKeyManagement>(ret.KeyManagements, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingKeyManagements);
            NotificationService?.RemoveByKey("Pages/KeyManagement/KeyManagementsSelector.OnInitializedAsync");
            if (_selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (Active?.KeyManagements != null)
            {
                _selected.Items = Active.KeyManagements;
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/KeyManagement/KeyManagementsSelector.OnInitializedAsync");
        }
    }
}
