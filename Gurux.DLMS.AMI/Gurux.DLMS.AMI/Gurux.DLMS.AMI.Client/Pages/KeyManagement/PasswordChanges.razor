@using System.Text
@using System.Security.Cryptography
@using Gurux.DLMS.AMI.Client.Shared.KeyManagement
@using Gurux.DLMS.AMI.Http
@using Gurux.DLMS.AMI.Module
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IAsyncDisposable

<AuthorizeView Policy="@GXKeyPermissions.Lifecycle">
    <section aria-label="Meter password changes">
        <p>The current password stays encrypted on the server. You do not need to enter it.
            The agent writes the new password and verifies a new connection before it is activated.</p>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <div class="mb-2">
            <label for="password-association">Meter association</label>
            <select id="password-association" class="form-select" @bind="_association" disabled="@(_busy || Pending)">
                <option value="">Select the association used by the LLS connection</option>
                @foreach (var item in _associations)
                {
                    <option value="@item.LogicalName">@item.Name (@item.LogicalName)</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label for="new-meter-password">New password</label>
            <input id="new-meter-password" class="form-control" type="password" autocomplete="new-password"
                   @bind="_password" disabled="@(_busy || Pending)" />
        </div>
        @if (Pending)
        {
            <div class="alert alert-info mt-2">
                A password change is pending. A write in progress must be verified before ordinary meter work can continue.
                If a response was lost, retry checks the new password before sending another write.
            </div>
        }
        @if (_history.Length != 0)
        {
            <table class="table mt-3">
                <thead><tr><th>Requested</th><th>Operation</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in _history)
                    {
                        <tr @key="item.Id">
                            <td>@item.Created.ToLocalTime()</td>
                            <td>@(item.RestoredFromId == null ? "Password change" : "Password recovery")</td>
                            <td>@(item.State == "Writing" ? "Verification pending" : item.State)</td>
                            <td>
                                @if (item.CanRetry)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                            @onclick="() => RetryAsync(item)">Retry and verify</button>
                                }
                                @if (item.CanCancel)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                            @onclick="() => CancelAsync(item)">Cancel before writing</button>
                                }
                                @if (item.State == "Verified")
                                {
                                    <AuthorizeView Policy="@GXKeyPermissions.Recovery" Context="recovery">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_busy || Pending || string.IsNullOrEmpty(_association))"
                                                @onclick="() => RestoreAsync(item)">Restore password used before this change</button>
                                    </AuthorizeView>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</AuthorizeView>

@code {
    [Parameter] public Guid ManagementId { get; set; }
    [Parameter] public Guid DeviceId { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private Task _poll = Task.CompletedTask;
    private Guid _loaded;
    private bool _busy;
    private bool _loading;
    private string? _error;
    private string _association = "";
    private string _password = "";
    private GXPasswordAssociation[] _associations = [];
    private GXPasswordChangeInfo[] _history = [];
    private bool Pending => _history.Any(item => item.State is "Queued" or "Writing");

    protected override async Task OnParametersSetAsync()
    {
        if (ManagementId != Guid.Empty && DeviceId != Guid.Empty && ManagementId != _loaded)
        {
            _loaded = ManagementId;
            _history = [];
            _associations = [];
            _association = "";
            await RefreshAsync();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _poll = PollAsync();
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (Pending)
                {
                    await InvokeAsync(RefreshAsync);
                }
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (_loading || _stop.IsCancellationRequested)
        {
            return;
        }
        _loading = true;
        try
        {
            var before = string.Join("|", _history.Select(item => item.Id + ":" + item.State));
            _history = await Http.GetAsJsonAsync<GXPasswordChangeInfo[]>($"api/PasswordChange/{ManagementId}", _stop.Token);
            if (_associations.Length == 0)
            {
                _associations = await Http.GetAsJsonAsync<GXPasswordAssociation[]>($"api/PasswordChange/Associations/{DeviceId}", _stop.Token);
                if (_associations.Length == 1)
                {
                    _association = _associations[0].LogicalName;
                }
            }
            _error = null;
            var after = string.Join("|", _history.Select(item => item.Id + ":" + item.State));
            if (before != after)
            {
                await Changed.InvokeAsync();
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _loading = false;
        }
        if (!_stop.IsCancellationRequested)
        {
            StateHasChanged();
        }
    }

    /// <summary>Submits the new password from the containing dialog's OK action.</summary>
    public async Task ChangeAsync()
    {
        if (_busy || _loading || Pending || _stop.IsCancellationRequested)
        {
            return;
        }
        if (string.IsNullOrEmpty(_association) || string.IsNullOrEmpty(_password))
        {
            _error = "Select a meter association and enter the new password.";
            StateHasChanged();
            return;
        }
        _busy = true;
        _error = null;
        StateHasChanged();
        byte[]? material = null;
        try
        {
            if (!await Confirmation.ConfirmAsync("Change meter password",
                "Write the new password to this meter and verify a new connection? The current password will be kept encrypted for recovery.") || _stop.IsCancellationRequested)
            {
                return;
            }
            material = Encoding.UTF8.GetBytes(_password);
            await Http.PostAsJson<GXPasswordChangeInfo>("api/PasswordChange", new GXPasswordChangeRequest
            {
                ManagementId = ManagementId, DeviceId = DeviceId, AssociationLogicalName = _association, NewPassword = material
            }, _stop.Token);
            _password = "";
            await RefreshAsync();
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            if (material != null)
            {
                CryptographicOperations.ZeroMemory(material);
            }
            _busy = false;
            if (!_stop.IsCancellationRequested)
            {
                StateHasChanged();
            }
        }
    }

    private async Task RestoreAsync(GXPasswordChangeInfo item)
    {
        if (_busy || Pending || !await Confirmation.ConfirmAsync("Restore previous meter password",
            "Restore the password used before the selected change on this meter? The agent will verify it before activation."))
        {
            return;
        }
        _busy = true;
        try
        {
            await Http.PostAsJson<GXPasswordChangeInfo>("api/PasswordChange", new GXPasswordChangeRequest
            {
                ManagementId = ManagementId, DeviceId = DeviceId, AssociationLogicalName = _association, RestoreChangeId = item.Id
            }, _stop.Token);
            await RefreshAsync();
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RetryAsync(GXPasswordChangeInfo item) => UpdateOperationAsync(item.Id, "Retry");

    private async Task CancelAsync(GXPasswordChangeInfo item)
    {
        if (await Confirmation.ConfirmAsync("Cancel password change", "Cancel this password change before the meter write starts?"))
        {
            await UpdateOperationAsync(item.Id, "Cancel");
        }
    }

    private async Task UpdateOperationAsync(Guid id, string action)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        try
        {
            using var response = await Http.PostAsync($"api/PasswordChange/{id}/{action}", null, _stop.Token);
            await response.EnsureSuccessAsync(_stop.Token);
            await RefreshAsync();
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _stop.Cancel();
        await _poll;
        _stop.Dispose();
        _password = "";
    }
}