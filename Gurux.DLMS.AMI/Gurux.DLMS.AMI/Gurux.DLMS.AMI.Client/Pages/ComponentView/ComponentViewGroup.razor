@page "/config/ComponentGroup/{Id:guid?}"
@page "/config/ComponentGroup/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="ComponentViewGroup" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ComponentViewGroupTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXComponentViewGroup Active = new GXComponentViewGroup(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.ComponentViewGroup;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingComponentViewGroup);
            NotificationService?.RemoveByKey("Pages/ComponentView/ComponentViewGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get component view group data.
                var tmp = (await Http.GetAsJsonAsync<GetComponentViewGroupResponse>(string.Format("api/ComponentViewGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            _ready = true;
            EditorMenu.Set(Active, EditorAction, OnSave, OnCancel);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/ComponentView/ComponentViewGroup.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);
    private CrudAction EditorAction => ClientHelpers.GetAction(NavigationManager, Action);
    public bool DeleteTarget { get; set; }
    public void Dispose() => _editorMenu?.Dispose();

    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingComponentViewGroup);
            NotificationService?.RemoveByKey("Pages/ComponentView/ComponentViewGroupGeneral.OnSave");
            if (EditorAction == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveComponentViewGroupResponse>("api/ComponentViewGroup/Delete", new RemoveComponentViewGroup()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (EditorAction == CrudAction.Create)
                {
                    address = "api/ComponentViewGroup/Add";
                }
                else if (EditorAction == CrudAction.Update)
                {
                    address = "api/ComponentViewGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddComponentViewGroupResponse>(address, new AddComponentViewGroup() { ComponentViewGroups = new GXComponentViewGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/ComponentView/ComponentViewGroupGeneral.OnSave");
        }
    }
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
}
