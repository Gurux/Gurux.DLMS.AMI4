@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Pages.Device
@using System.IO.Ports;

<GXHelpContext Topic="SerialSettings" />

<GXAccordion Id="content-type-authoring">
    <HeaderTemplate>
        <div>
            <h6><b>@Properties.Resources.SerialPort</b></h6>
            @if (!Disabled)
            {
                <label>@(string.Format("Settings: {0}", _serial.ToString()))</label>
            }
        </div>
    </HeaderTemplate>
    <ChildContent>
        <div class="form-group">
            <label>@Properties.Resources.Baudrate</label>
            <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="BaudRate"
                             Items="@(BaudRateList)" />
        </div>
        <div class="form-group">
            <label>@Properties.Resources.DataBits</label>
            <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="DataBits"
                             Items="@(DataBitsList)" />
        </div>
        <div class="form-group">
            <label>@Properties.Resources.Parity</label>
            <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="Parity"
                             Items="@(ParityList)" />
        </div>
        <div class="form-group">
            <label>@Properties.Resources.StopBits</label>
            <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="StopBits"
                             Items="@(StopBitList)" />
        </div>
    </ChildContent>
</GXAccordion>
@code {
    private string? _settings;

    /// <summary>
    /// Are the serial port settings disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Settings { get; set; }

    private void UpdateSettings(string? value)
    {
        if (Settings != value)
        {
            Settings = _settings = value;
            _ = SettingsChanged.InvokeAsync(value);
        }
    }

    /// <summary>
    /// Notified when settings are updated.
    /// </summary>
    [Parameter]
    public EventCallback<string?> SettingsChanged { get; set; }

    /// <summary>
    /// Available baud rates.
    /// </summary>
    private int[] BaudRateList = new[] { 300, 600, 1200, 1800, 2400, 4800, 7200, 9600, 14400, 19200, 38400, 56000, 57600, 115200, 128000 };

    /// <summary>
    /// Available parities.
    /// </summary>
    private Parity[] ParityList = new[] { Parity.None, Parity.Odd, Parity.Even, Parity.Mark, Parity.Space };

    /// <summary>
    /// Available stop bits.
    /// </summary>
    private StopBits[] StopBitList = new[] { StopBits.None, StopBits.One, StopBits.Two };

    /// <summary>
    /// Available data bits.
    /// </summary>
    private int[] DataBitsList = new[] { 7, 8 };

    private GXSerialTemplate _serial = new GXSerialTemplate();

    private int BaudRate
    {
        get
        {
            if (_serial == null)
            {
                return 9600;
            }
            return _serial.BaudRate;
        }
        set
        {
            _serial.BaudRate = value;
            UpdateSettings(_serial.Settings);
        }
    }

    private int DataBits
    {
        get
        {
            if (_serial == null)
            {
                return 8;
            }
            return _serial.DataBits;
        }
        set
        {
            _serial.DataBits = value;
            UpdateSettings(_serial.Settings);
        }
    }

    private Parity Parity
    {
        get
        {
            if (_serial == null)
            {
                return Parity.None;
            }
            return (Parity)_serial.Parity;
        }
        set
        {
            _serial.Parity = (int)value;
            UpdateSettings(_serial.Settings);
        }
    }

    private StopBits StopBits
    {
        get
        {
            if (_serial == null)
            {
                return StopBits.None;
            }
            return (StopBits)_serial.StopBits;
        }
        set
        {
            _serial.StopBits = (int)value;
            UpdateSettings(_serial.Settings);
        }
    }

    protected override void OnParametersSet()
    {
        if (_settings == Settings)
        {
            return;
        }
        _settings = Settings;
        try
        {
            _serial.Settings = _settings;
        }
        catch (Exception)
        {
            //Settings might fail when media type is changed.
        }
    }

    /// <summary>
    /// Validate serial port settings.
    /// </summary>
    public void Validate(GXValidator sender)
    {

    }
}
