@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.UI.Components.Accordion
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Pages.Device

<GXHelpContext Topic="NetworkSettings" />

<GXAccordion Id="content-type-authoring">
    <HeaderTemplate>
        <div>
            <h6><b>@Properties.Resources.Network</b></h6>
            @if (!Disabled)
            {
                <label>@(string.Format("Settings: {0}", _net.ToString()))</label>
            }
        </div>
    </HeaderTemplate>
    <ChildContent>
        <div class="form-group">
            <label>@Properties.Resources.Protocol</label>
            <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="Protocol"
                             Items="@(NetworkTypeList)" />
        </div>
        @if (!IsServer)
        {
            <div class="form-group">
                <label>@Properties.Resources.HostName</label>
                <InputText id="name" class="form-control"
                           @bind-Value="HostName" />
                <ValidationMessage For="@(() => HostName)" />
            </div>
        }
        <div class="form-group">
            <label>@Properties.Resources.Port</label>
            <GXInputNumber RememberValue="false" id="port" class="form-control"
                         @bind-Value="Port" Min="@GXNumberBounds.Minimum(Port)" Max="@GXNumberBounds.Maximum(Port)" />
            <ValidationMessage For="@(() => Port)" />
        </div>
    </ChildContent>
</GXAccordion>

@code {
    Gurux.Net.NetworkType[] NetworkTypeList = new Gurux.Net.NetworkType[] { Gurux.Net.NetworkType.Tcp, Gurux.Net.NetworkType.Udp };

    private Gurux.Net.GXNet _net = new Gurux.Net.GXNet();

    private string? _settings;

    /// <summary>
    /// Host name is hidden if only server settings are shown.
    /// </summary>
    [Parameter]
    public bool IsServer { get; set; }

    /// <summary>
    /// Are the network settings disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }


    /// <summary>
    /// Network settings.
    /// </summary>
    [Parameter]
    public string? Settings { get; set; }

    private void UpdateSettings(string value)
    {
        if (Settings != value)
        {
            Settings = _settings = value;
            _ = SettingsChanged.InvokeAsync(value);
        }
    }

    /// <summary>
    /// Notified when settings are updated.
    /// </summary>
    [Parameter]
    public EventCallback<string?> SettingsChanged { get; set; }

    public string? HostName
    {
        get
        {
            return _net?.HostName;
        }
        set
        {
            _net.HostName = value;
            UpdateSettings(_net.Settings.Trim());
        }
    }

    public int Port
    {
        get
        {
            return _net.Port;
        }
        set
        {
            _net.Port = value;
            UpdateSettings(_net.Settings.Trim());
        }
    }

    public Gurux.Net.NetworkType Protocol
    {
        get
        {
            return _net.Protocol;
        }
        set
        {
            _net.Protocol = value;
            UpdateSettings(_net.Settings.Trim());
        }
    }

    /// <summary>
    /// Initialise network settings.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_settings == Settings)
        {
            return;
        }
        _settings = Settings;
        try
        {
            _net.Settings = _settings;
        }
        catch (Exception)
        {
            //Settings might fail when media type is changed.
        }
    }

    /// <summary>
    /// Validate network settings.
    /// </summary>
    public void Validate(GXValidator sender)
    {
        if (!IsServer && string.IsNullOrEmpty(HostName))
        {
            sender.AddError(() => HostName, Properties.Resources.InvalidHostName);
        }
        if (Port == 0)
        {
            sender.AddError(() => Port, Properties.Resources.InvalidPort);
        }
    }
}
