@page "/get-started"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = GXRoles.Admin)]

<PageTitle>@Properties.Resources.GetStartedWithGuruxDlmsAmi</PageTitle>
<AuthorizeView Roles="@GXRoles.Admin">
    <section class="getting-started" aria-labelledby="get-started-title">
        <a href="">@Properties.Resources.Walkthroughs</a>
        <h1 id="get-started-title">@Properties.Resources.GetStartedWithGuruxDlmsAmi</h1>
        <p class="intro">@Properties.Resources.GetStartedDescription</p>
        <section class="setup-section" aria-labelledby="choose-theme">
            <h2 id="choose-theme">@Properties.Resources.ChooseYourTheme</h2>
            <p>@Properties.Resources.ChooseThemeDescription</p>
            <a class="btn btn-primary" href="config/appearance/theme">@Properties.Resources.Theme</a>
        </section>
        <section class="setup-section" aria-labelledby="basic-settings">
            <h2 id="basic-settings">@Properties.Resources.BasicSettings</h2>
            <p>@Properties.Resources.BasicSettingsDescription</p>
            <a class="btn btn-primary" href="User/Edit">@Properties.Resources.UserSettings</a>
        </section>
        <section class="setup-section" aria-labelledby="application-settings">
            <h2 id="application-settings">@Properties.Resources.ApplicationSettings</h2>
            <p>@Properties.Resources.ApplicationSettingsDescription</p>
            <a class="btn btn-outline-secondary" href="config">@Properties.Resources.Settings</a>
        </section>
        <section class="setup-section" aria-labelledby="security-settings">
            <h2 id="security-settings">@Properties.Resources.Security</h2>
            <a class="btn btn-outline-secondary" href="config/security?returnUrl=%2FConfig">@Properties.Resources.Security</a>
        </section>
        <p>
            <a class="forum-link" href="https://gurux.fi/forum/gurux.dlms.ami" target="_blank" rel="noopener noreferrer">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" />
                    <path d="M8 11h8m-8 4h5" />
                </svg>
                <span>@Properties.Resources.AmiForum</span>
            </a>
        </p>
        <p><a href="learn-the-fundamentals">@Properties.Resources.LearnTheFundamentals →</a></p>
    </section>
</AuthorizeView>
