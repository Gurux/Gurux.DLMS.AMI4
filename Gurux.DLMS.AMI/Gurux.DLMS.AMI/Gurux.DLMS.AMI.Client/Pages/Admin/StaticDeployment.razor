@using Gurux.DLMS.AMI.Client.Rest
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable

@if (_status?.Configured == true)
{
    <section aria-labelledby="static-deployment-title" aria-busy="@_status.Busy">
        <h2 id="static-deployment-title">@Text(_status.IncludesBackend ? "Title" : "Interface")</h2>
        <p>@Text("Environment"): @Text("Environment" + _status.HostingEnvironment)</p>
        <p>@Text(_status.IncludesBackend ? "InstalledVersion" : "WasmVersion"): @(_status.CurrentVersion ?? "—")</p>
        <p>@Text("ApiVersion"): @_status.ApiVersion</p>
        <p>@Text("AvailableVersion"): @(_available ?? "—")</p>
        @if (_releases.Length != 0)
        {
            <GXInputDropdown TValue="string" class="form-select" aria-label="AMI version" @bind-Value="_available" Disabled="@(_status.Busy || _starting)" Items="@_releases.Select(release => release.Version)" RememberValue="false" />
        }
        @if (_status.IncludesBackend) { <p>@Text("ExpectedOutage")</p> }
        @if (_maintenanceRequired) { <p role="alert">@Text("StateMaintenanceRequired")</p> }
        @if (_status.AgentAvailable && UpdateAvailable && !_maintenanceRequired)
        {
            <button type="button" class="btn btn-primary" disabled="@(_status.Busy || _starting)" @onclick="StartAsync">
                @Text(_status.Mode == "compose" ? "UpdateAmi" : _status.IncludesBackend ? "UpdateAll" : "UpdateInterface")
            </button>
        }
        @if (_status.AgentAvailable && _status.RestoreVersion is not null)
        {
            <button type="button" class="btn btn-secondary" aria-label="Restore previous version" disabled="@(_status.Busy || _starting)" @onclick="RestorePreviousAsync">
                @Text("RestorePrevious") (@_status.RestoreVersion)
            </button>
        }
        <p role="status">@Text("State" + _status.State) @(_reconnecting ? Text("Reconnecting") : "")</p>
        @if (_status.RequestId is not null) { <p>@Text("UpdateId"): @_status.RequestId</p> }
        @if (!_status.AgentAvailable && !_status.Busy) { <p role="status">@Text("Unavailable")</p> }
        @if (!string.IsNullOrEmpty(_error ?? _status.Error)) { <p role="alert">@(_error ?? _status.Error)</p> }
        @if (_status.State == "Succeeded")
        {
            <button type="button" class="btn btn-secondary" @onclick="Reload">@Text("Reload")</button>
        }
    </section>
}

else if (_status?.HostingEnvironment is "Systemd" or "Linux" or "Container")
{
    <section aria-labelledby="deployment-setup-title">
        <h2 id="deployment-setup-title">@Text("SetupTitle")</h2>
        <p>@Text("Environment"): @Text("Environment" + _status.HostingEnvironment)</p>
        <p role="status">@Text(_status.HostingEnvironment == "Container" ? "ContainerSetup" : "SystemdSetup")</p>
    </section>
}

@code {
    static readonly System.Resources.ResourceManager Labels = new("Gurux.DLMS.AMI.Client.Properties.DeploymentResources", typeof(StaticDeployment).Assembly);
    static string Text(string key) => Labels.GetString(key, System.Globalization.CultureInfo.CurrentUICulture) ?? key;
    bool UpdateAvailable => NuGet.Versioning.NuGetVersion.TryParse(_available, out var available) &&
        (!NuGet.Versioning.NuGetVersion.TryParse(_status?.CurrentVersion, out var current) || available > current);
    readonly CancellationTokenSource _lifetime = new();
    GXDeploymentResponse? _status;
    string? _available;
    string? _error;
    string? _requestId;
    GXDeploymentRelease[] _releases = [];
    bool _maintenanceRequired => _releases.SingleOrDefault(r => r.Version == _available)?.MaintenanceRequired == true;
    bool _starting;
    bool _reconnecting;
    Task? _polling;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) {
            return;
        }
        try
        {
            _requestId = await JS.InvokeAsync<string?>("localStorage.getItem", new object[] { "ami.deployment.requestId" });
            if (!Guid.TryParseExact(_requestId, "N", out _)) {
                _requestId = null;
            }
            _polling = PollAsync();
            _status = await Http.GetFromJsonAsync<GXDeploymentResponse>(StatusUrl, _lifetime.Token);
            if (_status?.Configured == true)
            {
                StateHasChanged();
                var catalog = await Http.GetFromJsonAsync<GXDeploymentResponse>("api/Update/Deployment", _lifetime.Token);
                _available = catalog?.AvailableVersion;
                _releases = catalog?.Releases ?? [];
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { _error = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }
    string StatusUrl => "api/Update/Deployment/Status" + (_requestId is null ? "" : "?requestId=" + _requestId);
    Task StartAsync() => SubmitAsync(_available!, false);
    Task RestorePreviousAsync() => SubmitAsync(_status!.RestoreVersion!, true);
    async Task SubmitAsync(string version, bool restorePrevious)
    {
        _starting = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/Update/Deployment" + (restorePrevious ? "/Restore" : ""), new GXDeploymentVersion { Version = version }, _lifetime.Token);
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(_lifetime.Token); return; }
            _status = await response.Content.ReadFromJsonAsync<GXDeploymentResponse>(cancellationToken: _lifetime.Token);
            _requestId = _status?.RequestId;
            if (_requestId is not null) {
                await JS.InvokeVoidAsync("localStorage.setItem", "ami.deployment.requestId", _requestId);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _reconnecting = true; }
        finally { _starting = false; }
    }
    async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                try
                {
                    _status = await Http.GetFromJsonAsync<GXDeploymentResponse>(StatusUrl, _lifetime.Token);
                    _reconnecting = false;
                }
                catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { break; }
                catch (Exception) { _reconnecting = true; }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_polling != null) {
            await _polling;
        }
        _lifetime.Dispose();
    }
}
