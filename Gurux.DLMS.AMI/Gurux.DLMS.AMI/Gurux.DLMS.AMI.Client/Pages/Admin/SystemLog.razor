@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/systemlog"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="SystemLog" />

<PageTitle>@Properties.Resources.SystemLogs</PageTitle>

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXSystemLogPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Admin.SystemLog" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXSystemLogPolicies.View })" TItem="GXLog" @ref="table"
             @bind-Active="Active"
             Context="error"
             ItemsProvider="@GetItems"
             Filter="@Filter"
             OnSearch="@Updated"
             Columns="@Columns"
             ShowAllUsers="false"
             ShowRemoved="false">
    <FilterContent>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="SystemLog-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Type" Visibility="Visibility.Medium">
            <EnumTypeSelector Type="@TargetType.SystemLog"
                              @bind-Value="@filter.Type"
                              OnSelected="@((int? e) => Updated())">
            </EnumTypeSelector>
        </GXFh>
        <GXFh Id="Message" Visibility="Visibility.Medium">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByError"
                   @onchange="@((ChangeEventArgs __e) => filter.Message = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Level" Visibility="Visibility.Medium">
            <GXInputDropdown class="form-select"
                             Id="ScheduleLogs-TraceLevel"
                             RememberValue="true"
                             @bind-Value="TraceLevel"
                             OnSelected="@((TraceLevel e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Closed" Visibility="Visibility.Medium">
            <input class="form-control" placeholder="@Properties.Resources.FilterByCloseTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Closed = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <HeaderContent>
        <GXTh Name="CreationTime" Target="@error" Sort="@(s => error.CreationTime)" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Type" Target="@error">@Properties.Resources.Type</GXTh>
        <GXTh Name="Message" Target="@error">@Properties.Resources.Error</GXTh>
        <GXTh Name="Level" Target="@error">@Properties.Resources.Level</GXTh>
        <GXTh Name="Closed" Target="@error">@Properties.Resources.CloseTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="CreationTime"><button type="button" class="btn btn-link p-0 text-start" data-diagnostic-details="true" @onclick="() => { _detailsId = error.PublicId; }" @onclick:stopPropagation="true">@ResourceStorage.DateTimeOffsetToString(error.CreationTime)</button></GXTd>
        <GXTd Id="Type">@(ResourceStorage.GetEnumType(TargetType.SystemLog, error.Type))</GXTd>
        <GXTd Id="Message">@error.Message</GXTd>
        <GXTd Id="Level">@ClientHelpers.LevelToString(error.Level)</GXTd>
        <GXTd Id="Closed">@ResourceStorage.DateTimeOffsetToString(error.Closed)</GXTd>
    </ItemContent>
</GXViewTable>

<br />


@if (_detailsId is Guid detailsId)
{
    <GXDialog Title="@Properties.Resources.SystemLogs" Save="false" ManageFocus="true"
              OkButtonTitle="" CancelButtonTitle="@Properties.Resources.Close" OnCancel="() => { _detailsId = null; }">
        <Gurux.DLMS.AMI.Client.Pages.Log.LogDetails Id="@detailsId" Source="system" Embedded="true" />
    </GXDialog>
}

@code {
    private Guid? _detailsId;
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Type") { Position = 1, Description = "Type", Visibility = (byte)Visibility.All },
        new("Message") { Position = 2, Description = "Error", Visibility = (byte)Visibility.All },
        new("Level") { Position = 3, Description = "Level", Visibility = (byte)Visibility.All },
        new("Closed") { Position = 4, Description = "CloseTime", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected system log ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXLog? Active { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.SystemLogs;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "system-log";
        }
    }

    private string? GetTraceLevel(int id)
    {
        //Get localized enum type.
        return ResourceStorage.GetEnumType(TargetType.SystemLog, id);
    }

    /// <summary>
    /// Amount of the sytem logs shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    private GXViewTable<GXLog>? table;

    /// <summary>
    /// Trace level.
    /// </summary>
    private TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// System error filter.
    /// </summary>
    private GXLog filter = new GXLog();


    public bool IsActive(GXLog item)
    {
        return item.Closed == null;
    }

    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingSystemLog);
            NotificationService?.RemoveByKey("Pages/Admin/SystemLog.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (logs) =>
            {
                foreach (var it in logs)
                {
                    if (it.Type == GXSystemLogPolicies.Add ||
                        it.Type == GXSystemLogPolicies.Clear ||
                        it.Type == GXSystemLogPolicies.Close)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, logs, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXLog() { PublicId = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/SystemLog.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingSystemLog);
        try
        {
            if (ShowClosedErrors)
            {
                //Show closed errors.
                filter.Closed = DateTimeOffset.MaxValue;
            }
            else
            {
                //Show active errors.
                filter.Closed = null;
            }
            if (TraceLevel == TraceLevel.Off)
            {
                filter.Level = null;
            }
            else
            {
                filter.Level = (int)TraceLevel;
            }
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.SystemLog);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=system", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                //Mark system logs as seen.
                if (ret.Logs.Any())
                {
                    if (Notifier != null)
                    {
                        await Notifier.Mark(Http, TargetType.SystemLog, ret.Logs.Max(s => s.CreationTime));
                    }
                }
            
                if (Id.HasValue && table != null)
                {
                    Active = ret.Logs?.FirstOrDefault(log => log.PublicId == Id.Value);
                    table.RestoreSelection(Active);
                }
            
                return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (OperationCanceledException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (ObjectDisposedException)
        {
            //Might happen when the user scrolls the list rapidly.
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(ex.ToString());
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Clear the system error list.
    /// </summary>

    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Admin/SystemLog.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearErrors,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the system error list.
    /// </summary>

    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingSystemLog);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=system", new ClearLog());
                    await Updated();
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
