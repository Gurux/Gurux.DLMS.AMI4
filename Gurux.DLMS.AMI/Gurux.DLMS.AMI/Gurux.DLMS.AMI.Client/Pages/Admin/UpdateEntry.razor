@using Gurux.DLMS.AMI.Client.Rest

<GXHelpContext Topic="UpdateEntry" />

<article class="update-entry @StatusClass">
    <div class="update-heading">
        <strong>@Item.Name</strong>
        <span class="update-status">@StatusText</span>
    </div>
    <div class="update-details">
        <div>
            <span class="version-label">@Properties.Resources.UpdatesInstalledVersion:</span>
            <span>@InstalledVersionText</span>
        </div>
        <div>
            <span class="version-label">@Properties.Resources.UpdatesLatestVersion:</span>
            <span>@(string.IsNullOrWhiteSpace(Item.AvailableVersion) ? Properties.Resources.Unknown : Item.AvailableVersion)</span>
            @if (ReleaseNotesUrl != null)
            {
                <a href="@ReleaseNotesUrl" target="_blank" rel="noopener noreferrer">@Properties.Resources.ReleaseNotes</a>
            }
            @if (Item.PublishedAt is DateTimeOffset published)
            {
                <time datetime="@published.ToString("O")">@published.ToLocalTime().ToString("d")</time>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Item.Description))
    {
        <p class="update-description">@Item.Description</p>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public GXAvailableUpdate Item { get; set; } = new();

    private string InstalledVersionText => !string.IsNullOrWhiteSpace(Item.InstalledVersion)
        ? Item.InstalledVersion : Item.Status == GXUpdateStatus.Available ? Properties.Resources.UpdatesNotInstalled : Properties.Resources.Unknown;

    private string StatusText => Item.Status switch
    {
        GXUpdateStatus.UpToDate => Properties.Resources.UpdatesUpToDate,
        GXUpdateStatus.UpdateAvailable => Properties.Resources.UpdatesUpdateAvailable,
        GXUpdateStatus.Available => Properties.Resources.UpdatesAvailable,
        _ => Properties.Resources.Unknown
    };

    private string StatusClass => Item.Status switch
    {
        GXUpdateStatus.UpToDate => "up-to-date",
        GXUpdateStatus.UpdateAvailable => "update-available",
        GXUpdateStatus.Available => "available",
        _ => "unknown"
    };

    private string? ReleaseNotesUrl => Uri.TryCreate(Item.ReleaseNotesUrl, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp) ? uri.AbsoluteUri : null;
}
