@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/tasks"
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent

<GXHelpContext Topic="Tasks" />

@if (Title)
{
    <PageTitle>@Properties.Resources.Tasks (@Properties.Resources.Total: @Total)</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXTaskPolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXTaskPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Admin.Tasks" ViewColumns="_viewColumnDefaults" ViewPolicies="@(new List<string> { GXTaskPolicies.View })" TItem="GXTask" @ref="table"
             @bind-Active="Active"
             Context="task"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             ShowAllUsers="@Header"
             Columns="@Columns"
             Filter="@Filter"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Target">
            @*Target*@
        </GXFh>
        <GXFh Id="CreationTime">
            <GXDateTimeSelector Id="Tasks-CreationTime"
                                @bind-Value="@_filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="TaskType" Visibility="Visibility.Small">
            @*Task type*@
            <GXInputDropdown class="form-select"
                             Id="Tasks-Type"
                             RememberValue="true"
                             @bind-Value="_filter.TaskType"
                             OnSelected="@((TaskType? e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Start" Visibility="Visibility.Small">
            <input class="form-control" placeholder="@Properties.Resources.FilterByStartTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => _filter.Start = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="Ready" Visibility="Visibility.Medium">
            <input class="form-control" placeholder="@Properties.Resources.FilterByEndTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => _filter.Ready = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="Error">
        </GXFh>
        <GXFh Id="Result" Visibility="Visibility.Large">
            @*Result.*@
        </GXFh>
    </FilterContent>
    <HeaderContent>
        <GXTh Name="Target" Target="@task">@Properties.Resources.Target</GXTh>
        <GXTh Name="CreationTime" Target="@task" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="TaskType" Target="@task" Visibility="Visibility.Small">@Properties.Resources.TaskType</GXTh>
        <GXTh Name="Start" Target="@task" Visibility="Visibility.Small">@Properties.Resources.StartTime</GXTh>
        <GXTh Name="Ready" Target="@task" Visibility="Visibility.Medium">@Properties.Resources.CompletedTime</GXTh>
        <GXTh Name="Error" Target="@task">@Properties.Resources.Error</GXTh>
        <GXTh Name="Result" Target="@task" Visibility="Visibility.Large">@Properties.Resources.Result</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Target">@task.Target</GXTd>
        <GXTd Id="CreationTime"><button type="button" class="btn btn-link p-0 text-start" data-diagnostic-details="true" @onclick="() => { _detailsId = task.Id; }" @onclick:stopPropagation="true">@ResourceStorage.DateTimeOffsetToString(task.CreationTime)</button></GXTd>
        <GXTd Id="TaskType" Visibility="Visibility.Small">@TaskTypeToString(task.TaskType)</GXTd>
        <GXTd Id="Start" Visibility="Visibility.Small">@ResourceStorage.DateTimeOffsetToString(task.Start)</GXTd>
        <GXTd Id="Ready" Visibility="Visibility.Medium">@ResourceStorage.DateTimeOffsetToString(task.Ready)</GXTd>
        <GXTd Id="Error"><span class="text-danger">@task.Error</span></GXTd>
        <GXTd Id="Result" Visibility="Visibility.Large">@task.Result</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@if (_detailsId is Guid detailsId)
{
    <GXDialog Title="@Properties.Resources.Task" Save="false" ManageFocus="true"
              OkButtonTitle="" CancelButtonTitle="@Properties.Resources.Close" OnCancel="() => { _detailsId = null; }">
        <TaskDetails Id="@detailsId" />
    </GXDialog>
}

@code {
    /// <summary>Identifies the record whose details are currently open.</summary>
    private Guid? _detailsId;
    /// <summary>Defines the default columns and formatting used by the page's table.</summary>
    private static readonly GXViewColumn[] _viewColumnDefaults =
    [
        new("Target") { Position = 0, Description = "Target", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("TaskType") { Position = 2, Description = "TaskType", Visibility = (byte)Visibility.Small },
        new("Start") { Position = 3, Description = "StartTime", Visibility = (byte)Visibility.Small },
        new("Ready") { Position = 4, Description = "CompletedTime", Visibility = (byte)Visibility.Medium },
        new("Error") { Position = 5, Description = "Error", Visibility = (byte)Visibility.All },
        new("Result") { Position = 6, Description = "Result", Visibility = (byte)Visibility.Large },
    ];

    /// <summary>Combines overlapping task notifications into serialized refresh passes.</summary>
    private GXUpdateRefreshCoordinator? _taskRefresh;
    /// <summary>Cancels targeted task reads when the page is disposed.</summary>
    private readonly CancellationTokenSource _notificationCancellation = new();
    /// <summary>Identifies the current provider load so an older targeted read cannot overwrite a newer page.</summary>
    private long _loadGeneration;
    /// <summary>Identifies provider requests whose snapshots must be restarted when a task changes.</summary>
    private bool _providerLoading;
    /// <summary>Retains the user visibility scope selected by the current provider request.</summary>
    private bool _showAllUserData;
    /// <summary>Prevents queued notification callbacks from updating a disposed page.</summary>
    private bool _disposed;

    /// <summary>Subscribes to connection and application-state notifications used by this view.</summary>
    private IGXNotifier2? _notifier;
    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected schedule ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Gets or sets the selected task without replacing its identity during runtime updates.</summary>
    private GXTask? Active { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Tasks;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "tasks";
        }
    }

    /// <summary>
    /// Amount of the tasks shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Total numbers of rows in the database.
    /// </summary>
    internal int Total
    {
        get
        {
            if (table == null)
            {
                return 0;
            }
            return table.TotalCount;
        }
    }


    /// <summary>Formats a task operation using the current localized operation labels.</summary>
    /// <param name="type">The task operation, if known.</param>
    /// <returns>The localized operation label or an empty string for an unspecified operation.</returns>
    private static string TaskTypeToString(TaskType? type)
    {
        string? str;
        switch (type)
        {
            case TaskType.Read:
                str = Properties.Resources.Read;
                break;
            case TaskType.Write:
                str = Properties.Resources.Write;
                break;
            case TaskType.Action:
                str = Properties.Resources.Action;
                break;
            case TaskType.Refresh:
                str = Properties.Resources.Refresh;
                break;
            default:
                str = type?.ToString() ?? string.Empty;
                break;
        }
        return str;
    }

    /// <summary>
    /// Task filter.
    ///</summary>
    private GXTask _filter = new GXTask();

    /// <summary>
    /// User is verified before tasks are cleared.
    ///</summary>
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXTask>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                _notificationService?.RemoveByKey("Pages/Admin/Tasks.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Admin/Tasks.Updated");
        }
    }

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        _notifier = Services.GetService<IGXNotifier2>();
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();
        if (_notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingTasks);
            _notificationService?.RemoveByKey("Pages/Admin/Tasks.OnInitialized");
            IReadOnlyList<GXTarget> pendingUpdates = [];
            _taskRefresh = new GXUpdateRefreshCoordinator(items =>
            {
                pendingUpdates = items;
                return true;
            }, () => InvokeAsync(() => RefreshTasksAsync(pendingUpdates)));
            _notifier.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), items =>
            {
                _ = _taskRefresh.RequestAsync(items.Where(item => item.Type == GXTaskPolicies.Add ||
                    item.Type == GXTaskPolicies.Edit || item.Type == GXTaskPolicies.Delete || item.Type == GXTaskPolicies.Clear));
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXTask() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Admin/Tasks.OnInitialized");
        }
    }

    /// <summary>Updates visible runtime fields in place, reloading the page when membership or order may change.</summary>
    /// <param name="updates">Task notifications combined by the page's refresh coordinator.</param>
    /// <returns>The completion of the affected-row read or full provider refresh.</returns>
    private async Task RefreshTasksAsync(IReadOnlyList<GXTarget> updates)
    {
        if (_disposed || table == null)
        {
            return;
        }
        try
        {
            if (updates.Any(update => update.Type != GXTaskPolicies.Edit || update.Source?.StartsWith("task.runtime:", StringComparison.Ordinal) != true ||
                !Guid.TryParse(update.Id, out _)) || _providerLoading || RuntimeChangesAffectQuery(updates))
            {
                await Updated();
                return;
            }
            var ids = updates.Select(update => Guid.Parse(update.Id!)).ToHashSet();
            var rows = table.Items?.Where(row => ids.Contains(row.Id)).ToArray() ?? [];
            if (rows.Length == 0)
            {
                return;
            }
            long generation = _loadGeneration;
            var response = await Http.PostAsJson<ListTasksResponse>("api/Task/List", new ListTasks
            {
                Included = rows.Select(row => row.Id).ToArray(),
                Count = rows.Length,
                Filter = _filter,
                AllUsers = _showAllUserData
            }, _notificationCancellation.Token);
            if (_disposed || generation != _loadGeneration)
            {
                return;
            }
            var tasks = response.Tasks?.ToDictionary(task => task.Id);
            if (tasks == null || rows.Any(row => !tasks.ContainsKey(row.Id)))
            {
                await Updated();
                return;
            }
            foreach (var row in rows)
            {
                var task = tasks[row.Id];
                row.Start = task.Start;
                row.Ready = task.Ready;
                row.Error = task.Error;
                row.Result = task.Result;
                row.Data = task.Data;
                row.OperatingAgent = task.OperatingAgent;
                row.Updated = task.Updated;
            }
            _notificationService?.RemoveByKey("Pages/Admin/Tasks.RuntimeUpdate");
            await table.RefreshRowsAsync();
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // The page no longer owns any visible rows.
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Admin/Tasks.RuntimeUpdate");
        }
    }

    /// <summary>Checks whether the reported runtime columns can change result membership or ordering.</summary>
    /// <param name="updates">Notifications whose sources identify the changed runtime columns.</param>
    /// <returns>True when a changed column is filtered or determines the displayed ordering.</returns>
    private bool RuntimeChangesAffectQuery(IEnumerable<GXTarget> updates)
    {
        foreach (var column in updates.SelectMany(update => update.Source!["task.runtime:".Length..].Split(',')).Distinct())
        {
            if (column is not (nameof(GXTask.Start) or nameof(GXTask.Ready) or nameof(GXTask.Error) or
                nameof(GXTask.Result) or nameof(GXTask.Data) or nameof(GXTask.OperatingAgent) or nameof(GXTask.Updated)))
            {
                return true;
            }
            var filterValue = typeof(GXTask).GetProperty(column)!.GetValue(_filter);
            if ((filterValue != null && filterValue is not "") || (table?.SortMode != SortMode.None && table?.OrderBy == column))
            {
                return true;
            }
        }
        return false;
    }

    /// <summary>Loads a task page using the current filters, ordering, and user visibility.</summary>
    /// <param name="request">The provider's paging, ordering, and cancellation settings.</param>
    /// <returns>The matching tasks and the total count reported by the server.</returns>
    private async ValueTask<ItemsProviderResult<GXTask>> GetItems(GXItemsProviderRequest request)
    {
        long generation = ++_loadGeneration;
        _providerLoading = true;
        _showAllUserData = request.ShowAllUserData;
        //Don't clear status or error is lost.
        using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingTasks);
        try
        {
            ListTasks req = new ListTasks()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = _filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListTasksResponse>("api/Task/List", req, request.CancellationToken);
            if (ret.Tasks != null)
            {
                //Mark tasks as seen.
                if (_notifier != null && ret.Tasks.Any())
                {
                    await _notifier.Mark(Http, TargetType.Task, ret.Tasks.Max(s => s.CreationTime));
                }

                return new ItemsProviderResult<GXTask>(ret.Tasks, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _providerLoading = false;
            }
        }
        return default;
    }

    /// <summary>
    /// Remove selected tasks.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SelectedItems.Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = false
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Clear the all tasks.
    /// </summary>
    public async Task OnClear()
    {
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearTasks,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Delete the selected task list.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                DeleteTask req = new DeleteTask();
                req.Ids = table.SelectedItems.Select(w => w.Id).ToArray();
                await Http.PostAsJson<DeleteTaskResponse>("api/Task/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Clear user tasks.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = _progress?.ProgressStart(GXProgress.SavingTask);
                try
                {
                    ClearTask req = new ClearTask();
                    await Http.PostAsJson<ClearTaskResponse>("api/Task/Clear", req);
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>Stops notification refreshes and cancels outstanding row reads before releasing the view.</summary>
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        _taskRefresh?.Dispose();
        _notificationCancellation.Cancel();
        _notificationCancellation.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        _notifier?.RemoveListener(this);
    }
}
