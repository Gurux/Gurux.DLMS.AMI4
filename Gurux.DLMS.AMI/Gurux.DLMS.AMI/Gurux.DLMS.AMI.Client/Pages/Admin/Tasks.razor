@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/tasks"
@using Gurux.DLMS.AMI.Client.Shared.Enums
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent

<GXHelpContext Topic="Tasks" />

@if (Title)
{
    <PageTitle>@Properties.Resources.Tasks (@Properties.Resources.Total: @Total)</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXTaskPolicies.Delete" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXTaskPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Admin.Tasks" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXTaskPolicies.View })" TItem="GXTask" @ref="table"
             @bind-Active="Active"
             Context="task"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             ShowAllUsers="@Header"
             Columns="@Columns"
             Filter="@Filter"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Target">
            @*Target*@
        </GXFh>
        <GXFh Id="CreationTime">
            <GXDateTimeSelector Id="Tasks-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="TaskType" Visibility="Visibility.Small">
            @*Task type*@
            <GXInputDropdown class="form-select"
                             Id="Tasks-Type"
                             RememberValue="true"
                             @bind-Value="filter.TaskType"
                             OnSelected="@((TaskType? e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Start" Visibility="Visibility.Small">
            <input class="form-control" placeholder="@Properties.Resources.FilterByStartTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Start = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="Ready" Visibility="Visibility.Medium">
            <input class="form-control" placeholder="@Properties.Resources.FilterByEndTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Ready = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="Result" Visibility="Visibility.Large">
            @*Result.*@
        </GXFh>
    </FilterContent>
    <HeaderContent>
        <GXTh Name="Target" Target="@task">@Properties.Resources.Target</GXTh>
        <GXTh Name="CreationTime" Target="@task" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="TaskType" Target="@task" Visibility="Visibility.Small">@Properties.Resources.TaskType</GXTh>
        <GXTh Name="Start" Target="@task" Visibility="Visibility.Small">@Properties.Resources.StartTime</GXTh>
        <GXTh Name="Ready" Target="@task" Visibility="Visibility.Medium">@Properties.Resources.CompletedTime</GXTh>
        <GXTh Name="Result" Target="@task" Visibility="Visibility.Large">@Properties.Resources.Result</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Target">@task.Target</GXTd>
        <GXTd Id="CreationTime"><button type="button" class="btn btn-link p-0 text-start" data-diagnostic-details="true" @onclick="() => { _detailsId = task.Id; }" @onclick:stopPropagation="true">@ResourceStorage.DateTimeOffsetToString(task.CreationTime)</button></GXTd>
        <GXTd Id="TaskType" Visibility="Visibility.Small">@TaskTypeToString(task.TaskType)</GXTd>
        <GXTd Id="Start" Visibility="Visibility.Small">@ResourceStorage.DateTimeOffsetToString(task.Start)</GXTd>
        <GXTd Id="Ready" Visibility="Visibility.Medium">@ResourceStorage.DateTimeOffsetToString(task.Ready)</GXTd>
        <GXTd Id="Result" Visibility="Visibility.Large">@task.Result</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@if (_detailsId is Guid detailsId)
{
    <GXDialog Title="@Properties.Resources.Task" Save="false" ManageFocus="true"
              OkButtonTitle="" CancelButtonTitle="@Properties.Resources.Close" OnCancel="() => { _detailsId = null; }">
        <TaskDetails Id="@detailsId" />
    </GXDialog>
}

@code {
    private Guid? _detailsId;
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Target") { Position = 0, Description = "Target", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("TaskType") { Position = 2, Description = "TaskType", Visibility = (byte)Visibility.Small },
        new("Start") { Position = 3, Description = "StartTime", Visibility = (byte)Visibility.Small },
        new("Ready") { Position = 4, Description = "CompletedTime", Visibility = (byte)Visibility.Medium },
        new("Result") { Position = 5, Description = "Result", Visibility = (byte)Visibility.Large },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected schedule ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXTask? Active { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Tasks;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "tasks";
        }
    }

    /// <summary>
    /// Amount of the tasks shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Total numbers of rows in the database.
    /// </summary>
    internal int Total
    {
        get
        {
            if (table == null)
            {
                return 0;
            }
            return table.TotalCount;
        }
    }


    private static string TaskTypeToString(TaskType? type)
    {
        string? str;
        switch (type)
        {
            case TaskType.Read:
                str = Properties.Resources.Read;
                break;
            case TaskType.Write:
                str = Properties.Resources.Write;
                break;
            case TaskType.Action:
                str = Properties.Resources.Action;
                break;
            case TaskType.Refresh:
                str = Properties.Resources.Refresh;
                break;
            default:
                str = type?.ToString() ?? string.Empty;
                break;
        }
        return str;
    }

    /// <summary>
    /// Task filter.
    ///</summary>
    private GXTask filter = new GXTask();

    /// <summary>
    /// User is verified before tasks are cleared.
    ///</summary>
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXTask>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Admin/Tasks.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/Tasks.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingTasks);
            NotificationService?.RemoveByKey("Pages/Admin/Tasks.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXTaskPolicies.Add ||
                        it.Type == GXTaskPolicies.Delete ||
                        it.Type == GXTaskPolicies.Clear)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                    if (it.Type == GXTaskPolicies.Edit)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXTask() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/Tasks.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXTask>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingTasks);
        try
        {
            ListTasks req = new ListTasks()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListTasksResponse>("api/Task/List", req, request.CancellationToken);
            if (ret.Tasks != null)
            {
                //Mark tasks as seen.
                if (Notifier != null)
                {
                    await Notifier.Mark(Http, TargetType.Task, ret.Tasks.Max(s => s.CreationTime));
                }

                return new ItemsProviderResult<GXTask>(ret.Tasks, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Remove selected tasks.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SelectedItems.Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = false
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Clear the all tasks.
    /// </summary>
    public async Task OnClear()
    {
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearTasks,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Delete the selected task list.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                DeleteTask req = new DeleteTask();
                req.Ids = table.SelectedItems.Select(w => w.Id).ToArray();
                await Http.PostAsJson<DeleteTaskResponse>("api/Task/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Clear user tasks.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingTask);
                try
                {
                    ClearTask req = new ClearTask();
                    await Http.PostAsJson<ClearTaskResponse>("api/Task/Clear", req);
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
