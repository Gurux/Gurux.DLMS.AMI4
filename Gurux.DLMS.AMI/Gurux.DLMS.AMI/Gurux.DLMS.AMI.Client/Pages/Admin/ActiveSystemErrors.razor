@page "/activeSystemLogs"
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject IServiceProvider Services
@inject HttpClient Http
@implements IGXAmiComponent
@implements IDisposable

<GXHelpContext Topic="ActiveSystemErrors" />

@if (ActiveErrors != null)
{
    @foreach (var it in ActiveErrors)
    {
        <StatusTile Title="@GetErrorTitle(@it.Level)" OnClose="@OnClose" Target="@it" Mode="@GetTraceLevel(it)">
            @it.Message
        </StatusTile>
    }
}
<CascadingValue Value=this>
    @ChildContent
</CascadingValue>
@code {
    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    /// <summary>
    /// Amount of the errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 5;

    TraceLevel GetTraceLevel(GXLog item)
    {
        return (TraceLevel)item.Level.GetValueOrDefault();
    }

    string GetErrorTitle(int? level)
    {
        return ((TraceLevel)level.GetValueOrDefault()).ToString();
    }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ActiveSystemErrors;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "system-errors";
        }
    }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    IEnumerable<GXLog>? ActiveErrors = null;

    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Admin/ActiveSystemErrors.Updated");
            ActiveErrors = null;
            await GetActiveErrors();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveSystemErrors.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingActiveSystemErrors);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveSystemErrors.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (logs) =>
           {
               foreach (var it in logs)
               {
                   if (it.Type == GXSystemLogPolicies.Add ||
                       it.Type == GXSystemLogPolicies.Clear ||
                       it.Type == GXSystemLogPolicies.Close)
                   {
                       _ = GXNotificationRefresh.RefreshViewAsync(this, logs, Updated);
                       break;
                   }
               }
           });
            await GetActiveErrors();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveSystemErrors.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Get active errors.
    /// </summary>
    private async Task GetActiveErrors()
    {
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingActiveSystemErrors);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveSystemErrors.GetActiveErrors");
            GXLog filter = new GXLog();
            ListLogs req = new ListLogs() { Filter = filter };
            req.Count = Count;
            ListLogsResponse ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=system", req);
            ActiveErrors = ret.Logs;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveSystemErrors.GetActiveErrors");
        }
    }

    public void Dispose()
    {
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Close the selected system error.
    /// </summary>
    /// <param name="error"></param>
    /// <returns></returns>
    public async Task OnClose(object sender)
    {
        try
        {
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingActiveSystemError);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveSystemErrors.OnClose");
            CloseLog arg = new CloseLog();
            if (sender is not GXLog log)
            {
                return;
            }
            arg.Ids = new Guid[] { log.PublicId };
            await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=system", arg);
            List<GXLog> list = new List<GXLog>();
            list.AddRange(ActiveErrors ?? []);
            list.Remove(log);
            ActiveErrors = list.ToArray();
            await Updated();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveSystemErrors.OnClose");
        }
    }


    /// <summary>
    /// Clear the system error list.
    /// </summary>

    public async Task OnClearConfirmation(bool confirm)
    {
        try
        {
            if (confirm)
            {
                using var progressScope4 = Progress?.ProgressStart(GXProgress.SavingActiveSystemError);
                await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=system", new ClearLog());
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
