@using Gurux.DLMS.AMI.Client.Rest

<div class="release-row">
    <span class="release-label">@Label:</span>
    <div class="release-version">
        @if (NotesUrl is string url)
        {
            <a href="@url" target="_blank" rel="noopener noreferrer">@Release.Version</a>
        }
        else
        {
            <span>@Release.Version</span>
        }
        @if (Release.Prerelease)
        {
            <span class="prerelease">@Properties.Resources.Prerelease</span>
        }
        @if (Release.PublishedAt is DateTimeOffset published)
        {
            <time datetime="@published.ToString("O")">(@published.ToLocalTime().ToString("yyyy-MMM-dd"))</time>
        }
    </div>
    <div class="release-notes">
        @if (NotesUrl is string notes)
        {
            <a href="@notes" target="_blank" rel="noopener noreferrer">@ReleaseNotesLabel</a>
        }
        else if (!string.IsNullOrWhiteSpace(Release.ReleaseNotes))
        {
            <details>
                <summary>@ReleaseNotesLabel</summary>
                <pre>@Release.ReleaseNotes</pre>
            </details>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GXAvailableRelease Release { get; set; } = new();
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string ReleaseNotesLabel { get; set; } = Properties.Resources.ReleaseNotes;

    private string? NotesUrl => Uri.TryCreate(Release.ReleaseNotesUrl, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp) ? uri.AbsoluteUri : null;
}
