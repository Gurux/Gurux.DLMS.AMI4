@page "/activedeviceerrors"
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics
@using System.Text.Json

@inject IServiceProvider Services
@inject HttpClient Http
@implements IGXAmiComponent
@implements IDisposable

<GXHelpContext Topic="ActiveDeviceErrors" />

@if (_errors != null)
{
    @foreach (var it in _errors)
    {
        <StatusTile Title="@GetErrorTitle(@it.Level)" OnClose="@OnClose" Target="@it" Mode="@GetTraceLevel(it)">
            <div class="small"><LogCreatorLabel Creator="@it.Creator" Resource="Device" /></div>
            @it.Message
        </StatusTile>
    }
}
<CascadingValue Value=this>
    @ChildContent
</CascadingValue>
@code {
    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    TraceLevel GetTraceLevel(GXLog item)
    {
        return (TraceLevel)item.Level.GetValueOrDefault();
    }

    string GetErrorTitle(int? level)
    {
        if (level == null)
        {
            return "";
        }
        return ((TraceLevel)level).ToString();
    }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Amount of the errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 5;

    IEnumerable<GXLog>? _errors = null;

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ActiveDeviceErrors;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device-errors";
        }
    }

    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            await GetActiveErrors();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingActiveDeviceErrors);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveDeviceErrors.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXDeviceLogPolicies.Add ||
                        it.Type == GXDeviceLogPolicies.Clear ||
                        it.Type == GXDeviceLogPolicies.Close)
                    {
                        _ = GXNotificationRefresh.RefreshViewAsync(this, items, Updated);
                        break;
                    }
                }
            });
            await GetActiveErrors();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveDeviceErrors.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Get active errors.
    /// </summary>
    private async Task GetActiveErrors()
    {
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingActiveDeviceErrors);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveDeviceErrors.GetActiveErrors");
            GXLog filter = new GXLog();
            ListLogs req = new ListLogs() { Filter = filter };
            req.Count = Count;
            ListLogsResponse ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=device-error", req);
            _errors = ret.Logs;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveDeviceErrors.GetActiveErrors");
        }
    }

    public void Dispose()
    {
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Close the selected error.
    /// </summary>
    /// <param name="error"></param>
    /// <returns></returns>
    public async Task OnClose(object sender)
    {
        try
        {
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingActiveDeviceError);
            NotificationService?.RemoveByKey("Pages/Admin/ActiveDeviceErrors.OnClose");
            CloseLog arg = new CloseLog();
            if (sender is not GXLog log)
            {
                return;
            }
            arg.Ids = new Guid[] { log.PublicId };
            await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=device-error", arg);
            List<GXLog> list = new List<GXLog>();
            list.AddRange(_errors ?? []);
            list.Remove(log);
            _errors = list.ToArray();
            await InvokeAsync(StateHasChanged);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Admin/ActiveDeviceErrors.OnClose");
        }
    }


    /// <summary>
    /// Clear the error list.
    /// </summary>

    public async Task OnClearConfirmation(bool confirm)
    {
        try
        {
            if (confirm)
            {
                using var progressScope4 = Progress?.ProgressStart(GXProgress.SavingActiveDeviceError);
                await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=device-error", new ClearLog());
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
