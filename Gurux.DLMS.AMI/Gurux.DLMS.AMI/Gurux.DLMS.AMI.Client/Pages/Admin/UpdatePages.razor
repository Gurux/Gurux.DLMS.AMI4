@page "/updates"
@page "/update"
@page "/updates/settings"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = GXUpdatePolicies.Admin)]
@inject NavigationManager Navigation

<GXTabControl PersistSelectionInUrl="true" RouteGroup="updates" Active="@ActivePath">
    <TabTextTemplate>
        <GXImage Id="@context.Icon" />
        <GXLocalizedText Value="@context.Text" />
    </TabTextTemplate>
    <ChildContent>
        <TabHeader Name="@GXMenus.UpdateTab" />
    </ChildContent>
</GXTabControl>

@code {
    private string ActivePath => Navigation.GetCurrentPagePath().Equals("updates/settings", StringComparison.OrdinalIgnoreCase)
        ? "updates/settings" : "updates";
}


