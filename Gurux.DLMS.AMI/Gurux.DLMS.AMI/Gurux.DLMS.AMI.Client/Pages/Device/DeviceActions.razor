@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/DeviceActions"
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Helpers

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="DeviceActions" />

@if (Title)
{
    <PageTitle>@Properties.Resources.Actions @SelectedDevice</PageTitle>
}
<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXDeviceActionPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Device.DeviceActions" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXDeviceActionPolicies.View })"
             TItem="GXLog" @ref="table"
             @bind-Active="Active"
             Context="action"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.None"
             Filter="@Filter"
             ShowAllUsers="@Header"
             Columns="@Columns"
             ShowRemoved="false"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Device">
            <DeviceDropdownSelector @bind-Value="_deviceFilter" @bind-Value:after="Updated" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="DeviceActions-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Type">
            @*Type*@
        </GXFh>
        <GXFh Id="Data">
            @*Data*@
        </GXFh>
        <GXFh Id="Reply">
            @*Reply*@
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnEdit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Device">@Properties.Resources.Device</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@action" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Type" Name="Type" Target="@action">@Properties.Resources.Type</GXTh>
        <GXTh Id="Data" Target="@action">@Properties.Resources.Data</GXTh>
        <GXTh Id="Reply" Target="@action">@Properties.Resources.Reply</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Device"><LogCreatorLabel Creator="@action.Creator" Resource="Device" /></GXTd>
        <GXTd Id="CreationTime" Link="@NavigationManager.GetCurrentPagePath("/DeviceAction/Edit/" + action.PublicId)">@action.CreationTime</GXTd>
        <GXTd Id="Type">@GetEnumType(action.Type)</GXTd>
        <GXTd Id="Data">@action.Data</GXTd>
        <GXTd Id="Reply">@action.Reply</GXTd>
    </ItemContent>
</GXViewTable>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Device") { Position = 0, Description = "Device", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Type") { Position = 2, Description = "Type", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Data") { Position = 3, Description = "Data", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Reply") { Position = 4, Description = "Reply", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected device action ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXLog? Active { get; set; }

    private string? GetEnumType(int? id)
    {
        //Get localized enum type.
        return id.HasValue ? ResourceStorage.GetEnumType(TargetType.DeviceAction, id.Value) : null;
    }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.DeviceActions;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device-action";
        }
    }

    /// <summary>
    /// Amount of the device actions shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Device action log filter.
    /// </summary>
    private GXDevice? _deviceFilter;
    private GXLog filter = new GXLog();

    public string? SelectedDevice { get; private set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXLog>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Device/DeviceActions.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceActions.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceActions);
            NotificationService?.RemoveByKey("Pages/Device/DeviceActions.OnInitialized");
            NotificationService?.RemoveByKey("Pages/Device/DeviceActions.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXDeviceActionPolicies.Add ||
                        it.Type == GXDeviceActionPolicies.Clear)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXLog() { PublicId = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceActions.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingDeviceActions);
        try
        {
            filter.Creator = _deviceFilter?.Id;
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.DeviceAction);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=device-action", req, request.CancellationToken);
            if (Id.HasValue && table != null)
            {
                table.RestoreSelection(ret.Logs?.FirstOrDefault(log => log.PublicId == Id.Value));
            }
            return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Show device action.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/DeviceActions.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/DeviceAction/Edit/" + table?.Active.PublicId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceActions.OnEdit");
        }
    }

    /// <summary>
    /// Clear the device actions.
    /// </summary>
    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Device/DeviceActions.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = "Clear",
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the system error list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingDeviceAction);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=device-action", new ClearLog() { Delete = args.Delete });
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
