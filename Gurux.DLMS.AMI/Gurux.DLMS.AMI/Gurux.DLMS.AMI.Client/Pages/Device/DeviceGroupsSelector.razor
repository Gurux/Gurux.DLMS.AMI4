@using Gurux.DLMS.AMI.Client.Pages.Agent;
@using Gurux.DLMS.AMI.Client.Pages.Gateway;
@using Gurux.DLMS.AMI.Client.Pages.Schedule;
@using Gurux.DLMS.AMI.Client.Pages.User;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="DeviceGroupsSelector" />

<SelectionContainer TItem="GXDeviceGroup" @ref="@_selectionContainer">
    <SelectionList TItem="GXDeviceGroup" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems"
                   OnAdded="OnAdded"
                   OnRemoved="@Removed">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
        <ButtonContent>
            <div>
                <button style="float: right;" class="btn btn-outline-secondary border-left-0 border"
                        type="button" onclick="@(() => RemoveAll())">
                    &raquo;
                </button>
            </div>
        </ButtonContent>
    </SelectionList>
    <SelectionList TItem="GXDeviceGroup" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
        <ButtonContent>
            <div>
                <button style="float: left;" class="btn btn-outline-secondary border-left-0 border"
                        type="button" onclick="@(() => AddAll())">
                    &laquo;
                </button>
            </div>
        </ButtonContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    [CascadingParameter]
    private UserGroup? UserGroupParent { get; set; }

    [CascadingParameter]
    private Device? DeviceParent { get; set; }

    [CascadingParameter]
    private AgentGroup? AgentGroupParent { get; set; }

    [CascadingParameter]
    private Gateway? GatewayParent { get; set; }

    [CascadingParameter]
    private Schedule? ScheduleParent { get; set; }

    SelectionList<GXDeviceGroup>? _selected;
    SelectionList<GXDeviceGroup>? _available;
    SelectionContainer<GXDeviceGroup>? _selectionContainer;

    /// <summary>
    /// Device group filter.
    /// </summary>
    private GXDeviceGroup filter = new GXDeviceGroup(null);
    /// <summary>
    /// Selected device group filter.
    /// </summary>
    private GXDeviceGroup selectedFilter = new GXDeviceGroup();

    /// <summary>
    /// Available device groups.
    /// </summary>
    [Parameter]
    public List<GXDeviceGroup>? DeviceGroups { get; set; }

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected != null)
            {
                selectedFilter.Name = name;
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Add all objects to selected items.
    /// </summary>
    /// <returns></returns>
    private async Task AddAll()
    {
        int max = 0;
        //max 1000 items are added at the one time.
        if (_available != null && _available.TotalCount > 1000)
        {
            max = 1000;
        }
        var ret = await GetItems(new GXItemsProviderRequest(0, max));
        await OnAdded(ret.Items);
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
        if (_available != null)
        {
            await _available.RefreshDataAsync();
        }
    }

    /// <summary>
    /// Remove all objects from selected items.
    /// </summary>
    /// <returns></returns>
    private async Task RemoveAll()
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.Clear();
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
        if (_available != null)
        {
            await _available.RefreshDataAsync();
        }
    }

    /// <summary>
    /// New device is added for selection list.
    /// </summary>
    public async Task OnAdded(IEnumerable<GXDeviceGroup> items)
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.InsertRange(0, items);
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
    }

    /// <summary>
    /// Device has removed from the lists.
    /// </summary>
    private async Task Removed(IEnumerable<GXDeviceGroup> items)
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.RemoveAll(w => items.Contains(w));
        if (_selected != null)
        {
            await _selected.RefreshDataAsync();
        }
    }

    private List<GXDeviceGroup> GetDeviceGroups()
    {
        if (DeviceGroups != null)
        {
            return DeviceGroups;
        }
        if (UserGroupParent?.Active?.DeviceGroups != null)
        {
            return UserGroupParent.Active.DeviceGroups;
        }
        if (DeviceParent?.Active?.DeviceGroups != null)
        {
            return DeviceParent.Active.DeviceGroups;
        }
        if (AgentGroupParent?.Active?.DeviceGroups != null)
        {
            return AgentGroupParent.Active.DeviceGroups;
        }
        if (ScheduleParent?.Active?.DeviceGroups != null)
        {
            return ScheduleParent.Active.DeviceGroups;
        }
        return GatewayParent?.Active is { } parent ? parent.DeviceGroups ??= [] : [];
    }

    public Task Update()
    {
        if (_selected == null)
        {
            return Task.CompletedTask;
        }
        return _selected.RefreshDataAsync();
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXDeviceGroup>> GetSelectedItems(GXItemsProviderRequest request)
    {
        var groups = GetDeviceGroups();
        int total = groups.Count;
        if (!string.IsNullOrEmpty(selectedFilter.Name))
        {
            groups = groups.Where(w => (w.Name ?? string.Empty).ToLower().Contains((selectedFilter.Name ?? string.Empty).ToLower())).ToList();
        }
        return new(new ItemsProviderResult<GXDeviceGroup>(
        groups.Skip(request.StartIndex).Take(request.Count), total));
    }

    private async ValueTask<ItemsProviderResult<GXDeviceGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
        try
        {
            ListDeviceGroups req = new ListDeviceGroups()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = GetDeviceGroups().Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListDeviceGroupsResponse>("api/DeviceGroup/List", req, request.CancellationToken);
            if (ret?.DeviceGroups != null && _selected != null)
            {
                return new ItemsProviderResult<GXDeviceGroup>(ret.DeviceGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (_selectionContainer == null || _selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.OnInitializedAsync");
            if (_selected != null)
            {
                await _selected.RefreshDataAsync();
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.OnInitializedAsync");
        }
    }
}

