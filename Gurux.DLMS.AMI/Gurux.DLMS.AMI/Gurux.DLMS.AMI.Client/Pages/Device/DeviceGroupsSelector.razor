@using Gurux.DLMS.AMI.Client.Pages.Agent;
@using Gurux.DLMS.AMI.Client.Pages.Gateway;
@using Gurux.DLMS.AMI.Client.Pages.Schedule;
@using Gurux.DLMS.AMI.Client.Pages.User;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="DeviceGroupsSelector" />

<GXRelationshipSelector TItem="GXDeviceGroup" @ref="_selectionContainer"
                        SelectedItems="@(() => GetDeviceGroups())"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems"
                        Disabled="@Disabled" OwnerMutates="true" OnAdded="OnAdded" OnRemoved="Removed">
    <ItemContent>
            @context.Name

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
    <ButtonContent>
        <GXMenuEntry Id="AddAll" Text="@Properties.Resources.AddAll" ReadOnly="@Disabled" OnClick="AddAll" />
        <GXMenuEntry Id="RemoveAll" Text="@Properties.Resources.RemoveAll" ReadOnly="@Disabled" OnClick="RemoveAll" />
    </ButtonContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether relationship changes are disabled by the parent editor.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Receives the containing user group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private UserGroup? UserGroupParent { get; set; }

    /// <summary>Receives the containing device editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Device? DeviceParent { get; set; }

    /// <summary>Receives the containing agent group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private AgentGroup? AgentGroupParent { get; set; }

    /// <summary>Receives the containing gateway editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Gateway? GatewayParent { get; set; }

    /// <summary>Receives the containing schedule editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Schedule? ScheduleParent { get; set; }

    /// <summary>Coordinates paged checkbox selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXDeviceGroup>? _selectionContainer;

    /// <summary>Stores endpoint criteria shared by selected and available device group queries.</summary>
    private GXDeviceGroup _filter = new GXDeviceGroup(null);

    /// <summary>
    /// Available device groups.
    /// </summary>
    [Parameter]
    public List<GXDeviceGroup>? DeviceGroups { get; set; }

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null)
            {
                _filter.Name = name;
                _notificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.SearchByName");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = _filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        _filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(_filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.SearchByUser");
        }
    }

    /// <summary>Adds up to 1000 matching available records through the existing relationship mutation handler.</summary>
    /// <returns></returns>
    private async Task AddAll()
    {
        var ret = await GetItems(new GXRelationshipQuery<GXDeviceGroup>(new GXItemsProviderRequest(0, 1000), excluded: (GetDeviceGroups()).ToArray()));
        await OnAdded(ret.Items);
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Clears the current relationship and refreshes the paged selection view.</summary>
    /// <returns></returns>
    private async Task RemoveAll()
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.Clear();
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Adds each new identity once to the authoritative relationship and refreshes its selection view.</summary>
    /// <param name="items">The records explicitly added or removed by the selection control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    public async Task OnAdded(IEnumerable<GXDeviceGroup> items)
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.InsertRange(0, items.Where(item => !groups.Any(existing => existing.Id == item.Id)).DistinctBy(item => item.Id));
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Removes matching identities from the authoritative relationship, including reloaded DTO instances.</summary>
    /// <param name="items">The records explicitly added or removed by the selection control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    private async Task Removed(IEnumerable<GXDeviceGroup> items)
    {
        List<GXDeviceGroup> groups = GetDeviceGroups();
        groups.RemoveAll(value => items.Any(item => item.Id == value.Id));
        if (_selectionContainer != null)
        {
            await _selectionContainer.RefreshDataAsync();
        }
    }

    /// <summary>Returns the relationship collection owned by the explicit parameter or the containing editor.</summary>
    /// <returns>The parent editor's authoritative relationship collection.</returns>
    private List<GXDeviceGroup> GetDeviceGroups()
    {
        if (DeviceGroups != null)
        {
            return DeviceGroups;
        }
        if (UserGroupParent?.Active?.DeviceGroups != null)
        {
            return UserGroupParent.Active.DeviceGroups;
        }
        if (DeviceParent?.Active?.DeviceGroups != null)
        {
            return DeviceParent.Active.DeviceGroups;
        }
        if (AgentGroupParent?.Active?.DeviceGroups != null)
        {
            return AgentGroupParent.Active.DeviceGroups;
        }
        if (ScheduleParent?.Active?.DeviceGroups != null)
        {
            return ScheduleParent.Active.DeviceGroups;
        }
        return GatewayParent?.Active is { } parent ? parent.DeviceGroups ??= [] : [];
    }

    /// <summary>Closes the active module settings selection and refreshes the component display.</summary>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    public Task Update()
    {
        if (_selectionContainer == null)
        {
            return Task.CompletedTask;
        }
        return _selectionContainer.RefreshDataAsync();
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXDeviceGroup>> GetItems(GXRelationshipQuery<GXDeviceGroup> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
        try
        {
            ListDeviceGroups req = new ListDeviceGroups()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = _filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Included = request.Included?.Select(item => item.Id).ToArray(),
                    OrderBy = nameof(GXDeviceGroup.Id),
                    Exclude = request.Excluded.Select(item => item.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListDeviceGroupsResponse>("api/DeviceGroup/List", req, request.CancellationToken);
            if (ret?.DeviceGroups != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXDeviceGroup>(ret.DeviceGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXDeviceGroup>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (_selectionContainer == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
            _notificationService?.RemoveByKey("Pages/Device/DeviceGroupsSelector.OnInitializedAsync");
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/DeviceGroupsSelector.OnInitializedAsync");
        }
    }
}

