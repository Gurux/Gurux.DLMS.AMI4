@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Module
@page "/Device/{Id:guid?}"
@page "/Device/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Objects
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Manufacturer;
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs
@using System.Diagnostics;
@using System.Text.Json
@using System.Text.Json.Serialization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@using Gurux.DLMS.AMI.Shared.DTOs.Menu
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Device" />

@if (!NotInitialized)
{
    <h1>
        @Title
    </h1>
    <CascadingValue Value="this">
        <GXTabControl PersistSelectionInUrl="true" Active="@Action" NavigateOnSelection="false">
            <TabTextTemplate>
                <GXTabIcon Id="@context.Icon" Color="@context.IconColor" />
                @context.Text
            </TabTextTemplate>
            <ChildContent>
                @if (_ready)
                {
                    <TabHeader Name="@GXMenus.DeviceDetailsTab" Parameters="@TabParameters" ParametersForLink="@GetTabParameters" LinkFilter="@ShowDeviceTab" />
                }
                <ModuleViews Area="AmiViewArea.Device" Target="@Active" Parameters="@TabParameters" />
            </ChildContent>
        </GXTabControl>
    </CascadingValue>
    @if (_ready)
    {
        <div hidden="@(!GeneralVisible)">
            <EditForm EditContext="@FormContext">
                <ValidationSummary />
                <ParametersView @ref="_parametersView" Parameters="@_properties" Target="@Active" />
            </EditForm>
        </div>
    }
}
<br />
<ModuleViews Area="AmiViewArea.Device" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
@code {
    private GXEditorMenu? _editorMenu;
    private GXProfilePictureEdit? _profilePictureEdit;
    private ParametersView? _parametersView;
    private List<IGXProperty> _properties = new();
    public bool CreateImmediately { get; set; }
    public bool DeleteTarget { get; set; }
    public Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings? Settings { get; set; }
    public EditContext FormContext => GXEditContexts.For(Active);
    private bool DisableSecurity() => Settings == null ||
        (Settings.Authentication != (byte)Gurux.DLMS.Enums.Authentication.HighGMAC && Settings.Security == (byte)Gurux.DLMS.Enums.Security.None) || _action != CrudAction.Create;
    private async Task InitializeDefaults()
    {
        try
        {
            //Get default user settings.
            GetUserProperties us = await Http.GetAsJsonAsync<GetUserProperties>("api/UserProperties?Name=Ami.Device");
            if (us.Item != null && !string.IsNullOrEmpty(us.Item.Value))
            {
                Guid Id = JsonSerializer.Deserialize<Guid>(us.Item.Value);
                //Get device data.
                GetDeviceResponse ret = await Http.GetAsJsonAsync<GetDeviceResponse>(string.Format("api/Device?id={0}", Id));
                if (ret.Item != null)
                {
                    Active = ret.Item;
                    Active.Id = Guid.Empty;
                    Active.Name = null;
                      Active.ProfilePicture = null;
                }
            }

            GXObject? ldn = Active?.Objects?.Where(w => w.Template?.LogicalName == "0.0.42.0.0.255").SingleOrDefault() as GXObject;
            if (ldn == null && Active != null)
            {
                if (Active.Objects == null)
                {
                    Active.Objects = new List<GXObject>();
                }
                GXAttribute att = new()
                {
                    Template = new GXAttributeTemplate()
                    {
                        Index = 2
                    }
                };
                Active.Objects.Add(new GXObject()
                {
                    Template = new GXObjectTemplate()
                    {
                        LogicalName = "0.0.42.0.0.255"
                    },
                    Attributes = new List<GXAttribute>(new GXAttribute[] { att })
                }
                );
            }
        }
        catch (Exception)
        {
            //It's OK if this fails.
        }

    }
    private void InitializeEditorMenu()
    {
        _profilePictureEdit = new GXProfilePictureEdit(Active.ProfilePicture?.Id, Active.Id == Guid.Empty ? null : Active.Creator?.Id);
        if (!string.IsNullOrEmpty(Active.Settings))
            {
            Settings = JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Settings);
        }
        else if (!string.IsNullOrEmpty(Active.Template?.Settings))
            {
            Settings = JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Template.Settings);
        }
        if (Active.Properties != null) {
            _properties.AddRange(Active.Properties);
        }
        _editorMenu = new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active, _action, OnSave, OnCancel);
    }
    private async Task OnCancel()
    {
        try
        {
            if (_parametersView != null) {
                await _parametersView.CancelAsync();
            }
        }
        catch (Exception ex) { NotificationService?.ReportError(ex); }
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
    private bool _disposed;
    internal bool GeneralVisible;
    internal void SetGeneralVisible(bool visible)
    {
        GeneralVisible = visible;
        if (!_disposed) {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    public void Dispose()
    {
        _disposed = true;
        _editorMenu?.Dispose();
    }
    private bool ValidateDevice()
    {
        bool valid = true;
        void Invalid(string message, string field = nameof(GXDevice.Settings))
        {
            valid = false;
            _editorMenu?.AddValidationError(field, message);
        }
        if (Active != null)
        {
            if (string.IsNullOrEmpty(Active.Name))
            {
                Invalid(Properties.Resources.InvalidName, nameof(GXDevice.Name));
            }
            //Check password.
            if (Settings != null)
            {
                var settings = Settings;
                if (settings != null && settings.Authentication != (byte)Gurux.DLMS.Enums.Authentication.None &&
                settings.Authentication != (byte)Gurux.DLMS.Enums.Authentication.HighGMAC &&
                settings.Authentication != (byte)Gurux.DLMS.Enums.Authentication.HighECDSA)
                {
                    if (_action == CrudAction.Create && Settings?.Password?.Any() != true)
                    {
                        Invalid(Properties.Resources.InvalidPassword);
                    }
                }
            }

            //Check security settings
            if (Settings != null)
            {
                if (Settings.PreEstablished && Settings.DeviceSystemTitle?.Any() != true)
                {
                    Invalid(Client.Properties.Resources.InvalidSystemTitle);
                }
                if (Settings.Security != (byte)Gurux.DLMS.Enums.Security.None)
                {
                    if (Settings.ClientSystemTitle?.Any() == true)
                    {
                        if (Settings.ClientSystemTitle.Length != 8)
                        {
                            Invalid(Client.Properties.Resources.InvalidSystemTitle);
                        }
                    }
                    else
                    {
                        Invalid(Client.Properties.Resources.InvalidSystemTitle);
                    }
                    if (Settings.DeviceSystemTitle?.Any() == true)
                    {
                        if (Settings.DeviceSystemTitle.Length != 8)
                        {
                            Invalid(Client.Properties.Resources.InvalidSystemTitle);
                        }
                    }
                    if (Settings.BlockCipherKey?.Any() == true)
                    {
                        if ((Settings.SecuritySuite != (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.BlockCipherKey.Length != 16) ||
                        (Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.BlockCipherKey.Length != 32))
                        {
                            Invalid(Client.Properties.Resources.InvalidBlockCipherKey);
                        }
                    }
                    else
                    {
                        Invalid(Client.Properties.Resources.InvalidBlockCipherKey);
                    }
                    if (Settings.AuthenticationKey?.Any() == true)
                    {
                        if ((Settings.SecuritySuite != (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.AuthenticationKey.Length != 16) ||
                        (Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.AuthenticationKey.Length != 32))
                        {
                            Invalid(Client.Properties.Resources.InvalidAuthenticationKey);
                        }
                    }
                    else
                    {
                        Invalid(Client.Properties.Resources.InvalidAuthenticationKey);
                    }
                    if (Settings.BroadcastKey?.Any() == true)
                    {
                        if ((Settings.SecuritySuite != (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.BroadcastKey.Length != 16) ||
                        (Settings.SecuritySuite == (int)Gurux.DLMS.Objects.Enums.SecuritySuite.Suite2 && Settings.BroadcastKey.Length != 32))
                        {
                            Invalid(Client.Properties.Resources.InvalidBlockCipherKey);
                        }
                    }
                    else
                    {
                        Invalid(Client.Properties.Resources.InvalidBroadcastKey);
                    }
                }
            }
            if (!Active.Dynamic.GetValueOrDefault() && Active.MediaType == "Gurux.Net.GXNet")
            {
                using var media = new Gurux.Net.GXNet();
                media.Settings = Active.MediaSettings;
                if (string.IsNullOrEmpty(media.HostName)) {
                    Invalid(Properties.Resources.InvalidHostName, nameof(GXDevice.MediaSettings));
                }
                if (media.Port == 0) {
                    Invalid(Properties.Resources.InvalidPort, nameof(GXDevice.MediaSettings));
                }
            }
        }
        return valid;
    }
    private async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Client.Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !ValidateDevice()) {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingDevice);
            NotificationService?.RemoveByKey("Pages/Device/DeviceGeneral.OnSave");
            //Update device parameters.
            if (_parametersView != null)
            {
                await _parametersView.UpdateSettingsAsync(Active.Properties ??= []);
            }
            var options = new JsonSerializerOptions
            {
                DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingDefault
            };
            if (Settings != null)
            {
                if (!DisableSecurity())
                {
                }
                else
                {
                    Settings.ClientSystemTitle = Settings.DeviceSystemTitle =
                    Settings.BlockCipherKey = Settings.AuthenticationKey = Settings.BroadcastKey = null;
                }
                Active.Settings = JsonSerializer.Serialize(Settings, options);
            }
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveDeviceResponse>("api/Device/Delete", new RemoveDevice()
                {
                    Ids = new Guid[] { Active.Id },
                    Delete = DeleteTarget
                });
            }
            else if (_action == CrudAction.Create)
            {
                await SaveDeviceWithPictureAsync("api/Device/Add", !CreateImmediately);
            }
            else if (_action == CrudAction.Update)
            {
                await SaveDeviceWithPictureAsync("api/Device/Update", false);
            }
            FormContext.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGeneral.OnSave");
        }
    }

    private Task SaveDeviceWithPictureAsync(string address, bool lateBinding)
        => (_profilePictureEdit ??= new GXProfilePictureEdit(Active.ProfilePicture?.Id, Active.Id == Guid.Empty ? null : Active.Creator?.Id)).SaveAsync(Http,
            Active.ProfilePicture, image => Active.ProfilePicture = image,
            async () => { await Http.PostAsJson<UpdateDeviceResponse>(address, new UpdateDevice { Devices = [Active], LateBinding = lateBinding }); },
            error => NotificationService?.ReportError(error, "Device.ProfilePicture.Cleanup"));

    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Device"] = Active,
        ["Templates"] = Templates!,
        ["Manufacturers"] = Manufacturers!,
        ["CustomTemplates"] = CustomTemplates!
    };

    private IGXProgress? Progress;
    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
    {
        var type = Type.GetType(link.TargetType ?? string.Empty);
        if (type == typeof(ProfilePictureEditor))
        {
            return new Dictionary<string, object>
            {
                [nameof(ProfilePictureEditor.Value)] = Active.ProfilePicture!,
                [nameof(ProfilePictureEditor.ValueChanged)] = EventCallback.Factory.Create<GXAppearance?>(this, ProfilePictureChanged),
                [nameof(ProfilePictureEditor.Disabled)] = _action is not (CrudAction.Create or CrudAction.Update),
                [nameof(ProfilePictureEditor.Id)] = "device-profile-picture-editor"
            };
        }
        return type == typeof(DeviceGeneral)
            ? new Dictionary<string, object> { ["Action"] = _action } : null;
    }

    private bool ShowDeviceTab(GXMenuLink link)
        => _action != CrudAction.Create || Type.GetType(link.TargetType ?? string.Empty) != typeof(ProfilePictureEditor);

    private void ProfilePictureChanged(GXAppearance? image)
    {
        if (_action is not (CrudAction.Create or CrudAction.Update)) {
            return;
        }
        Active.ProfilePicture = image;
        FormContext.NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXDevice.ProfilePicture)));
    }

    private IGXNotificationService? NotificationService;

    /// <summary>
    /// If manufacturers or device templates are not installed.
    /// </summary>
    bool NotInitialized;
    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXDevice Active = new GXDevice(null)
    {
        TraceLevel = TraceLevel.Off
    };

    /// <summary>
    /// List of manufacturer templates.
    /// </summary>
    public List<GXDeviceTemplate>? ManufacturerTemplates;
    /// <summary>
    /// List of custom templates.
    /// </summary>
    public List<GXDeviceTemplate>? CustomTemplates;
    /// <summary>
    /// Installed manufacturers.
    /// </summary>
    public GXManufacturer[]? Manufacturers;
    public GXDeviceTemplate[]? Templates;

    /// <summary>
    /// Separate custom templates the manufacturer templates.
    /// </summary>
    private void UpdateTemplates(IEnumerable<GXDeviceTemplate> templates)
    {
        Templates = templates.ToArray();
        //Get Manufacturer templates.
        List<Guid> manufacturerTemplates = new List<Guid>();
        if (Manufacturers != null)
        {
            foreach (var manufacturer in Manufacturers)
            {
                if (manufacturer.Models != null)
                {
                    foreach (var model in manufacturer.Models)
                    {
                        if (model.Versions != null)
                        {
                            foreach (var version in model.Versions)
                            {
                                if (version.Settings != null)
                                {
                                    foreach (var settings in version.Settings)
                                    {
                                        if (settings.Template != null)
                                        {
                                            //If manufacturer template.
                                            manufacturerTemplates.Add(settings.Template.Id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ManufacturerTemplates = new List<GXDeviceTemplate>();
            CustomTemplates = new List<GXDeviceTemplate>();
            foreach (var it in templates)
            {
                if (manufacturerTemplates.Contains(it.Id))
                {
                    ManufacturerTemplates.Add(it);
                }
                else
                {
                    CustomTemplates.Add(it);
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Device;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDevice);
            NotificationService?.RemoveByKey("Pages/Device/Device.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get device data.
                var tmp = (await Http.GetAsJsonAsync<GetDeviceResponse>(string.Format("api/Device?id={0}", Id)));
                // Serial-number editing requires object.view; removal only needs the device.
                if (_action != CrudAction.Delete && tmp?.Item != null && tmp.Item.Objects == null)
                {
                    //Get serial number object.
                    ListObjects req2 = new ListObjects()
                    {
                        Select = new string[] { "Attribute" },
                        Filter = new GXObject()
                        {
                            Device = new GXDevice() { Id = tmp.Item.Id },
                            Template = new GXObjectTemplate()
                            {
                                LogicalName = "0.0.42.0.0.255"
                            },
                        }
                    };
                    var tmp3 = (await Http.PostAsJson<ListObjectsResponse>("api/Object/List", req2));
                    if (tmp3.Objects != null && tmp3.Objects.Count() == 1)
                    {
                        tmp.Item.Objects = new List<GXObject>(tmp3.Objects);
                    }
                }

                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            if (_action == CrudAction.Create) {
                await InitializeDefaults();
            }
            //Get installed manufacturer settings.
            var filter2 = new Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXManufacturer(null);
            filter2.Template = true;
            GXDeviceModel model = new GXDeviceModel(null);
            GXDeviceVersion version = new GXDeviceVersion(null);
            GXDeviceSettings settings = new GXDeviceSettings();
            settings.InstallationTime = DateTimeOffset.MinValue;
            if (Action != "Add")
            {
                //Get only selected manufacturer.
                settings.Template = Active.Template;
            }
            (filter2.Models ??= []).Add(model);
            (model.Versions ??= []).Add(version);
            (version.Settings ??= []).Add(settings);
            ListManufacturersResponse ret2 = await Http.PostAsJson<ListManufacturersResponse>("api/Manufacturer/List",
            new ListManufacturers()
            {
                Filter = filter2,
                //Get model and version info.
                Select = new string[] { "Version" }
            });
            List<GXManufacturer> tmp2 = new List<GXManufacturer>(ret2.Manufacturers ?? []);
            //Add custom manufacturer.
            tmp2.Add(new GXManufacturer(Properties.Resources.Custom));
            Manufacturers = tmp2.ToArray();

            //Get device templates.
            ListDeviceTemplates req = new ListDeviceTemplates()
            {
                Filter = new GXDeviceTemplate()
            };
            if (Active?.Template != null && Action != "Add")
            {
                //Get only selected template.
                var ret = await Http.GetAsJsonAsync<GetDeviceTemplateResponse>("api/DeviceTemplate?Id=" + Active.Template.Id);
                UpdateTemplates(ret.Item == null ? [] : [ret.Item]);
            }
            else
            {
                //Get all templates when new device is added.
                var ret = await Http.PostAsJson<ListDeviceTemplatesResponse>("api/DeviceTemplate/List", req);
                UpdateTemplates(ret.Templates);
            }
            //Check are manufacturers empty.
            bool empty = true;
            foreach (var manufacturer in Manufacturers)
            {
                if (manufacturer.Models != null)
                {
                    foreach (var model2 in manufacturer.Models)
                    {
                        if (model2.Versions != null)
                        {
                            foreach (var version2 in model2.Versions)
                            {
                                empty = version2.Settings == null || !version2.Settings.Any();
                                if (!empty)
                                {
                                    break;
                                }
                            }
                            if (!empty)
                            {
                                break;
                            }
                        }
                    }
                    if (!empty)
                    {
                        break;
                    }
                }
            }
            if (_disposed) {
                return;
            }
            if (empty && (Templates == null || !Templates.Any()))
            {
                NotInitialized = true;
                //Ask user to install manufacturers or device templates if they are not installed yet.
                NotificationService?.Add(new GXNotificationItem(
                    Gurux.UI.Components.Enums.NotificationLevel.Information,
                    Properties.Resources.DeviceTemplatesNotInstalled, string.Empty, Closable: true));
            }
            if (!NotInitialized) {
                InitializeEditorMenu();
            }
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/Device.OnInitializedAsync");
        }
    }
}
