@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/devicegroups"
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="DeviceGroups" />

@if (Header)
{
    <AuthorizeView Policy="@GXDeviceGroupPolicies.View">
        <GXMenuControl RightCorner="true">
            <ChildContent>
                <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
                <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" />
            </ChildContent>
        </GXMenuControl>
    </AuthorizeView>
}

<GXViewTable ViewName="Device.DeviceGroups" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXDeviceGroupPolicies.View })"
             TItem="GXDeviceGroup" @ref="table"
             @bind-Active="Active"
             Context="group"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <input class="form-control" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="DeviceGroups-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        @if (Menu)
        {
            <AuthorizeView Policy="@GXDeviceGroupPolicies.View">
                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
            </AuthorizeView>
        }
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Name" Name="Name" Target="@group">@Properties.Resources.Name</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@group" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated" Name="Updated" Target="@group">@Properties.Resources.Updated</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/DeviceGroup/Edit/" + group.Id)">@group.Name</GXTd>
        <GXTd Id="CreationTime">@group.CreationTime</GXTd>
        <GXTd Id="Updated">@group.Updated</GXTd>
    </ItemContent>
</GXViewTable>

<br />
@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 2, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected device group ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    public GXDeviceGroup? Active { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.DeviceGroups;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device-group";
        }
    }

    /// <summary>
    /// Amount of the device groups shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is menu shown.
    /// </summary>
    [Parameter]
    public bool Menu { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// List of available device groups.
    /// </summary>
    [Parameter]
    public IEnumerable<GXDeviceGroup>? AvailableDeviceGroups { get; set; }

    /// <summary>
    /// Device group filter.
    /// </summary>
    private GXDeviceGroup filter = new GXDeviceGroup(null);

    /// <summary>
    /// Reference to the table.
    /// </summary>
    private GXTable<GXDeviceGroup>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Device/DeviceGroups.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroups.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroups.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), async (items) =>
             {
                 foreach (var it in items)
                 {
                     if (it.Type == GXDeviceGroupPolicies.Add ||
                         it.Type == GXDeviceGroupPolicies.Edit ||
                         it.Type == GXDeviceGroupPolicies.Delete)
                     {
                         await GXNotificationRefresh.RefreshAsync(table, items, Updated);
                         break;
                     }
                 }
             });
            if (Header)
            {
                MenuService.Clear();
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    //Don't use Properties.Resources.Read. This is updated later.
                    Text = "Read",
                    Icon = "Read",
                    OnClick = EventCallback.Factory.Create(this, OnReadSelected)
                });
            }
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXDeviceGroup() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroups.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXDeviceGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingDeviceGroups);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListDeviceGroups req = new ListDeviceGroups()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (AvailableDeviceGroups != null && AvailableDeviceGroups.Any())
            {
                req.Included = AvailableDeviceGroups.Select(s => s.Id).ToArray();
            }
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListDeviceGroupsResponse>("api/DeviceGroup/List", req, request.CancellationToken);
            //Get only selected amount of the block groups.
            if (Count != 0)
            {
                ret.Count = Count;
            }
            return new ItemsProviderResult<GXDeviceGroup>((ret.DeviceGroups ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new device group.
    /// </summary>

    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/DeviceGroup/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit device group.
    /// </summary>

    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroups.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/DeviceGroup/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroups.OnEdit");
        }
    }

    /// <summary>
    /// Remove selected device groups.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected agent groups.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveDeviceGroup req = new RemoveDeviceGroup()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveDeviceGroupResponse>("api/DeviceGroup/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Read all selected objects.
    /// </summary>
    public async Task OnReadSelected()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroups.OnReadSelected");
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingDeviceGroup);
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            List<GXTask> tasks = new List<GXTask>();
            foreach (var it in table.SingleOrDefault())
            {
                GXTask task = new GXTask();
                task.TaskType = TaskType.Read;
                task.DeviceGroup = new GXDeviceGroup() { Id = it.Id };
                tasks.Add(task);
            }
            AddTask req = new AddTask();
            req.Tasks = tasks.ToArray();
            await Http.PostAsJson<AddTaskResponse>("api/Task/Add", req);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroups.OnReadSelected");
        }
    }

    public void Dispose()
    {
        MenuService.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

