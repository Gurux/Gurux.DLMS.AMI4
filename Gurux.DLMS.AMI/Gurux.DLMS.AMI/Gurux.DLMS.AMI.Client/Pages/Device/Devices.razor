@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/Devices"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Text.Json;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="Devices" />

@if (Title)
{
    <PageTitle>@Properties.Resources.DevicesTitle</PageTitle>
}
@if (Header)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="add" OnClick="@OnAdd" Policy="@GXDevicePolicies.Add" />
            <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXDevicePolicies.Delete" />
        </ChildContent>
    </GXMenuControl>
}

<GXViewTable ViewName="Device.Devices" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXDevicePolicies.View })"
             TItem="GXDevice" @ref="table"
             Context="device"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <GXInputText Id="Devices-Name"
                         @bind-Value="@filter.Name"
                         Placeholder="@Properties.Resources.FilterByName">
            </GXInputText>
        </GXFh>
        <GXFh Id="Template.Type">
            <input class="form-control" placeholder="@Properties.Resources.Type"
                   type="text"
                   @onchange="@((ChangeEventArgs __e) => (filter.Template ??= new()).Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Detected" Visibility="Visibility.Small">
            <input class="form-control" placeholder="@Properties.Resources.FilterByDetectionTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Detected = StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="Devices-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated" Visibility="Visibility.Large">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Updated = StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        @if (Menu)
        {
            <AuthorizeView Policy="@GXDevicePolicies.View">
                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear"></GXContextMenuItem>
            </AuthorizeView>
        }
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Name" Name="Name" Target="@device">
            @Properties.Resources.Name
        </GXTh>
        <GXTh Id="Template.Type" Name="Template.Type" Target="@device">
            @Properties.Resources.Type
        </GXTh>
        <GXTh Id="Detected" Name="Detected" Target="@device" Visibility="Visibility.Small" SortMode="SortMode.Descending">
            @Properties.Resources.Detected
        </GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Visibility="Visibility.Medium" Target="@device"
            SortMode="SortMode.Descending">
            @Properties.Resources.CreationTime
        </GXTh>
        <GXTh Id="Updated" Name="Updated" Visibility="Visibility.Large" Target="@device">
            @Properties.Resources.Updated
        </GXTh>
        <GXTh Id="LastRead" Name="LastRead" Visibility="Visibility.ExtraLarge" Target="@device">
            @Properties.Resources.LastRead
        </GXTh>
        <GXTh Id="LastWrite" Name="LastWrite" Visibility="Visibility.ExtraLarge" Target="@device">
            @Properties.Resources.LastWrite
        </GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath(GXDeviceObjectRoutes.Objects(device.Id))"><span class=@(ClientHelpers.GetActiveDot(device.Enabled))></span>@device.Name</GXTd>
        <GXTd Id="Template.Type">@device.Template?.Name</GXTd>
        <GXTd Id="Detected" Visibility="Visibility.Small">@device.Detected</GXTd>
        <GXTd Id="CreationTime" Visibility="Visibility.Medium">@device.CreationTime</GXTd>
        <GXTd Id="Updated" Visibility="Visibility.Large">@device.Updated</GXTd>
        <GXTd Id="LastRead" Visibility="Visibility.ExtraLarge">@device.LastRead</GXTd>
        <GXTd Id="LastWrite" Visibility="Visibility.ExtraLarge">@device.LastWrite</GXTd>
    </ItemContent>
</GXViewTable>
<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Template.Type") { Position = 1, Description = "Type", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Detected") { Position = 2, Description = "Detected", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Small },
        new("CreationTime") { Position = 3, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Medium },
        new("Updated") { Position = 4, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Large },
        new("LastRead") { Position = 5, Description = "LastRead", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.ExtraLarge },
        new("LastWrite") { Position = 6, Description = "LastWrite", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.ExtraLarge },
    ];

    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    /// <summary>
    /// Selected device ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Devices;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device";
        }
    }

    /// <summary>
    /// Amount of the devices shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is menu shown.
    /// </summary>
    [Parameter]
    public bool Menu { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// List of available devices.
    /// </summary>
    [Parameter]
    public IEnumerable<GXDevice>? AvailableDevice { get; set; }

    //Verify that history is clear.

    /// <summary>
    /// Device filter.
    /// </summary>
    private GXDevice filter = new GXDevice() { Template = new GXDeviceTemplate() };
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXDevice>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Device/Devices.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/Devices.Updated");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/Devices.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
 {
     foreach (var it in items)
     {
         if (it.Type == GXDevicePolicies.Add ||
             it.Type == GXDevicePolicies.Edit ||
             it.Type == GXDevicePolicies.Delete)
         {
             _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
             break;
         }
     }
 });

            /*Miko
                       Notifier?.On<IEnumerable<GXDevice>>(this, nameof(IGXHubEvents.DeviceStatusChange), (devices) =>
                       {
                           bool updated = false;
                           foreach (var it in devices)
                           {
                               var dev = table?.Items?.Where(w => w.Id == it.Id).SingleOrDefault();
                               if (dev != null)
                               {
                                   dev.Detected = it.Detected;
                                   dev.Status = it.Status;
                                   updated = true;
                               }
                           }
                           if (updated)
                           {
                               InvokeAsync(StateHasChanged);
                           }
                       });
                       */
            if (Header)
            {
                MenuService.Clear();
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    Text = "Read",
                    Icon = "Read",
                    OnClick = EventCallback.Factory.Create(this, OnReadSelected)
                });
            }
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXDevice() { Id = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/Devices.OnInitializedAsync");
        }
    }

    private async ValueTask<ItemsProviderResult<GXDevice>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDevices);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListDevices req = new ListDevices()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
            };
            if (AvailableDevice != null && AvailableDevice.Any())
            {
                req.Included = AvailableDevice.Select(s => s.Id).ToArray();
            }
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListDevicesResponse>("api/Device/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXDevice>((ret.Devices ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new device.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/Device/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit device.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/Devices.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Device/Edit/" + table?.Active.Id);

        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/Devices.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected device.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected devices.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        if (table != null && args.Confirm)
        {
            try
            {
                using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingDevice);
                RemoveDevice req = new RemoveDevice()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveDeviceResponse>("api/Device/Delete", req);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex);
            }
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClear()
    {
        try
        {
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDelete, Properties.Resources.AreYouSureYouWantToClearDeviceHistoryThisActionCannotBeUndone,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Clear,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnClearConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm && table != null)
            {
                List<GXDevice> devices = new List<GXDevice>();
                foreach (var it in table.SingleOrDefault())
                {
                    devices.Add(new GXDevice() { Id = it.Id });
                }
                await Http.PostAsJson<ClearValueResponse>("api/Value/Clear", new ClearValue()
                {
                    Devices = devices.ToArray()
                });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Read all selected objects.
    /// </summary>
    public async Task OnReadSelected()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Device/Devices.OnReadSelected");
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingDevice);
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            List<GXTask> tasks = new List<GXTask>();
            foreach (var it in table.SingleOrDefault())
            {
                GXTask task = new GXTask();
                task.TaskType = TaskType.Read;
                task.TargetDevice = it.Id;
                tasks.Add(task);
            }
            AddTask req = new AddTask();
            req.Tasks = tasks.ToArray();
            var response = await Http.PostAsJson<AddTaskResponse>("api/Task/Add", req);
            Services.GetService<GXReadTaskNotifications>()?.Track(response.Ids);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/Devices.OnReadSelected");
        }
    }

    public void Dispose()
    {
        MenuService.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

