@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/Devices"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Text.Json;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="Devices" />

@if (Title)
{
    <PageTitle>@Properties.Resources.DevicesTitle</PageTitle>
}
@if (Header)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="add" OnClick="@OnAdd" Policy="@GXDevicePolicies.Add" />
            <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXDevicePolicies.Delete" />
        </ChildContent>
    </GXMenuControl>
}

<GXViewTable ViewName="Device.Devices" ViewColumns="_viewColumnDefaults" ViewPolicies="@(new List<string> { GXDevicePolicies.View })"
             TItem="GXDevice" @ref="table"
             Context="device"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Name">
            <GXInputText Id="Devices-Name"
                         @bind-Value="@_filter.Name"
                         Placeholder="@Properties.Resources.FilterByName">
            </GXInputText>
        </GXFh>
        <GXFh Id="Template.Type">
            <input class="form-control" placeholder="@Properties.Resources.Type"
                   type="text"
                   @onchange="@((ChangeEventArgs __e) => (_filter.Template ??= new()).Name = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Detected" Visibility="Visibility.Small">
            <input class="form-control" placeholder="@Properties.Resources.FilterByDetectionTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => _filter.Detected = StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="Devices-CreationTime"
                                @bind-Value="@_filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated" Visibility="Visibility.Large">
            <input class="form-control" placeholder="@Properties.Resources.FilterByUpdatedTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => _filter.Updated = StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        @if (Menu)
        {
            <AuthorizeView Policy="@GXDevicePolicies.View">
                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
                <GXContextMenuItem Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear"></GXContextMenuItem>
            </AuthorizeView>
        }
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Name" Name="Name" Target="@device">
            @Properties.Resources.Name
        </GXTh>
        <GXTh Id="Template.Type" Name="Template.Type" Target="@device">
            @Properties.Resources.Type
        </GXTh>
        <GXTh Id="Detected" Name="Detected" Target="@device" Visibility="Visibility.Small" SortMode="SortMode.Descending">
            @Properties.Resources.Detected
        </GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Visibility="Visibility.Medium" Target="@device"
            SortMode="SortMode.Descending">
            @Properties.Resources.CreationTime
        </GXTh>
        <GXTh Id="Updated" Name="Updated" Visibility="Visibility.Large" Target="@device">
            @Properties.Resources.Updated
        </GXTh>
        <GXTh Id="LastRead" Name="LastRead" Visibility="Visibility.ExtraLarge" Target="@device">
            @Properties.Resources.LastRead
        </GXTh>
        <GXTh Id="LastWrite" Name="LastWrite" Visibility="Visibility.ExtraLarge" Target="@device">
            @Properties.Resources.LastWrite
        </GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath(GXDeviceObjectRoutes.Objects(device.Id))"><span class=@(ClientHelpers.GetActiveDot(device.Enabled))></span>@device.Name</GXTd>
        <GXTd Id="Template.Type">@device.Template?.Name</GXTd>
        <GXTd Id="Detected" Visibility="Visibility.Small">@device.Detected</GXTd>
        <GXTd Id="CreationTime" Visibility="Visibility.Medium">@device.CreationTime</GXTd>
        <GXTd Id="Updated" Visibility="Visibility.Large">@device.Updated</GXTd>
        <GXTd Id="LastRead" Visibility="Visibility.ExtraLarge">@device.LastRead</GXTd>
        <GXTd Id="LastWrite" Visibility="Visibility.ExtraLarge">@device.LastWrite</GXTd>
    </ItemContent>
</GXViewTable>
<br />



@code {
    /// <summary>Defines the default columns and formatting used by the page's table.</summary>
    private static readonly GXViewColumn[] _viewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Template.Type") { Position = 1, Description = "Type", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Detected") { Position = 2, Description = "Detected", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Small },
        new("CreationTime") { Position = 3, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Medium },
        new("Updated") { Position = 4, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.Large },
        new("LastRead") { Position = 5, Description = "LastRead", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.ExtraLarge },
        new("LastWrite") { Position = 6, Description = "LastWrite", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.ExtraLarge },
    ];

    /// <summary>Owns the page's command registration and releases it when the page is disposed.</summary>
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    /// <summary>Combines overlapping device notifications into serialized refresh passes.</summary>
    private GXUpdateRefreshCoordinator? _deviceRefresh;
    /// <summary>Cancels targeted device reads when the page is disposed.</summary>
    private readonly CancellationTokenSource _notificationCancellation = new();
    /// <summary>Identifies the current provider load so an older targeted read cannot overwrite a newer page.</summary>
    private long _loadGeneration;
    /// <summary>Identifies provider requests whose snapshots must be restarted when a device changes.</summary>
    private bool _providerLoading;
    /// <summary>Retains the user visibility scope selected by the current provider request.</summary>
    private bool _showAllUserData;
    /// <summary>Prevents queued notification callbacks from updating a disposed page.</summary>
    private bool _disposed;

    /// <summary>Subscribes to server notifications that refresh the displayed data.</summary>
    private IGXNotifier? _notifier;
    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;


    /// <summary>
    /// Selected device ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Devices;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "device";
        }
    }

    /// <summary>
    /// Amount of the devices shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is menu shown.
    /// </summary>
    [Parameter]
    public bool Menu { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// List of available devices.
    /// </summary>
    [Parameter]
    public IEnumerable<GXDevice>? AvailableDevice { get; set; }

    //Verify that history is clear.

    /// <summary>
    /// Device filter.
    /// </summary>
    private GXDevice _filter = new GXDevice() { Template = new GXDeviceTemplate() };
    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXDevice>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                _notificationService?.RemoveByKey("Pages/Device/Devices.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/Devices.Updated");
        }
    }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _notifier = Services.GetService<IGXNotifier>();
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();
        if (_notifier == null)
        {
            return;
        }

        //Wait until table is loaded. Don't remove this or table is null and last settings are not available.
        await Task.Delay(1);
        if (_disposed)
        {
            return;
        }
        try
        {
            _notificationService?.RemoveByKey("Pages/Device/Devices.OnInitializedAsync");
            IReadOnlyList<GXTarget> pendingUpdates = [];
            _deviceRefresh = new GXUpdateRefreshCoordinator(items =>
            {
                pendingUpdates = items;
                return true;
            }, () => InvokeAsync(() => RefreshDevicesAsync(pendingUpdates)));
            _notifier.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), items =>
            {
                _ = _deviceRefresh.RequestAsync(items.Where(item =>
                    item.Type == GXDevicePolicies.Add || item.Type == GXDevicePolicies.Edit || item.Type == GXDevicePolicies.Delete));
            });

            if (Header)
            {
                MenuService.Clear();
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    Text = "Read",
                    Icon = "Read",
                    OnClick = EventCallback.Factory.Create(this, OnReadSelected)
                });
            }
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXDevice() { Id = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/Devices.OnInitializedAsync");
        }
    }

    /// <summary>Updates visible runtime fields in place, reloading the page when membership or order may change.</summary>
    /// <param name="updates">Device notifications combined by the page's refresh coordinator.</param>
    /// <returns>The completion of the affected-row read or full provider refresh.</returns>
    private async Task RefreshDevicesAsync(IReadOnlyList<GXTarget> updates)
    {
        if (_disposed || table == null)
        {
            return;
        }
        try
        {
            if (updates.Any(update => update.Type != GXDevicePolicies.Edit || update.Source?.StartsWith("device.runtime:", StringComparison.Ordinal) != true ||
                !Guid.TryParse(update.Id, out _)) || _providerLoading || RuntimeChangesAffectQuery(updates))
            {
                await Updated();
                return;
            }
            var ids = updates.Select(update => Guid.Parse(update.Id!)).ToHashSet();
            var rows = table.Items?.Where(row => ids.Contains(row.Id)).ToArray() ?? [];
            if (rows.Length == 0)
            {
                return;
            }
            long generation = _loadGeneration;
            var response = await Http.PostAsJson<ListDevicesResponse>("api/Device/List", new ListDevices
            {
                Included = rows.Select(row => row.Id).ToArray(),
                Count = rows.Length,
                Filter = _filter,
                AllUsers = _showAllUserData
            }, _notificationCancellation.Token);
            if (_disposed || generation != _loadGeneration)
            {
                return;
            }
            var devices = response.Devices?.ToDictionary(device => device.Id);
            if (devices == null || rows.Any(row => !devices.ContainsKey(row.Id)))
            {
                await Updated();
                return;
            }
            foreach (var row in rows)
            {
                var device = devices[row.Id];
                row.Status = device.Status;
                row.Detected = device.Detected;
                row.ConnectionInfo = device.ConnectionInfo;
                row.LastRead = device.LastRead;
                row.LastWrite = device.LastWrite;
                row.LastAction = device.LastAction;
                row.LastError = device.LastError;
                row.LastErrorMessage = device.LastErrorMessage;
                row.Updated = device.Updated;
                row.ConcurrencyStamp = device.ConcurrencyStamp;
            }
            _notificationService?.RemoveByKey("Pages/Device/Devices.RuntimeUpdate");
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_disposed)
        {
            // The page no longer owns any visible rows.
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/Devices.RuntimeUpdate");
        }
    }

    /// <summary>Checks whether the reported runtime columns can change result membership or ordering.</summary>
    /// <param name="updates">Notifications whose sources identify the changed runtime columns.</param>
    /// <returns>True when a changed column is filtered or determines the displayed ordering.</returns>
    private bool RuntimeChangesAffectQuery(IEnumerable<GXTarget> updates)
    {
        foreach (var column in updates.SelectMany(update => update.Source!["device.runtime:".Length..].Split(',')).Distinct())
        {
            if (column is not (nameof(GXDevice.Detected) or nameof(GXDevice.Status) or nameof(GXDevice.ConnectionInfo) or
                nameof(GXDevice.LastRead) or nameof(GXDevice.LastWrite) or nameof(GXDevice.LastAction) or
                nameof(GXDevice.LastError) or nameof(GXDevice.LastErrorMessage) or nameof(GXDevice.Updated)))
            {
                return true;
            }
            var filterValue = typeof(GXDevice).GetProperty(column)!.GetValue(_filter);
            if ((filterValue != null && filterValue is not "") || (table?.SortMode != SortMode.None && table?.OrderBy == column))
            {
                return true;
            }
        }
        return false;
    }

    /// <summary>Loads a device page using the current filters, sorting, and visibility settings.</summary>
    /// <param name="request">The provider's paging, ordering, and cancellation settings.</param>
    /// <returns>The requested device summaries and total matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXDevice>> GetItems(GXItemsProviderRequest request)
    {
        long generation = ++_loadGeneration;
        _providerLoading = true;
        _showAllUserData = request.ShowAllUserData;
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingDevices);
        try
        {
            if (request.Removed)
            {
                _filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                _filter.Removed = null;
            }
            ListDevices req = new ListDevices()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = _filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
            };
            if (AvailableDevice != null && AvailableDevice.Any())
            {
                req.Included = AvailableDevice.Select(s => s.Id).ToArray();
            }
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListDevicesResponse>("api/Device/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXDevice>((ret.Devices ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _providerLoading = false;
            }
        }
        return default;
    }

    /// <summary>
    /// Add new device.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/Device/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit device.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            _notificationService?.RemoveByKey("Pages/Device/Devices.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Device/Edit/" + table?.Active.Id);

        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/Devices.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected device.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected devices.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        if (table != null && args.Confirm)
        {
            try
            {
                using var progressScope2 = _progress?.ProgressStart(GXProgress.SavingDevice);
                RemoveDevice req = new RemoveDevice()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveDeviceResponse>("api/Device/Delete", req);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception ex)
            {
                _notificationService?.ReportError(ex);
            }
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClear()
    {
        try
        {
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDelete, Properties.Resources.AreYouSureYouWantToClearDeviceHistoryThisActionCannotBeUndone,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Clear,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.Name).ToArray()
                });
            await OnClearConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    /// <summary>
    /// Clear history.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm && table != null)
            {
                List<GXDevice> devices = new List<GXDevice>();
                foreach (var it in table.SingleOrDefault())
                {
                    devices.Add(new GXDevice() { Id = it.Id });
                }
                await Http.PostAsJson<ClearValueResponse>("api/Value/Clear", new ClearValue()
                {
                    Devices = devices.ToArray()
                });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Read all selected objects.
    /// </summary>
    public async Task OnReadSelected()
    {
        try
        {
            _notificationService?.RemoveByKey("Pages/Device/Devices.OnReadSelected");
            using var progressScope3 = _progress?.ProgressStart(GXProgress.SavingDevice);
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            List<GXTask> tasks = new List<GXTask>();
            foreach (var it in table.SingleOrDefault())
            {
                GXTask task = new GXTask();
                task.TaskType = TaskType.Read;
                task.TargetDevice = it.Id;
                tasks.Add(task);
            }
            AddTask req = new AddTask();
            req.Tasks = tasks.ToArray();
            var response = await Http.PostAsJson<AddTaskResponse>("api/Task/Add", req);
            Services.GetService<GXReadTaskNotifications>()?.Track(response.Ids);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Device/Devices.OnReadSelected");
        }
    }

    /// <summary>Stops notifications and cancels outstanding reads before releasing page services.</summary>
    public void Dispose()
    {
        _disposed = true;
        _deviceRefresh?.Dispose();
        _notificationCancellation.Cancel();
        _notificationCancellation.Dispose();
        MenuService.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        _notifier?.RemoveListener(this);
    }
}

