@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="DeviceTrace" />

@if (_active != null)
{
    <EditForm EditContext="@GXEditContexts.For(_active)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.Direction</label>
                    <input type="text" id="direction" disabled="disabled" value="@GetDirection()" class="form-control" />
                </div>

                <div class="form-group">
                    <label>@Properties.Resources.Message</label>
                    <input type="text" id="frame" disabled="disabled" value="@_active.Frame" class="form-control" />
                </div>
                @if (_active.Device != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.Device</label>
                        <input type="text" id="device" disabled="disabled" value="@_active.Device.Name" class="form-control" />
                    </div>
                }
                @if (_active.CreationTime != null)
                {
                    <div class="form-group">
                        <label>@Properties.Resources.CreationTime</label>
                        <InputDate Type="@InputDateType.DateTimeLocal" id="generation" readonly="readonly" class="form-control"
                           @bind-Value="_active.CreationTime" />
                    </div>
                }
            </div>
        </div>
    </EditForm>
}
@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXDeviceTrace? _active;

    private string GetDirection()
    {
        return "Tx";
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceTrace);
            NotificationService?.RemoveByKey("Pages/Device/DeviceTrace.OnInitializedAsync");
            //Get selected item.
            if (Id == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem() { Text = Properties.Resources.Close, Icon = "Cancel", OnClick = EventCallback.Factory.Create(this, OnCancel) });
            //Read device trace item.
            HttpResponseMessage response = await Http.GetAsync(string.Format("api/DeviceTrace?id={0}", Id));
            await response.EnsureSuccessAsync(default);
            _active = (await response.Content.ReadFromJsonAsync<GetDeviceTrace>())?.Item;
            if (_active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceTrace.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Cancel.
    /// </summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        MenuService.Dispose();
    }
}
