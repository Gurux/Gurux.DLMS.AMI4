@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Module

@page "/DeviceGroup/{Id:guid?}"
@page "/DeviceGroup/{Action}/{Id:guid?}"
@using Gurux.DLMS.AMI.Client.Pages.Agent
@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="DeviceGroup" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXTabIcon Id="@context.Icon" Color="@context.IconColor" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.DeviceGroupTab" Parameters="@TabParameters" />
            }
            <ModuleViews Area="AmiViewArea.DeviceGroup" Target="@Active" Parameters="@TabParameters" />
                <ModuleViews Area="AmiViewArea.DeviceGroupSettings" Target="@Active" Parameters="@TabParameters" />
            </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
<ModuleViews Area="AmiViewArea.DeviceGroup" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
<ModuleViews Area="AmiViewArea.DeviceGroupSettings" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXDeviceGroup Active = new GXDeviceGroup(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.DeviceGroup;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingDeviceGroup);
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get device group data.
                var tmp = (await Http.GetAsJsonAsync<GetDeviceGroupResponse>(string.Format("api/DeviceGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            SetEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroup.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    public bool DeleteTarget { get; set; }
    private void SetEditorMenu() { _editorMenu = new GXEditorMenu(SharedMenuService); _editorMenu.Set(Active, _action, OnSave, () => { OnCancel(); return Task.CompletedTask; }); }
    public void Dispose() => _editorMenu?.Dispose();
    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !GXEditContexts.For(Active).Validate()) {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingDeviceGroup);
            NotificationService?.RemoveByKey("Pages/Device/DeviceGroupGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveDeviceGroupResponse>("api/DeviceGroup/Delete", new RemoveDeviceGroup()
                    {
                        Ids = new Guid[] { Active.Id },
                        Delete = DeleteTarget
                    });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/DeviceGroup/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/DeviceGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddDeviceGroupResponse>(address, new AddDeviceGroup() { DeviceGroups = new GXDeviceGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Device/DeviceGroupGeneral.OnSave");
        }
    }
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}
