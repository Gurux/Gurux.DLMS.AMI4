@using Gurux.DLMS.AMI.Module.Enums

@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Device
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.User
@using Microsoft.AspNetCore.Authorization
@using System.Reflection
@inject ModuleLoader Loader
@inject AuthenticationStateProvider Authentication
@inject IAuthorizationService Authorization
@inject IGXNotificationService Notifications
@implements IDisposable

<GXHelpContext Topic="ParametersView" />

@foreach (var view in _views)
{
    <ModuleErrorBoundary @key="view" ModuleId="@view.ModuleId">
        @RenderView(view)
    </ModuleErrorBoundary>
}

@code {
    [Parameter] public List<IGXProperty>? Parameters { get; set; }
    [Parameter] public object? Target { get; set; }

    private sealed class SettingsView
    {
        public required string ModuleId { get; init; }
        public required string Name { get; init; }
        public required Type Component { get; init; }
        public string? Settings { get; init; }
        public object? Instance { get; set; }
        public Task? Initialization { get; set; }
    }

    private readonly List<SettingsView> _views = [];
    private object? _target;
    private List<IGXProperty>? _parameters;
    private bool _reload = true;
    private bool _interactive;
    private readonly SemaphoreSlim _gate = new(1);
    private bool _disposed;
    private long _generation;

    protected override void OnInitialized()
    {
        Loader.Changed += ModulesChanged;
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
    }

    private void AuthenticationChanged(Task<AuthenticationState> state) => ModulesChanged();

    private void ModulesChanged()
    {
        ++_generation;
        _reload = true;
        _views.Clear();
        if (!_interactive)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }
            await LoadViewsAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_target, Target) || !ReferenceEquals(_parameters, Parameters))
        {
            _target = Target;
            _parameters = Parameters;
            _reload = true;
            ++_generation;
        }
        if (_interactive)
        {
            await LoadViewsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        _interactive = true;
        await LoadViewsAsync();
        StateHasChanged();
    }

    private AmiViewArea SettingsArea => Target switch
    {
        GXDevice => AmiViewArea.DeviceSettings,
        GXDeviceGroup => AmiViewArea.DeviceGroupSettings,
        GXObject => AmiViewArea.ObjectSettings,
        GXAttribute => AmiViewArea.AttributeSettings,
        GXUser => AmiViewArea.UserSettings,
        GXUserGroup => AmiViewArea.UserGroupSettings,
        _ => AmiViewArea.ParameterSettings
    };

    private async Task LoadViewsAsync()
    {
        await _gate.WaitAsync();
        try
        {
            if (!_reload || _disposed)
            {
                return;
            }
        
            _reload = false;
            _views.Clear();
            if (Target == null)
            {
                return;
            }
        
            try
            {
                var generation = _generation;
                if (!Loader.IsInitialized)
                {
                    await Loader.RefreshAsync();
                }
        
                var user = (await Authentication.GetAuthenticationStateAsync()).User;
                var views = new List<SettingsView>();
                foreach (var module in Loader.AddIns.OrderBy(m => m.Id))
                {
                    foreach (var view in module.Views.Where(v => v.Area == SettingsArea).OrderBy(v => v.Order).ThenBy(v => v.Key))
                    {
                        if (string.IsNullOrWhiteSpace(view.Policy) || !(await Authorization.AuthorizeAsync(user, Target, view.Policy)).Succeeded)
                        {
                            continue;
                        }
        
                        var type = await Loader.GetViewTypeAsync(module.Id, view.Area, view.Key);
                        if (type == null)
                        {
                            continue;
                        }
        
                        if (!typeof(IGXAmiModuleSettings).IsAssignableFrom(type))
                        {
                            var error = new InvalidOperationException("A module settings view must implement IGXAmiModuleSettings.");
                            Loader.DisableClientModule(module.Id, error);
                            Notifications.ReportError(error);
                            continue;
                        }
        
                        var name = view.Key ?? module.Id;
                        views.Add(new SettingsView { ModuleId = module.Id, Name = name, Component = type, Settings = Parameters?.FirstOrDefault(p => p.Module?.Id == module.Id && p.Name == name)?.Value });
                    }
                }
        
                if (!_disposed && generation == _generation)
                {
                    _views.AddRange(views);
                }
            }
            catch (Exception error)
            {
                Notifications.ReportError(error);
            }
        }
        finally
        {
            _gate.Release();
        }
    }

    private RenderFragment RenderView(SettingsView view) => builder =>
    {
        builder.OpenComponent(0, view.Component);
        if (view.Component.GetProperty("Target")?.GetCustomAttribute<ParameterAttribute>() != null)
        {
            builder.AddAttribute(1, "Target", Target);
        }
        builder.AddComponentReferenceCapture(2, instance =>
        {
            if (ReferenceEquals(view.Instance, instance))
            {
                return;
            }
            view.Instance = instance;
            view.Initialization = InitializeAsync(view);
        });
        builder.CloseComponent();
    };

    private async Task InitializeAsync(SettingsView view)
    {
        try
        {
            var settings = (IGXAmiModuleSettings)view.Instance!;
            settings.Initialize(view.Settings);
            await settings.InitializeAsync(view.Settings);
            if (!_disposed && _views.Contains(view))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception error)
        {
            Loader.DisableClientModule(view.ModuleId, error);
            await DispatchExceptionAsync(error);
        }
    }

    public async Task UpdateSettingsAsync<T>(List<T>? parameters) where T : IGXProperty
    {
        if (parameters == null)
        {
            return;
        }
        foreach (var view in _views.ToArray())
        {
            if (view.Initialization != null)
            {
                await view.Initialization;
            }
            if (!_views.Contains(view) || view.Instance is not IGXAmiModuleSettings settings)
            {
                continue;
            }
            var value = await settings.SaveAsync();
            var parameter = parameters.SingleOrDefault(p => p.Module?.Id == view.ModuleId && p.Name == view.Name);
            if (parameter == null)
            {
                parameter = Activator.CreateInstance<T>();
                parameter.Name = view.Name;
                parameter.Module = new GXModule { Id = view.ModuleId };
                parameters.Add(parameter);
            }
            parameter.Value = value;
        }
    }

    public async Task CancelAsync()
    {
        foreach (var view in _views.ToArray())
        {
            if (view.Initialization != null)
            {
                await view.Initialization;
            }
            if (!_views.Contains(view) || view.Instance is not IGXAmiModuleSettings settings)
            {
                continue;
            }
            settings.Cancel();
            await settings.CancelAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ++_generation;
        Loader.Changed -= ModulesChanged;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        _views.Clear();
    }
}