@using Gurux.UI.Components.Accordion
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.Net
@using Gurux.Serial
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS
@using Gurux.DLMS.ManufacturerSettings
@using Gurux.DLMS.Objects
@using System.Xml.Linq
@using System.IO
@using System.Xml
@using System.Xml.Serialization
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Pages.Media
@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Text.Json.Serialization
@using System.Diagnostics
@using System.Text;

@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ILogger<DeviceGeneral> Logger

<GXHelpContext Topic="DeviceGeneral" />

<CascadingValue Value="this">

    @if (Active != null)
    {
        <div class="form-group">
            <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="Active.Enabled" />
        </div>
        @if (Templates != null && Templates.Any())
        {
            @if (Action != CrudAction.Create)
            {
                <GXMenuControl RightCorner="true" Bottom="true">
                    <ChildContent>
                        <GXMenuEntry Text="@Properties.Resources.SaveAsDefault"
                                  Id="Save as Default" OnClick="@(async () => await OnDefault())" />
                    </ChildContent>
                </GXMenuControl>
            }
            <EditForm EditContext="@FormContext">
                <DataAnnotationsValidator />
                <ul>
                    @foreach (var message in context.GetValidationMessages())
                    {
                        <li class="validation-message">@message</li>
                    }
                </ul>
                <div class="form-group">
                    <div class="d-flex align-items-center">
                        <label for="name">@Properties.Resources.Name</label>
                        <GXCopyButton Value="@Active.Name" />
                    </div>
                    <InputText id="name" class="form-control"
                               @bind-Value="Active.Name" />
                    <ValidationMessage For="@(() => Active.Name)" />
                </div>
                @if (Action == CrudAction.Create)
                {
                    <div class="form-group row">
                        <div class="form-inline">
                            <label>@Properties.Resources.CreateTheDeviceImmediately</label>
                            <GXInputSwitch @bind-Value="CreateImmediately">
                            </GXInputSwitch>
                        </div>
                    </div>
                }
                <div class="row justify-content-center">
                    <div>
                        @if (Manufacturers != null && Manufacturers.Any())
                        {
                            <div class="form-group row">
                                <label>@Properties.Resources.Manufacturer</label>
                                <GXInputDropdown RememberValue="false" id="type" class="form-control"
                                             @bind-Value="SelectedManufacturer" Disabled="@(IsCreate() != null)"
                                                 Items="@(Manufacturers.Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => Manufacturers.First(it => it.Id == value).Name)" />
                            </div>
                        }
                        @if (_manufacturer != null && _manufacturer.Id != Guid.Empty)
                        {
                            @if (_manufacturer?.Models != null)
                            {
                                <div class="form-group row">
                                    <label>@Properties.Resources.Model</label>
                                    <GXInputDropdown RememberValue="false" id="type" class="form-control"
                                                 @bind-Value="SelectedModel" Disabled="@(IsCreate() != null)"
                                                     Items="@(_manufacturer.Models.Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => _manufacturer.Models.First(it => it.Id == value).Name)" />
                                </div>
                                @if (_model?.Versions != null)
                                {
                                    <div class="form-group row">
                                        <label>@Properties.Resources.Version</label>
                                        <GXInputDropdown RememberValue="false" id="type" class="form-control"
                                                     @bind-Value="SelectedVersion" Disabled="@(IsCreate() != null)"
                                                         Items="@(_model.Versions.Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => string.IsNullOrEmpty(_model.Versions.First(it => it.Id == value).Name) ? Properties.Resources.Generic : _model.Versions.First(it => it.Id == value).Name)" />
                                    </div>
                                    @if (ShowLogicalDeviceName)
                                    {
                                        <div class="form-group row">
                                            <label>@Properties.Resources.LogicalDeviceName</label>
                                            <InputText id="sn" class="form-control"
                                                       @bind-Value="LogicalDeviceName" />
                                            <ValidationMessage For="@(() => LogicalDeviceName)" />
                                        </div>
                                    }
                                    @if (_version?.Settings != null)
                                    {
                                        <div class="form-group row">
                                            <label>@Properties.Resources.InterfaceType</label>
                                            <GXInputDropdown RememberValue="false" id="type" class="form-select"
                                                         @bind-Value="SelectedSettings" Disabled="@(IsCreate() != null)"
                                                             Items="@(GetInterfaceTypes().Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => GetInterfaceType(GetInterfaceTypes().First(it => it.Id == value)).ToString())" />
                                        </div>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <div class="form-group row">
                                <label>@Properties.Resources.Type</label>
                                <GXInputDropdown RememberValue="false" id="type" class="form-control"
                                             @bind-Value="SelectedTemplate" Disabled="@(IsCreate() != null)"
                                                 Items="@(GetCustomTemplates().Select(it => it.Name))" />
                            </div>
                            @if (_templateSettings != null)
                            {
                                <div class="form-group row">
                                    <label>@Properties.Resources.Manufacturer</label>
                                    <InputText id="manuacturer" class="form-control" readonly="readonly"
                                               @bind-Value="_templateSettings.Manufacturer" />
                                </div>
                            }
                            @if (ShowLogicalDeviceName)
                            {
                                <div class="form-group row">
                                    <label>@Properties.Resources.LogicalDeviceName</label>
                                    <InputText id="sn" class="form-control"
                                               @bind-Value="LogicalDeviceName" />
                                    <ValidationMessage For="@(() => LogicalDeviceName)" />
                                </div>
                            }
                            @if (_settings != null)
                            {
                                <div class="form-group row">
                                    <label style="margin:auto">@Properties.Resources.InterfaceType</label>
                                    <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="_settings.InterfaceType"
                                                     Items="@(InterfaceList.Select(it => (int)it))" Formatter="@((int value) => ((Gurux.DLMS.Enums.InterfaceType)value).ToString())" />
                                </div>
                            }
                        }
                        <div class="form-group row">
                            <label>@Properties.Resources.Authentication</label>
                            <GXInputDropdown RememberValue="false" id="type" class="form-select"
                                         @bind-Value="SelectedSettings" Disabled="@(IsCreate() != null)"
                                             Items="@(GetAuthenticationLevels().Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => GetAuthenticationLevel(GetAuthenticationLevels().First(it => it.Id == value)).ToString())" />
                        </div>
                        @if (_settings != null)
                        {
                            <fieldset disabled=@DisablePassword()>
                                <div class="form-group row">
                                    <div class="form-inline">
                                        <label>@Properties.Resources.Password</label>
                                        <GXInputHexAscii Id="device-password" disabled="@IsAuthenticated()"
                                                       @bind-Value="@_settings.Password">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.Password)" />
                                    </div>
                                </div>
                            </fieldset>
                        }
                        <GXAccordion Id="ciphering">
                            <HeaderTemplate>
                                <div>
                                    <h6><b>@Properties.Resources.Security</b></h6>
                                    @GetSecurity()
                                </div>
                            </HeaderTemplate>
                            <ChildContent>
                                <div class="form-group row">
                                    <label>@Properties.Resources.Security</label>
                                    <GXInputDropdown RememberValue="false" id="security" class="form-select"
                                                 @bind-Value="SelectedSettings" Disabled="@(IsCreate() != null)"
                                                     Items="@(GetSecurityLevels().Select(it => (Guid?)it.Id))" Formatter="@((Guid? value) => GetSecurity(GetSecurityLevels().First(it => it.Id == value)).ToString())" />
                                </div>
                                @if (_settings != null)
                                {
                                    <div class="form-group row">
                                        <GXInputHexAscii @ref="_clientSystemTitle"
                                                       Save="!DisableSecurity()"
                                                       @bind-Value="@_settings.ClientSystemTitle"
                                                       Title="@Properties.Resources.ClientSystemTitle">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.ClientSystemTitle)" />
                                    </div>
                                    <div class="form-group row">
                                        <GXInputHexAscii @ref="_deviceSystemTitle"
                                                       Save="!DisableSecurity()"
                                                       @bind-Value="@_settings.DeviceSystemTitle"
                                                       Title="@Properties.Resources.DeviceSystemTitle">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.DeviceSystemTitle)" />
                                    </div>
                                    <div class="form-group row">
                                        <GXInputHexAscii @ref="_blockCipherKey"
                                                       Save="!DisableSecurity()"
                                                       @bind-Value="@_settings.BlockCipherKey"
                                                       Title="@Properties.Resources.BlockCipherKey">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.BlockCipherKey)" />
                                    </div>
                                    <div class="form-group row">
                                        <GXInputHexAscii @ref="_authenticationKey"
                                                       Save="false"
                                                       @bind-Value="@_settings.AuthenticationKey"
                                                       Title="@Properties.Resources.AuthenticationKey">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.AuthenticationKey)" />
                                    </div>
                                    <div class="form-group row">
                                        <GXInputHexAscii @ref="_broadcastKey"
                                                       Save="false"
                                                       @bind-Value="@_settings.BroadcastKey"
                                                       Title="@Properties.Resources.BroadcastKey">
                                        </GXInputHexAscii>
                                        <ValidationMessage For="@(() => _settings.BroadcastKey)" />
                                    </div>
                                }
                            </ChildContent>
                        </GXAccordion>
                        @if (_settings != null && _settings.HDLCAddressing == (int)HDLCAddressType.SerialNumber)
                        {
                            <div class="form-group row">
                                <label>@Properties.Resources.SerialNumber</label>
                                <GXInputNumber RememberValue="false" id="Device.SerialNumber" class="form-control"
                                             @bind-Value="_settings.PhysicalAddress" Min="@GXNumberBounds.Minimum(_settings.PhysicalAddress)" Max="@GXNumberBounds.Maximum(_settings.PhysicalAddress)" />
                                <ValidationMessage For="@(() => _settings.PhysicalAddress)" />
                            </div>
                        }
                        <div class="form-group row">
                            <label>@Properties.Resources.WaitTime</label>
                            <GXInputTimeSpan RememberValue="false" id="Device.WaitTime" class="form-control"
                                                  @bind-Value="Active.WaitTime" />
                            <ValidationMessage For="@(() => Active.WaitTime)" />
                        </div>
                        <div class="form-group row">
                            <label>@Properties.Resources.ResendCount</label>
                            <GXInputNumber RememberValue="false" id="Device.Resend" class="form-control"
                                         @bind-Value="Active.ResendCount" Min="@GXNumberBounds.Minimum(Active.ResendCount)" Max="@GXNumberBounds.Maximum(Active.ResendCount)" />
                            <ValidationMessage For="@(() => Active.ResendCount)" />
                        </div>
                        <div class="form-group row">
                            <GXInputSwitch Text="@Properties.Resources.Dynamic"
                                         @bind-Value="Active.Dynamic" />
                            <br />
                        </div>
                        @if (!Active.Dynamic.GetValueOrDefault(false))
                        {
                            <div class="form-group row">
                                <label style="margin:auto">@Properties.Resources.Media</label>
                                <GXInputDropdown RememberValue="false" class="form-select" @bind-Value="Active.MediaType"
                                                 Items="@(MediaList.Keys)" Formatter="@((string? value) => value == null ? null : MediaList[value])" />
                            </div>
                            @if (Active.MediaType == typeof(GXNet).FullName)
                            {
                                <NetworkSettings @bind-Settings="@Active.MediaSettings"></NetworkSettings>
                            }
                            @if (Active.MediaType == typeof(GXSerial).FullName || string.IsNullOrEmpty(Active.MediaType))
                            {
                                <SerialSettings @bind-Settings="@Active.MediaSettings"></SerialSettings>
                            }
                        }
                        else
                        {
                            <div class="form-group row">
                                <label>@Properties.Resources.ConnectionUpTime</label>
                                <GXInputTimeSpan RememberValue="false" id="resend" class="form-control"
                                                              @bind-Value="Active.ConnectionUpTime" />
                                <ValidationMessage For="@(() => Active.ConnectionUpTime)" />
                            </div>
                        }
                        <div class="form-group row">
                            <label>@Properties.Resources.TraceLevel</label>
                            <GXInputDropdown class="form-select"
                                             Id="Device.TraceLevel"
                                             RememberValue="@(Action == CrudAction.Create)"
                                             @bind-Value="Active.TraceLevel">
                            </GXInputDropdown>
                        </div>
                    </div>
                    <AuthoringInformationDateTimeOffset Action="@Action" @bind-Creator="Active.Creator" CreationTime="@Active.CreationTime"
                                                        Updated="@Active.Updated" @bind-Removed="Active.Removed" />
                    @if (Action == CrudAction.Delete)
                    {
                        <hr />
                        <p>
                        </p>
                        <div class="form-group row">
                            <InputRadioGroup @bind-Value="DeleteTarget">
                                <InputRadio Value="false">
                                </InputRadio>
                                <label>@Properties.Resources.TargetDisableQuestion</label><br>
                                <InputRadio Value="true">
                                </InputRadio>
                                <label>@Properties.Resources.TargetDeleteQuestion</label>
                            </InputRadioGroup>
                            <br />
                        </div>
                    }
                </div>
                <br />
            </EditForm>
        }
    }
</CascadingValue>
@code {
    [Parameter] public GXDeviceTemplate[]? Templates { get; set; }
    [Parameter] public Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXManufacturer[]? Manufacturers { get; set; }
    [Parameter] public List<GXDeviceTemplate>? CustomTemplates { get; set; }

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private GXInputHexAscii? _clientSystemTitle;
    private GXInputHexAscii? _deviceSystemTitle;
    private GXInputHexAscii? _blockCipherKey;
    private GXInputHexAscii? _authenticationKey;
    private GXInputHexAscii? _broadcastKey;

    /// <summary>
    /// Is device created immediatly or when needed.
    /// </summary>
    /// <remarks>
    /// Create devices immediatly is taking longer time when it's added.
    /// This is handy when a large amount of the meter is added.
    /// </remarks>
    private bool CreateImmediately { get => Editor?.CreateImmediately ?? false; set { if (Editor != null) {
        Editor.CreateImmediately = value;
    } } }

    [Parameter, EditorRequired]
    public GXDevice? Active { get; set; }

    private bool ShowLogicalDeviceName
    {
        get
        {
            GXObject? ldn = Active?.Objects?.Where(w => w.Template?.LogicalName == "0.0.42.0.0.255").SingleOrDefault() as GXObject;
            return ldn?.Attributes?.FirstOrDefault() is GXAttribute;
        }
    }

    private string? LogicalDeviceName
    {
        get
        {
            GXObject? ldn = Active?.Objects?.Where(w => w.Template?.LogicalName == "0.0.42.0.0.255").SingleOrDefault() as GXObject;
            if (ldn?.Attributes?.FirstOrDefault() is GXAttribute att)
            {
                return att.Value;
            }
            return null;
        }
        set
        {
            GXObject? ldn = Active?.Objects?.Where(w => w.Template?.LogicalName == "0.0.42.0.0.255").SingleOrDefault() as GXObject;
            if (ldn?.Attributes?.FirstOrDefault() is GXAttribute att)
            {
                att.Value = value;
            }
        }
    }

    private bool DisablePassword()
    {
        if (_settings != null &&
            _settings.Authentication != (byte)Gurux.DLMS.Enums.Authentication.None)
        {
            return Action != CrudAction.Create;
        }
        return true;
    }

    private string GetSecurity()
    {
        if (_settings != null)
        {
            return ((Gurux.DLMS.Enums.Security)_settings.Security).ToString();
        }
        return Gurux.DLMS.Enums.Security.None.ToString();
    }

    private bool DisableSecurity()
    {
        if (_settings != null &&
            (_settings.Authentication == (byte)Gurux.DLMS.Enums.Authentication.HighGMAC ||
            _settings.Security != (byte)Gurux.DLMS.Enums.Security.None))
        {
            return Action != CrudAction.Create;
        }
        return true;
    }

    private byte[] GetByteArray(string? value, bool toHex)
    {
        if (string.IsNullOrEmpty(value))
        {
            return new byte[0];
        }
        if (toHex)
        {
            //Convert ASCII to hex.
            return ASCIIEncoding.ASCII.GetBytes(value);
        }
        //Convert hex to ASCII.
        return GXDLMSTranslator.HexToBytes(value);
    }

    private string? GetValue(string? value, bool toHex)
    {
        byte[] bytes = GetByteArray(value, toHex);
        if (toHex)
        {
            //Convert ASCII to hex.
            return GXDLMSTranslator.ToHex(bytes);
        }
        //Convert hex to ASCII.
        return ASCIIEncoding.ASCII.GetString(bytes);
    }

    /// <summary>
    /// Find only custom templates from the device templates and remove manufacturer templates.
    /// </summary>
    /// <returns>Collection of custom templates.</returns>
    private IEnumerable<GXDeviceTemplate> GetCustomTemplates()
    {
        if (CustomTemplates == null)
        {
            return new GXDeviceTemplate[0];
        }
        return CustomTemplates;
    }

    private void SelectFirstManufacturer()
    {
        if (Active != null && Manufacturers != null && Manufacturers.Any())
        {
            SelectedManufacturer = Manufacturers[0].Id;
            if (_deviceSettings?.Template != null && Templates != null && Templates.Any())
            {
                Active.Template = Templates.Where(w => w.Id == _deviceSettings.Template.Id).SingleOrDefault();
            }
        }
    }

    private void SelectFirstCustomTemplate()
    {
        if (Active != null && CustomTemplates != null && CustomTemplates.Any())
        {
            if (SelectedManufacturer == null ||
                SelectedManufacturer == Guid.Empty)
            {
                SelectedTemplate = CustomTemplates[0].Name;
            }
            else
            {
                SelectedTemplate = null;
            }
        }
    }
    /// <summary>
    /// Device tab asks to update the UI.
    /// </summary>
    public void Update()
    {
        if (Active != null)
        {
            //New device is created.
            if (Active.Template == null || Active.Template.Id == Guid.Empty)
            {
                //Select first manufacturer.
                SelectFirstManufacturer();
                //The first custom teplate is selected is manufacturer is not selected.
                SelectFirstCustomTemplate();
            }
            else if (Manufacturers != null && Manufacturers.Any())
            {
                //Find manufacturer.
                bool found = false;
                foreach (var manufacturer in Manufacturers)
                {
                    if (manufacturer.Models != null)
                    {
                        foreach (var model in manufacturer.Models)
                        {
                            if (model.Versions != null)
                            {
                                foreach (var version in model.Versions)
                                {
                                    if (version.Settings != null)
                                    {
                                        foreach (var settings in version.Settings)
                                        {
                                            if (settings?.Template?.Id == Active.Template.Id)
                                            {
                                                _manufacturer = manufacturer;
                                                _model = model;
                                                _version = version;
                                                _deviceSettings = settings;
                                                settings.Settings = Active.Settings;
                                                found = true;
                                                break;
                                            }
                                        }
                                    }
                                    if (found)
                                    {
                                        break;
                                    }
                                }
                                if (found)
                                {
                                    break;
                                }
                            }
                            if (found)
                            {
                                break;
                            }
                        }
                        if (found)
                        {
                            break;
                        }
                    }
                    if (found)
                    {
                        break;
                    }
                }
            }
            if (Active.Template != null
                && !string.IsNullOrEmpty(Active.Template.Settings))
            {
                _templateSettings = JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Template.Settings ?? "{}");
            }
            if (_settings == null)
            {
                _settings = !string.IsNullOrEmpty(Active.Settings)
                    ? JsonSerializer.Deserialize<Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings>(Active.Settings)
                    : _templateSettings;
            }
            if (string.IsNullOrEmpty(Active.MediaType))
            {
                Active.MediaType = typeof(GXNet).FullName ?? throw new InvalidOperationException(Properties.Resources.TheNetworkMediaTypeNameIsMissing);
            }

        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Get available interface types.
    /// </summary>
    /// <returns>Available interface types.</returns>
    List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> GetInterfaceTypes()
    {
        Gurux.DLMS.Enums.InterfaceType current = Gurux.DLMS.Enums.InterfaceType.HDLC;
        if (_deviceSettings != null)
        {
            current = GetInterfaceType(_deviceSettings);
        }
        List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> settings = new();
        List<Gurux.DLMS.Enums.InterfaceType> items = new List<Enums.InterfaceType>();
        if (_version?.Settings != null)
        {
            foreach (var it in _version.Settings)
            {
                var item = GetInterfaceType(it);
                if (!items.Contains(item) && (_deviceSettings == null || it.Id == _deviceSettings.Id || item != current))
                {
                    settings.Add(it);
                    items.Add(item);
                }
            }
        }
        return settings;
    }

    /// <summary>
    /// Get available authentication levels.
    /// </summary>
    /// <returns>Available authentication levels.</returns>
    List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> GetAuthenticationLevels()
    {
        Gurux.DLMS.Enums.Authentication current = Gurux.DLMS.Enums.Authentication.None;
        if (_templateSettings != null)
        {
            //Get default value when new device is create from device template.
            current = (Gurux.DLMS.Enums.Authentication)_templateSettings.Authentication;
        }
        if (_deviceSettings != null)
        {
            current = GetAuthenticationLevel(_deviceSettings);
        }
        List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> settings = new();
        List<Gurux.DLMS.Enums.Authentication> items = new List<Enums.Authentication>();
        if (_version?.Settings != null)
        {
            foreach (var it in _version.Settings)
            {
                var item = GetAuthenticationLevel(it);
                if (!items.Contains(item) && (_deviceSettings == null || it.Id == _deviceSettings.Id || item != current))
                {
                    settings.Add(it);
                    items.Add(item);
                }
            }
        }
        else if (_deviceSettings != null)
        {
            settings.Add(_deviceSettings);
        }
        else
        {
            settings.Add(new AMI.Shared.DTOs.Manufacturer.GXDeviceSettings()
            {
                Settings = JsonSerializer.Serialize(new Gurux.DLMS.AMI.Shared.DTOs.Device.GXDLMSSettings()
                {
                    Authentication = (byte)current
                })
            });
        }
        return settings;
    }

    /// <summary>
    /// Get available security levels.
    /// </summary>
    /// <returns>Available security levels.</returns>
    List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> GetSecurityLevels()
    {
        Gurux.DLMS.Enums.Security current = Gurux.DLMS.Enums.Security.None;
        if (_templateSettings != null)
        {
            //Get default value when new device is create from device template.
            current = (Gurux.DLMS.Enums.Security)_templateSettings.Security;
        }
        if (_deviceSettings != null)
        {
            current = GetSecurity(_deviceSettings);
        }
        List<Gurux.DLMS.AMI.Shared.DTOs.Manufacturer.GXDeviceSettings> settings = new();
        List<Gurux.DLMS.Enums.Security> items = new List<Enums.Security>();
        if (_version?.Settings != null)
        {
            foreach (var it in _version.Settings)
            {
                var item = GetSecurity(it);
                if (!items.Contains(item) && (_deviceSettings == null || it.Id == _deviceSettings.Id || item != current))
                {
                    settings.Add(it);
                    items.Add(item);
                }
            }
        }
        else if (_deviceSettings != null)
        {
            settings.Add(_deviceSettings);
        }
        else
        {
            //Default authentication is added.
