@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/users"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="Users" />

@if (Title)
{
    <PageTitle>@Properties.Resources.UsersTitle</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXUserPolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXUserPolicies.Delete" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="User.Users" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXUserPolicies.View })"
             TItem="GXUser" @ref="table"
             @bind-@bind-Active="Active"
             Context="user"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             Filter="@Filter"
             ShowAllUsers="false"
             ShowRemoved="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="GivenName">
            <input class="form-control" placeholder="@Properties.Resources.FilterByGivenName"
                   @onchange="@((ChangeEventArgs __e) => filter.GivenName = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Surname">
            <input class="form-control" placeholder="@Properties.Resources.FilterBySurname"
                   @onchange="@((ChangeEventArgs __e) => filter.Surname = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Email">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByEmail"
                   @onchange="@((ChangeEventArgs __e) => filter.Email = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="EmailConfirmed">
        </GXFh>
        <GXFh Id="Roles">
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="users-creation-time"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated">
            <GXDateTimeSelector Id="users-updated-time"
                                @bind-Value="@filter.Updated"
                                Placeholder="@Properties.Resources.FilterByUpdated">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="LastLogin">
            <GXDateTimeSelector Id="users-last-login-time"
                                @bind-Value="@filter.LastLogin"
                                Placeholder="@Properties.Resources.FilterByLastLogin">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="AccessFailed">
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXUserPolicies.Edit"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXUserPolicies.Delete"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Actions" Id="actions" OnClick="@OnActions" Policy="@GXUserPolicies.View"></GXContextMenuItem>
        @*TODO:
            <GXContextMenuItem Text="@Properties.Resources.Agents" Icon="oi oi-wifi" OnClick="async () => OnAgents()"></GXContextMenuItem>
            *@
    </MenuContent>
    <HeaderContent>
        <GXTh Id="GivenName" Name="GivenName" Target="@user">@Properties.Resources.GivenName</GXTh>
        <GXTh Id="Surname" Name="Surname" Target="@user">@Properties.Resources.Surname</GXTh>
        <GXTh Id="Email" Name="Email" Target="@user">@Properties.Resources.Email</GXTh>
        <GXTh Id="EmailConfirmed" Name="EmailConfirmed" Target="@user">@Properties.Resources.EmailConfirmed</GXTh>
        <GXTh Id="Roles" Target="@user">@Properties.Resources.Roles</GXTh>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@user" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Updated" Name="Updated" Target="@user">@Properties.Resources.Updated</GXTh>
        <GXTh Id="LastLogin" Name="LastLogin" Target="@user">@Properties.Resources.LastLogin</GXTh>
        <GXTh Id="AccessFailed" Name="AccessFailed" Target="@user">@Properties.Resources.AccessFailed</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="GivenName">@user.GivenName</GXTd>
        <GXTd Id="Surname">@user.Surname</GXTd>
        <GXTd Id="Email" Link="@NavigationManager.GetCurrentPagePath("/User/Edit/" + user.Id)">@user.Email</GXTd>
        <GXTd Id="EmailConfirmed">@user.EmailConfirmed</GXTd>
        <GXTd Id="Roles">@RolesToString(user.Roles)</GXTd>
        <GXTd Id="CreationTime">@user.CreationTime</GXTd>
        <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(user.Updated)</GXTd>
        <GXTd Id="LastLogin">@GetConnectionInformation(user)</GXTd>
        <GXTd Id="AccessFailed">@user.AccessFailedCount</GXTd>
    </ItemContent>
</GXViewTable>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("GivenName") { Position = 0, Description = "GivenName", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Surname") { Position = 1, Description = "Surname", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Email") { Position = 2, Description = "Email", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("EmailConfirmed") { Position = 3, Description = "EmailConfirmed", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Roles") { Position = 4, Description = "Roles", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("CreationTime") { Position = 5, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Updated") { Position = 6, Description = "Updated", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("LastLogin") { Position = 7, Description = "LastLogin", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("AccessFailed") { Position = 8, Description = "AccessFailed", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected user ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXUser? Active { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.UsersTitle;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "user";
        }
    }

    private string? GetConnectionInformation(GXUser user)
    {
        if (user.LastLogin != null)
        {
            return string.Format(Properties.Resources.ConnectionInformationFormat, ResourceStorage.DateTimeOffsetToString(user.LastLogin), user.ConnectionInfo);
        }
        return null;
    }

    /// <summary>
    /// Amount of the users shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Convert role array to string.
    /// </summary>
    /// <param name="roles"></param>
    /// <returns></returns>
    private static string? RolesToString(List<string>? roles)
    {
        if (roles == null)
        {
            return null;
        }
        string str = string.Join(',', roles);
        //Truncate if string is too long...
        if (str.Length > 30)
        {
            str = str.Substring(0, 30) + "...";
        }
        return str;
    }

    private void UpdateRoles(string roles)
    {
        if (filter != null && filter.Roles != null)
        {
            filter.Roles.Clear();
            if (!string.IsNullOrEmpty(roles))
            {
                filter.Roles.AddRange(roles.Split(',', StringSplitOptions.RemoveEmptyEntries));
            }
        }
    }

    /// <summary>
    /// User filter.
    /// </summary>
    private GXUser filter = new GXUser();


    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXUser>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/User/Users.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/User/Users.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXUserPolicies.Add ||
                        it.Type == GXUserPolicies.Edit ||
                        it.Type == GXUserPolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXUser() { Id = Id.Value.ToString() };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXUser>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingUsers);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListUsers req = new ListUsers()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = true
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListUsersResponse>("api/User/List", req, request.CancellationToken);
            return new ItemsProviderResult<GXUser>((ret.Users ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new user.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/Users.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager, "/User/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.OnAdd");
        }
    }

    /// <summary>
    /// Edit user.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/Users.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/User/Edit/" + table.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected user.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table?.SingleOrDefault()?.Select(s => s.UserName).ToArray()
                });
            OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected users.
    /// </summary>
    public void OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                using var progressScope2 = Progress?.ProgressStart(GXProgress.RemovingUsers);
                RemoveUser req = new RemoveUser()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id!).ToArray()
                };
                _ = Http.PostAsJson<RemoveUserResponse>("api/User/Delete", req).ContinueWith(t =>
                {
                    if (t.IsFaulted)
                    {
                        NotificationService?.ReportError(t.Exception);
                    }
                    else
                    {
                        NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.UsersRemoved, string.Empty, Closable: false));
                        _ = Updated();
                    }
                });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }


    /// <summary>
    /// Show user actions.
    /// </summary>
    public void OnActions()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/Users.OnActions");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, $"/userActions");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.OnActions");
        }
    }

    /// <summary>
    /// Show user readers.
    /// </summary>
    public void OnAgents()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/Users.OnAgents");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, $"/agents");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/Users.OnAgents");
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

