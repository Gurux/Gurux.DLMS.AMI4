@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/usererrors"

@inject IServiceProvider Services

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="UserErrors" />

@if (Title)
{
    <PageTitle>@Properties.Resources.UserErrors</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Close" Id="Close" OnClick="@OnClose" Policy="@GXUserErrorPolicies.Close" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="Clear" OnClick="@OnClear" Policy="@GXUserErrorPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="User.UserErrors" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXUserErrorPolicies.View })"
             TItem="GXLog" @ref="table"
             @bind-Active="Active"
             Context="error"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             Filter="@Filter"
             ShowAllUsers="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="UserErrors-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="usererror-id">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByUserName"
                   @onchange="@((ChangeEventArgs __e) => (filter.User ??= new()).UserName = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Message">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByError"
                   @onchange="@((ChangeEventArgs __e) => filter.Message = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Level">
            <GXInputDropdown class="form-select"
                             Id="UserErrors-TraceLevel"
                             RememberValue="true"
                             @bind-Value="TraceLevel"
                             OnSelected="@((TraceLevel e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Closed">
            <input class="form-control" placeholder="@Properties.Resources.FilterByCloseTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Closed = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Close" Id="edit" OnClick="@OnClose"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@error" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="usererror-id" Name="usererror-id" Target="@error">@Properties.Resources.User</GXTh>
        <GXTh Id="Message" Name="Message" Target="@error">@Properties.Resources.Error</GXTh>
        <GXTh Id="Level" Name="Level" Target="@error">@Properties.Resources.Level</GXTh>
        <GXTh Id="Closed" Name="Closed" Target="@error">@Properties.Resources.CloseTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(error.CreationTime)</GXTd>
        <GXTd Id="usererror-id">@(error.User != null ? error.User.UserName : "")</GXTd>
        <GXTd Id="Message">@error.Message</GXTd>
        <GXTd Id="Level">@ClientHelpers.LevelToString(error.Level)</GXTd>
        <GXTd Id="Closed">@ResourceStorage.DateTimeOffsetToString(error.Closed)</GXTd>
    </ItemContent>
</GXViewTable>
<br />



@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new(Properties.Resources.UsererrorId) { Position = 1, Description = "User", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Message") { Position = 2, Description = "Error", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Level") { Position = 3, Description = "Level", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Closed") { Position = 4, Description = "CloseTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected user error ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.UserErrors;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "user-error";
        }
    }

    /// <summary>
    /// Amount of the user errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// User error filter.
    /// </summary>
    private GXLog filter = new GXLog()
    {
        User = new GXUser()
    };


    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXLog? Active { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLog>? table;

    /// <summary>
    /// Trace level.
    /// </summary>
    private TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/User/UserErrors.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserErrors.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingUserErrors);
            NotificationService?.RemoveByKey("Pages/User/UserErrors.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXUserErrorPolicies.Add ||
                       it.Type == GXUserErrorPolicies.Close ||
                       it.Type == GXUserErrorPolicies.Clear)
                    {
                        _ = InvokeAsync(() => GXNotificationRefresh.RefreshAsync(table, items, Updated));
                        break;
                    }
                }
            });
            if (Id is Guid id)
            {
                //Get last selected item.
                Active = new GXLog() { PublicId = id };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserErrors.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingUserErrors);
        try
        {
            if (ShowClosedErrors)
            {
                //Show closed errors.
                filter.Closed = DateTimeOffset.MaxValue;
            }
            else
            {
                //Show active errors.
                filter.Closed = null;
            }

            if (TraceLevel == TraceLevel.Off)
            {
                filter.Level = null;
            }
            else
            {
                filter.Level = (int)TraceLevel;
            }
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=user-error", req, request.CancellationToken);
            if (Id is Guid id)
            {
                Active = ret.Logs?.FirstOrDefault(log => log.PublicId == id);
            }
            return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Show user error details.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/UserErrors.OnShow");
            if (Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/UserError/Edit/" + Active.PublicId);

        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserErrors.OnShow");
        }
    }

    /// <summary>
    /// Close the selected errors.
    /// </summary>
    public async Task OnClose()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmClose, Properties.Resources.AreYouSureYouWantToCloseSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Close,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Message).ToArray()
                });
            await OnCloseConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Close the selected user errors.
    /// </summary>
    public async Task OnCloseConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                CloseLog req = new CloseLog()
                {
                    Ids = table.SingleOrDefault().Select(w => w.PublicId).ToArray()
                };
                await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=user-error", req);
                await Updated();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Clear the user error list.
    /// </summary>
    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/User/UserErrors.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearErrors,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the user error list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingUserError);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=user-error", new ClearLog());
                    Active = null;
                    await Updated();
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
