@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Module
@page "/User/{Id:guid?}"
@page "/User/{Action}/{Id:guid?}"
@page "/Notifications"
@using Gurux.DLMS.AMI.Shared.DTOs.Menu
@using Gurux.DLMS.AMI.Client.Pages.Notification
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="User" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" Active="@_activeTab" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXTabIcon Id="@context.Icon" Color="@context.IconColor" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.UserDetailsTab" Parameters="@TabParameters" ParametersForLink="@GetTabParameters" LinkFilter="@ShowUserTab" />
            }
            <ModuleViews Area="AmiViewArea.User" Target="@Active" Parameters="@TabParameters" />
                <ModuleViews Area="AmiViewArea.UserSettings" Target="@Active" Parameters="@TabParameters" />
            </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
<ModuleViews Area="AmiViewArea.User" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
<ModuleViews Area="AmiViewArea.UserSettings" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
@code {
    public List<GXRole> RoleCatalog { get; } = new();
    public GXPermission[] PermissionCatalog { get; private set; } = Array.Empty<GXPermission>();
    private async Task InitializeUserCatalogs()
    {
            PermissionCatalog = await Http.GetAsJsonAsync<GXPermission[]>("api/Permission") ?? Array.Empty<GXPermission>();
            ListRoles req = new ListRoles();
            var ret = await Http.PostAsJson<ListRolesResponse>("api/Role/List", req);
            RoleCatalog.Clear();
            if (ret?.Roles != null)
            {
                RoleCatalog.AddRange(ret.Roles);
            }
            foreach (var name in Active.Roles ?? new List<string>())
            {
                if (!RoleCatalog.Any(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase)))
                {
                    RoleCatalog.Add(new GXRole { Name = name });
                }
            }
            //Clear role selection before applying the actual assigned roles.
            foreach (var role in RoleCatalog)
            {
                role.Default = false;

            }
            if (Active.Roles == null)
            {
                Active.Roles = new List<string>();
            }
            foreach (var role in GXRole.GetRoles(RoleCatalog, Active.Roles, false, false)) {
                role.Default = true;
            }
    }
    private GXEditorMenu? _editorMenu;
    private GXProfilePictureEdit? _profilePictureEdit;
    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);
    public bool DeleteTarget { get; set; }
    public EditContext FormContext => GXEditContexts.For(Active ?? throw new InvalidOperationException(Properties.Resources.InvalidTarget));
    private void InitializeEditorMenu()
    {
        _profilePictureEdit = new GXProfilePictureEdit(Active.ProfilePicture?.Id, Active.Id);
        _editorMenu ??= new GXEditorMenu(SharedMenuService);
        _editorMenu.Set(Active, _action, OnSave, OnCancel);
    }
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }
    public void Dispose() => _editorMenu?.Dispose();
    private async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingUser);
            NotificationService?.RemoveByKey("Pages/User/UserGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveUserResponse>("api/User/Delete", new RemoveUser()
                {
                    Ids = new string[] { Active.Id ?? throw new InvalidOperationException(Properties.Resources.TheUserIDIsMissing) },
                    Delete = DeleteTarget
                });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/User/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/User/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await (_profilePictureEdit ??= new GXProfilePictureEdit(Active.ProfilePicture?.Id, Active.Id)).SaveAsync(Http,
                    Active.ProfilePicture, image => Active.ProfilePicture = image,
                    async () => { await Http.PostAsJson<AddUserResponse>(address, new AddUser { Users = [Active] }); },
                    error => NotificationService?.ReportError(error, "User.ProfilePicture.Cleanup"));
                FormContext.MarkAsUnmodified();
                if (_action == CrudAction.Update && Active.Language != _originalLanguage)
                {
                    var authentication = Services.GetService<AuthenticationStateProvider>();
                    if (authentication != null &&
                        ClientHelpers.GetUserId((await authentication.GetAuthenticationStateAsync()).User, false) == Active.Id)
                    {
                        await Services.GetRequiredService<GXResourceStorage>().UpdateLocalizationAsync();
                    }
                }
            }
            FormContext.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserGeneral.OnSave");
        }
    }

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private bool _ready;
    private string? _originalLanguage;
    private string? _activeTab;

    protected override void OnParametersSet()
    {
        _activeTab = string.Equals(NavigationManager.GetCurrentPagePath(), "Notifications", StringComparison.OrdinalIgnoreCase)
            ? "Notifications" : null;
    }
    /// <summary>
    /// Action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Target ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>
    /// Page title.
    /// </summary>
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXUser Active = new GXUser(null);

    private bool _isOwnUser;
    private bool ShowUserTab(GXMenuLink link)
    {
        if (string.Equals(link.Url, "ProfilePicture", StringComparison.OrdinalIgnoreCase) ||
            link.TargetType?.Split(',')[0] == typeof(ProfilePictureEditor).FullName)
            {
            return _action != CrudAction.Create;
        }
        if (string.Equals(link.Url, "PersonalAccessTokens", StringComparison.OrdinalIgnoreCase) ||
            link.TargetType?.Split(',')[0] == typeof(UserPersonalAccessTokens).FullName)
            {
            return _action == CrudAction.Update && _isOwnUser;
        }
        return _isOwnUser || !IsNotificationsTab(link);
    }
    private static bool IsNotificationsTab(GXMenuLink link) =>
        string.Equals(link.Url, "Notifications", StringComparison.OrdinalIgnoreCase) ||
        link.TargetType?.Split(',')[0] == typeof(Gurux.DLMS.AMI.Client.Pages.Notification.Notifications).FullName;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action,
        ["User"] = Active
    };

    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
        => Type.GetType(link.TargetType ?? string.Empty) == typeof(ProfilePictureEditor)
            ? new Dictionary<string, object>
            {
                [nameof(ProfilePictureEditor.Value)] = Active.ProfilePicture!,
                [nameof(ProfilePictureEditor.ValueChanged)] = EventCallback.Factory.Create<GXAppearance?>(this, ProfilePictureChanged),
                [nameof(ProfilePictureEditor.Disabled)] = _action is not (CrudAction.Create or CrudAction.Update),
                [nameof(ProfilePictureEditor.Id)] = "user-profile-picture-editor"
            } : null;

    private void ProfilePictureChanged(GXAppearance? image)
    {
        if (_action is not (CrudAction.Create or CrudAction.Update)) {
            return;
        }
        Active.ProfilePicture = image;
        FormContext.NotifyFieldChanged(new FieldIdentifier(Active, nameof(GXUser.ProfilePicture)));
    }
    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            if (string.Equals(NavigationManager.GetCurrentPagePath(), "Notifications", StringComparison.OrdinalIgnoreCase))
            {
                Action = "Edit";
            }
            switch (_action)
            {
                case CrudAction.Create:
                    Title = Properties.Resources.Add;
                    break;
                case CrudAction.Update:
                    Title = Properties.Resources.Edit;
                    break;
                case CrudAction.Delete:
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.User;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingUser);
            NotificationService?.RemoveByKey("Pages/User/User.OnInitializedAsync");
            if (_action != CrudAction.Create)
            {
                //Get user data.
                var address = Id.HasValue ? $"api/User/{Id}" : "api/User";
                var tmp = await Http.GetAsJsonAsync<GetUserResponse>(address);
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            var authentication = Services.GetService<AuthenticationStateProvider>();
            _isOwnUser = authentication != null &&
                ClientHelpers.GetUserId((await authentication.GetAuthenticationStateAsync()).User, false) == Active.Id;
            _originalLanguage = Active.Language;
            await InitializeUserCatalogs();
            InitializeEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/User.OnInitializedAsync");
        }
    }
}
