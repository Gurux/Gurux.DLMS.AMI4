@using Gurux.DLMS.AMI.Client.Pages.Agent;
@using Gurux.DLMS.AMI.Client.Pages.Block;
@using Gurux.DLMS.AMI.Client.Pages.ComponentView;
@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Client.Pages.DeviceTemplate;
@using Gurux.DLMS.AMI.Client.Pages.Gateway;
@using Gurux.DLMS.AMI.Client.Pages.KeyManagement;
@using Gurux.DLMS.AMI.Client.Pages.Menu
@using Gurux.DLMS.AMI.Client.Pages.Module;
@using Gurux.DLMS.AMI.Client.Pages.Schedule;
@using Gurux.DLMS.AMI.Client.Pages.Script;
@using Gurux.DLMS.AMI.Client.Pages.Trigger;
@using Gurux.DLMS.AMI.Client.Pages.Workflow;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject NavigationManager NavigationManager
@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="UserGroupsSelector" />

<SelectionContainer TItem="GXUserGroup" @ref="@_selectionContainer">
    <SelectionList TItem="GXUserGroup" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXUserGroup" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    [CascadingParameter]
    private User? UserParent { get; set; }
    [CascadingParameter]
    private DeviceGroup? DeviceGroupParent { get; set; }
    [CascadingParameter]
    private AgentGroup? AgentGroupParent { get; set; }
    [CascadingParameter]
    private ModuleGroup? ModuleGroupParent { get; set; }
    [CascadingParameter]
    private WorkflowGroup? WorkflowGroupParent { get; set; }

    [CascadingParameter]
    private TriggerGroup? TriggerGroupParent { get; set; }
    [CascadingParameter]
    private BlockGroup? BlockGroupParent { get; set; }

    [CascadingParameter]
    private ComponentViewGroup? ComponentViewGroupParent { get; set; }
    [CascadingParameter]
    private Gurux.DLMS.AMI.Client.Pages.View.ViewGroup? ViewGroupParent { get; set; }
    [CascadingParameter]
    private ScriptGroup? ScriptGroupParent { get; set; }
    [CascadingParameter]
    private DeviceTemplateGroup? DeviceTemplateParent { get; set; }

    [CascadingParameter]
    private KeyManagementGroup? KeyManagementParent { get; set; }

    [CascadingParameter]
    private ScheduleGroup? ScheduleGroupParent { get; set; }

    [CascadingParameter]
    private GatewayGroup? GatewayGroupParent { get; set; }



    [CascadingParameter]
    private MenuGroup? MenuGroupParent { get; set; }

    SelectionList<GXUserGroup>? _selected;
    SelectionList<GXUserGroup>? _available;
    SelectionContainer<GXUserGroup>? _selectionContainer;

    /// <summary>
    /// User group filter.
    /// </summary>
    private GXUserGroup filter = new GXUserGroup(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(name))
                {
                    name = name.ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.Name != null && !(it.Name ?? string.Empty).ToLower().Contains(name))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/User/UserGroupsSelector.SearchSelectedByName");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.SearchSelectedByName");
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/User/UserGroupsSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.Users = null;
                }
                else
                {
                    GXUser? user = filter.Users?.FirstOrDefault();
                    if (user == null)
                    {
                        user = new();
                        filter.Users = new(new GXUser[] { user });
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/User/UserGroupsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXUserGroup>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return default;
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXUserGroup>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXUserGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingUserGroups);
        try
        {
            ListUserGroups req = new ListUserGroups()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
            };
            var ret = await Http.PostAsJson<ListUserGroupsResponse>("api/UserGroup/List", req, request.CancellationToken);
            if (ret?.UserGroups != null && _selected != null)
            {
                return new ItemsProviderResult<GXUserGroup>(ret.UserGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingUserGroups);
            NotificationService?.RemoveByKey("Pages/User/UserGroupsSelector.OnInitializedAsync");
            if (_selectionContainer == null || _selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            CrudAction action;
            //Get selected user groups.
            if (ScheduleGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = ScheduleGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ScheduleGroupParent.Action);
            }
            else if (DeviceTemplateParent?.Active?.UserGroups != null)
            {
                _selected.Items = DeviceTemplateParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, DeviceTemplateParent.Action);
            }
            else if (DeviceGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = DeviceGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, DeviceGroupParent.Action);
            }
            else if (AgentGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = AgentGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, AgentGroupParent.Action);
            }
            else if (ModuleGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = ModuleGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ModuleGroupParent.Action);
            }
            else if (WorkflowGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = WorkflowGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, WorkflowGroupParent.Action);
            }
            else if (TriggerGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = TriggerGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, TriggerGroupParent.Action);
            }
            else if (BlockGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = BlockGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, BlockGroupParent.Action);
            }
            else if (ComponentViewGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = ComponentViewGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ComponentViewGroupParent.Action);
            }
            else if (ViewGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = ViewGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ViewGroupParent.Action);
            }
            else if (ScriptGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = ScriptGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ScriptGroupParent.Action);
            }
            else if (UserParent?.Active?.UserGroups != null)
            {
                _selected.Items = UserParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, UserParent.Action);
            }
            else if (KeyManagementParent?.Active?.UserGroups != null)
            {
                _selected.Items = KeyManagementParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, KeyManagementParent.Action);
            }
            else if (GatewayGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = GatewayGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, GatewayGroupParent.Action);
            }

            else if (MenuGroupParent?.Active?.UserGroups != null)
            {
                _selected.Items = MenuGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, MenuGroupParent.Action);
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            bool addDefaultGroups = action == CrudAction.Create && !_selected.Items.Any();
            if (addDefaultGroups)
            {
                //Show default groups when new group is added.
                ListUserGroups req = new ListUserGroups()
                {
                    Filter = new GXUserGroup()
                    {
                        Default = true
                    },
                    Count = _selectionContainer.PageSize,
                    Exclude = _selected.Items.Select(s => s.Id).ToArray()
                };
                var ret = await Http.PostAsJson<ListUserGroupsResponse>("api/UserGroup/List", req);
                if (ret?.UserGroups != null)
                {
                    _selected.Items.AddRange(ret.UserGroups);
                }
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.OnInitializedAsync");
        }
    }
}

