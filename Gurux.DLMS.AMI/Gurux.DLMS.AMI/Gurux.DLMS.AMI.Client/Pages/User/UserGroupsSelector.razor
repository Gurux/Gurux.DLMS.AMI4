@using Gurux.DLMS.AMI.Client.Pages.Agent;
@using Gurux.DLMS.AMI.Client.Pages.Block;
@using Gurux.DLMS.AMI.Client.Pages.ComponentView;
@using Gurux.DLMS.AMI.Client.Pages.Device;
@using Gurux.DLMS.AMI.Client.Pages.DeviceTemplate;
@using Gurux.DLMS.AMI.Client.Pages.Gateway;
@using Gurux.DLMS.AMI.Client.Pages.KeyManagement;
@using Gurux.DLMS.AMI.Client.Pages.Menu
@using Gurux.DLMS.AMI.Client.Pages.Module;
@using Gurux.DLMS.AMI.Client.Pages.Schedule;
@using Gurux.DLMS.AMI.Client.Pages.Script;
@using Gurux.DLMS.AMI.Client.Pages.Trigger;
@using Gurux.DLMS.AMI.Client.Pages.Workflow;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject NavigationManager NavigationManager
@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="UserGroupsSelector" />

<GXRelationshipSelector TItem="GXUserGroup" @ref="_selectionContainer"
                        SelectedItems="@(() => _selectedItems)"
                        ItemKey="@(item => item.Id!)" ItemsProvider="GetItems" Disabled="@Disabled">
    <ItemContent>
            @context.Name

    </ItemContent>
    <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />

    </FilterContent>
</GXRelationshipSelector>

@code {
    /// <summary>Gets or sets whether the parent editor prevents changes to this relationship.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>References the live relationship saved by the parent editor.</summary>
    private List<GXUserGroup> _selectedItems = [];

    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>Receives the containing user editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private User? UserParent { get; set; }
    /// <summary>Receives the containing device group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private DeviceGroup? DeviceGroupParent { get; set; }
    /// <summary>Receives the containing agent group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private AgentGroup? AgentGroupParent { get; set; }
    /// <summary>Receives the containing module group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private ModuleGroup? ModuleGroupParent { get; set; }
    /// <summary>Receives the containing workflow group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private WorkflowGroup? WorkflowGroupParent { get; set; }

    /// <summary>Receives the containing trigger group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private TriggerGroup? TriggerGroupParent { get; set; }
    /// <summary>Receives the containing block group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private BlockGroup? BlockGroupParent { get; set; }

    /// <summary>Receives the containing component view group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private ComponentViewGroup? ComponentViewGroupParent { get; set; }
    /// <summary>Receives the containing view group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private Gurux.DLMS.AMI.Client.Pages.View.ViewGroup? ViewGroupParent { get; set; }
    /// <summary>Receives the containing script group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private ScriptGroup? ScriptGroupParent { get; set; }
    /// <summary>Receives the containing device template editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private DeviceTemplateGroup? DeviceTemplateParent { get; set; }

    /// <summary>Receives the containing key management editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private KeyManagementGroup? KeyManagementParent { get; set; }

    /// <summary>Receives the containing schedule group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private ScheduleGroup? ScheduleGroupParent { get; set; }

    /// <summary>Receives the containing gateway group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private GatewayGroup? GatewayGroupParent { get; set; }

    /// <summary>Receives the containing menu group editor whose relationship collection is modified.</summary>
    [CascadingParameter]
    private MenuGroup? MenuGroupParent { get; set; }

    /// <summary>Coordinates paged selection for the edited relationship.</summary>
    private GXRelationshipSelector<GXUserGroup>? _selectionContainer;

    /// <summary>Stores endpoint criteria shared by selected and available user group queries.</summary>
    private GXUserGroup _filter = new GXUserGroup(null);

    /// <summary>Applies the name filter to both selected and available relationship records.</summary>
    /// <param name="name">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_selectionContainer != null)
            {
                _filter.Name = name;
                _notificationService?.RemoveByKey("Pages/User/UserGroupsSelector.SearchByName");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.SearchByName");
        }
    }

    /// <summary>Applies the user filter to both selected and available relationship records.</summary>
    /// <param name="userName">The filter value supplied by the corresponding search control.</param>
    /// <returns>A task completing after the relationship or displayed results have been updated.</returns>
    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_selectionContainer != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    _filter.Users = null;
                }
                else
                {
                    GXUser? user = _filter.Users?.FirstOrDefault();
                    if (user == null)
                    {
                        user = new();
                        _filter.Users = new(new GXUser[] { user });
                    }
                    user.UserName = userName;
                }
                _notificationService?.RemoveByKey("Pages/User/UserGroupsSelector.SearchByUser");
                await _selectionContainer.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.SearchByUser");
        }
    }

    /// <summary>Retrieves a bounded server-filtered relationship page using the supplied inclusion and exclusion identities.</summary>
    /// <param name="request">The bounded page, cancellation token and stable identity restrictions.</param>
    /// <returns>The bounded result page and full matching count.</returns>
    private async ValueTask<ItemsProviderResult<GXUserGroup>> GetItems(GXRelationshipQuery<GXUserGroup> request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingUserGroups);
        try
        {
            ListUserGroups req = new ListUserGroups()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = _filter,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData,
                Included = request.Included?.Select(item => item.Id).ToArray(),
                OrderBy = nameof(GXUserGroup.Id),
                Exclude = request.Excluded.Select(item => item.Id).ToArray()
            };
            var ret = await Http.PostAsJson<ListUserGroupsResponse>("api/UserGroup/List", req, request.CancellationToken);
            if (ret?.UserGroups != null && _selectionContainer != null)
            {
                return new ItemsProviderResult<GXUserGroup>(ret.UserGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex);
            throw;
        }
        return new ItemsProviderResult<GXUserGroup>([], 0);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = _progress?.ProgressStart(GXProgress.RetrievingUserGroups);
            _notificationService?.RemoveByKey("Pages/User/UserGroupsSelector.OnInitializedAsync");
            if (_selectionContainer == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            CrudAction action;
            //Get selected user groups.
            if (ScheduleGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = ScheduleGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ScheduleGroupParent.Action);
            }
            else if (DeviceTemplateParent?.Active?.UserGroups != null)
            {
                _selectedItems = DeviceTemplateParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, DeviceTemplateParent.Action);
            }
            else if (DeviceGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = DeviceGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, DeviceGroupParent.Action);
            }
            else if (AgentGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = AgentGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, AgentGroupParent.Action);
            }
            else if (ModuleGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = ModuleGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ModuleGroupParent.Action);
            }
            else if (WorkflowGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = WorkflowGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, WorkflowGroupParent.Action);
            }
            else if (TriggerGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = TriggerGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, TriggerGroupParent.Action);
            }
            else if (BlockGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = BlockGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, BlockGroupParent.Action);
            }
            else if (ComponentViewGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = ComponentViewGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ComponentViewGroupParent.Action);
            }
            else if (ViewGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = ViewGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ViewGroupParent.Action);
            }
            else if (ScriptGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = ScriptGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, ScriptGroupParent.Action);
            }
            else if (UserParent?.Active?.UserGroups != null)
            {
                _selectedItems = UserParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, UserParent.Action);
            }
            else if (KeyManagementParent?.Active?.UserGroups != null)
            {
                _selectedItems = KeyManagementParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, KeyManagementParent.Action);
            }
            else if (GatewayGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = GatewayGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, GatewayGroupParent.Action);
            }

            else if (MenuGroupParent?.Active?.UserGroups != null)
            {
                _selectedItems = MenuGroupParent.Active.UserGroups;
                action = ClientHelpers.GetAction(NavigationManager, MenuGroupParent.Action);
            }
            else
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            bool addDefaultGroups = action == CrudAction.Create && !_selectedItems.Any();
            if (addDefaultGroups)
            {
                //Show default groups when new group is added.
                ListUserGroups req = new ListUserGroups()
                {
                    Filter = new GXUserGroup()
                    {
                        Default = true
                    },
                    Count = 5,
                    Exclude = _selectedItems.Select(s => s.Id).ToArray()
                };
                var ret = await Http.PostAsJson<ListUserGroupsResponse>("api/UserGroup/List", req);
                if (ret?.UserGroups != null)
                {
                    _selectedItems.AddRange(ret.UserGroups);
                }
            }
            //Read available items.
            if (_selectionContainer != null)
            {
                await _selectionContainer.InitializeAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/User/UserGroupsSelector.OnInitializedAsync");
        }
    }
}

