@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/useractions"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Enums

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Helpers

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXAmiComponent
<GXHelpContext Topic="UserActions" />

@if (Title)
{
    <PageTitle>@Properties.Resources.Actions</PageTitle>
}

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="clear" OnClick="@OnClear" Policy="@GXUserActionPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="User.UserActions" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXUserActionPolicies.View })"
             TItem="GXLog" @ref="table"
             @bind-Active="Active"
             Context="action"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.None"
             ShowRemoved="false"
             Filter="@Filter"
             ShowAllUsers="@Header"
             Columns="@Columns"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="UserActions-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="User">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByUserName"
                   @onchange="@((ChangeEventArgs __e) => filter.User!.UserName = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Target">
            @*Target*@
        </GXFh>
        <GXFh Id="Action">
            <EnumTypeSelector Type="@TargetType.UserAction"
                              @bind-Value="@Action"
                              OnSelected="@((int e) => Updated())">
            </EnumTypeSelector>
        </GXFh>
        <GXFh Id="Status">
            @*Status*@
        </GXFh>
        <GXFh Id="Duration">
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@action" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="User" Target="@action">@Properties.Resources.User</GXTh>
        <GXTh Id="Target" Name="Target" Target="@action">@Properties.Resources.Target</GXTh>
        <GXTh Id="Action" Name="Action" Target="@action">@Properties.Resources.Action</GXTh>
        <GXTh Id="Status" Name="Status" Target="@action">@Properties.Resources.Status</GXTh>
        <GXTh Id="Duration" Name="Duration" Target="@action">@Properties.Resources.Duration (ms)</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(action.CreationTime)</GXTd>
        <GXTd Id="User">@action.User?.UserName</GXTd>
        <GXTd Id="Target">@action.TargetType</GXTd>
        <GXTd Id="Action">@(ResourceStorage.GetEnumType(TargetType.UserAction, (int)action.Action))</GXTd>
        <GXTd Id="Status">@action.Status</GXTd>
        <GXTd Id="Duration">@action.Duration</GXTd>
    </ItemContent>
</GXViewTable>
<br />


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("User") { Position = 1, Description = "User", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Target") { Position = 2, Description = "Target", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Action") { Position = 3, Description = "Action", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Status") { Position = 4, Description = "Status", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Duration") { Position = 5, Description = "Duration", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected user action ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXLog? Active { get; set; }

    private int Action
    {
        get
        {
            return (int)filter.Action;
        }
        set
        {
            filter.Action = (CrudAction)value;
        }
    }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.UserActions;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "user-action";
        }
    }

    /// <summary>
    /// Amount of the user actions shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// User action log filter.
    /// </summary>
    private GXLog filter = new GXLog()
    {
        User = new GXUser()
        {
            EmailConfirmed = null,
            PhoneNumberConfirmed = null,
            TwoFactorEnabled = null,
            LockoutEnabled = null
        }
    };


    public string? SelectedUser { get; private set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLog>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/User/UserActions.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserActions.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingUserActions);
            NotificationService?.RemoveByKey("Pages/User/UserActions.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXUserActionPolicies.Add ||
                        it.Type == GXUserActionPolicies.Clear)
                    {
                        _ = InvokeAsync(() => GXNotificationRefresh.RefreshAsync(table, items, Updated));
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXLog() { PublicId = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserActions.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingUserActions);
        try
        {
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.UserAction);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=user-action", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                if (Id is Guid id)
                {
                    Active = ret.Logs?.FirstOrDefault(log => log.PublicId == id);
                }
                return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Show user action.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/User/UserActions.OnShow");
            if (table?.Active?.Id == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/UserAction/Edit/" + table.Active.PublicId);

        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserActions.OnShow");
        }
    }


    /// <summary>
    /// Clear the user actions.
    /// </summary>
    public async Task OnClear()
    {
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the system error list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingUserAction);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=user-action", new ClearLog());
                    Active = null;
                    await Updated();
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }

    }
}
