@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Accordion
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.Rest

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="UserRoleEditor" />

<GXAccordion Id="content-type-authoring">
    <HeaderTemplate>
        <div>
            <h6><b>@Properties.Resources.Roles</b></h6>
            <label>@_availableRoles</label>
        </div>
    </HeaderTemplate>
    <ChildContent>
        <GXSearch Placeholder="@Properties.Resources.FilterByName"
                Id="Roles.Filter"
                Immediate="true"
                @bind-Value="@Filter"
                @bind-Value:after="Update" />
        <hr />
        <GXViewTable ViewName="User.UserRoleEditor" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXRolePolicies.View })"
         TItem="GXRole" @ref="table"
                 Context="it"
                 ItemsProvider="@GetItems"
                 OnSearch="@Update"
                 ShowAllUsers="false"
                 ShowRemoved="false"
                 ShowAllData="true">
            <MenuContent>
            </MenuContent>
            <HeaderContent>
                <GXTh Id="DefaultRole">
                    @Properties.Resources.DefaultRole
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="roles_all"
                               @onchange="@((ChangeEventArgs __e) => @CheckAll(Convert.ToBoolean(__e.Value)))" />
                        <label>@Properties.Resources.Roles</label>
                    </div>
                </GXTh>
                <GXTh Id="Name">@Properties.Resources.Name</GXTh>
                <GXTh Id="Permissions"><GXLocalizedText Value="@Properties.Resources.Permissions" /></GXTh>
            </HeaderContent>
            <ItemContent>
                <GXTd Id="DefaultRole">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               checked="@it.Default"
                               @onchange="@((e) => it.Default = Convert.ToBoolean(e.Value))" />
                    </div>
                </GXTd>
                <GXTd Id="Name">
                    <GXLocalizedText Value="@ClientHelpers.KebabToTitle(it.Name)" />
                </GXTd>
                <GXTd Id="Permissions">
                    @string.Join(", ", it.Permissions?.Select(p => p.Name) ?? Enumerable.Empty<string?>())
                </GXTd>
            </ItemContent>
        </GXViewTable>
    </ChildContent>
</GXAccordion>

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("DefaultRole") { Position = 0, Description = "DefaultRole", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Permissions") { Position = 2, Description = "Permissions", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }
    }

    private IGXNotifier2? Notifier;

    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Filter.
    /// </summary>
    public string? Filter { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXRole>? table;
    private string? _availableRoles;

    [Parameter]
    public List<GXRole>? Roles { get; set; }

    private GXRole? _active = null;
    //If role is not active it can't be the default role.
    private string? IsDefault(GXRole selected)
    {
        return selected.Default.HasValue && selected.Default.Value ? null : "disabled";
    }

    private string GetSelectedClass(GXRole selected)
    {
        return _active != null && selected.Id == _active.Id ? "table-info" : "table-striped";
    }

    private void RowSelected(GXRole selected)
    {
        _active = selected;
    }

    /// <summary>
    /// Set or unset all roles to default.
    /// </summary>
    /// <param name="check"></param>
    private void CheckAll(bool check)
    {
        if (Roles != null)
        {
            foreach (var it in Roles)
            {
                if (it.Name != GXRoles.Admin)
                {
                    it.Default = check;
                }
            }
        }
    }

    /// <summary>
    /// Check the permission.
    /// </summary>
    /// <param name="permission"></param>
    private ValueTask<ItemsProviderResult<GXRole>> GetItems(GXItemsProviderRequest request)
    {
        List<GXRole>? list;
        if (string.IsNullOrEmpty(Filter))
        {
            list = Roles;
        }
        else
        {
            list = Roles?.Where(w => w.Name?.ToLower().Contains(Filter.ToLower()) == true).ToList();
        }
        if (list != null)
        {
            _availableRoles = string.Join(",", list.Where(w => w.Default == true).Select(s => s.Name).ToArray());
            //Update availableRoles.
            StateHasChanged();
            return new(new ItemsProviderResult<GXRole>(list, list.Count));
        }
        return default;
    }

    /// <summary>
    /// Update virtualized items.
    /// </summary>
    public async Task Update()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/User/UserRoleEditor.Update");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/User/UserRoleEditor.Update");
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}
