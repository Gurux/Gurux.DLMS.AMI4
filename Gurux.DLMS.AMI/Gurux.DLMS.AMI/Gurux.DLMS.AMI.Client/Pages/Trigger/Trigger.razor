@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.DTOs.Trigger
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Trigger" />

<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.TriggerDetailsTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>

@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active!,
        ["Action"] = action
    };

    private GXEditorMenu? _editorMenu;

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private GXTrigger? Active;

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction action;
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingTrigger);
            NotificationService?.RemoveByKey("Pages/Trigger/Trigger.OnInitializedAsync");
            if (Active == null && Id != null)
            {
                //Get trigger data.
                var tmp = (await Http.GetAsJsonAsync<GetTriggerResponse>("api/Trigger?id=" + Id));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            if (Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            action = ClientHelpers.GetAction(NavigationManager, Action);
            _editorMenu ??= new GXEditorMenu(SharedMenuService);
            _editorMenu.Set(Active, action, OnSave, OnCancel);
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Trigger/Trigger.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }

    private async Task OnSave()
    {
        try
        {
            if (Active == null || action != CrudAction.Update)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope = Progress?.ProgressStart(GXProgress.SavingTrigger);
            NotificationService?.RemoveByKey("Pages/Trigger/Trigger.OnSave");
            await Http.PostAsJson<UpdateTriggerResponse>("api/Trigger/Update", new UpdateTrigger
            {
                Triggers = [Active]
            });
            GXEditContexts.For(Active).MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Trigger/Trigger.OnSave");
        }
    }

    public void Dispose()
    {
        _editorMenu?.Dispose();
    }
}
