@page "/ScheduleLogs"

@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics
@using Gurux.DLMS.AMI.Shared.DTOs.View

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation

@implements IDisposable

<GXHelpContext Topic="ScheduleLogs" />

<PageTitle>@Properties.Resources.ScheduleLogs</PageTitle>

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose" Policy="@GXScheduleLogPolicies.Close" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="clear" OnClick="@OnClear" Policy="@GXScheduleLogPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

@if (_viewDefaultsLoaded)
{
    <GXTable TItem="GXLog" @ref="table"
             Id="schedule-logs"
             Context="error"
             @bind-Active="Active"
             ItemsProvider="@GetItems"
             SelectionMode="@DefaultSelectionMode"
             AllowColumnCustomization="@GXViewSettings.CanCustomizeColumns(_viewDefaults, _isAdmin)"
             ShowAllData="@(_viewDefaults?.ShowAllData ?? false)"
             PageSize="@(_viewDefaults?.PageSize ?? 10)"
             DefaultColumns="@_viewColumns"
             DefaultColumnOrder="@_viewColumnOrder"
             DefaultColumnVisibility="@_viewColumnVisibility"
             OnColumnEditorReset="editor => GXViewColumnEditor.ResetAsync(editor, ScheduleLogColumns)"
             ShowRemoved="false"
             Filter="@Filter"
             ShowAllUsers="@Header"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
        <ColumnEditorContent Context="editor">
            <GXViewColumnEditor Editor="editor" ViewName="@GXViews.ScheduleLog" Title="@Properties.Resources.ScheduleLogs"
                                DefaultColumns="ScheduleLogColumns" View="_viewDefaults" Policies="ScheduleLogViewPolicies"
                                ViewChanged="ApplyViewDefaults" />
        </ColumnEditorContent>
        <FilterContent>
            <GXFh Id="CreationTime" Visibility="Visibility.Medium">
                <GXDateTimeSelector Id="ScheduleLogs-CreationTime"
                                    @bind-Value="@filter.CreationTime"
                                    Placeholder="@Properties.Resources.FilterByCreationTime">
                </GXDateTimeSelector>
            </GXFh>
            <GXFh Id="Type" Visibility="Visibility.Medium">
                <EnumTypeSelector Type="@TargetType.ScheduleLog"
                                  @bind-Value="@filter.Type"
                                  OnSelected="@((int? e) => Updated())">
                </EnumTypeSelector>
            </GXFh>
            <GXFh Id="Creator">
                <GXDropdownSearch TValue="GXSchedule"
                                Id="ScheduleLogs-Creator"
                                Placeholder="@Properties.Resources.FilterByName"
                                RememberValue="false"
                                ShowItemsWhenEmpty="true"
                                Items="@_creatorSchedules"
                                Formatter="@(schedule => schedule?.Name ?? schedule?.Id.ToString())"
                                @bind-Value="_creator"
                                OnSelected="@CreatorSelectedAsync" />
            </GXFh>
            <GXFh Id="Message">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByMessage"
                       @onchange="@((ChangeEventArgs __e) => filter.Message = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="Level">
                <GXInputDropdown class="form-select"
                                 Id="ScheduleLogs-TraceLevel"
                                 RememberValue="true"
                                 @bind-Value="TraceLevel"
                                 OnSelected="@((TraceLevel e) => Updated())">
                </GXInputDropdown>
            </GXFh>
            <GXFh Id="Closed">
                <input class="form-control" placeholder="@Properties.Resources.FilterByCloseTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Closed = @StatusTile.ToDateTime(__e.Value))" />
            </GXFh>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow" Policy="@GXScheduleLogPolicies.View"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose" Policy="@GXScheduleLogPolicies.Close"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="CreationTime" Target="@error" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
            <GXTh Name="Type" Target="@error">@Properties.Resources.Type</GXTh>
            <GXTh Id="Creator" Target="@error">@Properties.Resources.Schedule</GXTh>
            <GXTh Name="Message" Target="@error">@Properties.Resources.Message</GXTh>
            <GXTh Name="Level" Target="@error">@Properties.Resources.Level</GXTh>
            <GXTh Name="Closed" Target="@error">@Properties.Resources.CloseTime</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="CreationTime" Link="@NavigationManager.GetCurrentPagePath("/ScheduleLog/Edit/" + error.PublicId)">@ResourceStorage.DateTimeOffsetToString(error.CreationTime)</GXTd>
            <GXTd Id="Type">@(ResourceStorage.GetEnumType(TargetType.ScheduleLog, error.Type))</GXTd>
            <GXTd Id="Creator"><LogCreatorLabel Creator="@error.Creator" Resource="Schedule" Property="Name" /></GXTd>
            <GXTd Id="Message">@error.Message</GXTd>
            <GXTd Id="Level">@ClientHelpers.LevelToString(error.Level)</GXTd>
            <GXTd Id="Closed">@ResourceStorage.DateTimeOffsetToString(error.Closed)</GXTd>
        </ItemContent>
    </GXTable>
}
<br />




@code {
    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected schedule group ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ScheduleLogs;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "schedule-log";
        }
    }

    /// <summary>
    /// Amount of the schedule errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Schedule error filter.
    /// </summary>
    private GXLog filter = new GXLog();
    private GXSchedule? _creator;
    private IEnumerable<GXSchedule> _creatorSchedules = [];

    private async Task CreatorSelectedAsync(GXSchedule? schedule)
    {
        _creator = schedule;
        filter.Creator = schedule?.Id;
        await Updated();
    }

    private async Task LoadCreatorSchedulesAsync()
    {
        try
        {
            using var progress = Progress?.ProgressStart(GXProgress.RetrievingSchedules);
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleLogs.LoadCreatorSchedules");
            var response = await Http.PostAsJson<ListSchedulesResponse>("api/Schedule/List", new ListSchedules
            {
                Count = 0,
                AllUsers = true,
                OrderBy = nameof(GXSchedule.Name)
            });
            _creatorSchedules = response.Schedules?.ToArray() ?? [];
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.LoadCreatorSchedules");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var generation = _viewChangeGeneration;
            var view = await GXViewSettings.ReadAsync(Http, GXViews.ScheduleLog, _viewStorage);
            if (!_disposed && generation == _viewChangeGeneration)
            {
                ApplyViewDefaults(view);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.LoadViewDefaults");
        }
        finally
        {
            if (!_disposed)
            {
                if (_viewColumnOrder == null)
                {
                    ApplyViewDefaults(null);
                }

                _viewDefaultsLoaded = true;
            }
        }
        if (Filter && !_disposed)
        {
            await LoadCreatorSchedulesAsync();
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = AuthenticationState != null && (await AuthenticationState).User.IsInRole(GXRoles.Admin);
    }

    private GXView? _viewDefaults;
    private IAmiViewStorage? _viewStorage;
    private bool _disposed;
    private long _viewChangeGeneration;
    private static readonly List<string> ScheduleLogViewPolicies = [GXScheduleLogPolicies.View];
    private static readonly GXViewColumn[] ScheduleLogColumns =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime" },
        new("Type") { Position = 1, Description = "Type" },
        new("Creator") { Position = 2, Description = "Schedule" },
        new("Message") { Position = 3, Description = "Message" },
        new("Level") { Position = 4, Description = "Level" },
        new("Closed") { Position = 5, Description = "CloseTime" }
    ];
    private bool _viewDefaultsLoaded;
    private string[]? _viewColumns;
    private string[]? _viewColumnOrder;
    private IReadOnlyDictionary<string, Visibility>? _viewColumnVisibility;
    private SelectionMode DefaultSelectionMode => _viewDefaults?.SelectionMode is byte mode && Enum.IsDefined((SelectionMode)mode)
        ? (SelectionMode)mode : SelectionMode.Multiple;

    private async void OnViewChanged(object? sender, GXViewChangedEventArgs args)
    {
        if (_disposed || !string.Equals(args.Name, GXViews.ScheduleLog, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }
                ++_viewChangeGeneration;
                ApplyViewDefaults(args.View);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.ViewChanged");
            }
        }
    }

    private void ApplyViewDefaults(GXView? view)
    {
        _viewDefaults = view?.Enabled == false ? null : view;
        var columns = GXViewColumnDefaults.Merge(ScheduleLogColumns, _viewDefaults?.Columns);
        _viewColumns = columns.Where(column => column.Visible).Select(column => column.Name!).ToArray();
        _viewColumnOrder = columns.Select(column => column.Name!).ToArray();
        _viewColumnVisibility = columns.Where(column => column.Visibility.HasValue && Enum.IsDefined((Visibility)column.Visibility.Value))
            .ToDictionary(column => column.Name!, column => (Visibility)column.Visibility!.Value, StringComparer.Ordinal);
    }

    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXLog? Active { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLog>? table;

    /// <summary>
    /// Trace level.
    /// </summary>
    private TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Schedule/ScheduleLogs.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.Updated");
        }
    }

    protected override void OnInitialized()
    {
        _viewStorage = Services.GetService<IAmiViewStorage>();
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged += OnViewChanged;
        }
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScheduleLogs);
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleLogs.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXScheduleLogPolicies.Add ||
                       it.Type == GXScheduleLogPolicies.Close ||
                       it.Type == GXScheduleLogPolicies.Clear)
                    {
                        _ = InvokeAsync(() => GXNotificationRefresh.RefreshAsync(table, items, Updated));
                        break;
                    }
                }
            });
            if (table != null && Id != null)
            {
                //Get last selected item.
                Active = new GXLog() { PublicId = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingScheduleLogs);
        try
        {
            if (TraceLevel == TraceLevel.Off)
            {
                filter.Level = null;
            }
            else
            {
                filter.Level = (int)TraceLevel;
            }
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.ScheduleLog);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=schedule", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                //Mark schedule logs as seen.
                if (ret.Logs.Any())
                {
                    if (Notifier != null)
                    {
                        await Notifier.Mark(Http, TargetType.ScheduleLog, ret.Logs.Max(s => s.CreationTime));
                    }
                }

                if (Id is Guid id)
                {
                    Active = ret.Logs?.FirstOrDefault(log => log.PublicId == id);
                }

                return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Show schedule log details.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleLogs.OnShow");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/ScheduleLog/Edit/" + table?.Active.PublicId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleLogs.OnShow");
        }
    }

    /// <summary>
    /// Close the selected error.
    /// </summary>
    public async Task OnClose()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmClose, Properties.Resources.AreYouSureYouWantToCloseSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Close,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Message).ToArray()
                });
            await OnCloseConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnCloseConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                CloseLog req = new CloseLog()
                {
                    Ids = table.SingleOrDefault().Select(w => w.PublicId).ToArray()
                };
                await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=schedule", req);
                await Updated();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged -= OnViewChanged;
        }
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Clear the schedule log list.
    /// </summary>
    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Schedule/ScheduleLogs.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the schedule log list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingScheduleLog);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=schedule", new ClearLog());
                    Active = null;
                    await Updated();
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
