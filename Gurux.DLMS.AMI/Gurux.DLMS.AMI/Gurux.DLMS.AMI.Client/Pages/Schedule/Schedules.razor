@page "/schedules"

@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using Gurux.DLMS.AMI.Shared.DTOs.View

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@implements IGXAmiComponent
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation

@if (Title)
{
    <PageTitle>@Properties.Resources.SchedulesTitle</PageTitle>
}

<GXHelpContext Topic="schedules" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Id="Add" Text="@Properties.Resources.Add" OnClick="@OnAdd" Policy="@GXSchedulePolicies.Add" />
        <GXMenuEntry Id="remove" Text="@Properties.Resources.Remove" OnClick="@OnRemove" Policy="@GXSchedulePolicies.Delete" />
    </ChildContent>
</GXMenuControl>

@if (_viewDefaultsLoaded)
{
    <GXTable TItem="GXSchedule" @ref="table"
             Id="schedules"
             @bind-Active="Active"
             Context="schedule"
             ItemsProvider="@GetItems"
             SelectionMode="@DefaultSelectionMode"
             AllowColumnCustomization="@GXViewSettings.CanCustomizeColumns(_viewDefaults, _isAdmin)"
             ShowAllData="@(_viewDefaults?.ShowAllData ?? false)"
             PageSize="@(_viewDefaults?.PageSize ?? 10)"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             DefaultColumns="@_viewColumns"
             DefaultColumnOrder="@_viewColumnOrder"
             DefaultColumnVisibility="@_viewColumnVisibility"
             OnColumnEditorReset="editor => GXViewColumnEditor.ResetAsync(editor, ScheduleColumns)"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
        <ColumnEditorContent Context="editor">
            <GXViewColumnEditor Editor="editor" ViewName="@GXViews.Schedule" Title="@Properties.Resources.SchedulesTitle"
                                DefaultColumns="ScheduleColumns" View="_viewDefaults" Policies="ScheduleViewPolicies"
                                ViewChanged="ApplyViewDefaults" />
        </ColumnEditorContent>
        <FilterContent>
            <GXFh Id="Name">
                <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                       @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="Start">
                <input class="form-control" placeholder="@Properties.Resources.FilterByStartTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Start = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="CreationTime" Visibility="Visibility.Medium">
                <GXDateTimeSelector Id="Schedules-CreationTime"
                                    @bind-Value="@filter.CreationTime"
                                    Placeholder="@Properties.Resources.FilterByCreationTime">
                </GXDateTimeSelector>
            </GXFh>
            <GXFh Id="Updated">
                <input class="form-control" placeholder="@Properties.Resources.FilterByUpdateTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Updated = "".Equals(__e.Value) ? DateTime.MinValue : Convert.ToDateTime(__e.Value))" />
            </GXFh>
            <GXFh Id="ExecutionTime">
                <input class="form-control" placeholder="@Properties.Resources.FilterByExecutionTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.ExecutionTime = "".Equals(__e.Value) ? DateTime.MinValue : Convert.ToDateTime(__e.Value))" />
            </GXFh>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Run" Id="Run" OnClick="async () => OnRun()" Policy="@GXSchedulePolicies.Edit"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXSchedulePolicies.Edit"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXSchedulePolicies.Delete"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Clone" Id="Clone" OnClick="@OnClone" Policy="@GXSchedulePolicies.Edit"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="Name" Target="@schedule">@Properties.Resources.Name</GXTh>
            <GXTh Name="Start" Target="@schedule">@Properties.Resources.StartTime</GXTh>
            <GXTh Name="CreationTime" Target="@schedule" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
            <GXTh Name="Updated" Target="@schedule">@Properties.Resources.Updated</GXTh>
            <GXTh Name="ExecutionTime" Target="@schedule">@Properties.Resources.LastExecutionTime</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Schedule/Edit/" + schedule.Id)">
                <span class=@(ClientHelpers.GetActiveDot(schedule.Enabled))></span>@schedule.Name
            </GXTd>
            <GXTd Id="Start">@schedule.Start</GXTd>
            <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(schedule.CreationTime)</GXTd>
            <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(schedule.Updated)</GXTd>
            <GXTd Id="ExecutionTime">@ResourceStorage.DateTimeOffsetToString(schedule.ExecutionTime)</GXTd>
        </ItemContent>
    </GXTable>
}
<br />


@code {
    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected schedule ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private GXSchedule? Active { get; set; }
    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.SchedulesTitle;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "schedule";
        }
    }

    /// <summary>
    /// Amount of the schedules shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Schedule filter.
    /// </summary>
    private GXSchedule filter = new GXSchedule();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXSchedule>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Schedule/Schedules.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.Updated");
        }
    }

    protected override void OnInitialized()
    {
        _viewStorage = Services.GetService<IAmiViewStorage>();
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged += OnViewChanged;
        }
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingSchedules);
            NotificationService?.RemoveByKey("Pages/Schedule/Schedules.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), async (schedules) =>
            {
                foreach (var it in schedules)
                {
                    if (it.Type == GXSchedulePolicies.Add ||
                        it.Type == GXSchedulePolicies.Edit ||
                        it.Type == GXSchedulePolicies.Delete)
                    {
                        await GXNotificationRefresh.RefreshAsync(table, schedules, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXSchedule() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.OnInitialized");
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = AuthenticationState != null && (await AuthenticationState).User.IsInRole(GXRoles.Admin);
    }

    private GXView? _viewDefaults;
    private IAmiViewStorage? _viewStorage;
    private bool _disposed;
    private long _viewChangeGeneration;
    private static readonly List<string> ScheduleViewPolicies = [GXSchedulePolicies.View];
    private static readonly GXViewColumn[] ScheduleColumns =
    [
        new("Name") { Position = 0, Description = "Name" },
        new("Start") { Position = 1, Description = "StartTime" },
        new("CreationTime") { Position = 2, Description = "CreationTime" },
        new("Updated") { Position = 3, Description = "Updated" },
        new("ExecutionTime") { Position = 4, Description = "LastExecutionTime" }
    ];
    private bool _viewDefaultsLoaded;
    private string[]? _viewColumns;
    private string[]? _viewColumnOrder;
    private IReadOnlyDictionary<string, Visibility>? _viewColumnVisibility;
    private SelectionMode DefaultSelectionMode => _viewDefaults?.SelectionMode is byte mode && Enum.IsDefined((SelectionMode)mode)
        ? (SelectionMode)mode : SelectionMode.Multiple;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var generation = _viewChangeGeneration;
            var view = await GXViewSettings.ReadAsync(Http, GXViews.Schedule, _viewStorage);
            if (!_disposed && generation == _viewChangeGeneration)
            {
                ApplyViewDefaults(view);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.LoadViewDefaults");
        }
        finally
        {
            if (!_disposed)
            {
                if (_viewColumnOrder == null)
                {
                    ApplyViewDefaults(null);
                }

                _viewDefaultsLoaded = true;
            }
        }
    }

    private async void OnViewChanged(object? sender, GXViewChangedEventArgs args)
    {
        if (_disposed || !string.Equals(args.Name, GXViews.Schedule, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }
                ++_viewChangeGeneration;
                ApplyViewDefaults(args.View);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.ViewChanged");
            }
        }
    }

    private void ApplyViewDefaults(GXView? view)
    {
        _viewDefaults = view?.Enabled == false ? null : view;
        var columns = GXViewColumnDefaults.Merge(ScheduleColumns, _viewDefaults?.Columns);
        _viewColumns = columns.Where(column => column.Visible).Select(column => column.Name!).ToArray();
        _viewColumnOrder = columns.Select(column => column.Name!).ToArray();
        _viewColumnVisibility = columns.Where(column => column.Visibility.HasValue && Enum.IsDefined((Visibility)column.Visibility.Value))
            .ToDictionary(column => column.Name!, column => (Visibility)column.Visibility!.Value, StringComparer.Ordinal);
    }

    private async ValueTask<ItemsProviderResult<GXSchedule>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingSchedules);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListSchedules req = new ListSchedules()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            ListSchedulesResponse ret = await Http.PostAsJson<ListSchedulesResponse>("api/Schedule/List", req, request.CancellationToken);
            if (ret.Schedules != null)
            {
                //Convert start time from invariant culture to UI culture.
                foreach (var it in ret.Schedules)
                {
                    it.Start = new GXDateTime(it.Start, CultureInfo.InvariantCulture).ToFormatString();
                }

                //Mark schedules as seen.
                if (Notifier != null)
                {
                    await Notifier.Mark(Http, TargetType.Schedule, ret.Schedules.Max(s => s.CreationTime));
                }

                return new ItemsProviderResult<GXSchedule>(ret.Schedules, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Run selected schedule.
    /// </summary>
    public async void OnRun()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/Schedules.OnRun");
            using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingSchedule);
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            HttpResponseMessage response = await Http.GetAsync(string.Format("api/Schedule/Run?id={0}", table.Active.Id));
            await response.EnsureSuccessAsync(default);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.OnRun");
        }
    }

    /// <summary>
    /// Add new schedule.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            ClientHelpers.NavigateTo(NavigationManager, "/Schedule/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit schedule.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/Schedules.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Schedule/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.OnEdit");
        }
    }

    /// <summary>
    /// Clone schedule.
    /// </summary>
    public void OnClone()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/Schedules.OnClone");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/Schedule/Clone/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/Schedules.OnClone");
        }
    }


    /// <summary>
    /// Remove selected schedule.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected schedules.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveSchedule req = new RemoveSchedule()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveScheduleResponse>("api/Schedule/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged -= OnViewChanged;
        }
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
