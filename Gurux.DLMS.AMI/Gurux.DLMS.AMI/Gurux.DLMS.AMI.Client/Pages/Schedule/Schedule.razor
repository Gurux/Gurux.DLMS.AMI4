@page "/Schedule/{Id:guid?}"
@page "/Schedule/{Action}/{Id:guid?}"

@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Client.Pages.Device
@using Gurux.DLMS.AMI.Shared.DTOs.Menu
@using Gurux.DLMS.AMI.Client.Pages.DeviceTemplate
@using Gurux.DLMS.AMI.Client.Pages.Module
@using Gurux.DLMS.AMI.Client.Pages.Objects
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs
@using System.Globalization;

@inject NavigationManager NavigationManager
@inject IGXProgress Progress
@inject IGXNotificationService NotificationService
@inject HttpClient Http
@inject IServiceProvider Services

<GXHelpContext Topic="Schedule" />

@if (_modulesSelector?.Active != null)
{
    <ScheduleEdit @ref="_scheduleEdit"
                  Module="@_modulesSelector.Active"
                  Schedule="@Active" Closed="@CloseModuleAsync"></ScheduleEdit>
}
else
{
    <CascadingValue Value="this">
        <GXTabControl PersistSelectionInUrl="true" Active="@_activeTab" NavigateOnSelection="false">
            <TabTextTemplate>
                <GXTabIcon Id="@context.Icon" Color="@context.IconColor" />
                @context.Text
            </TabTextTemplate>
            <ChildContent>
                @if (_ready)
                {
                    <TabHeader Name="@GXMenus.ScheduleDetailsTab" Parameters="@TabParameters" ParametersForLink="@GetTabParameters">
                        <ContentForLink Context="link">
                            @if (Type.GetType(link.TargetType ?? string.Empty) == typeof(ModulesSelector))
                            {
                                <ModulesSelector ModuleGroup="@null" @ref="_modulesSelector" />
                            }
                            else if (!string.IsNullOrEmpty(link.TargetType))
                            {
                                var componentType = Type.GetType(link.TargetType);
                                <DynamicComponent Type="@componentType" Parameters="@GXTabParameters.Filter(componentType!, TabParameters, GetTabParameters(link))" />
                            }
                        </ContentForLink>
                    </TabHeader>
                }
                <ModuleViews Area="AmiViewArea.Schedule" Target="@Active" Parameters="@TabParameters" />
            </ChildContent>
        </GXTabControl>
    </CascadingValue>
}
<ModuleViews Area="AmiViewArea.Schedule" Display="AmiViewDisplay.Append" Target="@Active" Parameters="@TabParameters" />
@implements IDisposable
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action == CrudAction.Clone ? CrudAction.Create : _action,
        ["AcceptChanges"] = (Func<bool, Task<bool>>)AcceptChanges
    };

    private IDictionary<string, object>? GetTabParameters(GXMenuLink link)
    {
        var type = Type.GetType(link.TargetType ?? string.Empty);
        if (type == typeof(DeviceSelector))
        {
            return new Dictionary<string, object>
            {
                ["Devices"] = Active.Devices!,
                ["ObjectTemplates"] = Active.DeviceObjectTemplates!,
                ["AttributeTemplates"] = Active.DeviceAttributeTemplates!
            };
        }
        if (type == typeof(DeviceGroupSelector))
        {
            return new Dictionary<string, object>
            {
                ["DeviceGroups"] = Active.DeviceGroups!,
                ["ObjectTemplates"] = Active.DeviceGroupObjectTemplates!,
                ["AttributeTemplates"] = Active.DeviceGroupAttributeTemplates!
            };
        }
        return type == typeof(ModulesSelector)
            ? new Dictionary<string, object> { ["ModuleGroup"] = null! } : null;
    }

    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action;

    private string? _activeTab;

    [Parameter]
    public Guid? Id { get; set; }

    ModulesSelector? _modulesSelector;
    ScheduleEdit? _scheduleEdit;
    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXSchedule Active = new GXSchedule(null)
    {
        Start = new Gurux.Scheduling.GXDateTime(@"*/*/* *:00:00", CultureInfo.InvariantCulture).ToFormatString(CultureInfo.CurrentUICulture)
    };

    /// <summary>
    /// Close module edit if user is editing
    /// the schedule module.
    /// </summary>
    /// <returns>True, if user is edit the module settings.</returns>
    internal async Task<bool> AcceptChanges(bool cancel)
    {
        if (_modulesSelector != null &&
            _modulesSelector.Active != null)
        {
            if (!cancel && _scheduleEdit != null)
            {
                await _scheduleEdit.SaveAsync();
            }
            _activeTab = "Modules";
            _modulesSelector.Active = null;
            await InvokeAsync(StateHasChanged);
            return true;
        }
        return false;
    }

    private async Task CloseModuleAsync()
    {
        await AcceptChanges(true);
    }

    /// <summary>
    /// ModulesSelector asks schedule to update the UI.
    /// </summary>
    internal void Update()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _action = ClientHelpers.GetAction(NavigationManager, Action);
            switch (_action)
            {
                case CrudAction.Create:
                case CrudAction.Clone:
                    Title = Properties.Resources.Add;
                    Action = "Add";
                    break;
                case CrudAction.Update:
                    Title = Properties.Resources.Edit;
                    break;
                case CrudAction.Delete:
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.Schedule;
            using var progressScope1 = Progress.ProgressStart(GXProgress.RetrievingSchedule);
            NotificationService.RemoveByKey("Pages/Schedule/ScheduleTab.OnInitializedAsync");
            if (_action != CrudAction.Create)
            {
                //Get schedule data.
                var tmp = (await Http.GetAsJsonAsync<GetScheduleResponse>(string.Format("api/Schedule?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                    //Convert start time from invariant culture to UI culture.
                    Active.Start = new GXDateTime(Active.Start, CultureInfo.InvariantCulture).ToFormatString();
                    if (_action == CrudAction.Clone)
                    {
                        Active.Id = Guid.Empty;
                        Active.Name += "-" + Properties.Resources.Clone;
                        Active.Updated = null;
                        Active.CreationTime = null;
                        Active.Creator = null;
                    }
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            _editorMenu = new GXEditorMenu(Services.GetRequiredService<IGXMenuService>());
            _editorMenu.Set(Active, EditorAction, SaveEditorAsync, CancelEditorAsync);
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Pages/Schedule/ScheduleTab.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    internal bool DeleteTarget;
    private CrudAction EditorAction => _action == CrudAction.Clone ? CrudAction.Create : _action;
    private async Task SaveEditorAsync()
    {
        if (!await AcceptChanges(false))
        {
            try
            {

                if (Active == null)
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }

                if (EditorAction != CrudAction.Delete && !ValidateEditor()) {
                    return;
                }
                using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingSchedule);
                NotificationService?.RemoveByKey("Pages/Schedule/Schedule.OnSave");
                if (EditorAction == CrudAction.Delete)
                {
                    await Http.PostAsJson<RemoveScheduleResponse>("api/Schedule/Delete",
                        new RemoveSchedule()
                        {
                            Ids = new Guid[] { Active.Id },
                            Delete = DeleteTarget
                        }
                        );
                }
                else
                {
                    string address;
                    if (EditorAction == CrudAction.Create)
                    {
                        address = "api/Schedule/Add";
                    }
                    else if (EditorAction == CrudAction.Update)
                    {
                        address = "api/Schedule/Update";
                    }
                    else
                    {
                        throw new Exception(Properties.Resources.InvalidTarget);
                    }
                    string? dt = Active.Start;
                    try
                    {
                        //Convert start time from UI culture to invariant culture.
                        Active.Start = new GXDateTime(Active.Start).ToFormatString(CultureInfo.InvariantCulture);
                        await Http.PostAsJson<UpdateScheduleResponse>(address, new UpdateSchedule()
                        {
                            Schedules = new List<GXSchedule>() { Active }
                        });
                    }
                    finally
                    {
                        Active.Start = dt;
                    }
                }
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex, "Pages/Schedule/Schedule.OnSave");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }
    private bool ValidateEditor()
    {
        string? error = null;
        if (string.IsNullOrWhiteSpace(Active.Name)) {
            error = Properties.Resources.InvalidName;
        }
        else
        {
            try { _ = new GXDateTime(Active.Start); }
            catch { error = Properties.Resources.InvalidStartTime; }
        }
        if (error == null) {
            return true;
        }
        _editorMenu?.AddValidationError(string.IsNullOrWhiteSpace(Active.Name) ? nameof(Active.Name) : nameof(Active.Start), error);
        NotificationService?.ReportError(new ArgumentException(error));
        return false;
    }
    private async Task CancelEditorAsync()
    {
        if (!await AcceptChanges(true)) {
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
    }
    public void Dispose() => _editorMenu?.Dispose();
}
