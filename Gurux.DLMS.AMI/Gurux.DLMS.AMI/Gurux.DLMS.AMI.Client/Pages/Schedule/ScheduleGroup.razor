@page "/ScheduleGroup/{Id:guid?}"
@page "/ScheduleGroup/{Action}/{Id:guid?}"

@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Schedule
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="ScheduleGroup" />
<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.ScheduleGroupTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@implements IDisposable
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXScheduleGroup Active = new GXScheduleGroup(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.ScheduleGroup;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScheduleGroup);
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get schedule group data.
                var tmp = (await Http.GetAsJsonAsync<GetScheduleGroupResponse>(string.Format("api/ScheduleGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            _editorMenu = new GXEditorMenu(Services.GetRequiredService<IGXMenuService>());
            _editorMenu.Set(Active, EditorAction, SaveEditorAsync, CancelEditorAsync);
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroup.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    internal bool DeleteTarget;
    private CrudAction EditorAction => _action == CrudAction.Clone ? CrudAction.Create : _action;
    private async Task SaveEditorAsync()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingScheduleGroup);
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroup.OnSave");
            if (EditorAction == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveScheduleGroupResponse>("api/ScheduleGroup/Delete", new RemoveScheduleGroup()
                    {
                        Ids = new Guid[] { Active.Id },
                        Delete = DeleteTarget
                    });
            }
            else
            {
                string address;
                if (EditorAction == CrudAction.Create)
                {
                    address = "api/ScheduleGroup/Add";
                }
                else if (EditorAction == CrudAction.Update)
                {
                    address = "api/ScheduleGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddScheduleGroupResponse>(address, new AddScheduleGroup() { ScheduleGroups = new GXScheduleGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroup.OnSave");
        }
    }
    private Task CancelEditorAsync() { ClientHelpers.NavigateToLastPage(NavigationManager); return Task.CompletedTask; }

    public void Dispose() => _editorMenu?.Dispose();
}


