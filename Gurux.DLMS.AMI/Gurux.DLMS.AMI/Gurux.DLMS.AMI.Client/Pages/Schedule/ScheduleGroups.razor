@page "/schedulegroups"

@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.DTOs.Schedule
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared.DTOs.View

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
<GXHelpContext Topic="ScheduleGroups" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" Policy="@GXScheduleGroupPolicies.Add" />
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXScheduleGroupPolicies.Delete" />
    </ChildContent>
</GXMenuControl>

@if (_viewDefaultsLoaded)
{
    <GXTable TItem="GXScheduleGroup" @ref="table"
             Id="schedule-groups"
             Context="group"
             ItemsProvider="@GetItems"
             SelectionMode="@DefaultSelectionMode"
             AllowColumnCustomization="@GXViewSettings.CanCustomizeColumns(_viewDefaults, _isAdmin)"
             ShowAllData="@(_viewDefaults?.ShowAllData ?? false)"
             PageSize="@(_viewDefaults?.PageSize ?? 10)"
             Filter="@Filter"
             ShowAllUsers="@Header"
             ShowRemoved="@Header"
             Columns="@Columns"
             DefaultColumns="@_viewColumns"
             DefaultColumnOrder="@_viewColumnOrder"
             DefaultColumnVisibility="@_viewColumnVisibility"
             OnColumnEditorReset="editor => GXViewColumnEditor.ResetAsync(editor, ScheduleGroupColumns)"
             CanEdit="@CanEdit"
             OnSearch="@Updated">
        <ColumnEditorContent Context="editor">
            <GXViewColumnEditor Editor="editor" ViewName="@GXViews.ScheduleGroup" Title="@Properties.Resources.ScheduleGroups"
                                DefaultColumns="ScheduleGroupColumns" View="_viewDefaults" Policies="ScheduleGroupViewPolicies"
                                ViewChanged="ApplyViewDefaults" />
        </ColumnEditorContent>
        <FilterContent>
            <GXFh Id="Name">
                <input class="form-control" placeholder="@Properties.Resources.FilterByName"
                       @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value))" />
            </GXFh>
            <GXFh Id="CreationTime" Visibility="Visibility.Medium">
                <GXDateTimeSelector Id="ScheduleGroups-CreationTime"
                                    @bind-Value="@filter.CreationTime"
                                    Placeholder="@Properties.Resources.FilterByCreationTime">
                </GXDateTimeSelector>
            </GXFh>
            <GXFh Id="Updated">
                <input class="form-control" placeholder="@Properties.Resources.FilterByUpdateTime"
                       type="datetime-local"
                       @onchange="@((ChangeEventArgs __e) => filter.Updated = @StatusTile.ToDateTime(__e.Value))" />
            </GXFh>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXScheduleGroupPolicies.Edit"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXScheduleGroupPolicies.Delete"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="Name" Target="@group">@Properties.Resources.Name</GXTh>
            <GXTh Name="CreationTime" Target="@group" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
            <GXTh Name="Updated" Target="@group">@Properties.Resources.Updated</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/ScheduleGroup/Edit/" + group.Id)">@group.Name</GXTd>
            <GXTd Id="CreationTime">@ResourceStorage.DateTimeOffsetToString(group.CreationTime)</GXTd>
            <GXTd Id="Updated">@ResourceStorage.DateTimeOffsetToString(group.Updated)</GXTd>
        </ItemContent>
    </GXTable>
}

<br />

@code {
    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected schedule group ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    public GXScheduleGroup? Active { get; set; }


    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.ScheduleGroups;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "schedule-group";
        }
    }

    /// <summary>
    /// Amount of the schedule groups shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Schedule group filter.
    /// </summary>
    private GXScheduleGroup filter = new GXScheduleGroup();

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXScheduleGroup>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroups.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.Updated");
        }
    }

    protected override void OnInitialized()
    {
        _viewStorage = Services.GetService<IAmiViewStorage>();
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged += OnViewChanged;
        }
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingScheduleGroups);
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroups.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), async (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXScheduleGroupPolicies.Add ||
                        it.Type == GXScheduleGroupPolicies.Edit ||
                        it.Type == GXScheduleGroupPolicies.Delete)
                    {
                        await GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXScheduleGroup() { Id = Id.Value };
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.OnInitialized");
        }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = AuthenticationState != null && (await AuthenticationState).User.IsInRole(GXRoles.Admin);
    }

    private GXView? _viewDefaults;
    private IAmiViewStorage? _viewStorage;
    private bool _disposed;
    private long _viewChangeGeneration;
    private static readonly List<string> ScheduleGroupViewPolicies = [GXScheduleGroupPolicies.View];
    private static readonly GXViewColumn[] ScheduleGroupColumns =
    [
        new("Name") { Position = 0, Description = "Name" },
        new("CreationTime") { Position = 1, Description = "CreationTime" },
        new("Updated") { Position = 2, Description = "Updated" }
    ];
    private bool _viewDefaultsLoaded;
    private string[]? _viewColumns;
    private string[]? _viewColumnOrder;
    private IReadOnlyDictionary<string, Visibility>? _viewColumnVisibility;
    private SelectionMode DefaultSelectionMode => _viewDefaults?.SelectionMode is byte mode && Enum.IsDefined((SelectionMode)mode)
        ? (SelectionMode)mode : SelectionMode.Multiple;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var generation = _viewChangeGeneration;
            var view = await GXViewSettings.ReadAsync(Http, GXViews.ScheduleGroup, _viewStorage);
            if (!_disposed && generation == _viewChangeGeneration)
            {
                ApplyViewDefaults(view);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.LoadViewDefaults");
        }
        finally
        {
            if (!_disposed)
            {
                if (_viewColumnOrder == null)
                {
                    ApplyViewDefaults(null);
                }

                _viewDefaultsLoaded = true;
            }
        }
    }

    private async void OnViewChanged(object? sender, GXViewChangedEventArgs args)
    {
        if (_disposed || !string.Equals(args.Name, GXViews.ScheduleGroup, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }
                ++_viewChangeGeneration;
                ApplyViewDefaults(args.View);
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.ViewChanged");
            }
        }
    }

    private void ApplyViewDefaults(GXView? view)
    {
        _viewDefaults = view?.Enabled == false ? null : view;
        var columns = GXViewColumnDefaults.Merge(ScheduleGroupColumns, _viewDefaults?.Columns);
        _viewColumns = columns.Where(column => column.Visible).Select(column => column.Name!).ToArray();
        _viewColumnOrder = columns.Select(column => column.Name!).ToArray();
        _viewColumnVisibility = columns.Where(column => column.Visibility.HasValue && Enum.IsDefined((Visibility)column.Visibility.Value))
            .ToDictionary(column => column.Name!, column => (Visibility)column.Visibility!.Value, StringComparer.Ordinal);
    }

    private async ValueTask<ItemsProviderResult<GXScheduleGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingScheduleGroups);
        try
        {
            if (request.Removed)
            {
                filter.Removed = DateTimeOffset.MaxValue;
            }
            else
            {
                filter.Removed = null;
            }
            ListScheduleGroups req = new ListScheduleGroups()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (Count != 0)
            {
                req.Count = Count;
            }
            var ret = await Http.PostAsJson<ListScheduleGroupsResponse>("api/ScheduleGroup/List", req, request.CancellationToken);
            if (ret?.ScheduleGroups != null)
            {
                return new ItemsProviderResult<GXScheduleGroup>(ret.ScheduleGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Add new schedule group.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroups.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager, "/ScheduleGroup/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.OnAdd");
        }
    }

    /// <summary>
    /// Edit schedule group.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Schedule/ScheduleGroups.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/ScheduleGroup/Edit/" + table?.Active.Id);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Schedule/ScheduleGroups.OnEdit");
        }
    }


    /// <summary>
    /// Remove selected schedule group.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Remove,
                    AllowDelete = true,
                    Items = table.SingleOrDefault().Select(s => s.Name).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Delete the selected agent groups.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                RemoveScheduleGroup req = new RemoveScheduleGroup()
                {
                    Delete = args.Delete,
                    Ids = table.SingleOrDefault().Select(w => w.Id).ToArray()
                };
                await Http.PostAsJson<RemoveScheduleGroupResponse>("api/ScheduleGroup/Delete", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_viewStorage != null)
        {
            _viewStorage.ViewChanged -= OnViewChanged;
        }
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}

