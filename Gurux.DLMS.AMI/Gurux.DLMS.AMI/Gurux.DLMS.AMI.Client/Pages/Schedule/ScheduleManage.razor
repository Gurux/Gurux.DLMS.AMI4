@page "/Schedule"
@page "/Schedule/Groups"
@page "/Schedule/Logs"
@page "/ScheduleGroup"
@page "/ScheduleLog/{Id:guid?}"
@page "/ScheduleLog/{Action}/{Id:guid?}"

@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable

@*If user adds a new item or modifies the existing one.*@
<GXHelpContext Topic="ScheduleManage" />

@if (string.Compare(Action, "Add", true) == 0 || (Id != null && Path != null && string.Compare(Action, "Edit", true) == 0))
{
    @if (string.Compare(Path, "ScheduleGroup", true) == 0)
    {
        <ScheduleGroup Action="@Action" Id="@Id"></ScheduleGroup>
    }
    else if (string.Compare(Path, "Schedule", true) == 0)
    {
        <Schedule Action="@Action" Id="@Id"></Schedule>
    }
    else if (string.Compare(Path, "ScheduleLog", true) == 0)
    {
        <ScheduleLog Id="@Id"></ScheduleLog>
    }
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="Schedule" Active="@Path" SelectionChanged="@SelectionChanged" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            <GXLocalizedText Value="@context.Text" />
            <GXBadge Value="@context.PadgeCount" Label="@context.Padge"
                   TraceLevel="@context.PadgeType">
            </GXBadge>
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.ScheduleTab"></TabHeader>
        </ChildContent>
    </GXTabControl>
}
<br />
@code {
    private IGXNotifier2? Notifier;

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }
    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    private string? Path { get; set; }

    /// <summary>
    /// Stamp.
    /// </summary>
    private GXUserStamp _log = new GXUserStamp();

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(GXTabPage page)
    {
        Path = page.Path;
        if (!string.IsNullOrEmpty(page.Path))
        {
            NavigationManager.NavigateTo(GXTabRoutes.SelectionUrl(NavigationManager, "Schedule", 0, page.Path));
        }
    }

    protected override void OnParametersSet()
    {
        var path = NavigationManager.GetCurrentPagePath().Trim('/');
        Path = path.ToLowerInvariant() switch
        {
            "schedule/groups" => "ScheduleGroup",
            "schedule/logs" => "ScheduleLog",
            _ => path.Split('/')[0].ToLowerInvariant() switch
            {
                "schedulegroup" => "ScheduleGroup",
                "schedulelog" => "ScheduleLog",
                _ => "Schedule"
            }
        };
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        if (Notifier == null)
        {
            return;
        }

        _log = Notifier?.GetUserStamps(TargetType.ScheduleLog) ?? new GXUserStamp { TargetType = TargetType.ScheduleLog };
        Notifier?.On<IEnumerable<GXUserStamp>>(this, nameof(IGXHubEvents.StampUpdate), (stamps) =>
        {
            bool updated = false;
            foreach (var it in stamps)
            {
                if (it.TargetType == TargetType.ScheduleLog)
                {
                    updated = true;
                }
            }
            if (updated)
            {
                InvokeAsync(StateHasChanged);
            }
        });
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}



