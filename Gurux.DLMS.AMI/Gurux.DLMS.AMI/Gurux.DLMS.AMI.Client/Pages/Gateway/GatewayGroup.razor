@page "/GatewayGroup/{Id:guid?}"
@page "/GatewayGroup/{Action}/{Id:guid?}"

@using Gurux.DLMS.AMI.Client.Pages.User
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.Rest;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.DTOs;

@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="GatewayGroup" />

<h1>
    @Title
</h1>
<CascadingValue Value="this">
    <GXTabControl PersistSelectionInUrl="true" NavigateOnSelection="false">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            @context.Text
        </TabTextTemplate>
        <ChildContent>
            @if (_ready)
            {
                <TabHeader Name="@GXMenus.GatewayGroupTab" Parameters="@TabParameters" />
            }
        </ChildContent>
    </GXTabControl>
</CascadingValue>
<br />
@code {
    private bool _ready;

    private IDictionary<string, object> TabParameters => new Dictionary<string, object>
    {
        ["Active"] = Active,
        ["Action"] = _action
    };

    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public string? Action { get; set; }

    private CrudAction _action => ClientHelpers.GetAction(NavigationManager, Action, CrudAction.None);

    /// <summary>
    /// Active page.
    /// </summary>
    [Parameter]
    public string? Page { get; set; }

    [Parameter]
    public Guid? Id { get; set; }

    private string? Title;

    /// <summary>
    /// Active item.
    /// </summary>
    public GXGatewayGroup Active = new GXGatewayGroup(null);

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        try
        {
            switch (Action)
            {
                case "Add":
                    Title = Properties.Resources.Add;
                    break;
                case "Edit":
                    Title = Properties.Resources.Edit;
                    break;
                case "Remove":
                    Title = Properties.Resources.Remove;
                    break;
                default:
                    ClientHelpers.NavigateToLastPage(NavigationManager);
                    return;
            }
            Title += " " + Properties.Resources.GatewayGroup;
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingGatewayGroup);
            NotificationService?.RemoveByKey("Pages/Gateway/GatewayGroup.OnInitializedAsync");
            if (string.Compare(Action, "Add", true) != 0)
            {
                //Get gateway group data.
                var tmp = (await Http.GetAsJsonAsync<GetGatewayGroupResponse>(string.Format("api/GatewayGroup?id={0}", Id)));
                if (tmp?.Item != null)
                {
                    Active = tmp.Item;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    NavigationManager.NavigateTo("404");
                    return;
                }
            }
            SetEditorMenu();
            _ready = true;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayGroup.OnInitializedAsync");
        }
    }

    private GXEditorMenu? _editorMenu;
    public bool DeleteTarget { get; set; }
    private void SetEditorMenu() { _editorMenu = new GXEditorMenu(SharedMenuService); _editorMenu.Set(Active, _action, OnSave, () => { OnCancel(); return Task.CompletedTask; }); }
    public void Dispose() => _editorMenu?.Dispose();
    public async Task OnSave()
    {
        try
        {
            if (Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            if (_action != CrudAction.Delete && !GXEditContexts.For(Active).Validate()) {
                return;
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingGatewayGroup);
            NotificationService?.RemoveByKey("Pages/Gateway/GatewayGroupGeneral.OnSave");
            if (_action == CrudAction.Delete)
            {
                await Http.PostAsJson<RemoveGatewayGroupResponse>("api/GatewayGroup/Delete", new RemoveGatewayGroup()
                    {
                        Ids = new Guid[] { Active.Id },
                        Delete = DeleteTarget
                    });
            }
            else
            {
                string address;
                if (_action == CrudAction.Create)
                {
                    address = "api/GatewayGroup/Add";
                }
                else if (_action == CrudAction.Update)
                {
                    address = "api/GatewayGroup/Update";
                }
                else
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
                await Http.PostAsJson<AddGatewayGroupResponse>(address, new AddGatewayGroup() { GatewayGroups = new GXGatewayGroup[] { Active } });
            }
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayGroupGeneral.OnSave");
        }
    }
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }
}


