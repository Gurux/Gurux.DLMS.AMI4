@using Gurux.DLMS.AMI.Client.Pages.User;
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="GatewayGroupsSelector" />

<SelectionContainer TItem="GXGatewayGroup" @ref="@_selectionContainer">
    <SelectionList TItem="GXGatewayGroup" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXGatewayGroup" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Action.
    /// </summary>
    [Parameter, EditorRequired]
    public CrudAction Action { get; set; }

    [CascadingParameter]
    private UserGroup? UserGroupParent { get; set; }

    [CascadingParameter]
    private Gateway? GatewayParent { get; set; }

    /// <summary>
    /// Selected gateway groups.
    /// </summary>
    [Parameter]
    public List<GXGatewayGroup>? GatewayGroups { get; set; }

    SelectionList<GXGatewayGroup>? _selected;
    SelectionList<GXGatewayGroup>? _available;
    SelectionContainer<GXGatewayGroup>? _selectionContainer;

    /// <summary>
    /// Gateway group filter.
    /// </summary>
    private GXGatewayGroup filter = new GXGatewayGroup(null);

    /// <summary>
    /// Selected gateway group filter.
    /// </summary>
    private GXGatewayGroup selectedFilter = new GXGatewayGroup(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected != null)
            {
                selectedFilter.Name = name;
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Gateway/GatewayGroupsSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayGroupsSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.UserGroups = null;
                }
                else
                {
                    GXUser user;
                    GXUserGroup? ug = filter.UserGroups?.FirstOrDefault();
                    if (ug == null)
                    {
                        user = new GXUser();
                        ug = new GXUserGroup();
                        filter.UserGroups = new(new GXUserGroup[] { ug });
                        ug.Users = new(new GXUser[] { user });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(filter.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Gateway/GatewayGroupsSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayGroupsSelector.SearchByUser");
        }
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXGatewayGroup>> GetSelectedItems(GXItemsProviderRequest request)
    {
        var groups = GetGroups();
        if (groups == null)
        {
            return new(new ItemsProviderResult<GXGatewayGroup>(new GXGatewayGroup[0], 0));
        }
        int total = groups.Count;
        if (!string.IsNullOrEmpty(selectedFilter.Name))
        {
            groups = groups.Where(w => (w.Name ?? string.Empty).ToLower().Contains((selectedFilter.Name ?? string.Empty).ToLower())).ToList();
        }
        return new(new ItemsProviderResult<GXGatewayGroup>(
            groups.Skip(request.StartIndex).Take(request.Count), 
            total));
    }

    private async ValueTask<ItemsProviderResult<GXGatewayGroup>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingGatewayGroups);
        try
        {
            ListGatewayGroups req = new ListGatewayGroups()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = (GetGroups() ?? []).Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListGatewayGroupsResponse>("api/GatewayGroup/List", req, request.CancellationToken);
            if (ret?.GatewayGroups != null && _selected != null)
            {
                return new ItemsProviderResult<GXGatewayGroup>(ret.GatewayGroups, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    List<GXGatewayGroup>? GetGroups()
    {
        if (GatewayGroups != null)
        {
            return GatewayGroups;
        }
        if (UserGroupParent?.Active != null)
        {
            return UserGroupParent.Active.GatewayGroups;
        }
        return GatewayParent?.Active.GatewayGroups;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            if (_selectionContainer == null || _selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingGatewayGroups);
            NotificationService?.RemoveByKey("Pages/Gateway/GatewayGroupsSelector.OnInitializedAsync");
            //Add selected gateways.
            _selected.Items = GetGroups() ?? [];
            bool addDefaultGroups = Action == CrudAction.Create && !_selected.Items.Any();
            if (addDefaultGroups)
            {
                //Show default groups when new group is added.
                ListGatewayGroups req = new ListGatewayGroups()
                    {
                        Filter = new GXGatewayGroup()
                        {
                            Default = true
                        },
                        Count = _selectionContainer.PageSize,
                        Exclude = (_selected.Items ?? []).Select(s => s.Id).ToArray()
                    };
                var ret = await Http.PostAsJson<ListGatewayGroupsResponse>("api/GatewayGroup/List", req);
                if (ret?.GatewayGroups != null)
                {
                    (_selected.Items ??= []).AddRange(ret.GatewayGroups);
                }
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayGroupsSelector.OnInitializedAsync");
        }
    }
}

