@using Gurux.DLMS.AMI.Shared.DTOs.View
@page "/GatewayLogs"

@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Diagnostics

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="GatewayLogs" />

<PageTitle>@Properties.Resources.GatewayLogs</PageTitle>

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose" Policy="@GXGatewayLogPolicies.Close" />
        <GXMenuEntry Text="@Properties.Resources.Clear" Id="clear" OnClick="@OnClear" Policy="@GXGatewayLogPolicies.Clear" />
    </ChildContent>
</GXMenuControl>

<GXViewTable ViewName="Gateway.GatewayLogs" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXGatewayLogPolicies.View })"
             TItem="GXLog" @ref="table"
             Context="error"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Multiple"
             ShowRemoved="false"
             Filter="@Filter"
             ShowAllUsers="@Header"
             CanEdit="@CanEdit"
             Columns="@Columns"
             OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="GatewayLogs-CreationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Type" Visibility="Visibility.Medium">
            <EnumTypeSelector Type="@TargetType.GatewayLog"
                              @bind-Value="@filter.Type"
                              OnSelected="@((int? e) => Updated())">
            </EnumTypeSelector>
        </GXFh>
        <GXFh Id="Gateway">
            <GXInputText class="form-control" @bind-Value="CreatorFilter" Placeholder="@Properties.Resources.GatewayID" />
        </GXFh>
        <GXFh Id="Message">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByMessage"
                   @onchange="@((ChangeEventArgs __e) => filter.Message = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="Level">
            <GXInputDropdown class="form-select"
                             Id="GatewayLogs-TraceLevel"
                             RememberValue="true"
                             @bind-Value="TraceLevel"
                             OnSelected="@((TraceLevel e) => Updated())">
            </GXInputDropdown>
        </GXFh>
        <GXFh Id="Closed">
            <input class="form-control" placeholder="@Properties.Resources.FilterByCloseTime"
                   type="datetime-local"
                   @onchange="@((ChangeEventArgs __e) => filter.Closed = @StatusTile.ToDateTime(__e.Value))" />
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Show" Id="show" OnClick="@OnShow" Policy="@GXGatewayLogPolicies.View"></GXContextMenuItem>
        <GXContextMenuItem Text="@Properties.Resources.Close" Id="close" OnClick="@OnClose" Policy="@GXGatewayLogPolicies.Close"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="CreationTime" Name="CreationTime" Target="@error" SortMode="SortMode.Descending">@Properties.Resources.CreationTime</GXTh>
        <GXTh Id="Type" Name="Type" Target="@error">@Properties.Resources.Type</GXTh>
        <GXTh Id="Gateway" Name="Type" Target="@error">@Properties.Resources.Gateway</GXTh>
        <GXTh Id="Message" Name="Message" Target="@error">@Properties.Resources.Message</GXTh>
        <GXTh Id="Level" Name="Level" Target="@error">@Properties.Resources.Level</GXTh>
        <GXTh Id="Closed" Name="Closed" Target="@error">@Properties.Resources.CloseTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="CreationTime" Link="@NavigationManager.GetCurrentPagePath("/GatewayLog/Edit/" + error.PublicId)">@ResourceStorage.DateTimeOffsetToString(error.CreationTime)</GXTd>
        <GXTd Id="Type">@(ResourceStorage.GetEnumType(TargetType.GatewayLog, error.Type))</GXTd>
        <GXTd Id="Gateway"><LogCreatorLabel Creator="@error.Creator" Resource="Gateway" Property="Name" /></GXTd>
        <GXTd Id="Message">@error.Message</GXTd>
        <GXTd Id="Level">@ClientHelpers.LevelToString(error.Level)</GXTd>
        <GXTd Id="Closed">@ResourceStorage.DateTimeOffsetToString(error.Closed)</GXTd>
    </ItemContent>
</GXViewTable>
<br />




@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("CreationTime") { Position = 0, Description = "CreationTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Type") { Position = 1, Description = "Type", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Gateway") { Position = 2, Description = "Gateway", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Message") { Position = 3, Description = "Message", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Level") { Position = 4, Description = "Level", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
        new("Closed") { Position = 5, Description = "CloseTime", Visibility = (byte)Gurux.UI.Components.Enums.Visibility.All },
    ];

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Selected gateway group ID.
    /// </summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.GatewayLogs;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "gateway-log";
        }
    }

    /// <summary>
    /// Amount of the gateway errors shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Gateway error filter.
    /// </summary>
    private GXLog filter = new GXLog();
    private string? CreatorFilter
    {
        get => filter.Creator?.ToString();
        set => filter.Creator = Guid.TryParse(value, out var id) ? id : null;
    }

    /// <summary>
    /// Closed errors are shown.
    /// </summary>
    public bool ShowClosedErrors { get; set; }

    /// <summary>
    /// Active item.
    /// </summary>
    public GXLog? Active
    {
        get
        {
            return table?.Active;
        }
    }

    /// <summary>
    /// Trace level.
    /// </summary>
    private TraceLevel TraceLevel { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXViewTable<GXLog>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Gateway/GatewayLogs.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayLogs.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingGatewayLogs);
            NotificationService?.RemoveByKey("Pages/Gateway/GatewayLogs.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXGatewayLogPolicies.Add ||
                         it.Type == GXGatewayLogPolicies.Clear ||
                         it.Type == GXGatewayLogPolicies.Close)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (table != null && Id != null)
            {
                //Get last selected item.
                table.RestoreSelection(new GXLog() { PublicId = Id.Value });
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayLogs.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLog>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingGatewayLogs);
        try
        {
            ListLogs req = new ListLogs()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };
            if (TraceLevel == TraceLevel.Off)
            {
                filter.Level = null;
            }
            else
            {
                filter.Level = (int)TraceLevel;
            }
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.GatewayLog);
            var ret = await Http.PostAsJson<ListLogsResponse>("api/Log/List?source=gateway", req, request.CancellationToken);
            if (ret.Logs != null)
            {
                //Mark gateway logs as seen.
                if (ret.Logs.Any())
                {
                    if (Notifier != null)
                    {
                        await Notifier.Mark(Http, TargetType.GatewayLog, ret.Logs.Max(s => s.CreationTime));
                    }
                }
            }
            if (Id.HasValue && table != null)
            {
                table.RestoreSelection(ret.Logs?.FirstOrDefault(log => log.PublicId == Id.Value));
            }
            return new ItemsProviderResult<GXLog>((ret.Logs ?? []), ClientHelpers.ToVirtualizedCount(ret.Count));
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Show gateway log details.
    /// </summary>
    public void OnShow()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Gateway/GatewayLogs.OnShow");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, "/GatewayLog/Edit/" + table?.Active.PublicId);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewayLogs.OnShow");
        }
    }

    /// <summary>
    /// Close the selected error.
    /// </summary>
    public async Task OnClose()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmClose, Properties.Resources.AreYouSureYouWantToCloseSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = Properties.Resources.Close,
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => s.Message).ToArray()
                });
            await OnCloseConfirmation(confirmation);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Close the selected logs.
    /// </summary>
    public async Task OnCloseConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (table != null && args.Confirm)
            {
                CloseLog req = new CloseLog()
                {
                    Ids = table.SingleOrDefault().Select(w => w.PublicId).ToArray()
                };
                await Http.PostAsJson<CloseLogResponse>("api/Log/Close?source=gateway", req);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }

    /// <summary>
    /// Clear the gateway log list.
    /// </summary>
    public async Task OnClear()
    {
        NotificationService?.RemoveByKey("Pages/Gateway/GatewayLogs.OnClear");
        var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDataClear, Properties.Resources.AreYouSureYouWantToClearLog,
            new AmiConfirmationOptions
            {
                ConfirmText = Properties.Resources.Clear,
                AllowDelete = false
            });
        await OnClearConfirmation(confirmation);
    }

    /// <summary>
    /// Clear the gateway log list.
    /// </summary>
    public async Task OnClearConfirmation(AmiConfirmationResult args)
    {
        try
        {
            if (args.Confirm)
            {
                using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingGatewayLog);
                try
                {
                    await Http.PostAsJson<ClearLogResponse>("api/Log/Clear?source=gateway", new ClearLog());
                }
                finally
                {
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }
}
