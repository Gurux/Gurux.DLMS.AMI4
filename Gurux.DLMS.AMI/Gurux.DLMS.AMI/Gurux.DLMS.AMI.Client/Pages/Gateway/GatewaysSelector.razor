@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Linq

@inject IServiceProvider Services
@inject HttpClient Http
<GXHelpContext Topic="GatewaysSelector" />

<SelectionContainer TItem="GXGateway" @ref="@_selectionContainer">
    <SelectionList TItem="GXGateway" Title="@Properties.Resources.Selected" @ref="_selected"
                   ShowAllUsers="false"
                   ItemsProvider="@GetSelectedItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchSelectedByName" />
        </FilterContent>
    </SelectionList>
    <SelectionList TItem="GXGateway" Title="@Properties.Resources.UpdatesAvailable" @ref="_available"
                   ItemsProvider="@GetItems">
        <DataContent>
            @context.Name
        </DataContent>
        <FilterContent>
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    ValueChanged="@SearchByName" />
            <GXSearch Placeholder="@Properties.Resources.FilterByUser"
                    ValueChanged="@SearchByUser" />
        </FilterContent>
    </SelectionList>
</SelectionContainer>

@code {
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter, EditorRequired]
    public GXGatewayGroup? Active { get; set; }

    /// <summary>
    /// Selected gateways.
    /// </summary>
    [Parameter]
    public List<GXGateway>? Gateways { get; set; }

    SelectionList<GXGateway>? _selected;
    SelectionList<GXGateway>? _available;
    SelectionContainer<GXGateway>? _selectionContainer;
    /// <summary>
    /// Gateway filter.
    /// </summary>
    private GXGateway filter = new GXGateway(null);

    protected async Task SearchSelectedByName(string? name)
    {
        try
        {
            if (_selected?.Items != null)
            {
                _selected.HiddenItems.Clear();
                if (!string.IsNullOrEmpty(name))
                {
                    name = name.ToLower();
                    foreach (var it in _selected.Items)
                    {
                        if (it.Name != null && !(it.Name ?? string.Empty).ToLower().Contains(name))
                        {
                            _selected.HiddenItems.Add(it);
                        }
                    }
                }
                NotificationService?.RemoveByKey("Pages/Gateway/GatewaysSelector.SearchSelectedByName");
                await _selected.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewaysSelector.SearchSelectedByName");
        }
    }

    protected async Task SearchByName(string? name)
    {
        try
        {
            if (_available != null)
            {
                filter.Name = name;
                NotificationService?.RemoveByKey("Pages/Gateway/GatewaysSelector.SearchByName");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewaysSelector.SearchByName");
        }
    }

    protected async Task SearchByUser(string? userName)
    {
        try
        {
            if (_available != null)
            {
                if (string.IsNullOrEmpty(userName))
                {
                    filter.GatewayGroups = null;
                }
                else
                {
                    GXUser user;
                    GXGatewayGroup? sg = filter.GatewayGroups?.FirstOrDefault();
                    if (sg == null)
                    {
                        sg = new GXGatewayGroup(null);
                        user = new();
                        GXUserGroup? ug = new GXUserGroup();
                        sg.UserGroups = new List<GXUserGroup>(new GXUserGroup[] { ug });
                        ug.Users = new List<GXUser>(new GXUser[] { user });
                        filter.GatewayGroups = new List<GXGatewayGroup>(new GXGatewayGroup[] { sg });
                    }
                    else
                    {
                        user = GXFilterHelpers.GetOrAddUser(sg.UserGroups ??= []);
                    }
                    user.UserName = userName;
                }
                NotificationService?.RemoveByKey("Pages/Gateway/GatewaysSelector.SearchByUser");
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewaysSelector.SearchByUser");
        }
    }

    private List<GXGateway> GetGateways()
    {
        if (Gateways != null)
        {
            return Gateways;
        }
        return Active is { } parent ? parent.Gateways ??= [] : [];
    }

    /// <summary>
    /// Filter is done when SearchSelectedByName is called.
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    private ValueTask<ItemsProviderResult<GXGateway>> GetSelectedItems(GXItemsProviderRequest request)
    {
        if (_selected?.Items == null)
        {
            return default;
        }
        //ToArray makes a clone from the items. Don't remove it.
        return new(new ItemsProviderResult<GXGateway>(_selected.Items.ToArray(), _selected.Items.Count));
    }

    private async ValueTask<ItemsProviderResult<GXGateway>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingGateways);
        try
        {
            ListGateways req = new ListGateways()
                {
                    Index = request.StartIndex,
                    Count = request.Count,
                    Filter = filter,
                    Descending = request.Descending,
                    AllUsers = request.ShowAllUserData,
                    Exclude = _selected?.Items?.Select(s => s.Id).ToArray()
                };
            var ret = await Http.PostAsJson<ListGatewaysResponse>("api/Gateway/List", req, request.CancellationToken);
            if (ret?.Gateways != null && _selected != null)
            {
                return new ItemsProviderResult<GXGateway>(ret.Gateways, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    protected override async Task OnInitializedAsync()
    {
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();

        //Wait until table is loaded. Don't remove this or selector is null.
        await Task.Delay(1);
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingGateways);
            NotificationService?.RemoveByKey("Pages/Gateway/GatewaysSelector.OnInitializedAsync");
            if (_selected == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (GetGateways() != null)
            {
                _selected.Items = GetGateways();
            }
            else
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            //Read available items.
            if (_available != null)
            {
                await _available.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Gateway/GatewaysSelector.OnInitializedAsync");
        }
    }
}
