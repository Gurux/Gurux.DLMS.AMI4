@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IGXMenuService Menu
@inject AuthenticationStateProvider Authentication
@inject IAuthorizationService Authorization
@implements IDisposable

@code {
    [Parameter] public string? Source { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    private GXPageMenu? _menu;
    private bool _disposed;
    private long _version;

    protected override async Task OnParametersSetAsync()
    {
        var version = ++_version;
        if (_disposed)
        {
            return;
        }
        _menu ??= new GXPageMenu(Menu);
        _menu.Clear();
        if (string.IsNullOrWhiteSpace(Source))
        {
            return;
        }
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var allowed = await Authorization.AuthorizeAsync(user, GXLogPolicies.Clear);
        if (_disposed || version != _version || !allowed.Succeeded)
        {
            return;
        }
        _menu.AddMenuItems(new GXMenuItem(Properties.Resources.Clear, "clear", OnClear));
    }

    public void Dispose()
    {
        _disposed = true;
        ++_version;
        _menu?.Dispose();
    }
}
