@page "/config/changehistory"
@page "/config/history"
@namespace Gurux.DLMS.AMI.Client.Pages
@using Gurux.DLMS.AMI.Shared.DTOs.History
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = GXChangeHistoryPolicies.View)]

<PageTitle>Change history</PageTitle>
<h1>Change history</h1>

@if (!_identityLoaded)
{
    <p role="status">@Properties.Resources.Loading</p>
}
else
{
    @if (_isAdmin)
    {
        <GXMenuControl RightCorner="true">
            <GXMenuEntry Text="@Properties.Resources.ApplyDefaults" Id="Regenerate" OnClick="ApplyDefaultsAsync"
                         ReadOnly="@(_loadingTypes || _applyingDefaults || _saving.Count != 0)" />
        </GXMenuControl>
    }
    <div class="history-content">
        <p>Select the entity types whose changes are recorded.</p>
        @if (_loadingTypes)
        {
            <p role="status">@Properties.Resources.Loading</p>
        }
        else if (_types.Length != 0)
        {
            <div class="table-responsive">
                <table class="table history-configuration">
                    <thead>
                        <tr><th scope="col">@Properties.Resources.Name</th><th scope="col">Record history</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types)
                        {
                            <tr @key="type.Id">
                                <td>@type.Name</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               data-history-type="@type.Id" aria-label="@($"Record history for {type.Name}")"
                                               disabled="@(!_isAdmin || _applyingDefaults || _saving.Contains(type.Id))"
                                               @bind:get="type.RecordHistory" @bind:set="(bool value) => SaveRecordingAsync(type, value)" />
                                    </div>
                                    @if (_saving.Contains(type.Id))
                                    {
                                        <span class="text-muted" role="status">Saving…</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!_isAdmin)
            {
                <p class="text-muted">Only administrators can change history recording settings.</p>
            }
        }
        else if (_typesLoaded)
        {
            <p role="status">No history types are available.</p>
        }
    </div>
}
