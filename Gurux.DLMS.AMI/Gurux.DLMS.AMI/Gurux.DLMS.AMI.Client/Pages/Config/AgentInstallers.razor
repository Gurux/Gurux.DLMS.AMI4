@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Agent
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text.Json;

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable
@implements IGXConfigUpdate

<GXHelpContext Topic="AgentInstallers" />

<GXMenuControl RightCorner="true">
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXAgentPolicies.Delete" />
    </ChildContent>
</GXMenuControl>

@if (_settings != null)
{
    <EditForm EditContext="@GXEditContexts.For(_settings)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@string.Format(Properties.Resources.LastChecked, ClientHelpers.GetLastChecked(_settings.Checked))</label>
                    <button type="button" class="btn btn-link" @onclick="OnCheck">(@Properties.Resources.CheckManually)</button>
                </div>
            </div>
        </div>
    </EditForm>
}

<GXViewTable ViewName="Config.AgentInstallers" ViewColumns="ViewColumnDefaults" TItem="GXAgentVersion" @ref="table"
         Context="version" ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Multiple"
         ShowAllUsers="false"
         OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Version">
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByVersionNumber"
                   @onchange="@((ChangeEventArgs __e) => (filter.Versions ??= [new()])[0].Number = Convert.ToString(__e.Value))" />
        </GXFh>
        <GXFh Id="CreationTime"></GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Id="Version" TItem="GXAgentVersion">@Properties.Resources.Version</GXTh>
        <GXTh Id="CreationTime" TItem="GXAgentVersion">@Properties.Resources.CreationTime</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Version">@version.Number</GXTd>
        <GXTd Id="CreationTime">@version.CreationTime</GXTd>
    </ItemContent>
</GXViewTable>


@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Version") { Position = 0, Description = "Version", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;
    private readonly GXConfigurationRefresh _configurationRefresh = new();


    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            _settings = JsonSerializer.Deserialize<AgentSettings>(Parent.Active.Settings);
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    private string? GetVersion(string? version)
    {
        if (version == null)
        {
            return Properties.Resources.CustomBuild;
        }
        return version;
    }

    private GXAgent filter = new GXAgent(null);
    //Verify that agant can be removed.
    //Verify that agent can be updated.
    //Verify that all agent can be updated.

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXAgentVersion>? table;

    /// <summary>
    /// Agent settings.
    /// </summary>
    private AgentSettings? _settings;

    private GXAgent? _active;
    private bool _removing;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Config/AgentInstallers.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/AgentInstallers.Updated");
        }
    }
    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            if (filter?.Versions == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Agent, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => true, NotificationService));
            });
            filter.Versions.Add(new GXAgentVersion() { Enabled = null });
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), async (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXAgentPolicies.Add ||
                        it.Type == GXAgentPolicies.Edit ||
                        it.Type == GXAgentPolicies.Delete)
                    {
                        await GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                _settings = JsonSerializer.Deserialize<AgentSettings>(Parent.Active.Settings);
            }
            else
            {
                _settings = new AgentSettings();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    private async ValueTask<ItemsProviderResult<GXAgentVersion>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAgentInstallers);
        try
        {
            if (filter.Versions != null && filter.Versions.Any())
            {
                if (request.Removed)
                {
                    filter.Versions[0].Removed = DateTimeOffset.MaxValue;
                }
                else
                {
                    filter.Versions[0].Removed = null;
                }
            }
            ListAgents req = new ListAgents()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
            };
            var ret = await Http.PostAsJson<ListAgentsResponse>("api/Agent/Installers", req, request.CancellationToken);
            if (ret.Agents == null || ret.Agents.Count() != 1)
            {
                _active = null;
                return default;
            }
            _active = ret.Agents.First();
            if (_active.Versions == null)
            {
                _active = null;
                return default;
            }
            return new ItemsProviderResult<GXAgentVersion>(_active.Versions, _active.Versions.Count);
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Delete selected agent.
    /// </summary>
    public async Task OnRemove()
    {
        try
        {
            if (table == null || !table.SingleOrDefault().Any())
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            var confirmation = await Confirmation.ConfirmAsync(Properties.Resources.ConfirmDelete, Properties.Resources.AreYouSureYouWantToDeleteSelectedItems,
                new AmiConfirmationOptions
                {
                    ConfirmText = "Delete",
                    AllowDelete = false,
                    Items = table?.SingleOrDefault()?.Select(s => Properties.Resources.Version + " " + s.Number).ToArray()
                });
            await OnDeleteConfirmation(confirmation);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Remove the agent.
    /// </summary>
    public async Task OnDeleteConfirmation(AmiConfirmationResult args)
    {
        if (_removing)
        {
            return;
        }
        try
        {
            if (args.Confirm && table != null && _active != null && _active.Versions != null)
            {
                var selectedIds = table.SingleOrDefault().Select(version => version.Id).ToHashSet();
                if (selectedIds.Count == 0)
                {
                    return;
                }
                _removing = true;
                // Keep the displayed state intact if saving fails.
                var updated = ClientHelpers.Clone(_active);
                updated.Versions!.RemoveAll(version => selectedIds.Contains(version.Id));
                UpdateAgent req = new UpdateAgent()
                {
                    Agents = new GXAgent[] { updated }
                };
                await Http.PostAsJson<UpdateAgentResponse>("api/Agent/Update", req);
                // Reload the server's new concurrency stamp before another removal.
                await Updated();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        finally
        {
            _removing = false;
        }
    }

    /// <summary>
    /// Check agent versions manually.
    /// </summary>
    public async Task OnCheck()
    {
        using var progressScope2 = Progress?.ProgressStart(GXProgress.CheckingNewVersions);
        NotificationService?.RemoveByKey("Pages/Config/AgentInstallers.OnCheck");
        try
        {
            await Services.GetRequiredService<GXBackgroundTaskNotifications>()
                .CheckAgentsAsync(progressScope2?.CancellationToken ?? CancellationToken.None);
        }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); }
        catch (OperationCanceledException) when (progressScope2?.CancellationToken.IsCancellationRequested == true) { }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/AgentInstallers.OnCheck");
        }
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
