@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
@implements IGXConfigUpdate

<GXHelpContext Topic="Prune" />

@if (_settings != null)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Run" Id="Prune" OnClick="@OnRun" />
        </ChildContent>
    </GXMenuControl>
    <p class="text-muted">@Properties.Resources.PruneRetentionHelp</p>
    <EditForm EditContext="@MenuService.EditContext">
        <PruneGroup Title="@Properties.Resources.System">
            <PruneAction Title="@Properties.Resources.RemoveSystemLogs" Action="@_settings.SystemLog"></PruneAction>
            <PruneAction Title="@Properties.Resources.RemovePerformanceLogs" Action="@_settings.PerformanceLog"></PruneAction>
        </PruneGroup>
        <PruneGroup Title="@Properties.Resources.User">
            <PruneAction Title="@Properties.Resources.RemoveUsersWhoNewerLoggedIn" Action="@_settings.User"></PruneAction>
            <PruneAction Title="@Properties.Resources.RemoveUserLogs" Action="@_settings.UserActions"></PruneAction>
        </PruneGroup>
        <PruneGroup Title="@Properties.Resources.Devices">
            <PruneAction Title="@Properties.Resources.RemoveDeviceLogs" Action="@_settings.DeviceLogs"></PruneAction>
            <PruneAction Title="@Properties.Resources.RemoveAgentLogs" Action="@_settings.AgentLog"></PruneAction>
            <PruneAction Title="@Properties.Resources.RemoveGatewayLogs" Action="@_settings.GatewayLog"></PruneAction>
        </PruneGroup>
        <PruneGroup Title="@Properties.Resources.Tasks">
            <PruneAction Title="@Properties.Resources.RemoveScheduleLogs" Action="@_settings.ScheduleLog"></PruneAction>
            <PruneAction Title="@Properties.Resources.RemoveTasks" Action="@_settings.Task">
                <label for="prune-task-type">@Properties.Resources.TaskStatus</label>
                <GXInputDropdown class="form-select"
                                 Id="prune-task-type"
                                 RememberValue="true"
                                 @bind-Value="_settings.Task.Type">
                </GXInputDropdown>
            </PruneAction>
        </PruneGroup>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            LoadSettings(Parent.Active.Settings);
        }
        InvokeAsync(StateHasChanged);
    }

    PruneSettings? _settings;

    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new PruneSettings()
            : JsonSerializer.Deserialize<PruneSettings>(settings) ?? new PruneSettings();
        MenuService.EditContext = new EditContext(_settings);
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingPrune);
            NotificationService?.RemoveByKey("Pages/Config/Prune.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Prune, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
            });
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSave), EnableStyle.Modified));
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                LoadSettings(Parent.Active.Settings);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Prune.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingPrune);
        NotificationService?.RemoveByKey("Pages/Config/Prune.OnSave");
        try
        {
            if (Parent?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Parent.Active.Settings = JsonSerializer.Serialize(_settings);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson("api/Configuration/Update", arg);
            MenuService.EditContext?.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Prune.OnSave");
        }
    }

    /// <summary>
    /// Run the prune.
    /// </summary>
    public async void OnRun()
    {
        using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingPrune);
        NotificationService?.RemoveByKey("Pages/Config/Prune.OnRun");
        try
        {
            ConfigurationRunPrune req = new ConfigurationRunPrune();
            await Http.PostAsJson<ConfigurationRunPruneResponse>("api/Configuration/Prune", req);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Prune.OnRun");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
