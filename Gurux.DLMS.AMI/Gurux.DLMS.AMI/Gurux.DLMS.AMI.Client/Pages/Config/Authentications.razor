@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.ManufacturerSettings
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text.Json

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@implements IGXConfigUpdate

<GXHelpContext Topic="Authentications" />

@if (string.Compare(Action, "Add", true) == 0 ||
string.Compare(Action, "Edit", true) == 0 ||
string.Compare(Action, "Remove", true) == 0)
{
    <Authentication Parent="this"
                    Id="@Id"
                    Action="@Action"></Authentication>
}
else
@if (_authentications != null)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
        </ChildContent>
    </GXMenuControl>

    <GXViewTable ViewName="Config.Authentications" ViewColumns="ViewColumnDefaults" TItem="AuthenticationSettings" @ref="table"
             Context="item"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Single"
             Filter="@false">
        <FilterContent>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXBlockGroupPolicies.Edit"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXBlockGroupPolicies.Delete"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="Name" Target="@item">@Properties.Resources.Name</GXTh>
            <GXTh Name="ClientId" Target="@item">@Properties.Resources.ClientID</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Config/Authentication/Edit/" + item.Name)">@item.Name</GXTd>
            <GXTd Id="ClientId">@item.ClientId</GXTd>
        </ItemContent>
    </GXViewTable>
    <br />
}
@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("ClientId") { Position = 1, Description = Properties.Resources.ClientID, Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<AuthenticationSettings>? table;

    private List<AuthenticationSettings> _authentications = new List<AuthenticationSettings>();

    /// <summary>
    /// Get available authentications.
    /// </summary>
    /// <returns></returns>
    public List<AuthenticationSettings> GetAuthentications()
    {
        return _authentications;
    }

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            var items = JsonSerializer.Deserialize<AuthenticationSettings[]>(Parent.Active.Settings);
            if (items != null)
            {
                _authentications.AddRange(items);
            }
        }
        InvokeAsync(StateHasChanged);
    }

    private async ValueTask<ItemsProviderResult<AuthenticationSettings>> GetItems(GXItemsProviderRequest request)
    {
        return new ItemsProviderResult<AuthenticationSettings>(_authentications, _authentications.Count);
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        if (NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Authentication/"))
        {
            //If authentication is shown or edit.
            return;
        }
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAuthentications);
            NotificationService?.RemoveByKey("Pages/Config/Authentications.OnInitialized");
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                var items = JsonSerializer.Deserialize<AuthenticationSettings[]>(Parent.Active.Settings);
                if (items != null)
                {
                    _authentications.AddRange(items);
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentications.OnInitialized");
        }
    }

    /// <summary>
    /// Delete selected authentications.
    /// </summary>

    public void OnRemove()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Authentications.OnRemove");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager,  "/Config/Authentication/Remove/" + table.Active.Name);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentications.OnRemove");
        }
    }

    /// <summary>
    /// Add new authentication.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Authentications.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager,  "Config/Authentication/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentications.OnAdd");
        }
    }

    /// <summary>
    /// Edit authentication.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Authentications.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager,  "/Config/Authentication/Edit/" + table.Active.Name);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentications.OnEdit");
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}
