@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
<GXHelpContext Topic="Authentication" />

@if (_active != null)
{
    <EditForm EditContext="@GXEditContexts.For(_active)">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.AuthenticationService</label>
                    <GXInputDropdown class="form-select" Disabled="@(IsCreating != null)"
                                     RememberValue="false" Items="@_services" @bind-Value="_active.Name" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.ClientID</label>
                    <InputText id="name" class="form-control"
                               disabled="@IsDeleting"
                               @bind-Value="_active.ClientId" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.ClientSecret</label>
                    <InputText id="name" class="form-control"
                               disabled="@IsDeleting"
                               @bind-Value="_active.ClientSecret" />
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    private AuthenticationSettings? _active;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Authentications? Parent { get; set; }

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Return disabled if user is not creating a new item.
    /// </summary>
    public string? IsCreating
    {
        get
        {
            if (action == CrudAction.Create)
            {
                return null;
            }
            return "disabled";
        }
    }

    /// <summary>
    /// Return disabled when user is deleting the item.
    /// </summary>
    public string? IsDeleting
    {
        get
        {
            if (action != CrudAction.Delete)
            {
                return null;
            }
            return "disabled";
        }
    }

    private List<string> _services = new();


    /// <summary>
    /// User action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    private CrudAction action;

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            _services.Add("GitHub");
            NotificationService?.RemoveByKey("Pages/Config/Authentication.OnInitialized");
            action = ClientHelpers.GetAction(NavigationManager, Action);
            if (Parent?.GetAuthentications() == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            if (action == CrudAction.Create)
            {
                _active = new AuthenticationSettings();
            }
            else
            {
                foreach (var it in Parent.GetAuthentications())
                {
                    if (string.Compare(it.Name, Id) == 0)
                    {
                        _active = it;
                        break;
                    }
                }
                if (_active == null)
                {
                    throw new Exception(Properties.Resources.InvalidTarget);
                }
            }
            MenuService.Clear();
            if (action == CrudAction.Delete)
            {
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    Text = Properties.Resources.Remove,
                    Icon = "Remove",
                    OnClick = EventCallback.Factory.Create(this, OnSave)
                });
            }
            else
            {
                MenuService.AddMenuItems(new GXMenuItem()
                {
                    Text = Properties.Resources.Save,
                    Icon = "Save",
                    OnClick = EventCallback.Factory.Create(this, OnSave)
                });
            }
            MenuService.AddMenuItems(new GXMenuItem()
            {
                Text = Properties.Resources.Cancel,
                Icon = "Cancel",
                OnClick = EventCallback.Factory.Create(this, OnCancel)
            });
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentication.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async void OnSave()
    {
        using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingAuthentication);
        NotificationService?.RemoveByKey("Pages/Config/Authentication.OnSave");
        try
        {
            if (Parent?.GetAuthentications() != null && _active != null)
            {
                switch (action)
                {
                    case CrudAction.Create:
                        foreach (var it in Parent.GetAuthentications())
                        {
                            if (it.Name == _active.Name)
                            {
                                throw new ArgumentException("The external authentication service has already been added.");
                            }
                        }
                        Parent.GetAuthentications().Add(_active);
                        break;
                    case CrudAction.Delete:
                        Parent.GetAuthentications().Remove(_active);
                        break;
                    case CrudAction.Update:
                        //Do nothing.
                        break;
                    default:
                        ClientHelpers.NavigateTo(NavigationManager,  "/configurations");
                        return;
                }
            }
            //Get selected item.
            GXConfiguration conf = Parent?.Parent?.Active ?? throw new InvalidOperationException(Properties.Resources.NoAuthenticationConfigurationIsSelected);
            conf.Settings = JsonSerializer.Serialize(Parent?.GetAuthentications());
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { conf };
            await Http.PostAsJson("api/Configuration/Update", arg);
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Authentication.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        MenuService.Dispose();
        MenuService.Clear();
        Notifier?.RemoveListener(this);
    }
}
