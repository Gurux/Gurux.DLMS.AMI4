@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.ManufacturerSettings
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Text.Json

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@implements IGXConfigUpdate


<GXHelpContext Topic="Language" />

@if (Active != null)
{

}
else @if (_authentications != null)
{
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="@OnAdd" />
        </ChildContent>
    </GXMenuControl>

    <GXViewTable ViewName="Config.Language" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXLanguagePolicies.View })" TItem="GXLanguage" @ref="table"
             Context="item"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Single"
             Filter="@false">
        <FilterContent>
        </FilterContent>
        <MenuContent>
            <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXLanguagePolicies.View"></GXContextMenuItem>
            <GXContextMenuItem Text="@Properties.Resources.Remove" Id="remove" OnClick="@OnRemove" Policy="@GXLanguagePolicies.Delete"></GXContextMenuItem>
        </MenuContent>
        <HeaderContent>
            <GXTh Name="Name" Target="@item">@Properties.Resources.Name</GXTh>
            <GXTh Name="ClientId" Target="@item">@Properties.Resources.ClientID</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Name" Link="@NavigationManager.GetCurrentPagePath("/Config/Authentication/Edit/" + item.Id)">@item.Id</GXTd>
            <GXTd Id="ClientId">@item.Id</GXTd>
        </ItemContent>
    </GXViewTable>
    <br />
}
@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Name") { Position = 0, Description = "Name", Visibility = (byte)Visibility.All },
        new("ClientId") { Position = 1, Description = Properties.Resources.ClientID, Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <summary>
    /// User action.
    /// </summary>
    private CrudAction Action { get; set; }
    private GXLanguage? Active;

    /// <summary>
    /// Selected item.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLanguage>? table;

    private List<GXLanguage> _authentications = new List<GXLanguage>();

    /// <inheritdoc/>
    public void Update()
    {
        InvokeAsync(StateHasChanged);
    }

    private async ValueTask<ItemsProviderResult<GXLanguage>> GetItems(GXItemsProviderRequest request)
    {
        return new ItemsProviderResult<GXLanguage>(_authentications, _authentications.Count);
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        if (NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("Authentication/"))
        {
            //If authentication is shown or edit.
            return;
        }
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingLanguage);
            NotificationService?.RemoveByKey("Pages/Config/Language.OnInitialized");
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                var items = JsonSerializer.Deserialize<AuthenticationSettings[]>(Parent.Active.Settings);
                if (items != null)
                {
                    //   _authentications.AddRange(items);
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Language.OnInitialized");
        }
    }

    /// <summary>
    /// Delete selected authentications.
    /// </summary>

    public void OnRemove()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Language.OnRemove");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Language.OnRemove");
        }
    }

    /// <summary>
    /// Add new authentication.
    /// </summary>
    public void OnAdd()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Language.OnAdd");
            ClientHelpers.NavigateTo(NavigationManager,  "Config/Authentication/Add");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Language.OnAdd");
        }
    }

    /// <summary>
    /// Edit language.
    /// </summary>
    public void Edit(GXLanguage value)
    {
        try
        {
            Action = CrudAction.Update;
            Active = value;
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit language.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Language.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            Edit(table.Active);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Language.OnEdit");
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}
