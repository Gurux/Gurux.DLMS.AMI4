@using Gurux.UI.Components.TemplateToken
@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging
@using System.Text.Encodings.Web
@using System.Text.Unicode

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
@implements IGXConfigUpdate

<GXHelpContext Topic="Maintenance" />

@if (_settings != null)
{
    <EditForm EditContext="@MenuService.EditContext">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.SiteIsInMaintenanceMode" id="maintenanceMode" @bind-Value="_settings.MaintenanceMode" />
                    <p>
                        <GXLocalizedText Value="@Properties.Resources.MaintenanceModeDescription" />
                    </p>
                </div>
                <div class="form-group">
                    <label for="maintenance-message">@Properties.Resources.Message</label>
                    <GXTemplateTokenEditor id="maintenance-message" @bind-Value="_settings.Message" Page="maintenance" Values="@_settings.GetTokenValues()" />
                </div>
                <div class="form-group">
                    <label for="maintenance-start">@Properties.Resources.StartTimeOptional</label>
                    <GXDateTimeSelector Id="maintenance-start" @bind-Value="_settings.StartTime" />
                </div>
                <div class="form-group">
                    <label for="maintenance-end">@Properties.Resources.EndTimeOptional</label>
                    <GXDateTimeSelector Id="maintenance-end" @bind-Value="_settings.EndTime" />
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    MaintenanceSettings? _settings;

    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new MaintenanceSettings()
            : JsonSerializer.Deserialize<MaintenanceSettings>(settings) ?? new MaintenanceSettings();
        MenuService.EditContext = new EditContext(_settings);
    }
    private bool _menuInitialized;

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            LoadSettings(Parent.Active.Settings);
            if (!string.IsNullOrEmpty(_settings?.Message))
            {
                _settings.Message = ((MarkupString)_settings.Message).ToString();
            }
        }
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingMaintenance);
        NotificationService?.RemoveByKey("Pages/Config/Maintenance.OnInitialized");
        Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
        {
            _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Maintenance, configuration =>
            {
                if (Parent?.Active?.Id != configuration.Id) {
                    return;
                }
                Parent.Active.Settings = configuration.Settings;
                Update();
            }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
        });
        try
        {
            if (string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                LoadSettings(null);
            }
            else
            {
                LoadSettings(Parent.Active.Settings);
                if (!string.IsNullOrEmpty(_settings?.Message))
                {
                    _settings.Message = ((MarkupString)_settings.Message).ToString();
                }
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Maintenance.OnInitialized");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_settings == null || _menuInitialized)
        {
            return;
        }
        _menuInitialized = true;
        var editContext = MenuService.EditContext;
        MenuService.Clear();
        MenuService.EditContext = editContext;
        MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSave)));
        MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async void OnSave()
    {
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingMaintenance);
            NotificationService?.RemoveByKey("Pages/Config/Maintenance.OnSave");
            if (Parent?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            //This is needed to serialize special chars.
            _settings?.Validate();
            var options = new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                WriteIndented = true
            };
            Parent.Active.Settings = JsonSerializer.Serialize(_settings, options);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson("api/Configuration/Update", arg);
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Maintenance.OnSave");
        }
    }

    /// <summary>
    /// Run the cron.
    /// </summary>
    public async void OnRun()
    {
        using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingMaintenance);
        NotificationService?.RemoveByKey("Pages/Config/Maintenance.OnRun");
        try
        {
            ConfigurationRunCron req = new ConfigurationRunCron();
            await Http.PostAsJson<ConfigurationRunCronResponse>("api/Configuration/Cron", req);
            NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.CronStarted, string.Empty, Closable: false));
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Maintenance.OnRun");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private async Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
