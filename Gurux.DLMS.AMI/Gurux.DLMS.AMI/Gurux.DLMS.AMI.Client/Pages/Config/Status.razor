@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@implements IGXConfigUpdate

@inject HttpClient Http
<GXHelpContext Topic="Status" />

@if (_settings != null)
{
    <EditForm EditContext="@MenuService.EditContext">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.SiteVersion</label>
                    <InputText id="siteVersion" class="form-control" readonly="readonly"
                               @bind-Value="_settings.SiteVersion" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.StartTime</label>
                    <input type="text" id="startTime" class="form-control" readonly="readonly"
                           Value="@Convert.ToString(_settings.StartTime.ToLocalTime())" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.SystemUpTime</label>
                    <input type="text" id="upTime" class="form-control" readonly="readonly"
                           Value="@GetUptime()" />
                </div>
            </div>
        </div>
    </EditForm>
}
<GXMenuControl>
    <ChildContent>
        <GXMenuEntry Text="@Properties.Resources.Search" Id="Search" OnClick="@Updated" />
    </ChildContent>
</GXMenuControl>
@if (_assemblies != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                           @onchange="@((ChangeEventArgs __e) => filter.Name = Convert.ToString(__e.Value) ?? string.Empty)" />
                </th>
                <th>
                    <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByVersion"
                           @onchange="@((ChangeEventArgs __e) => filter.Version = Convert.ToString(__e.Value) ?? string.Empty)" />
                </th>
                <th>
                    <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByLocation"
                           @onchange="@((ChangeEventArgs __e) => filter.Location = Convert.ToString(__e.Value))" />
                </th>
            </tr>
            <tr>
                <th>@Properties.Resources.Name</th>
                <th>@Properties.Resources.Version</th>
                <th>@Properties.Resources.Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assembly in _assemblies)
            {
                <tr class=@(GetSelectedClass(assembly)) @onclick="@(() => RowSelected(assembly))">
                    <td>@assembly.Name</td>
                    <td>@assembly.Version</td>
                    <td>@assembly.Location</td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    StatusSettings? _settings;
    private readonly CancellationTokenSource _uptimeLifetime = new();
    private bool _disposed;

    private string GetUptime()
    {
        if (_settings == null || _settings.StartTime == default)
        {
            return string.Empty;
        }
        var seconds = Math.Max(0, Math.Floor((DateTimeOffset.UtcNow - _settings.StartTime).TotalSeconds));
        return TimeSpan.FromSeconds(seconds).ToString("c", CultureInfo.CurrentCulture);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = RefreshUptimeAsync(_uptimeLifetime.Token);
        }
    }

    private async Task RefreshUptimeAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }


    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new StatusSettings()
            : JsonSerializer.Deserialize<StatusSettings>(settings) ?? new StatusSettings();
        MenuService.EditContext = new EditContext(_settings);
    }

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            LoadSettings(Parent.Active.Settings);
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Script log filter.
    /// </summary>
    private GXAssembly filter = new GXAssembly();

    /// <summary>
    /// Total numbers of rows in the database.
    /// </summary>
    internal int Total { get; private set; }

    /// <summary>
    /// Selected item.
    /// </summary>
    private GXAssembly? _selected;

    protected string GetSelectedClass(GXAssembly selected)
    {
        return _selected != null && selected.Name == _selected.Name ? "table-info" : "table-striped";
    }

    protected void RowSelected(GXAssembly selected)
    {
        _selected = selected;
    }

    IEnumerable<GXAssembly>? _assemblies;

    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingStatus);
            NotificationService?.RemoveByKey("Pages/Config/Status.Updated");
            _assemblies = null;
            LoadedAssemblies req = new LoadedAssemblies() { Filter = filter };
            var ret = await Http.PostAsJson<LoadedAssembliesResponse>("api/Configuration/Assemblies", req);
            _assemblies = ret.Assemblies;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Status.Updated");
        }
    }

    /// <summary>
    /// Virtualize.
    /// </summary>
    protected Virtualize<GXAssembly>? virtualize;

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingStatus);
            NotificationService?.RemoveByKey("Pages/Config/Status.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Status, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
            });
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem() { Text = Properties.Resources.Close, Icon = "Cancel", OnClick = EventCallback.Factory.Create(this, OnCancel) });
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                LoadSettings(Parent.Active.Settings);
            }
            await Updated();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Status.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        _uptimeLifetime.Cancel();
        _uptimeLifetime.Dispose();
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
