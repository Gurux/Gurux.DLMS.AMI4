@page "/config/access-control"
@page "/config/access-control/{Tab}"
@page "/config/roles"
@page "/config/policy"
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

@using Microsoft.AspNetCore.Authorization
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication


@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IAuthorizationService AuthorizationService
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Roles" />

<PageTitle>@Properties.Resources.AccessControl</PageTitle>
<h1>@Properties.Resources.AccessControl</h1>
<section data-testid="access-control" aria-busy="@(_initialized ? "false" : "true")">
@if (_canViewRoles || _canViewPolicies)
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="config/access-control" Active="@ActiveTab" InitialTab="@(_policyTabSelected ? 1 : 0)" SelectionChanged="OnTabChanged">
        <ChildContent>
            <TabHeader Name="@GXMenus.AccessControlTab" LinkFilter="CanViewTab">
                <ContentForLink Context="link">
                    @switch (link.Url)
                    {
                        case "Roles":
                            <GXMenuControl RightCorner="true">
                                <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="OnAdd" Policy="@GXRolePolicies.Add" />
                                <GXMenuEntry Text="@Properties.Resources.Edit" Id="Edit" OnClick="OnEdit" Policy="@GXRolePolicies.Edit" />
                                <GXMenuEntry Text="@Properties.Resources.Remove" Id="Remove" OnClick="OnRemove" Policy="@GXRolePolicies.Delete" />
                                <GXMenuEntry Text="@Properties.Resources.ApplyDefaults" Id="Regenerate" OnClick="OnRegenerate" Policy="@GXRolePolicies.Edit" />
                            </GXMenuControl>
                            <RoleEditor @ref="_roleEditor" Roles="@_roles" Edit="true" PermissionCatalog="@_permissions" OnChanged="RolesChanged"
                                        SelectionMode="Gurux.UI.Components.Table.SelectionMode.Multiple"></RoleEditor>
                            break;
                        case "Policies":
                            <PolicyList />
                            break;
                    }
                </ContentForLink>
            </TabHeader>
        </ChildContent>
    </GXTabControl>
}
else if (_initialized)
{
    <p role="status" data-testid="access-control-denied">@Properties.Resources.NotAuthorized</p>
}
</section>

@code {
    /// <summary>Receives the current identity and subsequent authentication changes from the application cascade.</summary>
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>Records whether the current user's permissions allow the view roles operation.</summary>
    private bool _canViewRoles;
    /// <summary>Records whether the current user's permissions allow the view policies operation.</summary>
    private bool _canViewPolicies;
    /// <summary>Records whether the initial component setup has completed.</summary>
    private bool _initialized;

    private bool CanViewTab(GXMenuLink link)
    {
        if (string.Equals(link.Url, "Roles", StringComparison.OrdinalIgnoreCase))
        {
            return _canViewRoles;
        }
        if (string.Equals(link.Url, "Policies", StringComparison.OrdinalIgnoreCase))
        {
            return _canViewPolicies;
        }
        return true;
    }

    [Parameter] public string? Tab { get; set; }
    private string ActiveTab => GXTabRoutes.Active(NavigationManager, "config/access-control", 0,
        new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/').EndsWith("/policy", StringComparison.OrdinalIgnoreCase) ? "Policies" : "Roles") ?? "Roles";

    /// <summary>Identifies the authentication snapshot used for role and policy access.</summary>
    private Task<AuthenticationState>? _authenticationState;
    /// <summary>Rejects role data superseded by a newer request.</summary>
    private long _roleLoadGeneration;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_authenticationState == AuthenticationState)
        {
            return;
        }
        var authenticationState = AuthenticationState;
        _authenticationState = authenticationState;
        _canViewRoles = false;
        _canViewPolicies = false;
        var user = (await authenticationState).User;
        var canViewRoles = (await AuthorizationService.AuthorizeAsync(user, GXRolePolicies.View)).Succeeded;
        var canViewPolicies = (await AuthorizationService.AuthorizeAsync(user, GXPolicyPolicies.View)).Succeeded;
        if (authenticationState != AuthenticationState)
        {
            return;
        }
        _canViewRoles = canViewRoles;
        _canViewPolicies = canViewPolicies;
        if (!_canViewRoles)
        {
            _roles.Clear();
            _originalRoles.Clear();
            _roleEditor?.EditingRoles.Clear();
            _editorMenu?.Dispose();
            _editorMenu = null;
        }
        else if (_initialized)
        {
            EditorMenu.Set(_roles, CrudAction.Update, OnSave, OnCancel);
            await Updated();
        }
    }

    protected override void OnParametersSet()
    {
        _policyTabSelected = string.Equals(ActiveTab, "Policies", StringComparison.OrdinalIgnoreCase);
    }
    /// <summary>Owns editing commands and connects their enabled state to the current form.</summary>
    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);

    /// <summary>Subscribes to server notifications that refresh the displayed data.</summary>
    private IGXNotifier? _notifier;
    /// <summary>Creates progress scopes that keep the page's commands synchronized with asynchronous operations.</summary>
    private IGXProgress? _progress;
    /// <summary>Publishes operation results and failures to the page's notification UI.</summary>
    private IGXNotificationService? _notificationService;

    /// <summary>
    /// Available roles.
    /// </summary>
    private List<GXRole> _roles = new List<GXRole>();
    /// <summary>Preserves original role assignments so edits can be compared with saved values.</summary>
    private readonly Dictionary<string, string> _originalRoles = new();
    private static string RoleValues(GXRole role) => System.Text.Json.JsonSerializer.Serialize(new
    {
        role.Name, role.Description, role.Default,
        Permissions = role.Permissions?.Select(p => p.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToArray() ?? []
    });
    /// <summary>References the role editor used to open or clear the selected role.</summary>
    private RoleEditor? _roleEditor;
    /// <summary>Lists the permissions available to the role being edited.</summary>
    private GXPermission[] _permissions = Array.Empty<GXPermission>();
    /// <summary>Records whether the policy tab is the active editing section.</summary>
    private bool _policyTabSelected;
    /// <summary>Prevents overlapping requests while applying defaults is in progress.</summary>
    private bool _applyingDefaults;
    /// <summary>Prevents overlapping requests while removing is in progress.</summary>
    private bool _removing;
    private void RolesChanged(List<GXRole> roles) => GXEditContexts.For(_roles).NotifyFieldChanged(new FieldIdentifier(_roles, nameof(_roles)));

    public async Task OnAdd()
    {
        var role = new GXRole { Name = string.Empty, Default = false, SystemDefined = false, Permissions = [] };
        _roles.Add(role);
        RolesChanged(_roles);
        if (_roleEditor != null)
        {
            _roleEditor.Filter = null;
            await _roleEditor.EditRoles([role]);
        }
    }

    public async Task OnEdit()
    {
        var selected = _roleEditor?.SelectedRoles ?? [];
        if (selected.Length == 0)
        {
            _notificationService?.ReportError(new Exception(Properties.Resources.NoItemIsSelected));
            return;
        }
        await _roleEditor!.EditRoles(selected);
    }

    public async Task OnRemove()
    {
        if (_removing)
        {
            return;
        }
        _removing = true;
        try
        {
            var selected = _roleEditor?.SelectedRoles ?? [];
            if (selected.Length == 0)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            if (selected.Any(r => r.Default == true) || selected.Length >= _roles.Count)
            {
                throw new InvalidOperationException(Properties.Resources.CannotRemoveDefaultRole);
            }
            var result = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.Remove, AllowDelete = false, Items = selected.Select(r => r.Name).ToArray() });
            if (!result.Confirm)
            {
                return;
            }
            var ids = selected.Where(r => !string.IsNullOrEmpty(r.Id)).Select(r => r.Id).ToArray();
            if (ids.Length != 0)
            {
                await Http.PostAsJson<RoleDeleteResponse>("api/Role/Delete", new RoleDelete { Ids = ids });
            }
            _roles.RemoveAll(r => selected.Contains(r));
            _roleEditor!.EditingRoles.ExceptWith(selected);
            await _roleEditor.Update();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Config/Roles.OnRemove");
        }
        finally
        {
            _removing = false;
        }
    }

    public async Task OnRegenerate()
    {
        if (_applyingDefaults)
        {
            return;
        }
        _applyingDefaults = true;
        try
        {
            var selected = _roleEditor?.SelectedRoles ?? [];
            var ids = selected.Select(r => r.Id).ToArray();
            var message = Properties.Resources.SelectedItemsWillBeResetToDefaultsWithoutASelectionOnlyMissingDefaultsWillBeAdded;
            if (GXEditContexts.For(_roles).IsModified())
            {
                message += " " + Properties.Resources.UnsavedChanges + ": " + Properties.Resources.DiscardChanges + "?";
            }
            var result = await Confirmation.ConfirmAsync(Properties.Resources.ApplyBuiltInDefaults, message,
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.ApplyDefaults, AllowDelete = false, Items = selected.Select(r => r.Name).ToArray() });
            if (!result.Confirm)
            {
                return;
            }
            using var progress = _progress?.ProgressStart(Properties.Resources.ApplyDefaults);
            await Http.PostAsJson<RegenerateRoleResponse>("api/Role/Regenerate", new RegenerateRole { Ids = ids },
                progress?.CancellationToken ?? CancellationToken.None);
            if (await Updated())
            {
                GXEditContexts.For(_roles).MarkAsUnmodified();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Config/Roles.OnRegenerate");
        }
        finally
        {
            _applyingDefaults = false;
        }
    }

    private void OnTabChanged(Gurux.UI.Components.Tab.GXTabPage page)
    {
        _policyTabSelected = string.Equals(page.Path, "Policies", StringComparison.OrdinalIgnoreCase);
        if (!_policyTabSelected && _canViewRoles && _roles.Count == 0)
        {
            _ = InvokeAsync(Updated);
        }
    }


    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task<bool> Updated()
    {
        var authenticationState = AuthenticationState;
        var generation = ++_roleLoadGeneration;
        try
        {
            var user = (await authenticationState).User;
            if (!(await AuthorizationService.AuthorizeAsync(user, GXRolePolicies.View)).Succeeded || authenticationState != AuthenticationState || generation != _roleLoadGeneration)
            {
                return false;
            }
            using var progressScope1 = _progress?.ProgressStart(GXProgress.RetrievingRoles);
            _notificationService?.RemoveByKey("Pages/Config/Roles.Updated");
            var permissions = await Http.GetAsJsonAsync<GXPermission[]>("api/Permission") ?? Array.Empty<GXPermission>();
            ListRoles req = new ListRoles();
            var response = await Http.PostAsJson<ListRolesResponse>("api/Role/List", req);
            if (authenticationState != AuthenticationState || generation != _roleLoadGeneration)
            {
                return false;
            }
            _permissions = permissions;
            _roles.Clear();
            _roles.AddRange(response.Roles ?? []);
            _originalRoles.Clear();
            foreach (var role in _roles)
            {
                _originalRoles[role.Id] = RoleValues(role);
            }
            _roleEditor?.EditingRoles.Clear();
            if (!_policyTabSelected && _roleEditor != null)
            {
                await _roleEditor.Update();
            }
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Config/Roles.Updated");
            return false;
        }
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _notifier = Services.GetService<IGXNotifier>();
        _progress = Services.GetService<IGXProgress>();
        _notificationService = Services.GetService<IGXNotificationService>();
        if (_notifier == null)
        {
            return;
        }

        try
        {
            var authenticationState = AuthenticationState;
            _authenticationState = authenticationState;
            _canViewRoles = false;
            _canViewPolicies = false;
            var user = (await authenticationState).User;
            var canViewRoles = (await AuthorizationService.AuthorizeAsync(user, GXRolePolicies.View)).Succeeded;
            var canViewPolicies = (await AuthorizationService.AuthorizeAsync(user, GXPolicyPolicies.View)).Succeeded;
            if (authenticationState != AuthenticationState)
            {
                return;
            }
            _canViewRoles = canViewRoles;
            _canViewPolicies = canViewPolicies;
            _notificationService?.RemoveByKey("Pages/Config/Roles.OnInitializedAsync");
            _notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXRolePolicies.Add ||
                            it.Type == GXRolePolicies.Edit ||
                            it.Type == GXRolePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshViewAsync(this, items, Updated);
                        break;
                    }
                }
            });
            if (_canViewRoles)
            {
                EditorMenu.Set(_roles, CrudAction.Update, OnSave, OnCancel);
                await Updated();
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Config/Roles.OnInitializedAsync");
        }
        finally
        {
            _initialized = true;
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        try
        {
            if (_roles != null)
            {
                if (_roles.Any(r => string.IsNullOrWhiteSpace(r.Name)) ||
                    _roles.Select(r => r.Name!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _roles.Count)
                {
                    throw new InvalidOperationException(Properties.Resources.Name);
                }
                using var progressScope2 = _progress?.ProgressStart(GXProgress.SavingRole);
                _notificationService?.RemoveByKey("Pages/Config/Roles.OnSave");
                var changes = _roles.Where(r => string.IsNullOrEmpty(r.Id) ||
                    !_originalRoles.TryGetValue(r.Id, out var original) || original != RoleValues(r)).ToArray();
                if (changes.Length != 0)
                {
                    UpdateRole req = new UpdateRole() { Roles = changes };
                    await Http.PostAsJson<UpdateRoleResponse>("api/Role/Update", req);
                }
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (Exception ex)
        {
            _notificationService?.ReportError(ex, "Pages/Config/Roles.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _editorMenu?.Dispose();
        GXNotificationRefresh.Remove(this);
        _notifier?.RemoveListener(this);
    }
}
