@page "/config/access-control"
@page "/config/access-control/{Tab}"
@page "/config/roles"
@page "/config/policy"
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication

@using Microsoft.AspNetCore.Authorization
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication


@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@inject HttpClient Http
@inject IGXAmiConfirmation Confirmation
@implements IDisposable

<GXHelpContext Topic="Roles" />

<PageTitle>@Properties.Resources.AccessControl</PageTitle>
<h1>@Properties.Resources.AccessControl</h1>
<GXTabControl PersistSelectionInUrl="true" RouteGroup="config/access-control" Active="@ActiveTab" InitialTab="@(_policyTabSelected ? 1 : 0)" SelectionChanged="OnTabChanged">
    <ChildContent>
        <TabHeader Name="@GXMenus.AccessControlTab">
            <ContentForLink Context="link">
                @switch (link.Url)
                {
                    case "Roles":
                        <GXMenuControl RightCorner="true">
                            <GXMenuEntry Text="@Properties.Resources.Add" Id="Add" OnClick="OnAdd" Policy="@GXRolePolicies.Add" />
                            <GXMenuEntry Text="@Properties.Resources.Edit" Id="Edit" OnClick="OnEdit" Policy="@GXRolePolicies.Edit" />
                            <GXMenuEntry Text="@Properties.Resources.Remove" Id="Remove" OnClick="OnRemove" Policy="@GXRolePolicies.Delete" />
                            <GXMenuEntry Text="@Properties.Resources.ApplyDefaults" Id="Regenerate" OnClick="OnRegenerate" Policy="@GXRolePolicies.Edit" />
                        </GXMenuControl>
                        <RoleEditor @ref="_roleEditor" Roles="@_roles" Edit="true" PermissionCatalog="@_permissions" OnChanged="RolesChanged"
                                    SelectionMode="Gurux.UI.Components.Table.SelectionMode.Multiple"></RoleEditor>
                        break;
                    case "Policies":
                        <PolicyList />
                        break;
                }
            </ContentForLink>
        </TabHeader>
    </ChildContent>
</GXTabControl>

@code {
    [Parameter] public string? Tab { get; set; }
    private string ActiveTab => GXTabRoutes.Active(NavigationManager, "config/access-control", 0,
        new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/').EndsWith("/policy", StringComparison.OrdinalIgnoreCase) ? "Policies" : "Roles") ?? "Roles";

    protected override void OnParametersSet()
    {
        _policyTabSelected = string.Equals(ActiveTab, "Policies", StringComparison.OrdinalIgnoreCase);
    }
    private GXEditorMenu? _editorMenu;
    private GXEditorMenu EditorMenu => _editorMenu ??= new GXEditorMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Available roles.
    /// </summary>
    private List<GXRole> _roles = new List<GXRole>();
    private readonly Dictionary<string, string> _originalRoles = new();
    private static string RoleValues(GXRole role) => System.Text.Json.JsonSerializer.Serialize(new
    {
        role.Name, role.Description, role.Default,
        Permissions = role.Permissions?.Select(p => p.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToArray() ?? []
    });
    private RoleEditor? _roleEditor;
    private GXPermission[] _permissions = Array.Empty<GXPermission>();
    private bool _policyTabSelected;
    private bool _applyingDefaults;
    private bool _removing;
    private void RolesChanged(List<GXRole> roles) => GXEditContexts.For(_roles).NotifyFieldChanged(new FieldIdentifier(_roles, nameof(_roles)));

    public async Task OnAdd()
    {
        var role = new GXRole { Name = string.Empty, Default = false, SystemDefined = false, Permissions = [] };
        _roles.Add(role);
        RolesChanged(_roles);
        if (_roleEditor != null)
        {
            _roleEditor.Filter = null;
            await _roleEditor.EditRoles([role]);
        }
    }

    public async Task OnEdit()
    {
        var selected = _roleEditor?.SelectedRoles ?? [];
        if (selected.Length == 0)
        {
            NotificationService?.ReportError(new Exception(Properties.Resources.NoItemIsSelected));
            return;
        }
        await _roleEditor!.EditRoles(selected);
    }

    public async Task OnRemove()
    {
        if (_removing)
        {
            return;
        }
        _removing = true;
        try
        {
            var selected = _roleEditor?.SelectedRoles ?? [];
            if (selected.Length == 0)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            if (selected.Any(r => r.Default == true) || selected.Length >= _roles.Count)
            {
                throw new InvalidOperationException(Properties.Resources.CannotRemoveDefaultRole);
            }
            var result = await Confirmation.ConfirmAsync(Properties.Resources.AreYouSureYouWantToDeleteSelectedItems, "",
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.Remove, AllowDelete = false, Items = selected.Select(r => r.Name).ToArray() });
            if (!result.Confirm)
            {
                return;
            }
            var ids = selected.Where(r => !string.IsNullOrEmpty(r.Id)).Select(r => r.Id).ToArray();
            if (ids.Length != 0)
            {
                await Http.PostAsJson<RoleDeleteResponse>("api/Role/Delete", new RoleDelete { Ids = ids });
            }
            _roles.RemoveAll(r => selected.Contains(r));
            _roleEditor!.EditingRoles.ExceptWith(selected);
            await _roleEditor.Update();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Roles.OnRemove");
        }
        finally
        {
            _removing = false;
        }
    }

    public async Task OnRegenerate()
    {
        if (_applyingDefaults)
        {
            return;
        }
        _applyingDefaults = true;
        try
        {
            var selected = _roleEditor?.SelectedRoles ?? [];
            var ids = selected.Select(r => r.Id).ToArray();
            var message = Properties.Resources.SelectedItemsWillBeResetToDefaultsWithoutASelectionOnlyMissingDefaultsWillBeAdded;
            if (GXEditContexts.For(_roles).IsModified())
            {
                message += " " + Properties.Resources.UnsavedChanges + ": " + Properties.Resources.DiscardChanges + "?";
            }
            var result = await Confirmation.ConfirmAsync(Properties.Resources.ApplyBuiltInDefaults, message,
                new AmiConfirmationOptions { ConfirmText = Properties.Resources.ApplyDefaults, AllowDelete = false, Items = selected.Select(r => r.Name).ToArray() });
            if (!result.Confirm)
            {
                return;
            }
            using var progress = Progress?.ProgressStart(Properties.Resources.ApplyDefaults);
            await Http.PostAsJson<RegenerateRoleResponse>("api/Role/Regenerate", new RegenerateRole { Ids = ids },
                progress?.CancellationToken ?? CancellationToken.None);
            if (await Updated())
            {
                GXEditContexts.For(_roles).MarkAsUnmodified();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Roles.OnRegenerate");
        }
        finally
        {
            _applyingDefaults = false;
        }
    }

    private void OnTabChanged(Gurux.UI.Components.Tab.GXTabPage page)
    {
        _policyTabSelected = string.Equals(page.Path, "Policies", StringComparison.OrdinalIgnoreCase);
        if (!_policyTabSelected && _roles.Count == 0)
        {
            _ = InvokeAsync(Updated);
        }
    }


    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task<bool> Updated()
    {
        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingRoles);
            NotificationService?.RemoveByKey("Pages/Config/Roles.Updated");
            _permissions = await Http.GetAsJsonAsync<GXPermission[]>("api/Permission") ?? Array.Empty<GXPermission>();
            ListRoles req = new ListRoles();
            var response = await Http.PostAsJson<ListRolesResponse>("api/Role/List", req);
            _roles.Clear();
            _roles.AddRange(response.Roles ?? []);
            _originalRoles.Clear();
            foreach (var role in _roles)
            {
                _originalRoles[role.Id] = RoleValues(role);
            }
            _roleEditor?.EditingRoles.Clear();
            if (!_policyTabSelected && _roleEditor != null)
            {
                await _roleEditor.Update();
            }
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Roles.Updated");
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Roles.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXRolePolicies.Add ||
                            it.Type == GXRolePolicies.Edit ||
                            it.Type == GXRolePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshViewAsync(this, items, Updated);
                        break;
                    }
                }
            });
            EditorMenu.Set(_roles, CrudAction.Update, OnSave, OnCancel);
            await Updated();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Roles.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        try
        {
            if (_roles != null)
            {
                if (_roles.Any(r => string.IsNullOrWhiteSpace(r.Name)) ||
                    _roles.Select(r => r.Name!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _roles.Count)
                {
                    throw new InvalidOperationException(Properties.Resources.Name);
                }
                using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingRole);
                NotificationService?.RemoveByKey("Pages/Config/Roles.OnSave");
                var changes = _roles.Where(r => string.IsNullOrEmpty(r.Id) ||
                    !_originalRoles.TryGetValue(r.Id, out var original) || original != RoleValues(r)).ToArray();
                if (changes.Length != 0)
                {
                    UpdateRole req = new UpdateRole() { Roles = changes };
                    await Http.PostAsJson<UpdateRoleResponse>("api/Role/Update", req);
                }
                ClientHelpers.NavigateToLastPage(NavigationManager);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Roles.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    /// </summary>
    private Task OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _editorMenu?.Dispose();
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
