@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable

<GXHelpContext Topic="Languages" />

<h1>
    <GXLocalizedText Value="@Properties.Resources.SupportedLanguages" />
</h1>
<InstallableLanguages />
@if (_active != null)
{
    <GXDialog OnCancel="Cancel"
            CancelButtonTitle="@Properties.Resources.Cancel"
            OkButtonTitle="@Properties.Resources.Ok"
            OnOk="Save">
        <EditForm EditContext="@GXEditContexts.For(_active)">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <GXValidator @ref="_validator" OnValidate="OnValidate" />
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <GXCopyButton Value="@_active.Id">@Properties.Resources.Identification</GXCopyButton>
                        <InputText id="description" readonly @bind-Value="_active.Id" class="form-control" />
                    </div>
                </div>
                <div style="width:100%">
                    <div class="form-group">
                        <GXCopyButton Value="@_active.Id">@Properties.Resources.EnglishName</GXCopyButton>
                        <InputText id="description" readonly @bind-Value="_active.EnglishName" class="form-control" />
                    </div>
                </div>
                <div style="width:100%">
                    <div class="form-group">
                        <GXCopyButton Value="@_active.Id">@Properties.Resources.NativeName</GXCopyButton>
                        <InputText id="description" readonly @bind-Value="_active.NativeName" class="form-control" />
                    </div>
                </div>
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.Enabled" @bind-Value="_active.Enabled" />
                </div>
                <div class="form-group">
                    <GXInputSwitch Text="@Properties.Resources.Default" @bind-Value="_active.Default" />
                </div>
            </div>
        </EditForm>
    </GXDialog>
}
<AuthorizeView Roles=@GXRoles.Admin>
    <GXMenuControl RightCorner="true">
        <ChildContent>
            <GXMenuEntry Text="@Properties.Resources.Refresh" Id="Refresh" OnClick="@OnRefresh" />
        </ChildContent>
    </GXMenuControl>
</AuthorizeView>

<h2>@Properties.Resources.Installed</h2>
@if (AvailableLanguages != null)
{
    <GXViewTable ViewName="Config.Languages" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXLanguagePolicies.View })" TItem="GXLanguage" @ref="table"
             Context="item"
             ItemsProvider="@GetItems"
             SelectionMode="SelectionMode.Single"
             Filter="@false">
        <FilterContent>
        </FilterContent>
        <MenuContent>
            <AuthorizeView Roles=@GXRoles.Admin>
                <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit"></GXContextMenuItem>
            </AuthorizeView>
        </MenuContent>
        <HeaderContent>
            <GXTh Id="Icon" TItem="GXLanguage" width="1%"></GXTh>
            <GXTh Name="Name" Target="@item">@Properties.Resources.Name</GXTh>
            <GXTh Name="Enabled" Target="@item">@Properties.Resources.Enabled</GXTh>
            <GXTh Name="Default" Target="@item">@Properties.Resources.Default</GXTh>
        </HeaderContent>
        <ItemContent>
            <GXTd Id="Icon" class="img-cell">
                @if (!string.IsNullOrEmpty(item.Id))
                {
                    <GXImage Id="@item.Id" Width="24" Height="24"></GXImage>
                }
            </GXTd>
            <GXTd Id="Name"><GXLinkButton TItem="GXLanguage" Target="@item" OnClick="@Edit" Text="@(item.NativeName + " (" + @item.EnglishName + ")")" /></GXTd>
            <GXTd Id="Enabled">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox"
                           checked="@item.Enabled"
                           @onchange="@((e) => Owner.SetEnabled(item, Convert.ToBoolean(e.Value)))" />
                </div>
            </GXTd>
            <GXTd Id="Default">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox"
                           disabled="@IsActive(item)" checked="@item.Default"
                           @onchange="@((e) => Owner.SetDefault(item, Convert.ToBoolean(e.Value)))" />
                </div>
            </GXTd>
        </ItemContent>
    </GXViewTable>
}
@code {
    [CascadingParameter] public ConfigurationLanguages Owner { get; set; } = default!;
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Icon") { Position = 0, Description = "Icon", Visibility = (byte)Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("Enabled") { Position = 2, Description = "Enabled", Visibility = (byte)Visibility.All },
        new("Default") { Position = 3, Description = "Default", Visibility = (byte)Visibility.All },
    ];


    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public List<GXLanguage> AvailableLanguages { get; set; } = new List<GXLanguage>();

    /// <summary>
    /// User action.
    /// </summary>
    private CrudAction Action { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLanguage>? table;

    private GXValidator? _validator;

    /// <summary>
    /// Validate the language content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (_active != null && string.IsNullOrEmpty(_active.Id))
        {
            sender.AddError(() => _active.Id, Properties.Resources.InvalidIdentifier);
        }
    }

    private GXLanguage? _active { get; set; } = null;
    private GXLanguage? _editingLanguage;
    //If language is not active it can't be the default language.
    protected string? IsActive(GXLanguage selected)
    {
        return selected.Enabled.HasValue && selected.Enabled.Value ? null : "disabled";
    }

    protected string GetSelectedClass(GXLanguage selected)
    {
        return _active != null && selected.Id == _active.Id ? "table-info" : "table-striped";
    }

    protected void RowSelected(GXLanguage selected)
    {
        Edit(selected);
    }


    /// <summary>
    /// Update virtualized items.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            AvailableLanguages.Clear();
            using var progressScope1 = Progress?.ProgressStart(GXProgress.SavingLanguage);
            NotificationService?.RemoveByKey("Pages/Config/Languages.Updated");
            var tmp = (await Http.PostAsJson<ListLanguagesResponse>("api/Localization/List", new ListLanguages())).Languages;
            if (tmp != null)
            {
                AvailableLanguages.AddRange(tmp);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Languages.Updated");
        }
    }

    /// <summary>
    /// Edit language.
    /// </summary>
    public void Edit(GXLanguage value)
    {
        try
        {
            Action = CrudAction.Update;
            _editingLanguage = value;
            _active = ClientHelpers.Clone<GXLanguage>(value);
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }

    /// <summary>
    /// Edit language.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Languages.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            Edit(table.Active);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Languages.OnEdit");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingLanguages);
            NotificationService?.RemoveByKey("Pages/Config/Languages.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXLanguagePolicies.Add ||
                       it.Type == GXLanguagePolicies.Edit ||
                       it.Type == GXLanguagePolicies.Delete)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            //Read languages as a default.
            if (!AvailableLanguages.Any())
            {
                await Updated();
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Languages.OnInitializedAsync");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLanguage>> GetItems(GXItemsProviderRequest request)
    {
        return new ItemsProviderResult<GXLanguage>(AvailableLanguages, AvailableLanguages.Count);
    }


    /// <summary>
    /// Refresh values.
    /// </summary>
    private async void OnRefresh()
    {
        try
        {
            using var progressScope4 = Progress?.ProgressStart(GXProgress.SavingLanguage);
            NotificationService?.RemoveByKey("Pages/Config/Languages.OnRefresh");
            List<GXLanguage> list = new List<GXLanguage>();
            //Only active language IDs are send.
            foreach (var it in AvailableLanguages)
            {
                if (it.Enabled.HasValue && it.Enabled.Value)
                {
                    list.Add(new GXLanguage() { Id = it.Id });
                }
            }
            RefreshLocalization req = new RefreshLocalization();
            await Http.PostAsJson("api/Localization/Refresh", req);
            NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.Refreshed, string.Empty, Closable: false));
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Languages.OnRefresh");
        }
    }

    /// <summary>
    /// Save icon.
    ///</summary>
    public async Task Save()
    {
        try
        {
            _validator?.ClearErrors();
            if (_validator != null &&
                !await _validator.ValidateAsync())
            {
                return;
            }
            UpdateLocalization req = new UpdateLocalization()
            {
                Localizations = [_active ?? throw new InvalidOperationException(Properties.Resources.NoLanguageIsSelected)]
            };
            await Http.PostAsJson<UpdateLocalizationResponse>("api/Localization/Update", req);
            if (_active != null && _editingLanguage != null)
                {
                ClientHelpers.Copy(_active, _editingLanguage);
            }
            _active = null;
            _editingLanguage = null;
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }


    /// <summary>
    /// Hide icon dlg.
    /// </summary>
    public void Cancel()
    {
        _active = null;
        _editingLanguage = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
