@using Gurux.UI.Components.Enums
@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
@implements IGXConfigUpdate

<GXHelpContext Topic="Account" />

@if (_settings != null)
{
    <EditForm EditContext="@MenuService.EditContext">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.WhoCanRegisterAccounts</label><br>
                    <InputRadioGroup @bind-Value="_settings.UserCreationType">
                        <label class="clickable-option">
                            <InputRadio Value="UserCreationType.Anyone" />Anyone
                        </label><br />
                        <label class="clickable-option">
                            <InputRadio Value="UserCreationType.AdminApprovalRequired" />Anyone, but administrator approval is required
                        </label><br />
                        <label class="clickable-option">
                            <InputRadio Value="UserCreationType.AdminOnly" />Administrators only
                        </label><br />
                    </InputRadioGroup>
                    <br />
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier2? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            _settings = JsonSerializer.Deserialize<AccountSettings>(Parent.Active.Settings) ?? new AccountSettings();
            MenuService.EditContext = new EditContext(_settings);
            MenuService.EditContext.MarkAsUnmodified();
        }
        InvokeAsync(StateHasChanged);
    }

    AccountSettings? _settings;

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingAccount);
            NotificationService?.RemoveByKey("Pages/Config/Account.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Account, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
            });
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem()
            {
                Text = Properties.Resources.Save,
                Icon = "Save",
                Enabled = EnableStyle.Modified,
                OnClick = EventCallback.Factory.Create(this, OnSave)
            });

            MenuService.AddMenuItems(new GXMenuItem()
            {
                Text = Properties.Resources.Cancel,
                Icon = "Cancel",
                OnClick = EventCallback.Factory.Create(this, OnCancel)
            });
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                _settings = JsonSerializer.Deserialize<AccountSettings>(Parent.Active.Settings) ?? new AccountSettings();
                MenuService.EditContext = new EditContext(_settings);
                MenuService.EditContext.MarkAsUnmodified();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Account.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingAccount);
        NotificationService?.RemoveByKey("Pages/Config/Account.OnSave");
        try
        {
            if (Parent?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Parent.Active.Settings = JsonSerializer.Serialize(_settings);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson("api/Configuration/Update", arg);
            MenuService.EditContext?.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Account.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
