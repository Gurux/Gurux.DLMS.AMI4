@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@inject HttpClient Http
@implements IGXConfigUpdate

<GXHelpContext Topic="Cron" />

@if (_settings != null)
{
    <p>
        <GXMenuControl RightCorner=true>
            <ChildContent>
                <GXMenuEntry Id="Run" Text="@Properties.Resources.RunCron" OnClick="@OnRun" />
            </ChildContent>
        </GXMenuControl>
    </p>
    <p>
    </p>
    <EditForm EditContext="@MenuService.EditContext">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.LastExecutionTime</label>
                    @if (_settings.Run != null)
                    {
                        <input class="form-control" type="text" readonly="readonly" value="@_settings.Run.ToString()" />
                    }
                    else
                    {
                        <label>@Properties.Resources.Never</label>
                    }
                    <p></p>
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.RunCronEvery</label>
                    <GXInputDropdown class="form-select" RememberValue="false" Items="@Intervals.Keys"
                                     Formatter="@(value => Intervals[value])" @bind-Value="_settings.Interval" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.NextEstimatedRunTime</label>
                    @if (_settings.EstimatedNextTime != null)
                    {
                        <input class="form-control" type="text" readonly="readonly" value="@_settings.EstimatedNextTime.ToString()" />
                    }
                    else
                    {
                        <label>@Properties.Resources.Never</label>
                    }
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    /// <inheritdoc/>
    public void Update()
    {
        if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
        {
            LoadSettings(Parent.Active.Settings);
        }
        InvokeAsync(StateHasChanged);
    }

    Dictionary<int, string> Intervals = new Dictionary<int, string>();

    CronSettings? _settings;

    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new CronSettings()
            : JsonSerializer.Deserialize<CronSettings>(settings) ?? new CronSettings();
        MenuService.EditContext = new EditContext(_settings);
    }


    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        Intervals.Add(0, "Never");
        Intervals.Add(1, "1 hours");
        Intervals.Add(3, "3 hours");
        Intervals.Add(6, "6 hours");
        Intervals.Add(12, "12 hours");
        Intervals.Add(24, "1 day");
        Intervals.Add(24 * 7, "1 week");

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingCron);
            NotificationService?.RemoveByKey("Pages/Config/Cron.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), async (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXConfigurationPolicies.Cron)
                    {
                        if (it.Id == GXCronNotifications.ScheduleUpdated && !string.IsNullOrEmpty(it.Settings))
                        {
                            var runtime = JsonSerializer.Deserialize<CronSettings>(it.Settings);
                            if (runtime != null)
                            {
                                // Runtime timestamps do not modify the editable interval.
                                if (_settings == null)
                                {
                                    LoadSettings(it.Settings);
                                }
                                else
                                {
                                    _settings.Run = runtime.Run;
                                    _settings.EstimatedNextTime = runtime.EstimatedNextTime;
                                }
                            }
                            _ = InvokeAsync(StateHasChanged);
                            break;
                        }
                    }
                    else if (it.Type == GXConfigurationPolicies.Edit && it.Id == Parent?.Active?.Id.ToString()
                        && MenuService.EditContext?.IsModified() != true)
                    {
                        try
                        {
                            //Get configuration data.
                            GXConfiguration? tmp = (await Http.GetAsJsonAsync<GetConfigurationResponse>(string.Format("api/Configuration?id={0}", Parent?.Active?.Id))).Item;
                            if (!string.IsNullOrEmpty(tmp?.Settings) && MenuService.EditContext?.IsModified() != true)
                            {
                                LoadSettings(tmp.Settings);
                                _ = InvokeAsync(StateHasChanged);
                            }
                        }
                        catch (Exception ex)
                        {
                            NotificationService?.ReportError(ex, "Pages/Config/Cron.OnInitialized");
                        }
                    }
                }
            });
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Save, "Save", EventCallback.Factory.Create(this, OnSave), Gurux.UI.Components.Enums.EnableStyle.Modified));
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
            if (!string.IsNullOrEmpty(Parent?.Active?.Settings))
            {
                LoadSettings(Parent.Active.Settings);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Cron.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async void OnSave()
    {
        using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingCron);
        NotificationService?.RemoveByKey("Pages/Config/Cron.OnSave");
        try
        {
            if (Parent?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Parent.Active.Settings = JsonSerializer.Serialize(_settings);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson("api/Configuration/Update", arg);
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Cron.OnSave");
        }
    }

    /// <summary>
    /// Run the cron.
    /// </summary>
    public async Task OnRun()
    {
        using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingCron);
        NotificationService?.RemoveByKey("Pages/Config/Cron.OnRun");
        try
        {
            ConfigurationRunCron req = new ConfigurationRunCron();
            await Http.PostAsJson<ConfigurationRunCronResponse>("api/Configuration/Cron", req);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Cron.OnRun");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
