@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@implements IGXConfigUpdate

@inject HttpClient Http
<GXHelpContext Topic="Security" />

@if (_settings != null)
{
    <EditForm EditContext="@_editContext">
        <p>
            <h2>@Properties.Resources.Password</h2>
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <label>@Properties.Resources.RequiredLength</label>
                        <GXInputNumber RememberValue="false" id="resend" class="form-control"
                                     @bind-Value="_settings.RequiredLength" Min="@GXNumberBounds.Minimum(_settings.RequiredLength)" Max="@GXNumberBounds.Maximum(_settings.RequiredLength)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.RequiredUniqueChars</label>
                        <GXInputNumber RememberValue="false" id="requiredUniqueChars" class="form-control"
                                     @bind-Value="_settings.RequiredUniqueChars" Min="@GXNumberBounds.Minimum(_settings.RequiredUniqueChars)" Max="@GXNumberBounds.Maximum(_settings.RequiredUniqueChars)" />
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireNonAlphanumeric" @bind-Value="_settings.RequireNonAlphanumeric" />
                        <label>@Properties.Resources.RequireNonAlphanumeric</label>
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireLowercase" @bind-Value="_settings.RequireLowercase" />
                        <label>@Properties.Resources.RequireLowercase</label>
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireUppercase" @bind-Value="_settings.RequireUppercase" />
                        <label>@Properties.Resources.RequireUppercase</label>
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireDigit" @bind-Value="_settings.RequireDigit" />
                        <label>@Properties.Resources.RequireDigit</label>
                    </div>
                </div>
            </div>
        </p>
        <hr />
        <p>
            <h2>@Properties.Resources.User</h2>
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <label>@Properties.Resources.AllowedUserNameCharacters</label>
                        <InputText id="allowedUserNameCharacters" class="form-control"
                                   @bind-Value="_settings.AllowedUserNameCharacters" />
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireUniqueEmail" @bind-Value="_settings.RequireUniqueEmail" />
                        <label>@Properties.Resources.RequireUniqueEmail</label>
                    </div>
                </div>
            </div>
        </p>
        <hr />
        <p>
            <h2>@Properties.Resources.SignIn2</h2>
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireConfirmedEmail" @bind-Value="_settings.RequireConfirmedEmail" />
                        <label>@Properties.Resources.RequireConfirmedEmail</label>
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireConfirmedPhoneNumber" @bind-Value="_settings.RequireConfirmedPhoneNumber" />
                        <label>@Properties.Resources.RequireConfirmedPhoneNumber</label>
                    </div>
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="requireConfirmedAccount" @bind-Value="_settings.RequireConfirmedAccount" />
                        <label>@Properties.Resources.RequireConfirmedAccount</label>
                    </div>
                </div>
            </div>
        </p>
        <hr />
        <p>
            <h2>@Properties.Resources.Lockout</h2>
            <div class="row">
                <div style="width:100%">
                    <div class="form-group">
                        <Microsoft.AspNetCore.Components.Forms.InputCheckbox id="allowedForNewUsers" @bind-Value="_settings.AllowedForNewUsers" />
                        <label>@Properties.Resources.AllowedForNewUsers</label>
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.MaximumFailedAccessAttempts</label>
                        <GXInputNumber RememberValue="false" id="maxFailedAccessAttempts" class="form-control"
                                     @bind-Value="_settings.MaxFailedAccessAttempts" Min="@GXNumberBounds.Minimum(_settings.MaxFailedAccessAttempts)" Max="@GXNumberBounds.Maximum(_settings.MaxFailedAccessAttempts)" />
                    </div>
                    <div class="form-group">
                        <label>@Properties.Resources.DefaultLockoutTimespanInMinutes</label>
                        <InputDate Type="@InputDateType.Time" id="defaultLockoutTimeSpan" class="form-control"
                                   @bind-Value="DefaultLockoutTimeSpan" />
                    </div>
                </div>
            </div>
        </p>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;


    /// <inheritdoc/>
    public void Update()
    {
        LoadSettings(Parent?.Active?.Settings);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    DateTime DefaultLockoutTimeSpan
    {
        get
        {
            return new DateTime((_settings ??= new SecuritySettings()).DefaultLockoutTimeSpan.Ticks);
        }
        set
        {
            (_settings ??= new SecuritySettings()).DefaultLockoutTimeSpan = value.TimeOfDay;
        }
    }
    SecuritySettings? _settings;
    private EditContext? _editContext;

    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new SecuritySettings()
            : JsonSerializer.Deserialize<SecuritySettings>(settings) ?? new SecuritySettings();
        _editContext = new EditContext(_settings);
        MenuService.EditContext = _editContext;
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingSecurity);
            NotificationService?.RemoveByKey("Pages/Config/Security.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.Security, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
            });           
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem
            {
                Text = Properties.Resources.Save, Icon = "Save",
                Enabled = Gurux.UI.Components.Enums.EnableStyle.Modified,
                OnClick = EventCallback.Factory.Create(this, OnSave)
            });
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
            LoadSettings(Parent?.Active?.Settings);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Security.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingSecurity);
            NotificationService?.RemoveByKey("Pages/Config/Security.OnSave");
            if (Parent?.Active == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidTarget);
            }
            Parent.Active.Settings = JsonSerializer.Serialize(_settings);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson("api/Configuration/Update", arg);
            _editContext?.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Security.OnSave");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
