@namespace Gurux.DLMS.AMI.Client.Pages.Config
@using Gurux.UI.Components.Enums

<GXHelpContext Topic="PruneAction" />

@if (Action != null)
{
    <div class="prune-row">
        <div class="prune-target">
            <label class="prune-title" for="@_intervalId">@Title</label>
            @if (ChildContent != null)
            {
                <div class="prune-options">@ChildContent</div>
            }
        </div>
        <div class="prune-retention">
            <label class="prune-mobile-label" for="@_intervalId">@Properties.Resources.PruneRetentionPeriod</label>
            <GXInputTimeSpan RememberValue="false" id="@_intervalId" class="form-control"
                             TimeSpanUnit="TimeSpanUnit.Minute"
                             @bind-Value="Action.Interval" />
            <ValidationMessage For="@(() => Action.Interval)" />
        </div>
        <div class="prune-maximum">
            <label class="prune-mobile-label" for="@_maximumId">@Properties.Resources.PruneMaxItemsPerRun</label>
            <InputNumber id="@_maximumId" class="form-control" min="0" step="1"
                         @bind-Value="Action.Maximum" />
            <ValidationMessage For="@(() => Action.Maximum)" />
        </div>
        <div class="prune-execution">
            <span class="prune-mobile-label">@Properties.Resources.LastExecutionTime</span>
            @if (Action.Run is DateTimeOffset run)
            {
                <time datetime="@run.ToString("O")">@run.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)</time>
            }
            else
            {
                <span class="text-muted">@Properties.Resources.Never</span>
            }
        </div>
    </div>
}

@code {
    private readonly string _intervalId = $"prune-interval-{Guid.NewGuid():N}";
    private readonly string _maximumId = $"prune-maximum-{Guid.NewGuid():N}";

    /// <summary>
    /// Custom child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Prune title.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Prune action.
    /// </summary>
    [Parameter]
    public PruneBase? Action { get; set; }

}
