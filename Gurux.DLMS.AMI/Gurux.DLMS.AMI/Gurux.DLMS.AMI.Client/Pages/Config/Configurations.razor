@page "/config"
@page "/config/settings"
@page "/config/{Target}"
@page "/config/{Target}/Groups"
@page "/config/{Target}/Logs"
@page "/config/{Target}/{Id}"
@page "/config/{Target}/{Action}/{Id}"

@using Gurux.DLMS.AMI.Client.Internal
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.DLMS.AMI.Client.Pages.Manufacturer
@using Gurux.DLMS.AMI.Client.Pages.Module
@using Gurux.DLMS.AMI.Shared.DTOs.Menu
@using Gurux.DLMS.AMI.Shared.DIs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = GXConfigurationPolicies.View)]
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest

@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Diagnostics

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@inject ILogger<Configurations> Logger
@inject IGXResourceStorage ResourceStorage

<GXHelpContext Topic="config" />

@if (Target != null && !_configurationReady)
{
    <p><GXLocalizedText Value="@Properties.Resources.Loading3" /></p>
}
else if (Target != null && _configurationType != null)
{
    <DynamicComponent @key="(_configurationType, _active?.Id)" Type="@_configurationType" Parameters="@ConfigurationParameters" />
}
else if (string.Compare(LegacyTarget, GXConfigurations.System, true) == 0)
{
    <SystemConfig Parent="this" @ref="@_updater"></SystemConfig>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Status, true) == 0)
{
    <Status Parent="this" @ref="@_updater"></Status>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Security, true) == 0)
{
    <Security Parent="this" @ref="@_updater"></Security>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Language, true) == 0)
{
    <ConfigurationLanguages AvailableLanguages="@AvailableLanguages" />
    <ModuleViews Area="Gurux.DLMS.AMI.Module.Enums.AmiViewArea.Config" Display="Gurux.DLMS.AMI.Module.Enums.AmiViewDisplay.Append" Target="@this" Parameters="@ConfigurationTabParameters" />
}
else if (string.Compare(LegacyTarget, "agent", true) == 0 ||
         string.Compare(LegacyTarget, "AgentInstallers", true) == 0)
{
    <AgentInstallers Parent="this" @ref="@_updater"></AgentInstallers>
}
else if (string.Compare(LegacyTarget, "Module", true) == 0 ||
        string.Compare(LegacyTarget, "ModuleGroup", true) == 0 ||
        string.Compare(LegacyTarget, "ModuleUpdate", true) == 0 ||
        string.Compare(LegacyTarget, "ModuleManage", true) == 0 ||
        string.Compare(LegacyTarget, "ModuleUpdate", true) == 0 ||
        string.Compare(LegacyTarget, "ModuleLog", true) == 0)
{
    <ModuleManage Action="@GetAction()"
                  Path="@("config/" + LegacyTarget)"
                  Id="@Id"
                  Parent="this"></ModuleManage>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Manufacturer, true) == 0)
{
    <ManufacturerManage Path="@("config/" + LegacyTarget)"
                        Action="@Action"
                        Id="@GetId()"
                        Parent="this"
                        @ref="@_updater"></ManufacturerManage>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Cron, true) == 0)
{
    <Cron Parent="this" @ref="@_updater"></Cron>
}

else if (string.Compare(LegacyTarget, GXConfigurations.Maintenance, true) == 0)
{
    <Maintenance Parent="this" @ref="@_updater"></Maintenance>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Prune, true) == 0)
{
    <Prune Parent="this" @ref="@_updater"></Prune>
}
else if (string.Compare(LegacyTarget, GXConfigurations.Account, true) == 0)
{
    <Account Parent="this" @ref="@_updater"></Account>
}
else
{
    <GXTabControl PersistSelectionInUrl="true" RouteGroup="config" Active="@(GXTabRoutes.Active(NavigationManager, "config", 0, null))">
        <TabTextTemplate>
            <GXImage Id="@context.Icon" />
            <GXLocalizedText Value="@ConfigurationTabTitle(context)" />
        </TabTextTemplate>
        <ChildContent>
            <TabHeader Name="@GXMenus.ConfigurationTab" Parameters="@ConfigurationTabParameters" />
            <ModuleTabs Area="Gurux.DLMS.AMI.Module.Enums.AmiViewArea.Config" Target="@this" Parameters="@ConfigurationTabParameters" />
        </ChildContent>
    </GXTabControl>
    <ModuleViews Area="Gurux.DLMS.AMI.Module.Enums.AmiViewArea.Config" Display="Gurux.DLMS.AMI.Module.Enums.AmiViewDisplay.Append" Target="@this" Parameters="@ConfigurationTabParameters" />
}
@code {
    private static string? ConfigurationTabTitle(GXTabPage page) =>
        string.Equals(page.Path?.Trim('/'), "config/settings", StringComparison.OrdinalIgnoreCase) && page.Text == "Update settings"
            ? Properties.Resources.ConfigurationLayout : page.Text;

    private IDictionary<string, object> ConfigurationTabParameters => new Dictionary<string, object>
    {
        ["Parent"] = this
    };

    internal async Task ConfigurationLinksSavedAsync(GXMenu menu)
    {
        var snapshot = System.Text.Json.JsonSerializer.Deserialize<GXMenuLink[]>(System.Text.Json.JsonSerializer.Serialize(menu.Links));
        _configurationLinks = snapshot?.Where(l => l.Configuration?.Name != GXConfigurations.Performance && !string.Equals(l.Url, "config/performance", StringComparison.OrdinalIgnoreCase)).OrderBy(l => l.Order).ToArray() ?? [];
        await Updated();
        await InvokeAsync(StateHasChanged);
    }

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    //Availalble languages.
    readonly List<GXLanguage> AvailableLanguages = new List<GXLanguage>();
    /// <summary>
    /// Cached configurations.
    /// </summary>
    GXMenuLink[]? _configurationLinks;
    private IAmiMenuStorage? _menuStorage;
    private bool _configurationReady;
    private bool _disposed;
    private string? _loadedTarget;
    private Type? _configurationType;
    private long _configurationGeneration;

    private IDictionary<string, object>? ConfigurationParameters
    {
        get
        {
            if (_configurationType == null)
            {
                return null;
            }
            var idType = _configurationType.GetProperty("Id")?.PropertyType;
            object? id = idType == typeof(Guid?) || idType == typeof(Guid)
                ? Guid.TryParse(Id, out var parsed) ? parsed : null : Id;
            object? action = _configurationType.GetProperty("Action")?.PropertyType == typeof(CrudAction)
                ? ClientHelpers.GetAction(NavigationManager, GetAction()) : GetAction();
            return GXTabParameters.Filter(_configurationType, new Dictionary<string, object>
            {
                ["Parent"] = this,
                ["Active"] = _active!,
                ["Id"] = id!,
                ["Action"] = action!,
                ["Path"] = "config/" + LegacyTarget
            });
        }
    }

    IGXConfigUpdate? _updater;
    GXConfiguration? _active;
    /// <summary>
    /// Selected item.
    /// </summary>
    public GXConfiguration? Active
    {
        get
        {
            if (_active != null)
            {
                return _active;
            }
            return table?.Active?.Configuration;
        }
    }

    /// <summary>
    /// Filter.
    /// </summary>
    public string? Filter { get; set; }

    /// <summary>
    /// Configuration target.
    /// </summary>
    [Parameter]
    public string? Target { get; set; }

    private string? LegacyTarget => GXConfigurationRoutes.LegacyTarget(Target);

    /// <summary>
    /// Configuration action.
    /// </summary>
    [Parameter]
    public string? Action { get; set; }

    /// <summary>
    /// Configuration target ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    private Guid? GetId()
    {
        if (string.IsNullOrEmpty(Id))
        {
            return null;
        }
        return Guid.Parse(Id);
    }

    /// <summary>
    /// Optional string is causing problems with route constraints and it must handle as a special case.
    /// </summary>
    /// <returns>Action.</returns>
    private string? GetAction()
    {
        if (string.Compare(Id, "Add", true) == 0)
        {
            Action = Id;
            Id = null;
        }
        return Action;
    }

    private static string GetPath(GXMenuLink target) => target.Url ?? "/Config";
    private static string? GetName(GXMenuLink target) => target.Name;
    private static string? GetDescription(GXMenuLink target) => target.Description;

    /// <summary>
    /// Table reference.
    /// </summary>
    internal GXTable<GXMenuLink>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    internal async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Config/Configurations.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Configurations.Updated");
        }
    }

    private ItemsProviderResult<GXMenuLink> GetFilteredItems(GXItemsProviderRequest request)
    {
        var list = new List<GXMenuLink>();
        if (_configurationLinks != null)
        {
            int total = _configurationLinks.Length;
            if (!string.IsNullOrEmpty(Filter))
            {
                string filter = Filter.ToLower();
                foreach (var it in _configurationLinks)
                {
                    if (IsFiltered(it, filter))
                    {
                        list.Add(it);
                    }
                }
            }
            else
            {
                list.AddRange(_configurationLinks);
            }
            var ordered = request.OrderBy == nameof(GXMenuLink.Name) && request.Descending
                ? list.OrderByDescending(GetName, StringComparer.CurrentCultureIgnoreCase)
                : list.OrderBy(GetName, StringComparer.CurrentCultureIgnoreCase);
            return new ItemsProviderResult<GXMenuLink>(ordered, list.Count);
        }
        return default;
    }

    /// <summary>
    /// Is configuration filtered.
    /// </summary>
    /// <param name="value">Configuration</param>
    /// <param name="filter">filter</param>
    /// <returns>True, if configuration is shown.</returns>
    private bool IsFiltered(GXMenuLink value, string filter)
    {
        return (GetName(value)?.ToLower().Contains(filter) == true
            || GetDescription(value)?.ToLower().Contains(filter) == true);
    }

    internal async ValueTask<ItemsProviderResult<GXMenuLink>> GetItems(GXItemsProviderRequest request)
    {
        if (_configurationLinks == null)
        {
            try
            {
                _menuStorage ??= Services.GetRequiredService<IAmiMenuStorage>();
                var menu = await _menuStorage.GetMenuAsync(GXMenus.ConfigurationMenu);
                _configurationLinks = menu?.Links?.Where(l => l.Configuration?.Name != GXConfigurations.Performance && !string.Equals(l.Url, "config/performance", StringComparison.OrdinalIgnoreCase)).OrderBy(l => l.Order).ToArray() ?? [];
            }
            catch (TaskCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                NotificationService?.ReportError(ex, "Configurations.GetItems");
            }
        }
        return GetFilteredItems(request);
    }

    private void ConfigurationMenuChanged(object? sender, GXMenuChangedEventArgs args)
    {
        if (_disposed || args.Name != GXMenus.ConfigurationMenu)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }
            _configurationLinks = args.Menu?.Links?.Where(l => l.Configuration?.Name != GXConfigurations.Performance && !string.Equals(l.Url, "config/performance", StringComparison.OrdinalIgnoreCase)).OrderBy(l => l.Order).ToArray() ?? [];
            await Updated();
            StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_configurationReady && string.Equals(_loadedTarget, Target, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        var generation = ++_configurationGeneration;
        bool Current() => !_disposed && generation == _configurationGeneration;
        var target = Target;
        _loadedTarget = Target;
        _configurationReady = false;
        _active = null;
        _configurationType = null;
        try
        {
            GXConfiguration? active = null;
            Type? type = null;
            if (target != null)
            {
                _menuStorage ??= Services.GetRequiredService<IAmiMenuStorage>();
                var menu = await _menuStorage.GetMenuAsync(GXMenus.ConfigurationMenu);
                if (!Current())
                {
                    return;
                }

                var path = "config/" + target;
                var link = menu?.Links?.FirstOrDefault(l => string.Equals(GXConfigurationRoutes.Canonicalize(l.Url?.Trim('/') ?? string.Empty), GXConfigurationRoutes.Canonicalize(path), StringComparison.OrdinalIgnoreCase));
                if (link?.Configuration != null)
                {
                    active = (await Http.GetAsJsonAsync<GetConfigurationResponse>("api/Configuration?id=" + link.Configuration.Id))?.Item;
                }

                if (!string.IsNullOrWhiteSpace(link?.TargetType))
                {
                    type = Type.GetType(link.TargetType);
                }
            }

            if (!Current())
            {
                return;
            }

            _active = active;
            _configurationType = type;
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            if (Current())
            {
                NotificationService?.ReportError(ex, "Configurations.Load");
            }
        }
        if (Current())
        {
            _configurationReady = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        _menuStorage = Services.GetRequiredService<IAmiMenuStorage>();
        _menuStorage.MenuChanged += ConfigurationMenuChanged;
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingConfigurations);
            NotificationService?.RemoveByKey("Pages/Config/Configurations.OnInitializedAsync");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXConfigurationPolicies.Edit)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Configurations.OnInitializedAsync");
        }
    }

    /// <summary>
    /// Edit configuration.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Configurations.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            ClientHelpers.NavigateTo(NavigationManager, GetPath(table.Active));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Configurations.OnEdit");
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ++_configurationGeneration;
        if (_menuStorage != null)
        {
            _menuStorage.MenuChanged -= ConfigurationMenuChanged;
        }
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
