@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.DLMS.AMI.Shared.DIs

@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Client.Helpers
@using Gurux.DLMS.AMI.Module

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IGXResourceStorage ResourceStorage

@implements IDisposable

<GXHelpContext Topic="Localization" />

@if (Active?.Language != null)
{
    <GXDialog OnCancel="Cancel"
            CancelButtonTitle="@Properties.Resources.Cancel"
            OkButtonTitle="@Properties.Resources.Ok"
            OnOk="Save">
        <EditForm EditContext="@GXEditContexts.For(Active)">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <GXValidator @ref="_validator" OnValidate="OnValidate" />
            <label>@Properties.Resources.Language</label>
            <label class="form-control">@GetLanguage(Active)</label>
            <GXCopyButton Value="@Active.Value">@Properties.Resources.Text</GXCopyButton>
            <InputText id="description" @bind-Value="Active.Value" class="form-control" />
            <GXInputSwitch Text="@Properties.Resources.Preload" @bind-Value="Active.Preload" />
        </EditForm>
    </GXDialog>
}

<GXViewTable ViewName="Config.Localization" ViewColumns="ViewColumnDefaults" ViewPolicies="@(new List<string> { GXLocalizationPolicies.View })" TItem="GXLocalizedResource" @ref="table"
         Context="item"
         ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Single"
         ShowAllUsers="false"
         ShowRemoved="false"
         OnSearch="@Updated">
    <FilterContent>
        <GXFh Id="Value">
            <GXSearch id="localization-search-value"
                    Immediate="true"
                    RememberValue="true"
                    @bind-Value="filter.Value"
                    @bind-Value:after="Updated" />
        </GXFh>
        <GXFh Id="CreationTime" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="localization-creationTime"
                                @bind-Value="@filter.CreationTime"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Updated" Visibility="Visibility.Medium">
            <GXDateTimeSelector Id="localization-updated"
                                @bind-Value="@filter.Updated"
                                Placeholder="@Properties.Resources.FilterByCreationTime">
            </GXDateTimeSelector>
        </GXFh>
        <GXFh Id="Status" Visibility="Visibility.Medium">
            <EnumTypeSelector Type="@TargetType.LocalizedResource"
                              @bind-Value="@filter.Status"
                              OnSelected="@((int? e) => Updated())">
            </EnumTypeSelector>
        </GXFh>
    </FilterContent>
    <MenuContent>
        <GXContextMenuItem Text="@Properties.Resources.Edit" Id="edit" OnClick="@OnEdit" Policy="@GXLocalizationPolicies.Edit"></GXContextMenuItem>
    </MenuContent>
    <HeaderContent>
        <GXTh Name="Value" Target="@item">@Properties.Resources.Value</GXTh>
        <GXTh Name="CreationTime" Target="@item">@Properties.Resources.CreationTime</GXTh>
        <GXTh Name="Updated" Target="@item">@Properties.Resources.Updated</GXTh>
        <GXTh Name="Status" Target="@item">@Properties.Resources.Status</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Id="Value">
            @if (item.Hash != null && LocalizedTexts.ContainsKey(item.Hash) && LocalizedTexts[item.Hash].Any())
            {
                <GXAccordion Id="content-type-authoring">
                    <HeaderTemplate>
                        <div>
                            <GXLinkButton TItem="GXLocalizedResource" Target="@item" OnClick="@Edit" Text="@item.Value" /><br />
                        </div>
                    </HeaderTemplate>
                    <ChildContent>
                        @foreach (var it in LocalizedTexts[item.Hash])
                        {
                            <div class="form-group">
                                <label>@GetLanguage(it)</label>
                                <GXLinkButton TItem="GXLocalizedResource" Target="@it" OnClick="@Edit" Text="@it.Value" /><br />
                            </div>
                        }
                    </ChildContent>
                </GXAccordion>
            }
            else
            {
                <GXLinkButton TItem="GXLocalizedResource" Target="@item" OnClick="@Edit" Text="@item.Value" />
            }
        </GXTd>
        <GXTd Id="CreationTime">@item.CreationTime</GXTd>
        <GXTd Id="Updated">@item.Updated</GXTd>
        <GXTd Id="Status">@(ResourceStorage.GetEnumType(TargetType.LocalizedResource, item.Status))</GXTd>
    </ItemContent>
</GXViewTable>
<br />

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Value") { Position = 0, Description = "Value", Visibility = (byte)Visibility.All },
        new("CreationTime") { Position = 1, Description = "CreationTime", Visibility = (byte)Visibility.All },
        new("Updated") { Position = 2, Description = "Updated", Visibility = (byte)Visibility.All },
        new("Status") { Position = 3, Description = "Status", Visibility = (byte)Visibility.All },
    ];

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public List<GXLanguage> AvailableLanguages { get; set; } = new List<GXLanguage>();
    private readonly Dictionary<string, List<GXLocalizedResource>> LocalizedTexts = new();
    internal GXLanguage[]? Installedlanguages = null;

    private GXValidator? _validator;

    /// <summary>
    /// Selected resource ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    GXLocalizedResource? Active;

    /// <summary>
    /// Amount of the resources shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    /// <summary>
    /// Resource filter.
    /// </summary>
    private GXLocalizedResource filter = new GXLocalizedResource()
    {
    };

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXLocalizedResource>? table;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Config/Localization.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Localization.Updated");
        }
    }

    private string? GetLanguage(GXLocalizedResource value)
    {
        var lang = AvailableLanguages.Where(w => w.Id == value.Language?.Id).SingleOrDefault();
        if (lang != null)
        {
            return lang.NativeName + " (" + lang.EnglishName + ")";
        }
        return value.Language?.Id;
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingLocalization);
            NotificationService?.RemoveByKey("Pages/Config/Localization.OnInitialized");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Localization.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXLocalizedResource>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope2 = Progress?.ProgressStart(GXProgress.RetrievingLocalization);
        try
        {
            //Get enum types.
            await ResourceStorage.RefreshEnumTypesAsync(TargetType.LocalizedResource);
            ListLocalizedResources req = new ListLocalizedResources()
            {
                Index = request.StartIndex,
                Count = request.Count,
                Filter = new GXLocalizedResource(),
                OrderBy = request.OrderBy,
                Descending = request.Descending,
            };
            var lang = AvailableLanguages.Where(w => w.Enabled == true && w.Default == true).SingleOrDefault();
            req.Filter.Language = lang == null ? null : new() { Id = lang.Id };
            req.Filter.Value = filter.Value;
            req.Filter.Status = filter.Status;
            if (filter.CreationTime != null && filter.CreationTime != DateTimeOffset.MinValue)
            {
                req.Filter.CreationTime = filter.CreationTime;
            }
            if (filter.Updated != null && filter.Updated != DateTimeOffset.MinValue)
            {
                req.Filter.Updated = filter.Updated;
            }
            if (Count != 0)
            {
                req.Count = Count;
            }
            //Get localized texts.
            req.Select = [TargetType.Language];
            var ret = await Http.PostAsJson<ListLocalizedResourcesResponse>("api/LocalizedResource/List", req, request.CancellationToken);
            if (ret.LocalizedResources != null)
            {
                LocalizedTexts.Clear();
                List<GXLocalizedResource> tmp = new();
                //Group texts by language.
                foreach (var it in ret.LocalizedResources)
                {
                    if (it.Hash == null)
                    {
                        continue;
                    }
                    if (LocalizedTexts.ContainsKey(it.Hash))
                    {
                        //Localized language.
                        LocalizedTexts[it.Hash].Add(it);
                    }
                    else
                    {
                        //Default language.
                        LocalizedTexts[it.Hash] = new();
                        tmp.Add(it);
                    }
                }
                return new ItemsProviderResult<GXLocalizedResource>(tmp, ClientHelpers.ToVirtualizedCount(ret.Count));
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    /// <summary>
    /// Edit localized resource.
    /// </summary>

    private void Edit(GXLocalizedResource value)
    {
        Active = ClientHelpers.Clone<GXLocalizedResource>(value);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Validate the object content.
    /// </summary>
    /// <param name="sender"></param>
    private void OnValidate(GXValidator sender)
    {
        if (Active != null)
        {
            if (string.IsNullOrEmpty(Active.Value))
            {
                sender.AddError(() => Active.Value, Properties.Resources.InvalidText);
            }
        }
    }

    /// <summary>
    /// Edit image.
    /// </summary>
    public void OnEdit()
    {
        try
        {
            NotificationService?.RemoveByKey("Pages/Config/Localization.OnEdit");
            if (table?.Active == null)
            {
                throw new Exception(Properties.Resources.NoItemIsSelected);
            }
            Edit(table.Active);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/Localization.OnEdit");
        }
    }

    /// <summary>
    /// Save icon.
    ///</summary>
    public async Task Save()
    {
        try
        {
            _validator?.ClearErrors();
            if (_validator != null &&
                !await _validator.ValidateAsync())
            {
                return;
            }
            if (Active == null)
            {
                return;
            }
            UpdateLocalizedResource req = new UpdateLocalizedResource()
            {
                LocalizedResources = [Active]
            };
            await Http.PostAsJson<UpdateLocalizedResourceResponse>("api/LocalizedResource/Update", req);
            Active = null;
            if (table != null)
            {
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
    }


    /// <summary>
    /// Hide icon dlg.
    /// </summary>
    public void Cancel()
    {
        Active = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}

