@using Gurux.DLMS.AMI.Shared.DTOs.View
@using Gurux.UI.Components.Enums
@using Gurux.UI.Components.Accordion
@using Gurux.DLMS.AMI.Shared.DTOs.Authentication
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Shared.Rest
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
<GXHelpContext Topic="RoleEditor" />

<h1>@Properties.Resources.Roles</h1>
<hr />
<GXViewTable ViewName="Config.RoleEditor" ViewColumns="RoleColumnDefaults" ViewPolicies="@(new List<string> { GXRolePolicies.View })" TItem="GXRole" @ref="table"
             Context="it"
             ItemsProvider="@GetItems"
             SelectionMode="@SelectionMode"
             OnSearch="@Update"
             ShowAllUsers="false"
             ShowRemoved="false"
             Filter="false"
             ShowAllData="true">
    <FilterContent>
        @if (Edit)
        {
            <GXFh Id="Default"></GXFh>
        }
        <GXFh Id="Name">
            <GXSearch Placeholder="@Properties.Resources.FilterByName"
                    Id="roles.filter"
                    Immediate="true"
                    @bind-Value="@Filter"
                    @bind-Value:after="Update" />
        </GXFh>
        @if (!AssignmentMode)
        {
            <GXFh Id="Permissions"></GXFh>
        }
    </FilterContent>
    <MenuContent>
    </MenuContent>
    <HeaderContent>
        @if (Edit)
        {
            <GXTh Id="Default" TItem="GXRole">
                @(AssignmentMode? Properties.Resources.Roles : Properties.Resources.DefaultRole)
                @if (AssignmentMode)
                {
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="roles_all"
                           disabled="@(AssignmentMode && AdminSelected)"
                           @onchange="@((ChangeEventArgs __e) => AllDefault(Convert.ToBoolean(__e.Value)))" />
                    <label>@Properties.Resources.Roles</label>
                </div>
                }
            </GXTh>
        }
        <GXTh Id="Name" TItem="GXRole">@Properties.Resources.Name</GXTh>
        @if (!AssignmentMode)
        {
            <GXTh Id="Permissions" TItem="GXRole"><GXLocalizedText Value="@Properties.Resources.Permissions" /></GXTh>
        }
    </HeaderContent>
    <ItemContent>
        @if (Edit)
        {
            <GXTd Id="Default">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="@(AssignmentMode ? "checkbox" : "radio")" name="roles_default"
                           checked="@it.Default"
                           disabled="@(AssignmentMode ? AdminSelected && !IsAdmin(it) : !CanEditRole(it) || !_canEdit)"
                           @onchange="@((e) => Check(it, AssignmentMode ? Convert.ToBoolean(e.Value) : true))" />
                </div>
            </GXTd>
        }
        <GXTd Id="Name">
            @if (!AssignmentMode && CanEditRole(it) && EditingRoles.Contains(it))
            {
                <label>@Properties.Resources.Name</label>
                <input class="form-control" maxlength="256" readonly="@(it.SystemDefined == true)" @bind="it.Name" @bind:event="oninput" @bind:after="Changed" />
                <label>@Properties.Resources.Description</label>
                <textarea class="form-control" @bind="it.Description" @bind:event="oninput" @bind:after="Changed"></textarea>
            }
            else
            {
            <GXLocalizedText Value="@ClientHelpers.KebabToTitle(it.Name)" />
                @if (!AssignmentMode && !string.IsNullOrEmpty(it.Description))
                {
                    <div class="small text-muted">@it.Description</div>
                }
            }
        </GXTd>
        @if (!AssignmentMode)
        {
            <GXTd Id="Permissions">
                @if (IsAdmin(it))
                {
                    <GXLocalizedText Value="@Properties.Resources.All" />
                }
                else if (AssignmentMode || !CanEditRole(it))
                {
                    @string.Join(", ", it.Permissions?.Select(p => p.Name) ?? Enumerable.Empty<string?>())
                }
                else
                {
                    <GXAccordion Id="@($"role-permissions-{it.Id}")">
                        <HeaderTemplate>
                            @string.Join(", ", it.Permissions?.Select(p => p.Name) ?? Enumerable.Empty<string?>())
                        </HeaderTemplate>
                        <ChildContent>
                            @foreach (var permission in PermissionCatalog.Concat(it.Permissions ?? new List<GXPermission>()).DistinctBy(p => p.Name))
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@(it.Permissions?.Any(p => string.Equals(p.Name, permission.Name, StringComparison.OrdinalIgnoreCase)) == true)"
                                           @onchange="@(e => CheckPermission(it, permission, Convert.ToBoolean(e.Value)))" />
                                    <label class="form-check-label">@permission.Name</label>
                                </div>
                            }
                        </ChildContent>
                    </GXAccordion>
                }
            </GXTd>
        }
    </ItemContent>
</GXViewTable>

@code {
    private static readonly GXViewColumn[] ViewColumnDefaults =
    [
        new("Default") { Position = 0, Description = "DefaultRole", Visibility = (byte)Visibility.All },
        new("Name") { Position = 1, Description = "Name", Visibility = (byte)Visibility.All },
        new("Permissions") { Position = 2, Description = "Permissions", Visibility = (byte)Visibility.All },
    ];

    private IReadOnlyList<GXViewColumn> RoleColumnDefaults => ViewColumnDefaults
        .Where(column => (Edit || column.Name != "Default") &&
            (!AssignmentMode || column.Name == "Default" || column.Name == "Name"))
        .ToArray();

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier2>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }
    }

    private IGXNotifier2? Notifier;
    private bool _canEdit;
    private bool _canAdd;
    private bool CanEditRole(GXRole role) => Edit && (string.IsNullOrEmpty(role.Id) ? _canAdd : _canEdit);

    private IGXNotificationService? NotificationService;

    /// <summary>
    /// User can't edit roles if Edit is false.
    /// This is used when showing the default roles of a user, so they can't be edited.
    /// </summary>
    [Parameter]
    public bool Edit { get; set; }
    [Parameter]
    public bool AssignmentMode { get; set; }
    [Parameter]
    public Gurux.UI.Components.Table.SelectionMode SelectionMode { get; set; } = Gurux.UI.Components.Table.SelectionMode.Single;

    public GXRole[] SelectedRoles => table?.SingleOrDefault().ToArray() ?? [];
    public HashSet<GXRole> EditingRoles { get; } = new();
    private Task Changed() => OnChanged.InvokeAsync(Roles);

    public async Task EditRoles(IEnumerable<GXRole> roles)
    {
        foreach (var role in roles)
        {
            EditingRoles.Add(role);
        }
        await Update();
        await InvokeAsync(StateHasChanged);
    }
    [Parameter]
    public IEnumerable<GXPermission> PermissionCatalog { get; set; } = Array.Empty<GXPermission>();

    [Parameter]
    public List<GXRole>? Roles { get; set; }

    [Parameter]
    public EventCallback<List<GXRole>> OnChanged { get; set; }

    /// <summary>
    /// Filter.
    /// </summary>
    public string? Filter { get; set; }

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXRole>? table;

    private static bool IsAdmin(GXRole role) => string.Equals(role.Name, GXRoles.Admin, StringComparison.OrdinalIgnoreCase);
    private bool AdminSelected => Roles?.Any(r => IsAdmin(r) && r.Default == true) == true;

    protected override async Task OnParametersSetAsync()
    {
        if (!AssignmentMode)
        {
            var authorization = Services.GetService<IAuthorizationService>();
            var authentication = Services.GetService<AuthenticationStateProvider>();
            if (authorization != null && authentication != null)
            {
                var user = (await authentication.GetAuthenticationStateAsync()).User;
                _canEdit = (await authorization.AuthorizeAsync(user, GXRolePolicies.Edit)).Succeeded;
                _canAdd = (await authorization.AuthorizeAsync(user, GXRolePolicies.Add)).Succeeded;
            }
        }
        if (AssignmentMode && AdminSelected && Roles != null)
        {
            foreach (var role in Roles.Where(r => !IsAdmin(r)))
            {
                role.Default = false;
            }
        }
    }

    /// <summary>
    /// Check or uncheck a role as default.
    /// </summary>
    /// <param name="role">The role to check or uncheck.</param>
    /// <param name="check">True to set as default, false to unset.</param>
    private void Check(GXRole role, bool check)
    {
        if (!AssignmentMode)
        {
            if (!check || Roles == null)
            {
                return;
            }
            foreach (var other in Roles)
            {
                other.Default = ReferenceEquals(other, role);
            }
        }
        if (AssignmentMode && AdminSelected && !IsAdmin(role))
        {
            return;
        }
        role.Default = check;
        if (AssignmentMode && check && IsAdmin(role) && Roles != null)
        {
            foreach (var other in Roles.Where(r => !IsAdmin(r)))
            {
                other.Default = false;
            }
        }
        if (OnChanged.HasDelegate)
        {
            OnChanged.InvokeAsync(Roles);
        }
    }

    /// <summary>
    /// Set or unset all roles to default.
    /// </summary>
    /// <param name="check"></param>
    private void AllDefault(bool check)
    {
        if (!AssignmentMode)
        {
            return;
        }
        if (AssignmentMode && AdminSelected)
        {
            return;
        }
        if (Roles != null)
        {
            foreach (var it in Roles)
            {
                if (it.Name != GXRoles.Admin)
                {
                    it.Default = check;
                }
            }
            if (OnChanged.HasDelegate)
            {
                OnChanged.InvokeAsync(Roles);
            }
        }
    }

    /// <summary>
    /// Check the permission.
    /// </summary>
    /// <param name="permission"></param>
    private void CheckPermission(GXRole role, GXPermission permission, bool selected)
    {
        role.Permissions ??= new List<GXPermission>();
        role.Permissions.RemoveAll(p => string.Equals(p.Name, permission.Name, StringComparison.OrdinalIgnoreCase));
        if (selected)
        {
            role.Permissions.Add(permission.Clone());
        }
        if (OnChanged.HasDelegate)
        {
            _ = OnChanged.InvokeAsync(Roles);
        }
    }
    private ValueTask<ItemsProviderResult<GXRole>> GetItems(GXItemsProviderRequest request)
    {
        List<GXRole>? list;
        if (string.IsNullOrEmpty(Filter))
        {
            list = Roles;
        }
        else
        {
            list = Roles?.Where(w => w.Name?.ToLower().Contains(Filter.ToLower()) == true).ToList();
        }
        if (list != null)
        {
            return new(new ItemsProviderResult<GXRole>(list, list.Count));
        }
        return default;
    }

    /// <summary>
    /// Update virtualized items.
    /// </summary>
    public async Task Update()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Pages/Config/RoleEditor.Update");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/RoleEditor.Update");
        }
    }

    public void Dispose()
    {
        Notifier?.RemoveListener(this);
    }
}
