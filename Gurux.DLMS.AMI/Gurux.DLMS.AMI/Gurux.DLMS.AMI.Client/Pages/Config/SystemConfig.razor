@using Gurux.DLMS.AMI.Script
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.DIs

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Globalization
@using System.Text
@using System.Text.Json
@using Gurux.DLMS.AMI.Script.Pages

@using Microsoft.Extensions.Logging

@namespace Gurux.DLMS.AMI.Client.Pages.Config

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IGXMenuService SharedMenuService
@implements IDisposable
@implements IGXConfigUpdate

@inject HttpClient Http
<GXHelpContext Topic="SystemConfig" />

@if (_settings != null)
{
    <EditForm EditContext="@_editContext">
        <div class="row">
            <div style="width:100%">
                <div class="form-group">
                    <label>@Properties.Resources.SizeOfTheDatabaseConnectionPool</label>
                    <GXInputNumber RememberValue="false" id="poolSize" class="form-control"
                                 @bind-Value="_settings.PoolSize" Min="@GXNumberBounds.Minimum(_settings.PoolSize)" Max="@GXNumberBounds.Maximum(_settings.PoolSize)" />
                </div>
                <div class="form-group">
                    <label>@Properties.Resources.SiteEmailAddress</label>
                    <InputText id="siteEmailAddress" class="form-control"
                               @bind-Value="_settings.SiteEmailAddress" />
                </div>
            </div>
        </div>
        <button type="button" style="float: right;" class="btn btn-danger"
                @onclick="() => OnRestart()">
            @Gurux.DLMS.AMI.Client.Properties.Resources.Restart
        </button>
    </EditForm>
}

@code {
    private GXPageMenu? _pageMenu;
    private GXPageMenu MenuService => _pageMenu ??= new GXPageMenu(SharedMenuService);

    private readonly Gurux.DLMS.AMI.Client.Pages.Config.GXConfigurationRefresh _configurationRefresh = new();

    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    /// <inheritdoc/>
    public void Update()
    {
        LoadSettings(Parent?.Active?.Settings);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Parent component.
    /// </summary>
    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Config.Configurations? Parent { get; set; }

    SystemSettings? _settings;
    private EditContext? _editContext;

    private void LoadSettings(string? settings)
    {
        _settings = string.IsNullOrEmpty(settings) ? new SystemSettings()
            : JsonSerializer.Deserialize<SystemSettings>(settings) ?? new SystemSettings();
        _editContext = new EditContext(_settings);
        MenuService.EditContext = _editContext;
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingSystemConfig);
            NotificationService?.RemoveByKey("Pages/Config/SystemConfig.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                _ = InvokeAsync(() => _configurationRefresh.RefreshAsync(Http, items, GXConfigurations.System, configuration =>
                {
                    if (Parent?.Active?.Id != configuration.Id) {
                        return;
                    }
                    Parent.Active.Settings = configuration.Settings;
                    Update();
                }, () => MenuService.EditContext?.IsModified() != true, NotificationService));
            });
            MenuService.Clear();
            MenuService.AddMenuItems(new GXMenuItem
            {
                Text = Properties.Resources.Save, Icon = "Save",
                Enabled = Gurux.UI.Components.Enums.EnableStyle.Modified,
                OnClick = EventCallback.Factory.Create(this, OnSave)
            });
            MenuService.AddMenuItems(new GXMenuItem(Properties.Resources.Cancel, "Cancel", EventCallback.Factory.Create(this, OnCancel)));
            LoadSettings(Parent?.Active?.Settings);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/SystemConfig.OnInitialized");
        }
    }

    /// <summary>
    /// Save values.
    /// </summary>
    private async Task OnSave()
    {
        try
        {
            using var progressScope2 = Progress?.ProgressStart(GXProgress.SavingSystemConfig);
            NotificationService?.RemoveByKey("Pages/Config/SystemConfig.OnSave");
            if (Parent?.Active == null)
            {
                throw new Exception(Properties.Resources.InvalidTarget);
            }
            Parent.Active.Settings = JsonSerializer.Serialize(_settings);
            ConfigurationUpdate arg = new ConfigurationUpdate();
            arg.Configurations = new GXConfiguration[] { Parent.Active };
            await Http.PostAsJson<ConfigurationUpdateResponse>("api/Configuration/Update", arg);
            _editContext?.MarkAsUnmodified();
            ClientHelpers.NavigateToLastPage(NavigationManager);
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/SystemConfig.OnSave");
        }
    }

    /// <summary>
    /// Restart the application.
    /// </summary>
    private async void OnRestart()
    {
        using var progressScope3 = Progress?.ProgressStart(GXProgress.SavingSystemConfig);
        NotificationService?.RemoveByKey("Pages/Config/SystemConfig.OnRestart");
        try
        {
            StopApplicationRequest req = new StopApplicationRequest();
            await Http.PostAsJson("api/Configuration/Restart", req);
            NotificationService?.Add(new GXNotificationItem(Gurux.UI.Components.Enums.NotificationLevel.Information, Properties.Resources.SystemRestarted, string.Empty, Closable: false));
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Pages/Config/SystemConfig.OnRestart");
        }
    }

    /// <summary>
    /// Cancel update.
    ///</summary>
    private void OnCancel()
    {
        ClientHelpers.NavigateToLastPage(NavigationManager);
    }

    public void Dispose()
    {
        _configurationRefresh.Dispose();
        MenuService.Dispose();
        Notifier?.RemoveListener(this);
    }
}
