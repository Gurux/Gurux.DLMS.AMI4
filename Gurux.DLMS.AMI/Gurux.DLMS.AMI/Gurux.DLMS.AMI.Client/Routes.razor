@inject NavigationManager NavigationManager

<Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="CanonicalizeConfigurationRoute">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@Properties.Resources.NotFound</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <NotFoundPage></NotFoundPage>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private Task CanonicalizeConfigurationRoute(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        var canonical = Gurux.DLMS.AMI.Client.Helpers.GXConfigurationRoutes.Canonicalize(context.Path);
        if (!string.Equals(context.Path, canonical, StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(canonical, replace: true);
        }
        return Task.CompletedTask;
    }
}
