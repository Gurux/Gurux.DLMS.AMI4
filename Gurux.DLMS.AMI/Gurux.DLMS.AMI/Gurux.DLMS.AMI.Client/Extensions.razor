@page "/extensions"

@using Gurux.DLMS.AMI.Shared.DIs
@using Gurux.DLMS.AMI.Shared.DTOs.Enums

@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Gurux.DLMS.AMI.Shared.DTOs
@using Gurux.DLMS.AMI.Shared.Rest
@using Gurux.DLMS.AMI.Shared
@using Gurux.DLMS.AMI.Shared.Enums
@using Gurux.DLMS.AMI.Module
@using System.Text.Json
@using Gurux.DLMS.AMI.Module.Enums
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ModuleLoader Loader
@implements IDisposable
@implements IGXAmiComponent

@if (Title)
{
    <h1>@Properties.Resources.Extensions</h1>
}

<GXTable TItem="GXModule" @ref="table"
         @bind-Active="Active"
         Context="module"
         ItemsProvider="@GetItems"
         SelectionMode="SelectionMode.Single"
         Filter="@Filter"
         ShowRemoved="false"
         ShowAllUsers="false"
         OnSearch="@Updated">
    <FilterContent>
        <th>
            @*Image*@
        </th>
        <th>
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@((ChangeEventArgs __e) => filter.Id = Convert.ToString(__e.Value) ?? string.Empty)" />
        </th>
    </FilterContent>
    <HeaderContent>
        <th width="1%"></th>
        <GXTh Name="Name" Target="@module" SortMode="SortMode.Descending">@Properties.Resources.Name</GXTh>
        <th>@Properties.Resources.Description</th>
    </HeaderContent>
    <ItemContent>
        <td class="img-cell">
            <GXImage Id="@module.Id"></GXImage>
        </td>
        <GXTd Link="@NavigationManager.GetCurrentPagePath("/Extension/Edit/" + module.Id)">
            <span class=@(ClientHelpers.GetActiveDot(module.Enabled))>
            </span><span class="@module.Id" aria-hidden="true"></span>@module.Id
        </GXTd>
        <td>
            @module.Description
        </td>
    </ItemContent>
</GXTable>
<br />
@code {
    private IGXNotifier? Notifier;
    private IGXProgress? Progress;
    private IGXNotificationService? NotificationService;

    [Parameter]
    public Gurux.DLMS.AMI.Client.Pages.Module.ModuleManage? Parent { get; set; }

    /// <summary>
    /// Selected module ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <inheritdoc />
    public string Name
    {
        get
        {
            return Properties.Resources.Extensions;
        }
    }

    /// <inheritdoc />
    public Type? ConfigurationUI
    {
        get
        {
            return null;
        }
    }

    /// <inheritdoc />
    public string? Icon
    {
        get
        {
            return "extensions";
        }
    }

    /// <summary>
    /// Amount of the modules shown on the view.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 0;

    [Parameter]
    public GXModule? Active { get; set; }

    /// <summary>
    /// Is filter shown.
    /// </summary>
    [Parameter]
    public bool Filter { get; set; } = true;

    /// <summary>
    /// Is header shown.
    /// </summary>
    [Parameter]
    public bool Header { get; set; } = true;

    /// <summary>
    /// Is edit allowed.
    /// </summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Available columns.
    /// </summary>
    [Parameter]
    public string[]? Columns { get; set; }

    /// <summary>
    /// Is title shown.
    /// </summary>
    [Parameter]
    public bool Title { get; set; } = true;

    /// <summary>
    /// Module filter. Show only installed and activated modules.
    /// </summary>
    private GXModule filter = new GXModule()
    {
        Enabled = true,

        Status = (ModuleStatus.Installed | ModuleStatus.CustomBuild)
    };

    /// <summary>
    /// Table reference.
    /// </summary>
    protected GXTable<GXModule>? table;

    /// <summary>
    /// Module settings.
    /// </summary>
    private ModuleSettings? _settings;

    /// <summary>
    /// Update table.
    /// </summary>
    protected async Task Updated()
    {
        try
        {
            if (table != null)
            {
                NotificationService?.RemoveByKey("Extensions.Updated");
                await table.RefreshDataAsync(true);
            }
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Extensions.Updated");
        }
    }

    protected override void OnInitialized()
    {
        Notifier = Services.GetService<IGXNotifier>();
        Progress = Services.GetService<IGXProgress>();
        NotificationService = Services.GetService<IGXNotificationService>();
        if (Notifier == null)
        {
            return;
        }

        try
        {
            if (Notifier == null)
            {
                throw new ArgumentException(Properties.Resources.InvalidNotifier);
            }
            NotificationService?.RemoveByKey("Extensions.OnInitialized");
            Notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), (items) =>
            {
                foreach (var it in items)
                {
                    if (it.Type == GXModulePolicies.Add ||
                            it.Type == GXModulePolicies.Delete ||
                            it.Type == GXModulePolicies.Edit)
                    {
                        _ = GXNotificationRefresh.RefreshAsync(table, items, Updated);
                        break;
                    }
                }
            });
            if (Id != null)
            {
                //Get last selected item.
                Active = new GXModule() { Id = Id };
            }
            //Get configuration data.
            if (!string.IsNullOrEmpty(Parent?.Parent?.Active?.Settings))
            {
                _settings = JsonSerializer.Deserialize<ModuleSettings>(Parent.Parent.Active.Settings);
            }
            else
            {
                _settings = new ModuleSettings();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex, "Extensions.OnInitialized");
        }
    }

    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXItemsProviderRequest request)
    {
        //Don't clear status or error is lost.
        using var progressScope1 = Progress?.ProgressStart(GXProgress.RetrievingExtensions);
        try
        {
            ListModules req = new ListModules()
            {
                Index = 0,
                Count = 0,
                Filter = filter,
                OrderBy = request.OrderBy,
                Descending = request.Descending,
                AllUsers = request.ShowAllUserData
            };

            if (!Loader.IsInitialized)
            {
                await Loader.RefreshAsync(request.CancellationToken);
            }
            //Get modules that declare an extension view.
            var ret = await Http.PostAsJson<ListModulesResponse>("api/Module/List", req, request.CancellationToken);
            if (ret.Modules != null)
            {
                var available = Loader.AddIns.Where(m => m.Views.Any(v => v.Area == AmiViewArea.Extension)).Select(m => m.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
                var modules = ret.Modules.Where(m => available.Contains(m.Id)).ToArray();
                return new ItemsProviderResult<GXModule>(modules.Skip(request.StartIndex).Take(Count != 0 ? Count : request.Count), modules.Length);
            }
        }
        catch (TaskCanceledException)
        {
            //Let the table component handle this.
            throw;
        }
        catch (Exception ex)
        {
            NotificationService?.ReportError(ex);
        }
        return default;
    }

    public void Dispose()
    {
        if (table != null)
        {
            GXNotificationRefresh.Remove(table);
        }
        GXNotificationRefresh.Remove(this);
        Notifier?.RemoveListener(this);
    }
}
