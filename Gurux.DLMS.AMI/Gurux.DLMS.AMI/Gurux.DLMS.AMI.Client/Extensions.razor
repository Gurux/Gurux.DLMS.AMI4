@page "/Extension"
@page "/extensions"
@using Gurux.DLMS.AMI.Module
@using Gurux.DLMS.AMI.Module.Enums
@using Gurux.UI.Components.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject HttpClient Http
@implements IDisposable
@implements IGXAmiComponent

@if (Title)
{
    <PageTitle>@Properties.Resources.Extensions</PageTitle>
    <h1>@Properties.Resources.Extensions</h1>
}

<GXTable TItem="GXModule" @ref="table" Active="Active" ActiveChanged="OpenModule"
         Context="module" ItemsProvider="GetItems" SelectionMode="SelectionMode.Single"
         Filter="Filter" ShowRemoved="false" ShowAllUsers="false" OnSearch="Updated">
    <FilterContent>
        <th>
            <input class="form-control" type="text" placeholder="@Properties.Resources.FilterByName"
                   @onchange="@(e => nameFilter = Convert.ToString(e.Value))" />
        </th>
        <th></th>
    </FilterContent>
    <HeaderContent>
        <GXTh Name="Name" Target="@module">@Properties.Resources.Name</GXTh>
        <GXTh Name="Version" Target="@module">@Properties.Resources.Version</GXTh>
    </HeaderContent>
    <ItemContent>
        <GXTd Link="@GetLink(module.Id)">@module.Name</GXTd>
        <GXTd>@module.Version</GXTd>
    </ItemContent>
</GXTable>

@code {
    [Parameter] public Gurux.DLMS.AMI.Client.Pages.Module.ModuleManage? Parent { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public GXModule? Active { get; set; }
    [Parameter] public bool Filter { get; set; } = true;
    [Parameter] public bool Header { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public string[]? Columns { get; set; }
    [Parameter] public bool Title { get; set; } = true;
    public string Name => Properties.Resources.Extensions;
    public Type? ConfigurationUI => null;
    public string? Icon => "extensions";
    protected GXTable<GXModule>? table;
    private IGXNotifier? notifier;
    private IGXProgress? progress;
    private IGXNotificationService? notifications;
    private AuthenticationStateProvider? authentication;
    private readonly CancellationTokenSource lifetime = new();
    private Dictionary<string, string> links = new(StringComparer.OrdinalIgnoreCase);
    private string? nameFilter;
    private long generation;
    private bool disposed;

    protected override void OnInitialized()
    {
        notifier = Services.GetService<IGXNotifier>();
        progress = Services.GetService<IGXProgress>();
        notifications = Services.GetService<IGXNotificationService>();
        authentication = Services.GetService<AuthenticationStateProvider>();
        if (authentication != null)
        {
            authentication.AuthenticationStateChanged += AuthenticationChanged;
        }
        notifier?.On<IEnumerable<GXTarget>>(this, nameof(IGXHubEvents.OnUpdate), items =>
        {
            if (items.Any(i => i.Type == GXModulePolicies.Add || i.Type == GXModulePolicies.Edit || i.Type == GXModulePolicies.Delete))
            {
                _ = InvokeAsync(Updated);
            }
        });
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        Interlocked.Increment(ref generation);
        links.Clear();
        _ = InvokeAsync(Updated);
    }

    protected async Task Updated()
    {
        try
        {
            if (!disposed && table != null) { await table.RefreshDataAsync(true); }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception error) { ReportError(error); }
    }

    private async ValueTask<ItemsProviderResult<GXModule>> GetItems(GXItemsProviderRequest request)
    {
        var current = Interlocked.Increment(ref generation);
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(request.CancellationToken, lifetime.Token);
        using var scope = progress?.ProgressStart(GXProgress.RetrievingExtensions);
        try
        {
            // ModuleController filters descriptors by the current user's module access and UI policies.
            // Runtime manifests describe installed modules; Active and Enabled exclude inactive deployments.
            var manifests = await Http.GetFromJsonAsync<AmiModuleManifest[]>("api/Module/Runtime", cancellation.Token) ?? [];
            cancellation.Token.ThrowIfCancellationRequested();
            if (current != generation || disposed) { throw new OperationCanceledException(); }
            var available = new List<GXModule>();
            var nextLinks = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var manifest in manifests.Where(m => m.Enabled && m.State == AmiModuleState.Active))
            {
                var page = manifest.Pages.FirstOrDefault(p => p.Navigation && !string.IsNullOrWhiteSpace(p.Route));
                var view = manifest.Views.FirstOrDefault(v => v.Area == AmiViewArea.Extension && v.Key == null);
                var moduleId = Uri.EscapeDataString(manifest.Id);
                string? link = page != null ? "/addin/" + moduleId + "/" + Uri.EscapeDataString(page.Route) : null;
                if (link == null && view != null) { link = "/Extension/" + moduleId; }
                page ??= manifest.Pages.FirstOrDefault(p => !string.IsNullOrWhiteSpace(p.Route));
                if (link == null && page != null) { link = "/addin/" + moduleId + "/" + Uri.EscapeDataString(page.Route); }
                if (link == null) { continue; }
                nextLinks[manifest.Id] = link;
                available.Add(new GXModule { Id = manifest.Id, Name = string.IsNullOrWhiteSpace(manifest.Name) ? manifest.Id : manifest.Name, Version = manifest.Version, Enabled = true });
            }
            links = nextLinks;
            notifications?.RemoveByKey("Extensions.Load");
            var filtered = available.Where(m =>
                (string.IsNullOrWhiteSpace(nameFilter) || (m.Name ?? m.Id).Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(request.Filter) || (m.Name ?? m.Id).Contains(request.Filter, StringComparison.CurrentCultureIgnoreCase) || m.Id.Contains(request.Filter, StringComparison.OrdinalIgnoreCase)));
            Func<GXModule, string?> sort = request.OrderBy == "Version" ? m => m.Version : m => m.Name;
            var ordered = (request.Descending ? filtered.OrderByDescending(sort, StringComparer.CurrentCultureIgnoreCase) : filtered.OrderBy(sort, StringComparer.CurrentCultureIgnoreCase))
                .ThenBy(m => m.Id, StringComparer.OrdinalIgnoreCase).ToArray();
            var count = Count > 0 ? Count : request.Count;
            return new ItemsProviderResult<GXModule>(count > 0 ? ordered.Skip(request.StartIndex).Take(count) : ordered.Skip(request.StartIndex), ordered.Length);
        }
        catch (OperationCanceledException) { throw; }
        catch (AccessTokenNotAvailableException error) { error.Redirect(); throw; }
        catch (Exception error)
        {
            if (current != generation || cancellation.IsCancellationRequested || disposed)
            {
                throw new OperationCanceledException("The module list request was superseded.", error, cancellation.Token);
            }
            links.Clear();
            ReportError(error);
            return new ItemsProviderResult<GXModule>([], 0);
        }
    }

    private string? GetLink(string id) => links.GetValueOrDefault(id);
    private void OpenModule(GXModule? module)
    {
        Active = module;
        if (module != null && GetLink(module.Id) is string link) { NavigationManager.NavigateTo(link); }
    }
    private void ReportError(Exception error) => notifications?.Add(new GXNotificationItem(NotificationLevel.Error, Properties.Resources.Extensions, error.Message, "Extensions.Load", true));

    public void Dispose()
    {
        disposed = true;
        lifetime.Cancel();
        if (authentication != null) { authentication.AuthenticationStateChanged -= AuthenticationChanged; }
        notifier?.RemoveListener(this);
    }
}
