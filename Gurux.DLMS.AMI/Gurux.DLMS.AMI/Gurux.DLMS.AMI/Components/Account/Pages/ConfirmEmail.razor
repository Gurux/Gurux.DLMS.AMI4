@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Gurux.DLMS.AMI.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ConfirmEmail> Logger

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.ConfirmEmail</PageTitle>

<h1>@Gurux.DLMS.AMI.Properties.Resources.ConfirmEmail</h1>
<StatusMessage Message="@statusMessage" />

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? ChangedEmail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = string.Format(Gurux.DLMS.AMI.Properties.Resources.ErrorLoadingUserWithID0, UserId);
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            if (ChangedEmail is not null)
            {
                // Identity API manage/info links use this route with changedEmail.
                // Validate the email-bound token before changing either stored identifier.
                var changeResult = await UserManager.ChangeEmailAsync(user, ChangedEmail, code);
                if (!changeResult.Succeeded)
                {
                    statusMessage = Gurux.DLMS.AMI.Properties.Resources.ErrorChangingEmail;
                    return;
                }
                var nameResult = await UserManager.SetUserNameAsync(user, ChangedEmail);
                statusMessage = nameResult.Succeeded
                    ? Gurux.DLMS.AMI.Properties.Resources.ThankYouForConfirmingYourEmailChange
                    : Gurux.DLMS.AMI.Properties.Resources.ErrorChangingUserName;
                return;
            }
            var result = await UserManager.ConfirmEmailAsync(user, code);
            if (!result.Succeeded)
            {
                Logger.LogWarning("Email confirmation failed with Identity error codes: {ErrorCodes}",
                    string.Join(", ", result.Errors.Select(error => error.Code)));
            }
            statusMessage = result.Succeeded ? Gurux.DLMS.AMI.Properties.Resources.ThankYouForConfirmingYourEmail : Gurux.DLMS.AMI.Properties.Resources.ErrorConfirmingYourEmail;
        }
    }
}
