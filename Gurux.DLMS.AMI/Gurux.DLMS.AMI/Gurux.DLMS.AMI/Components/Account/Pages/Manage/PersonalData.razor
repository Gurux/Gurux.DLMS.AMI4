@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.PersonalData2</PageTitle>

<StatusMessage />
<h3>@Gurux.DLMS.AMI.Properties.Resources.PersonalData2</h3>

<div class="row mx-0">
    <div class="col-md-6">
        <p>@Gurux.DLMS.AMI.Properties.Resources.YourAccountContainsPersonalDataThatYouHaveGivenUsThisPageAllowsYouToDownloadOrDeleteT</p>
        <p>
            <strong>@Gurux.DLMS.AMI.Properties.Resources.DeletingThisDataWillPermanentlyRemoveYourAccountAndThisCannotBeRecovered</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@Gurux.DLMS.AMI.Properties.Resources.Download</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@Gurux.DLMS.AMI.Properties.Resources.Delete</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
