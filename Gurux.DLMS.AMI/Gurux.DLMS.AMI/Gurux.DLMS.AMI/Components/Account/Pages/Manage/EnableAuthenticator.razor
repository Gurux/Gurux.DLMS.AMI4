@page "/Account/Manage/EnableAuthenticator"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Gurux.DLMS.AMI.Data
@using Gurux.DLMS.AMI.Module

@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject UrlEncoder UrlEncoder
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator> Logger
@inject IGXAmiModuleServices ModuleServices

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.ConfigureAuthenticatorApp</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else if (!enrollmentEnabled)
{
    <p>@Gurux.DLMS.AMI.Properties.Resources.AuthenticatorEnrollmentHasBeenDisabledByAnAdministratorExistingAuthenticatorLoginsRem</p>
}
else
{
    <StatusMessage Message="@message" />
    <h3>@Gurux.DLMS.AMI.Properties.Resources.ConfigureAuthenticatorApp</h3>
    <div>
        <p>@Gurux.DLMS.AMI.Properties.Resources.ToUseAnAuthenticatorAppGoThroughTheFollowingSteps</p>
        <ol class="list">
            <li>
                <p>
                    @Gurux.DLMS.AMI.Properties.Resources.DownloadATwoFactorAuthenticatorAppLikeMicrosoftAuthenticatorFor
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> @Gurux.DLMS.AMI.Properties.Resources.And
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> @Gurux.DLMS.AMI.Properties.Resources.OrGoogleAuthenticatorFor
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> @Gurux.DLMS.AMI.Properties.Resources.And
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
                </p>
            </li>
            <li>
                <p>@Gurux.DLMS.AMI.Properties.Resources.ScanTheQRCodeOrEnterThisKey <kbd>@sharedKey</kbd> into your two factor authenticator app. Spaces and casing do not matter.</p>
                @if (qrCodeImage is not null)
                {
                    <img src="@qrCodeImage" alt="@Gurux.DLMS.AMI.Properties.Resources.ScanThisQRCodeWithYourAuthenticatorApp" class="img-fluid" width="300" height="300" />
                }
                else
                {
                    <p>@Gurux.DLMS.AMI.Properties.Resources.QRCodeGenerationIsUnavailableEnterTheKeyAboveIntoYourAuthenticatorApp</p>
                }
            </li>
            <li>
                <p>
                    @Gurux.DLMS.AMI.Properties.Resources.OnceYouHaveScannedTheQRCodeOrInputTheKeyAboveYourTwoFactorAuthenticationAppWillProvid
                </p>
                <div class="row mx-0">
                    <div class="col-xl-6">
                        <EditForm EditContext="@Gurux.DLMS.AMI.Client.Helpers.GXEditContexts.For(Input)" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post">
                            <DataAnnotationsValidator />
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="Input.Code" id="Input.Code" class="form-control" autocomplete="off" placeholder="@Gurux.DLMS.AMI.Properties.Resources.EnterTheCode" />
                                <label for="Input.Code" class="control-label form-label">@Gurux.DLMS.AMI.Properties.Resources.VerificationCode</label>
                                <ValidationMessage For="() => Input.Code" class="text-danger" />
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-primary">@Gurux.DLMS.AMI.Properties.Resources.Verify</button>
                            <ValidationSummary class="text-danger" role="alert" />
                        </EditForm>
                    </div>
                </div>
            </li>
        </ol>
    </div>
}

@code {
    private const string AuthenticatorUriFormat = "otpauth://totp/{0}:{1}?secret={2}&issuer={0}&digits=6";

    private string? message;
    private ApplicationUser user = default!;
    private string? sharedKey;
    private string? qrCodeImage;
    private bool enrollmentEnabled;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        HttpContext.Response.Headers.CacheControl = "no-store";
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        enrollmentEnabled = (await QrLoginFlow.FeaturesAsync(ModuleServices, HttpContext.RequestAborted)).TotpEnrollmentEnabled;
        if (!enrollmentEnabled)
        {
            return;
        }

        await LoadSharedKeyAndQrCodeUriAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        // Recheck on POST: hiding the setup UI alone does not prevent enrollment.
        if (!(await QrLoginFlow.FeaturesAsync(ModuleServices, HttpContext.RequestAborted)).TotpEnrollmentEnabled)
        {
            return;
        }
        // Strip spaces and hyphens
        var verificationCode = Input.Code.Replace(" ", string.Empty).Replace("-", string.Empty);

        var is2faTokenValid = await UserManager.VerifyTwoFactorTokenAsync(
            user, UserManager.Options.Tokens.AuthenticatorTokenProvider, verificationCode);

        if (!is2faTokenValid)
        {
            message = Gurux.DLMS.AMI.Properties.Resources.ErrorVerificationCodeIsInvalid;
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, true);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has enabled 2FA with an authenticator app.", userId);

        message = Gurux.DLMS.AMI.Properties.Resources.YourAuthenticatorAppHasBeenVerified;

        if (await UserManager.CountRecoveryCodesAsync(user) == 0)
        {
            recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        }
        else
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/TwoFactorAuthentication", message, HttpContext);
        }
    }

    private async ValueTask LoadSharedKeyAndQrCodeUriAsync(ApplicationUser user)
    {
        // Load the authenticator key & QR code URI to display on the form
        var unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(unformattedKey))
        {
            await UserManager.ResetAuthenticatorKeyAsync(user);
            unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        }

        sharedKey = FormatKey(unformattedKey!);

        var email = await UserManager.GetEmailAsync(user);
        var authenticatorUri = GenerateQrCodeUri(email!, unformattedKey!);
        try
        {
            var png = await ModuleServices.InvokeAsync<IGXAmiQrCodeGenerator, byte[]>(
                (generator, _) => Task.FromResult(generator.GeneratePng(authenticatorUri)), HttpContext.RequestAborted);
            qrCodeImage = "data:image/png;base64," + Convert.ToBase64String(png);
        }
        catch (AmiModuleUnavailableException)
        {
            // Manual enrollment remains available when the optional module is stopped.
            qrCodeImage = null;
        }
    }

    private string FormatKey(string unformattedKey)
    {
        var result = new StringBuilder();
        int currentPosition = 0;
        while (currentPosition + 4 < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition, 4)).Append(' ');
            currentPosition += 4;
        }
        if (currentPosition < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition));
        }

        return result.ToString().ToLowerInvariant();
    }

    private string GenerateQrCodeUri(string email, string unformattedKey)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            AuthenticatorUriFormat,
            UrlEncoder.Encode("Gurux.DLMS.AMI"),
            UrlEncoder.Encode(email),
            unformattedKey);
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(7, ErrorMessageResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources), ErrorMessageResourceName = nameof(Gurux.DLMS.AMI.Properties.Resources.The0MustBeAtLeast2AndAtMax1CharactersLong), MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = nameof(Gurux.DLMS.AMI.Properties.Resources.VerificationCode), ResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources))]
        public string Code { get; set; } = "";
    }
}
