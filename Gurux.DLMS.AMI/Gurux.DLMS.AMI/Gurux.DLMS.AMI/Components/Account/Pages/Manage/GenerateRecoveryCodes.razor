@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using Gurux.DLMS.AMI.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.GenerateTwoFactorAuthentication2FARecoveryCodes</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <h3>@Gurux.DLMS.AMI.Properties.Resources.GenerateTwoFactorAuthentication2FARecoveryCodes</h3>
    <div class="alert alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>@Gurux.DLMS.AMI.Properties.Resources.PutTheseCodesInASafePlace</strong>
        </p>
        <p>
            @Gurux.DLMS.AMI.Properties.Resources.IfYouLoseYourDeviceAndDonTHaveTheRecoveryCodesYouWillLoseAccessToYourAccount
        </p>
        <p>
            @Gurux.DLMS.AMI.Properties.Resources.GeneratingNewRecoveryCodesDoesNotChangeTheKeysUsedInAuthenticatorAppsIfYouWishToChang <a href="Account/Manage/ResetAuthenticator">@Gurux.DLMS.AMI.Properties.Resources.ResetYourAuthenticatorKeys</a>
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">@Gurux.DLMS.AMI.Properties.Resources.GenerateRecoveryCodes</button>
        </form>
    </div>
}

@code {
    private string? message;
    private ApplicationUser user = default!;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException(Gurux.DLMS.AMI.Properties.Resources.CannotGenerateRecoveryCodesForUserBecauseTheyDoNotHave2FAEnabled);
        }
    }

    private async Task OnSubmitAsync()
    {
        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = Gurux.DLMS.AMI.Properties.Resources.YouHaveGeneratedNewRecoveryCodes;

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
