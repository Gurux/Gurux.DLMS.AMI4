@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Gurux.DLMS.AMI.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IWebHostEnvironment HostEnvironment
@inject Gurux.DLMS.AMI.Server.Services.GXAccountRegistrationPolicy RegistrationPolicy

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.Register</PageTitle>

<h1>@Gurux.DLMS.AMI.Properties.Resources.Register</h1>

<StatusMessage Message="@Message" />
@if (registrationAllowed && !registrationCompleted)
{
<div class="row mx-0">
    <div class="col-lg-6">
        <EditForm EditContext="@Gurux.DLMS.AMI.Client.Helpers.GXEditContexts.For(Input)" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="RegisterUser" FormName="register"
                  data-testid="account-register" data-first-user="@firstUser.ToString().ToLowerInvariant()">
            <DataAnnotationsValidator />
            <h2>@Gurux.DLMS.AMI.Properties.Resources.CreateANewAccount</h2>
            <hr />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email">@Gurux.DLMS.AMI.Properties.Resources.SiteEmailAddress</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Gurux.DLMS.AMI.Properties.Resources.Password2" />
                <label for="Input.Password">@Gurux.DLMS.AMI.Properties.Resources.Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Gurux.DLMS.AMI.Properties.Resources.Password2" />
                <label for="Input.ConfirmPassword">@Gurux.DLMS.AMI.Properties.Resources.ConfirmPassword</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@Gurux.DLMS.AMI.Properties.Resources.Register</button>
        </EditForm>
    </div>
    <div class="col-lg-4 col-lg-offset-2">
        <section>
            <ExternalLoginPicker Heading="@Gurux.DLMS.AMI.Properties.Resources.UseAnotherServiceToRegister" />
        </section>
    </div>
</div>
}

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private string? errorMessage;
    private bool registrationAllowed;
    private bool firstUser;
    private bool registrationCompleted;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckRegistrationAllowedAsync();
    }

    private async Task<bool> CheckRegistrationAllowedAsync()
    {
        var registration = await RegistrationPolicy.ReadAsync(HttpContext.RequestAborted);
        firstUser = registration.FirstUser;
        registrationAllowed = registration.CanCreate(HttpContext.User);
        if (!registrationAllowed)
        {
            errorMessage = Gurux.DLMS.AMI.Properties.Resources.RegistrationDisabled;
            if (!HttpContext.Response.HasStarted)
            {
                HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
            }
        }
        return registrationAllowed;
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => errorMessage ?? (identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}");

    public async Task RegisterUser(EditContext editContext)
    {
        identityErrors = null;
        errorMessage = null;
        try
        {
            await RegisterUserAsync();
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            Logger.LogError(ex, "Registration failed. Request ID: {RequestId}", HttpContext.TraceIdentifier);
            errorMessage = string.Format(Gurux.DLMS.AMI.Properties.Resources.ErrorRegistrationCouldNotBeCompletedRequestID0, HttpContext.TraceIdentifier);
            if (HostEnvironment.IsDevelopment())
            {
                var cause = ex.GetBaseException();
                errorMessage += string.Format(Gurux.DLMS.AMI.Properties.Resources.Text01, cause.GetType().Name, cause.Message);
            }
        }
    }

    private async Task RegisterUserAsync()
    {
        if (!await CheckRegistrationAllowedAsync())
        {
            return;
        }
        var user = CreateUser();

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        Logger.LogInformation("Registration: creating the user and initializing defaults. Request ID: {RequestId}", HttpContext.TraceIdentifier);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        if (!user.EmailConfirmed)
        {
            var userId = await UserManager.GetUserIdAsync(user);
            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

            Logger.LogInformation("Registration: sending the confirmation link. Request ID: {RequestId}", HttpContext.TraceIdentifier);
            await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));
        }
        registrationCompleted = true;
        if (!user.IsApproved)
        {
            errorMessage = Gurux.DLMS.AMI.Properties.Resources.RegistrationPendingApproval;
            return;
        }
        if (!await UserManager.IsEmailConfirmedAsync(user))
        {
            errorMessage = Gurux.DLMS.AMI.Properties.Resources.RegistrationConfirmationRequired;
            return;
        }
        if (!await SignInManager.CanSignInAsync(user))
        {
            errorMessage = Gurux.DLMS.AMI.Properties.Resources.AccountSignInNotAllowed;
            return;
        }
        Logger.LogInformation("Registration: signing in. Request ID: {RequestId}", HttpContext.TraceIdentifier);
        await SignInManager.SignInAsync(user, isPersistent: false);
        Logger.LogInformation("Registration: redirecting after sign-in. Request ID: {RequestId}", HttpContext.TraceIdentifier);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = nameof(Gurux.DLMS.AMI.Properties.Resources.SiteEmailAddress), ResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources))]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessageResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources), ErrorMessageResourceName = nameof(Gurux.DLMS.AMI.Properties.Resources.The0MustBeAtLeast2AndAtMax1CharactersLong), MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = nameof(Gurux.DLMS.AMI.Properties.Resources.Password), ResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources))]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = nameof(Gurux.DLMS.AMI.Properties.Resources.ConfirmPassword2), ResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources))]
        [Compare("Password", ErrorMessageResourceType = typeof(Gurux.DLMS.AMI.Properties.Resources), ErrorMessageResourceName = nameof(Gurux.DLMS.AMI.Properties.Resources.ThePasswordAndConfirmationPasswordDoNotMatch))]
        public string ConfirmPassword { get; set; } = "";
    }
}
