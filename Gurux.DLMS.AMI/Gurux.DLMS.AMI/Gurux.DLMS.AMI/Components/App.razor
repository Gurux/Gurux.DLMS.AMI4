@using Gurux.DLMS.AMI.Client.Layout
@using Gurux.DLMS.AMI.Services

@inject ILogger<App> Logger

<PersistAntiforgeryState />
@* Workaround for AntiforgeryToken bug like https://github.com/dotnet/aspnetcore/issues/58822 *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="gx-wasm-version" content="@(System.Diagnostics.FileVersionInfo.GetVersionInfo(typeof(App).Assembly.Location).FileVersion)" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Gurux.DLMS.AMI.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="deployment-version.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Interactive pages depend on browser services; Account routes retain static rendering.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting()
            ? new Microsoft.AspNetCore.Components.Web.InteractiveWebAssemblyRenderMode(prerender: false)
            : null;
}
