@page "/Error"
@using System.Diagnostics

<PageTitle>@Gurux.DLMS.AMI.Properties.Resources.Error</PageTitle>

<h1 class="text-danger">@Gurux.DLMS.AMI.Properties.Resources.Error2</h1>
<h2 class="text-danger">@Gurux.DLMS.AMI.Properties.Resources.AnErrorOccurredWhileProcessingYourRequest</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Gurux.DLMS.AMI.Properties.Resources.RequestID</strong> <code>@RequestId</code>
    </p>
}

<h3>@Gurux.DLMS.AMI.Properties.Resources.DevelopmentMode</h3>
<p>
    @Gurux.DLMS.AMI.Properties.Resources.SwappingTo <strong>@Gurux.DLMS.AMI.Properties.Resources.Development</strong> @Gurux.DLMS.AMI.Properties.Resources.EnvironmentWillDisplayMoreDetailedInformationAboutTheErrorThatOccurred
</p>
<p>
    <strong>@Gurux.DLMS.AMI.Properties.Resources.TheDevelopmentEnvironmentShouldnTBeEnabledForDeployedApplications</strong>
    @Gurux.DLMS.AMI.Properties.Resources.ItCanResultInDisplayingSensitiveInformationFromExceptionsToEndUsersForLocalDebuggingE <strong>@Gurux.DLMS.AMI.Properties.Resources.Development</strong> @Gurux.DLMS.AMI.Properties.Resources.EnvironmentBySettingThe <strong>ASPNETCORE_ENVIRONMENT</strong> @Gurux.DLMS.AMI.Properties.Resources.EnvironmentVariableTo <strong>@Gurux.DLMS.AMI.Properties.Resources.Development</strong>
    @Gurux.DLMS.AMI.Properties.Resources.AndRestartingTheApp
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
